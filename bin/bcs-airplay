#!/usr/bin/python3
"""bcs-airplay - the AirPlay receiver for the whole NOC wall (runs on the middle display).

Runs UxPlay so the wall shows up on Macs, iPhones and iPads as one AirPlay display ("BCS NOC Wall").
UxPlay doesn't draw the video itself here: it forwards the (decrypted, still compressed) stream to
the bcs-wallplayer on every display, which shows its own part. See bcs-wallplayer.

Settings (~/.config/bcs-noc/airplay, written by 'kiosk airplay ...'):
  mode=wall      the Mac sees one very wide display spanning the TVs (use it as an extended display);
                 a mirrored screen shows on the middle TV
  mode=center    the Mac sees one ordinary display: the middle TV
  res=720        picture height per TV: 540 (lightest), 720 (default), 1080 (sharpest; needs a Mac that
                 sends H.265 and minis that can decode it), 2160 (center mode only)
  name=BCS NOC Wall
  pin=1234       code a new device must enter once (off = no code)
  bluetooth=yes  also announce the wall over Bluetooth Low Energy, so Macs / iPhones in the room find it
                 even when Bonjour (mDNS) doesn't reach their network segment (no = network only)

  bcs-airplay            run (normally from the bcs-airplay user service)
  bcs-airplay --print    show the UxPlay command it would run
"""
import os, re, shlex, shutil, socket, subprocess, sys, time

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config", "bcs-noc")
SETTINGS = os.path.join(CONF, "airplay")
PEERS = os.path.join(CONF, "peers")
PIN_ASKED = os.path.join(CONF, "airplay-pin-asked")      # touched when a new device is asked for the code
STATUS = os.path.join(CONF, "airplay-status")
PORT = int(os.environ.get("BCS_WALL_PORT", "47600"))
RES = {"wall": [540, 720, 1080], "center": [720, 1080, 2160]}
BLE_FILE = os.path.join(HOME, ".uxplay.ble")
BEACON = os.environ.get("BCS_BEACON", "/usr/local/lib/bcs-noc/uxplay-beacon/uxplay-beacon.py")
BEACON_STATUS = os.path.join(CONF, "airplay-bluetooth")


def my_ipv4():
    """The address Macs should connect to (the one the default route uses)."""
    try:
        out = subprocess.run(["ip", "-4", "route", "get", "1.1.1.1"], capture_output=True, text=True, timeout=3).stdout.split()
        return out[out.index("src") + 1]
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        pass
    try:                                                        # no default route: the first global address
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"], capture_output=True, text=True, timeout=3).stdout
        return out.split()[3].split("/")[0]
    except (OSError, IndexError, subprocess.SubprocessError):
        pass
    try:
        return subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=3).stdout.split()[0]
    except (OSError, IndexError, subprocess.SubprocessError):
        return None


class Beacon:
    """UxPlay's Bluetooth LE beacon: tells nearby Apple devices the wall's address and port over
    Bluetooth, so it shows up in Screen Mirroring even when Bonjour doesn't reach their network."""

    def __init__(self):
        self.p, self.started, self.note = None, 0, ""

    def check(self, want):
        if not want:
            self.stop()
            return
        if self.p and self.p.poll() is None:
            return
        if self.p is not None and time.time() - self.started < 30:
            return                                                  # it gave up recently (no adapter?): retry in a bit
        ip = my_ipv4()
        if not os.path.exists(BEACON) or not ip:
            self.status("not available" + ("" if ip else " (no network address)"))
            return
        subprocess.run(["bluetoothctl", "power", "on"], capture_output=True, timeout=10)
        self.p = subprocess.Popen([sys.executable, "-u", BEACON, "--path", BLE_FILE, "--ipv4", ip],   # -u: its messages as they happen
                                  stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        self.started = time.time()
        import threading
        threading.Thread(target=self._read, args=(self.p, ip), daemon=True).start()

    def _read(self, p, ip):
        self.status(f"starting (announcing {ip})")
        problem = ""
        for line in p.stdout:
            line = line.rstrip()
            if not line:
                continue
            print("beacon:", line, file=sys.stderr, flush=True)
            low = line.lower()
            if "advertisement" in low and "registered" in low and "unregistered" not in low:
                self.status(f"on: announcing {ip} over Bluetooth")          # the beacon is on the air
            elif "unregistered" in low:
                self.status("waiting for UxPlay")
            elif "advertising ip address" in low:
                self.status(f"ready (will announce {ip} while AirPlay is on)")
            elif "error" in low or "not found" in low or "failed" in low or "importerror" in low:
                problem = line[:160]
                self.status("PROBLEM: " + problem)
        p.wait()
        self.status(f"NOT ANNOUNCING over Bluetooth: {problem or 'the beacon stopped'} (retrying every 30 s)")

    def status(self, text):
        self.note = text
        try:
            with open(BEACON_STATUS, "w") as f:
                f.write(text + "\n")
        except OSError:
            pass

    def stop(self):
        if self.p and self.p.poll() is None:
            self.p.terminate()
        self.p = None



def log(*a):
    print("bcs-airplay:", *a, file=sys.stderr, flush=True)


def settings():
    s = {"mode": "wall", "res": "720", "name": "BCS NOC Wall", "pin": "", "bluetooth": "yes"}
    try:
        for line in open(SETTINGS):
            k, _, v = line.rstrip("\n").partition("=")
            if k.strip() and not k.startswith("#"):
                s[k.strip()] = v.strip()
    except OSError:
        pass
    return s


def wall():
    try:
        v = open(os.path.join(CONF, "wall")).read().split()
        pos, n = int(v[0]), int(v[1])
        gap = float(v[2]) / 100 if len(v) > 2 else 0.08
        return (pos, n, gap) if 1 <= pos <= n else (1, 1, 0.0)
    except (OSError, ValueError, IndexError):
        return (1, 1, 0.0)


def size(mode, res, n, gap):
    """(width, height, h265) to ask the Mac for. In wall mode the picture covers every TV plus the bezel
    gaps between them, at 16:9 per TV; wider than 4096 pixels needs H.265."""
    h = int(res)
    tv_w = round(h * 16 / 9)
    w = round(tv_w * (n + (n - 1) * gap)) if mode == "wall" and n > 1 else tv_w
    w -= w % 2
    return w, h, w > 4096 or h > 1080


def players():
    """Every display's player (their addresses from 'noc link'), or just this one."""
    hosts = []
    try:
        for p in open(PEERS):
            p = p.strip()
            if p and not p.startswith("#"):
                hosts.append(p.partition(":")[0])
    except OSError:
        pass
    out = []
    for h in hosts or ["127.0.0.1"]:
        try:
            out.append(socket.gethostbyname(h))             # the sender wants addresses, not names
        except OSError:
            log("can't find the address of display", h)
    return out or ["127.0.0.1"]


def command(s=None):
    s = s or settings()
    mode = s["mode"] if s["mode"] in RES else "wall"
    res = s["res"] if s["res"].isdigit() and int(s["res"]) in RES[mode] else "720"
    pos, n, gap = wall()
    w, h, h265 = size(mode, res, n, gap)
    port = PORT + 2 if h265 else PORT
    targets = players() if mode == "wall" else ["127.0.0.1"]       # center mode: only this TV shows it
    clients = ",".join(f"{a}:{port}" for a in targets)
    cmd = ["uxplay", "-n", s["name"] or "BCS NOC Wall", "-nh", "-s", f"{w}x{h}", "-fps", "30", "-p",
           "-vrtp", f"config-interval=1 ! multiudpsink clients={clients}"]
    if h265:
        cmd.append("-h265")
    if s["pin"] and s["pin"] != "off":
        cmd += ["-pin", s["pin"], "-reg"]
    if s.get("bluetooth") != "no":
        cmd += ["-ble", BLE_FILE]                                  # UxPlay writes its port + pid here for the beacon
    desc = (f"{mode} mode, {w}x{h} ({'H.265' if h265 else 'H.264'})" +
            (f", across {n} TVs ({round(w / (n + (n - 1) * gap))}x{h} each)" if mode == "wall" and n > 1 else ", this TV only"))
    return cmd, desc


def main():
    if "--print" in sys.argv:
        cmd, desc = command()
        print(desc)
        print(" ".join(shlex.quote(c) for c in cmd))
        return
    os.makedirs(CONF, exist_ok=True)
    beacon = Beacon()
    import threading

    def keep_beacon():
        while True:
            beacon.check(settings().get("bluetooth") != "no")
            time.sleep(5)
    threading.Thread(target=keep_beacon, daemon=True).start()
    while True:
        cmd, desc = command()
        log("starting UxPlay:", desc, "- video to", ", ".join(players()))
        with open(STATUS, "w") as f:
            f.write(desc + "\n")
        if shutil.which("stdbuf"):
            cmd = ["stdbuf", "-oL", "-eL"] + cmd                # UxPlay's messages line by line (it buffers into a pipe)
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)
        for line in p.stdout:
            line = line.rstrip()
            if line:
                print(line, file=sys.stderr, flush=True)
            m = re.search(r'MUST NOW ENTER PIN = "(\d{4})"', line)            # UxPlay: a new device is pairing
            if m:
                with open(PIN_ASKED, "w") as f:                 # the TV shows the code (kiosk-launch)
                    f.write(m.group(1) + "\n")
        p.wait()
        log(f"UxPlay exited ({p.returncode}); restarting in 5 s")
        time.sleep(5)


if __name__ == "__main__":
    main()
