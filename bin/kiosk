#!/usr/bin/env bash
# kiosk - control the BCS NOC dashboard on this display
#
#   kiosk status            show state and dashboard URL
#   kiosk stop              close the dashboard (back to the desktop until next reboot)
#   kiosk start             open the dashboard
#   kiosk reload            reload the page
#   kiosk restart           restart Chrome
#   kiosk url [URL...]      show, or change, the dashboard URL (several URLs = a rotation)
#   kiosk rotate every N    rotate through the URLs every N minutes, with a fade (0 = off)
#   kiosk next              show the next dashboard now
#   kiosk interlude         play the BCS NOC interlude now
#   kiosk interlude every N play it every N minutes (0 = off), on the clock (:00, :30 ...)
#   kiosk blanket [on|off|toggle|status]
#                           "BCS Technology Department" over the dashboard until turned off
#                           (also toggled by moving the mouse to the bottom-left corner)
#   kiosk blanket holiday   blanket on with the holiday theme (snow, lights, ladder guy, plow ...)
#   kiosk blanket theme [standard|holiday]
#                           which theme 'on' and the hot corner use (switches it live if on)
#   kiosk wall POS COUNT [GAP]
#                           this display's place in a row of COUNT displays, from the left, and
#                           the space between screens as a % of a screen width (default 8)
#                           (the holiday plow and snowballs cross them in order; set by 'noc wall')
#   kiosk clock             is this display's clock in sync (keeps the holiday scene in step across displays)
#   kiosk version           which build of the display software is installed
#   kiosk link KEY HOST...  let this display's hot corner reach the other displays
#                           (normally set up by 'noc link')
#   kiosk gestures [on|off] camera gestures on this display (installed with --gestures)
#   kiosk gestures preview [off]   show what the camera sees, in a corner (10 minutes)
#   kiosk gestures range M  act on hands up to M metres from the camera (default 2.8)
#   kiosk gestures camera DEV  which camera, e.g. /dev/video2 ('size 640x480' if it's slow)
#   kiosk gestures record [S]  save S seconds of hand positions (no pictures) for tuning
#   kiosk disable           stop and stay off, even after reboots
#   kiosk enable            undo disable and start
#   kiosk reboot            reboot this display
#   kiosk shutdown          power this display off
#
# Works locally or over SSH as the display's auto-login user.
#

URL_FILE=/etc/bcs-noc-dashboard-url
USER_FILE=/etc/bcs-noc-kiosk-user
UNIT=bcs-kiosk.service
GDIR="$HOME/.config/bcs-noc"
INTERLUDE_FILE=/etc/bcs-noc-interlude
ROTATE_FILE=/etc/bcs-noc-rotate

# If run as root (e.g. with sudo), hand off to the kiosk user so we drive their session.
if [[ $EUID -eq 0 ]]; then
  KU=$(cat "$USER_FILE" 2>/dev/null)
  case "${1:-}" in
    reboot)   systemctl reboot --ignore-inhibitors; exit ;;
    shutdown) systemctl poweroff --ignore-inhibitors; exit ;;
  esac
  [[ -n "$KU" ]] || { echo "kiosk: no kiosk user configured ($USER_FILE)"; exit 1; }
  exec runuser -u "$KU" -- env XDG_RUNTIME_DIR="/run/user/$(id -u "$KU")" "$0" "$@"
fi

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
FLAG="$HOME/.config/bcs-noc/disabled"
BLANKET="$HOME/.config/bcs-noc/blanket"
HOST=$(hostname -s)

sc() { systemctl --user "$@"; }
# talk to the running launcher (not Chrome) with a signal
signal_kiosk() { sc kill --kill-whom=main -s "$1" "$UNIT" 2>/dev/null; }
running() { sc is-active --quiet "$UNIT" 2>/dev/null; }

have_desktop() {
  # true when this user has a graphical login (auto-login) running
  local s
  for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk -v u="$USER" '$3==u {print $1}'); do
    case "$(loginctl show-session "$s" -p Type --value 2>/dev/null)" in
      wayland|x11) return 0 ;;
    esac
  done
  return 1
}

start_kiosk() {
  if ! have_desktop; then
    echo "$HOST: no desktop session for $USER yet (still booting, or auto-login is off)"
    return 1
  fi
  sc daemon-reload 2>/dev/null
  sc start "$UNIT" && echo "$HOST: dashboard started"
}

case "${1:-status}" in
  status)
    st=$(sc is-active "$UNIT" 2>/dev/null); st=${st:-unknown}
    [[ $st == active ]] && st=showing
    [[ $st == inactive || $st == failed ]] && st=stopped
    [[ -f $FLAG ]] && st="$st (disabled)"
    [[ -f $BLANKET ]] && st="$st+blanket"; [[ $(cat "$BLANKET" 2>/dev/null) == holiday ]] && st="$st(holiday)"
    im=$(awk '{print $1}' "$INTERLUDE_FILE" 2>/dev/null); im=${im:-30}
    [[ $im == 0 ]] && il="interlude off" || il="interlude ${im}m"
    n=$(grep -c . "$URL_FILE" 2>/dev/null); first=$(grep -m1 . "$URL_FILE" 2>/dev/null)
    rm_=$(awk '{print $1}' "$ROTATE_FILE" 2>/dev/null); rm_=${rm_:-0}
    if [[ ${n:-0} -gt 1 ]]; then
      [[ $rm_ != 0 ]] && first="$first  (+$((n - 1)), rotating every ${rm_}m)" || first="$first  (+$((n - 1)), rotation off)"
    fi
    printf '%-16s up %-10s %-15s %s\n' "$st" "$(uptime -p 2>/dev/null | sed 's/^up //; s/ hours\?/h/; s/ minutes\?/m/; s/ days\?/d/; s/,//g')" "$il" "$first"
    ;;
  start)
    start_kiosk ;;
  stop)
    sc stop "$UNIT" && echo "$HOST: dashboard stopped (returns at next reboot; 'kiosk disable' keeps it off)" ;;
  restart)
    if have_desktop; then sc daemon-reload 2>/dev/null; sc restart "$UNIT" && echo "$HOST: dashboard restarted"
    else start_kiosk; fi ;;
  reload)
    if running; then signal_kiosk USR2 && echo "$HOST: page reloaded"
    else start_kiosk; fi ;;
  interlude)
    case "${2:-now}" in
      now)
        running || { echo "$HOST: dashboard is not running"; exit 1; }
        signal_kiosk USR1 && echo "$HOST: playing interlude" ;;
      every)
        [[ "${3:-}" =~ ^[0-9]+$ ]] || { echo "usage: kiosk interlude every MINUTES   (0 = off)"; exit 1; }
        secs=$(awk '{print $2}' "$INTERLUDE_FILE" 2>/dev/null)
        echo "$3 ${secs:-12}" >"$INTERLUDE_FILE" || { echo "$HOST: cannot write $INTERLUDE_FILE"; exit 1; }
        if [[ $3 == 0 ]]; then echo "$HOST: interlude off"; else echo "$HOST: interlude every $3 minutes"; fi ;;
      off)
        exec "$0" interlude every 0 ;;
      *) echo "usage: kiosk interlude [now | every MINUTES | off]"; exit 1 ;;
    esac ;;
  url)
    if [[ -z "${2:-}" ]]; then
      cat "$URL_FILE"
    else
      for u in "${@:2}"; do
        [[ "$u" =~ ^https?:// ]] || { echo "$HOST: URL must start with http:// or https://  ($u)"; exit 1; }
      done
      printf '%s\n' "${@:2}" >"$URL_FILE" || { echo "$HOST: cannot write $URL_FILE"; exit 1; }
      if [[ $# -eq 2 ]]; then echo "$HOST: dashboard set to $2"
      else
        echo "$HOST: $(($# - 1)) dashboards set"
        [[ $(awk '{print $1}' "$ROTATE_FILE" 2>/dev/null) =~ ^0?$ ]] && echo "$HOST: rotation is off; turn it on with: kiosk rotate every MINUTES"
      fi
      if running; then signal_kiosk HUP; fi
    fi ;;
  rotate)
    case "${2:-}" in
      every)
        [[ "${3:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "usage: kiosk rotate every MINUTES   (0 = off)"; exit 1; }
        echo "$3" >"$ROTATE_FILE" || { echo "$HOST: cannot write $ROTATE_FILE"; exit 1; }
        if [[ $3 =~ ^0*([.]0*)?$ ]]; then echo "$HOST: rotation off"; else echo "$HOST: rotating every $3 minutes"; fi ;;
      off) echo 0 >"$ROTATE_FILE" && echo "$HOST: rotation off" ;;
      "")  m=$(awk '{print $1}' "$ROTATE_FILE" 2>/dev/null); [[ ${m:-0} =~ ^0*([.]0*)?$ ]] && echo "off" || echo "every ${m}m" ;;
      *)   echo "usage: kiosk rotate [every MINUTES | off]"; exit 1 ;;
    esac
    if running; then signal_kiosk HUP; fi ;;
  next)
    mkdir -p "$(dirname "$BLANKET")" && touch "$(dirname "$BLANKET")/next"
    echo "$HOST: next dashboard"
    if running; then signal_kiosk HUP; fi ;;
  blanket)
    mkdir -p "$(dirname "$BLANKET")"
    TFILE="$(dirname "$BLANKET")/blanket-theme"
    deftheme=$(cat "$TFILE" 2>/dev/null); [[ $deftheme == holiday ]] || deftheme=standard
    act="${2:-status}"; theme="${3:-$deftheme}"
    if [[ $act == holiday || $act == standard ]]; then theme=$act; act=on; fi
    if [[ $act == toggle ]]; then [[ -f $BLANKET ]] && act=off || act=on; fi
    case "$act" in
      on)
        [[ $theme == holiday || $theme == standard ]] || { echo "usage: kiosk blanket on [standard|holiday]"; exit 1; }
        echo "$theme" >"$BLANKET"; echo "$HOST: blanket on ($theme)" ;;
      off)    rm -f "$BLANKET"; echo "$HOST: blanket off" ;;
      theme)
        if [[ -z "${3:-}" ]]; then echo "$deftheme"; exit 0; fi
        [[ $3 == holiday || $3 == standard ]] || { echo "usage: kiosk blanket theme [standard|holiday]"; exit 1; }
        echo "$3" >"$TFILE"
        if [[ -f $BLANKET ]]; then echo "$3" >"$BLANKET"; echo "$HOST: blanket theme $3 (switching now)"
        else echo "$HOST: blanket theme $3"; fi ;;
      show)
        # holiday blanket with its clock shifted by OFFSET seconds ('noc blanket show' picks
        # the same offset for every display so the plow and ladder guy come on right away)
        [[ "${3:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "usage: kiosk blanket show OFFSET_SECONDS"; exit 1; }
        echo "$3" >"$(dirname "$BLANKET")/holiday-offset"
        echo holiday >"$BLANKET"; echo "$HOST: holiday blanket, showtime" ;;
      status)
        if [[ -f $BLANKET ]]; then t=$(cat "$BLANKET"); echo "on (${t:-$deftheme})"; else echo off; fi; exit 0 ;;
      *)      echo "usage: kiosk blanket [on|off|toggle|status|holiday|standard|theme NAME]"; exit 1 ;;
    esac
    if running; then signal_kiosk HUP; fi ;;
  wall)
    WFILE="$(dirname "$BLANKET")/wall"
    read -r _ _ oldgap _ 2>/dev/null <"$WFILE"
    if [[ -z "${2:-}" ]]; then
      read -r p c g _ 2>/dev/null <"$WFILE"
      echo "display ${p:-1} of ${c:-1}, gap ${g:-8}%"; exit 0
    fi
    [[ "${2:-}" =~ ^[0-9]+$ && "${3:-}" =~ ^[0-9]+$ && $2 -ge 1 && $2 -le $3 ]] || { echo "usage: kiosk wall POSITION COUNT [GAP%]   (e.g. kiosk wall 2 3 10)"; exit 1; }
    gap="${4:-${oldgap:-8}}"
    [[ "$gap" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "kiosk wall: GAP is a percent of a screen width, e.g. 10"; exit 1; }
    mkdir -p "$(dirname "$BLANKET")" && echo "$2 $3 $gap" >"$WFILE"
    echo "$HOST: display $2 of $3 on the wall, gap $gap%"
    if running; then signal_kiosk HUP; fi ;;
  version)
    cat /etc/bcs-noc-version 2>/dev/null || echo "unknown (installed before versions were tracked)" ;;
  clock)
    if command -v chronyc >/dev/null 2>&1; then
      tr=$(chronyc -n tracking 2>/dev/null)
      leap=$(awk -F': *' '/^Leap status/{print $2}' <<<"$tr")
      ref=$(awk -F': *' '/^Reference ID/{print $2}' <<<"$tr")
      off=$(awk -F': *' '/^System time/{split($2,a," "); printf "%+.1f ms", (a[3]=="slow"?-1:1)*a[1]*1000}' <<<"$tr")
      if [[ $leap == Normal ]]; then echo "synced (chrony)  off by ${off:-?}  source ${ref:-?}"
      else echo "NOT SYNCED (chrony: ${leap:-not running})  - see 'chronyc sources'"; fi
    else
      s=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
      ts=$(timedatectl timesync-status 2>/dev/null)
      srv=$(awk -F': *' '/Server:/{print $2; exit}' <<<"$ts"); off=$(awk -F': *' '/Offset:/{print $2; exit}' <<<"$ts")
      if [[ $s == yes ]]; then echo "synced (timesyncd)  off by ${off:-?}  source ${srv:-?}"
      else echo "NOT SYNCED (timesyncd${srv:+, server $srv})"; fi
    fi
    # the linked displays also agree on a shared wall clock among themselves (kiosk-launch)
    wc="$HOME/.config/bcs-noc/wallclock"
    if ! running; then echo "  wall clock: dashboard not running"
    elif [[ -r $wc ]] && read -r woff wn wts wwho <"$wc" && (( $(date +%s) - ${wts:-0} < 60 )); then
      awk -v o="$woff" -v n="$wn" -v w="${wwho:-}" 'BEGIN { d = o < 0 ? -o : o; gsub(/,/, ", ", w)
        if (n < 1) print "  wall clock: NO OTHER DISPLAYS ANSWERING - not corrected (run noc link; check UDP 47474)"
        else if (d < 0.05) printf "  wall clock: in step with %s\n", w
        else printf "  wall clock: this clock is %.2f s %s %s; the animations correct for it\n", d, (o > 0 ? "behind" : "ahead of"), w }'
    else echo "  wall clock: no status yet (update and restart the dashboard)"
    fi ;;
  link)
    d="$(dirname "$BLANKET")"; mkdir -p "$d"
    if [[ "${2:-}" == off ]]; then rm -f "$d/fleet.key" "$d/peers"; echo "$HOST: hot corner only affects this display"; exit 0; fi
    [[ ${#2} -ge 32 && $# -ge 3 ]] || { echo "usage: kiosk link KEY HOST [HOST...]   (or: kiosk link off)"; exit 1; }
    ( umask 077; printf '%s\n' "$2" >"$d/fleet.key" )
    printf '%s\n' "${@:3}" >"$d/peers"
    echo "$HOST: hot corner linked to $(($# - 2)) display(s)" ;;
  disable)
    mkdir -p "$(dirname "$FLAG")" && touch "$FLAG"
    sc stop "$UNIT"; echo "$HOST: dashboard disabled (stays off after reboot until 'kiosk enable')" ;;
  enable)
    rm -f "$FLAG"; echo "$HOST: dashboard enabled"; start_kiosk ;;
  autostart)
    # called by the desktop at login
    [[ -f $FLAG ]] || { sleep 1; sc daemon-reload 2>/dev/null; sc start "$UNIT"; }
    [[ -f "$GDIR/gestures-on" && -x /opt/bcs-noc/gesture/bin/python3 ]] && sc start bcs-gesture.service ;;
  gestures)
    GSET="$GDIR/gestures"
    gset() { mkdir -p "$GDIR"; touch "$GSET"; sed -i "/^$1=/d" "$GSET"; echo "$1=$2" >>"$GSET"; }
    installed() { [[ -x /opt/bcs-noc/gesture/bin/python3 && -s /opt/bcs-noc/gesture/hand_landmarker.task ]]; }
    case "${2:-status}" in
      on)
        installed || { echo "$HOST: gestures aren't installed here (re-run the installer with --gestures)"; exit 1; }
        mkdir -p "$GDIR"; touch "$GDIR/gestures-on"; sc daemon-reload; sc restart bcs-gesture.service
        echo "$HOST: gestures on" ;;
      off)
        rm -f "$GDIR/gestures-on" "$GDIR/gesture-preview"; sc stop bcs-gesture.service 2>/dev/null
        echo "$HOST: gestures off" ;;
      preview)
        if [[ "${3:-}" == off ]]; then rm -f "$GDIR/gesture-preview"; echo "$HOST: preview off"
        else mkdir -p "$GDIR"; touch "$GDIR/gesture-preview"; echo "$HOST: camera preview in the bottom-right corner for 10 minutes ('kiosk gestures preview off' to hide)"; fi ;;
      range)
        [[ "${3:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] || { echo "usage: kiosk gestures range METRES"; exit 1; }
        gset range "$3"; sc restart bcs-gesture.service 2>/dev/null; echo "$HOST: acting on hands up to $3 m away" ;;
      record)
        secs="${3:-30}"; [[ "$secs" =~ ^[0-9]+$ ]] || { echo "usage: kiosk gestures record [SECONDS]"; exit 1; }
        mkdir -p "$GDIR"; echo "$secs" >"$GDIR/gesture-record"
        echo "$HOST: recording hand positions (no pictures) for $secs s to ~/bcs-gesture-record-*.jsonl - do the gestures now" ;;
      size)
        [[ "${3:-}" =~ ^([0-9]+)x([0-9]+)$ ]] || { echo "usage: kiosk gestures size WIDTHxHEIGHT   (e.g. 1280x720, 640x480)"; exit 1; }
        gset width "${BASH_REMATCH[1]}"; gset height "${BASH_REMATCH[2]}"; sc restart bcs-gesture.service 2>/dev/null
        echo "$HOST: camera at ${3}" ;;
      camera)
        [[ -n "${3:-}" ]] || { echo "usage: kiosk gestures camera /dev/videoN   (cameras: $(ls /dev/video* 2>/dev/null | tr '\n' ' '))"; exit 1; }
        gset camera "$3"; sc restart bcs-gesture.service 2>/dev/null; echo "$HOST: using camera $3" ;;
      status)
        if ! installed; then echo "not installed (installer --gestures)"; exit 0; fi
        if sc is-active --quiet bcs-gesture.service; then
          st=$(cat "$GDIR/gesture-status" 2>/dev/null); echo "on  ${st:-starting}"
        elif [[ -f "$GDIR/gestures-on" ]]; then echo "ON but not running - see: journalctl --user -u bcs-gesture -n 30"
        else echo "off ('kiosk gestures on')"; fi
        id -nG | grep -qw video || echo "  (log out and back in, or reboot, for camera access)" ;;
      *) echo "usage: kiosk gestures [on|off|status|preview [off]|range METRES|camera DEV|size WxH|record [SECONDS]]"; exit 1 ;;
    esac ;;
  reboot)
    echo "$HOST: rebooting"; sudo -n systemctl reboot --ignore-inhibitors ;;
  shutdown)
    echo "$HOST: powering off"; sudo -n systemctl poweroff --ignore-inhibitors ;;
  -h|--help|help)
    sed -n '2,39p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)
    echo "kiosk: unknown command '$1' (try: kiosk help)"; exit 1 ;;
esac
