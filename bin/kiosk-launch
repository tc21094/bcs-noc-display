#!/usr/bin/env bash
# Runs Chrome fullscreen on the dashboard. Started by the bcs-kiosk user service,
# which restarts it if it ever exits and stops it cleanly on 'kiosk stop'.
URL=$(cat /etc/bcs-noc-dashboard-url)
PREF="$HOME/.config/google-chrome/Default/Preferences"

nm-online -q -t 60 || true

# fall back to the standard socket names if the session didn't pass them along
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
if [[ -z "${WAYLAND_DISPLAY:-}" && -S "$XDG_RUNTIME_DIR/wayland-0" ]]; then export WAYLAND_DISPLAY=wayland-0; fi
if [[ -z "${DISPLAY:-}" ]]; then export DISPLAY=:0; fi

# suppress "Restore pages?" after a power cut or a stop
[[ -f "$PREF" ]] && sed -i 's/"exit_type":"Crashed"/"exit_type":"Normal"/; s/"exited_cleanly":false/"exited_cleanly":true/' "$PREF"

exec google-chrome --kiosk --no-first-run --noerrdialogs --disable-infobars \
  --disable-session-crashed-bubble --disable-features=Translate \
  --password-store=basic --check-for-update-interval=31536000 "$URL"
