#!/usr/bin/env python3
"""
BCS NOC kiosk launcher (run by the bcs-kiosk user service).

Runs Chrome fullscreen on the dashboard and keeps a private DevTools pipe to it,
which lets it:
  - play the BCS NOC interlude over the dashboard on a schedule (burn-in protection)
  - show the "BCS Technology Department" blanket until it's turned off. While the blanket
    is up, Chrome runs with nothing but the blanket (the dashboards are closed), so the
    animation never competes with a heavy dashboard for memory or CPU
  - notice the mouse in the bottom-left corner (hot corner: toggles the blanket)
  - reload the page or switch URLs without restarting Chrome
  - rotate through several dashboards on a timer, with a fade between them

Signals (sent by the 'kiosk' command):
  SIGUSR1  play the interlude now
  SIGUSR2  reload the page
  SIGHUP   re-read settings (URL, blanket, fleet link)

Files:
  /etc/bcs-noc-dashboard-url        dashboard URL(s), one per line; several = a rotation
  /etc/bcs-noc-rotate               minutes per dashboard when rotating (0 = off)
  /etc/bcs-noc-interlude            minutes between interludes (0 = off), optional seconds: "30 12"
  ~/.config/bcs-noc/blanket         present while the blanket is on (survives reboots); holds its theme
  ~/.config/bcs-noc/blanket-theme   theme the hot corner / 'blanket on' uses: standard or holiday
  ~/.config/bcs-noc/wall            this display's place on the wall, "POSITION COUNT GAP%" (holiday scene)
  ~/.config/bcs-noc/fleet.key       shared secret for the hot corner to reach other displays
  ~/.config/bcs-noc/peers           the other displays (one host[:port] per line)
  ~/.config/bcs-noc/next            one-shot request to show the next dashboard
  ~/.config/bcs-noc/holiday-offset  seconds added to the holiday scene's clock ('noc blanket show')
If Chrome exits, this exits too and systemd starts it again.
"""
import hashlib, hmac, json, math, os, secrets, shutil, signal, socket, subprocess, sys, threading, time

URL_FILE = "/etc/bcs-noc-dashboard-url"
INTERLUDE_FILE = "/etc/bcs-noc-interlude"
ROTATE_FILE = "/etc/bcs-noc-rotate"
JS_FILE = "/usr/local/share/bcs-noc/interlude.js"
GESTURE_JS = "/usr/local/share/bcs-noc/gesture.js"
AIRPLAY_LIVE = os.path.join(os.path.expanduser("~"), ".config", "bcs-noc", "airplay-live")      # bcs-wallplayer is showing
AIRPLAY_PIN = os.path.join(os.path.expanduser("~"), ".config", "bcs-noc", "airplay-pin-asked")  # bcs-airplay: new device
GESTURE_PORT = int(os.environ.get("BCS_GESTURE_PORT", "47481"))
# things that zoom themselves with the mouse wheel (maps, zoomable charts): a pinch-zoom on one of
# these zooms the map / chart itself instead of magnifying the page
ZOOMABLE = (".leaflet-container,.maplibregl-map,.mapboxgl-map,.ol-viewport,.gm-style,.esri-view,"
            ".cesium-widget,.jvm-container,.jsvectormap-container,.highcharts-container,.js-plotly-plot,"
            "[_echarts_instance_],.vis-network,.cy-container,[data-bcs-zoom]")
WHEEL_STEP = 0.5         # every this much (log2 of the pinch zoom) = one mouse-wheel notch to the map
WHEEL_PX = 53            # one notch, as a real mouse wheel sends it in Chrome on Linux (maps: about one level)
WHEEL_GAP = 0.15
GUEST_MINUTES = float(os.environ.get("BCS_GUEST_MINUTES", "10"))   # a thrown-in dashboard stays this long         # seconds between notches, so the map sees separate notches like a real wheel
HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config", "bcs-noc")
BLANKET_FLAG = os.path.join(CONF, "blanket")
KEY_FILE = os.path.join(CONF, "fleet.key")
TV_BIN = os.environ.get("BCS_TV", "/usr/local/bin/bcs-tv")       # TV on / off and the schedule
TV_OVERRIDE = os.path.join(CONF, "tv-override")                  # "on|off UNTIL" from 'kiosk tv on|off'
TV_STATUS = os.path.join(CONF, "tv-status")
ROOM_FILE = os.path.join(CONF, "room")                           # room-aware dimming settings ('kiosk room')
ROOM_STATUS = os.path.join(CONF, "room-status")
PEERS_FILE = os.path.join(CONF, "peers")
NEXT_FLAG = os.path.join(CONF, "next")
THEME_FILE = os.path.join(CONF, "blanket-theme")
WALL_FILE = os.path.join(CONF, "wall")
THEMES = ("standard", "holiday", "thanksgiving", "auto")
OFFSET_FILE = os.path.join(CONF, "holiday-offset")
CLOCK_FILE = os.path.join(CONF, "wallclock")          # this display's clock vs. the wall's (written for 'kiosk clock')
BLANKET_PAGE = "/usr/local/share/bcs-noc/blanket.html"
PROFILE = os.path.join(HOME, ".config", "bcs-kiosk", "chrome")
OLD_PROFILE = os.path.join(HOME, ".config", "google-chrome")
FLEET_PORT = int(os.environ.get("BCS_FLEET_PORT", "47474"))
HOSTNAME = os.environ.get("BCS_HOSTNAME") or socket.gethostname().split(".")[0]
NODE = secrets.token_hex(6)      # identifies this running launcher in clock messages (hostnames can repeat)

# installed into every page: reports the mouse reaching the bottom-left corner
CORNER_AGENT = r"""
(function () {
  if (window.__bcsCornerAgent) return;
  window.__bcsCornerAgent = true;
  var inside = false, last = 0;
  window.addEventListener("mousemove", function (e) {
    var c = e.clientX <= 4 && e.clientY >= window.innerHeight - 5;
    if (c && !inside) {
      var now = Date.now();
      if (now - last > 1500 && typeof window.__bcsCorner === "function") { last = now; window.__bcsCorner("bottom-left"); }
    }
    inside = c;
  }, true);
})();
"""


def log(*a):
    print("kiosk:", *a, file=sys.stderr, flush=True)


def read(path, default=""):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def interlude_setting():
    """-> (minutes, seconds); minutes 0 = off"""
    parts = read(INTERLUDE_FILE, "30").split()
    try:
        mins = max(0, int(float(parts[0]))) if parts else 30
    except ValueError:
        mins = 30
    try:
        secs = min(60, max(6, int(float(parts[1])))) if len(parts) > 1 else 12
    except ValueError:
        secs = 12
    return mins, secs


def dashboard_urls():
    return [u.strip() for u in read(URL_FILE).splitlines() if u.strip() and not u.strip().startswith("#")]


def rotate_minutes():
    try:
        return max(0.0, float(read(ROTATE_FILE, "0").split()[0]))
    except (ValueError, IndexError):
        return 0.0


# dip-to-dark between dashboards: 'out' on the old tab, 'cover' + 'in' on the new one
FADE_JS = r"""
(function () {
  if (!window.__bcsFade) window.__bcsFade = function (m) {
    var h = window.__bcsFadeEl;
    function gone() { try { if (h.hidePopover) h.hidePopover(); } catch (e) {} h.remove(); if (window.__bcsFadeEl === h) window.__bcsFadeEl = null; }
    if (m === "clear") { if (h) gone(); return "clear"; }
    if (m === "in") {
      if (!h) return "none";
      requestAnimationFrame(function () { requestAnimationFrame(function () {
        h.style.setProperty("transition", "opacity .6s ease", "important");
        h.style.setProperty("opacity", "0", "important");
        setTimeout(gone, 800);
      }); });
      return "in";
    }
    if (!h) {
      h = document.createElement("div");
      [["position","fixed"],["inset","0"],["width","100vw"],["height","100vh"],["margin","0"],["padding","0"],["border","0"],
       ["max-width","none"],["max-height","none"],["background","rgb(2,6,16)"],["z-index","2147483646"],
       ["pointer-events","none"],["display","block"],["opacity","0"]].forEach(function (p) { h.style.setProperty(p[0], p[1], "important"); });
      try { h.popover = "manual"; } catch (e) {}
      document.documentElement.appendChild(h);
      try { if (h.showPopover) h.showPopover(); } catch (e) {}
      window.__bcsFadeEl = h;
    }
    if (m === "cover") { h.style.setProperty("transition", "none", "important"); h.style.setProperty("opacity", "1", "important"); return "cover"; }
    h.getBoundingClientRect();
    h.style.setProperty("transition", "opacity .6s ease", "important");
    h.style.setProperty("opacity", "1", "important");
    return "out";
  };
})();
"""


def season_theme(now=None):
    """The 'auto' blanket theme: Thanksgiving from Nov 1 through Thanksgiving Day (4th Thursday),
    the holiday theme from the day after through Jan 6, the standard blanket otherwise."""
    d = time.localtime(now)
    first = time.localtime(time.mktime((d.tm_year, 11, 1, 12, 0, 0, 0, 0, -1)))
    tday = 22 + (3 - first.tm_wday) % 7                         # tm_wday: Monday = 0, Thursday = 3
    if d.tm_mon == 11:
        return "thanksgiving" if d.tm_mday <= tday else "holiday"
    if d.tm_mon == 12 or (d.tm_mon == 1 and d.tm_mday <= 6):
        return "holiday"
    return "standard"


_tvmod = {}


def tv_module():
    """bcs-tv, loaded as a module (its schedule rules and TV switching)."""
    try:
        m = os.path.getmtime(TV_BIN)
    except OSError:
        return None
    if _tvmod.get("mtime") != m:
        import importlib.machinery, importlib.util
        try:
            spec = importlib.util.spec_from_loader("bcs_tv", importlib.machinery.SourceFileLoader("bcs_tv", TV_BIN))
            mod = importlib.util.module_from_spec(spec)
            spec.loader.exec_module(mod)
            _tvmod.update(mtime=m, mod=mod)
        except Exception as e:
            log("bcs-tv:", e)
            _tvmod.update(mtime=m, mod=None)
    return _tvmod.get("mod")


def room_settings():
    r = {"enabled": "no", "after": "15", "action": "dim"}
    for line in read(ROOM_FILE).splitlines():
        k, _, v = line.partition("=")
        if k.strip():
            r[k.strip()] = v.strip()
    try:
        r["after"] = max(1.0, float(r["after"]))
    except ValueError:
        r["after"] = 15.0
    r["on"] = r["enabled"] == "yes"
    return r


def tv_override():
    """(on?, until) from 'kiosk tv on|off', or None. until 0 = until changed."""
    v = read(TV_OVERRIDE).split()
    try:
        state, until = v[0], float(v[1]) if len(v) > 1 else 0.0
    except (IndexError, ValueError):
        return None
    if state not in ("on", "off") or (until and time.time() >= until):
        return None
    return state == "on", until


def blanket_wanted():
    return os.path.exists(BLANKET_FLAG)


def default_theme():
    t = read(THEME_FILE, "standard")
    return t if t in THEMES else "standard"


def blanket_theme():
    t = read(BLANKET_FLAG)
    return t if t in THEMES else default_theme()


def wall_position():
    """-> [position, count, gap %]; gap = space between screens as a percent of a screen width"""
    parts = read(WALL_FILE, "1 1").split()
    try:
        pos, count = int(parts[0]), int(parts[1])
        gap = float(parts[2]) if len(parts) > 2 else 8.0
        return [pos, count, gap] if 1 <= pos <= count else [1, 1, gap]
    except (ValueError, IndexError):
        return [1, 1, 8.0]


def airplay_live():
    try:
        return time.time() - os.path.getmtime(AIRPLAY_LIVE) < 3
    except OSError:
        return False


def holiday_offset():
    try:
        return float(read(OFFSET_FILE, "0").split()[0])
    except (ValueError, IndexError):
        return 0.0


def set_blanket_flag(on, theme=None):
    os.makedirs(CONF, exist_ok=True)
    if on:
        with open(BLANKET_FLAG, "w") as fh:
            fh.write((theme if theme in THEMES else default_theme()) + "\n")
    else:
        try:
            os.remove(BLANKET_FLAG)
        except FileNotFoundError:
            pass


def prepare_profile():
    # Chrome only allows a DevTools connection on a non-default profile folder.
    # The first time, copy the old profile so dashboard logins carry over.
    if not os.path.isdir(PROFILE):
        os.makedirs(os.path.dirname(PROFILE), exist_ok=True)
        if os.path.isdir(OLD_PROFILE):
            tmp = PROFILE + ".copying"
            shutil.rmtree(tmp, ignore_errors=True)
            try:
                shutil.copytree(OLD_PROFILE, tmp, symlinks=True,
                                ignore=shutil.ignore_patterns("Singleton*", "Cache", "Code Cache", "GPUCache",
                                                              "ShaderCache", "GrShaderCache", "GraphiteDawnCache"))
                os.rename(tmp, PROFILE)
                log("copied the existing Chrome profile (dashboard logins kept)")
            except Exception as e:
                log("could not copy the old Chrome profile:", e)
                shutil.rmtree(tmp, ignore_errors=True)
    # never restore the last session: the launcher opens exactly the dashboards it wants.
    # (Chrome otherwise reopens the previous tabs on every start, one more hidden copy each time.)
    shutil.rmtree(os.path.join(PROFILE, "Default", "Sessions"), ignore_errors=True)
    # no "Restore pages?" bar after a power cut or a stop
    pref = os.path.join(PROFILE, "Default", "Preferences")
    try:
        with open(pref) as fh:
            s = fh.read()
        s2 = s.replace('"exit_type":"Crashed"', '"exit_type":"Normal"').replace('"exited_cleanly":false', '"exited_cleanly":true')
        if s2 != s:
            with open(pref, "w") as fh:
                fh.write(s2)
    except OSError:
        pass


class DevTools:
    """Minimal Chrome DevTools Protocol client over --remote-debugging-pipe (JSON messages, NUL separated)."""

    def __init__(self, rfd, wfd, on_event):
        self.r = os.fdopen(rfd, "rb", buffering=0)
        self.w = os.fdopen(wfd, "wb", buffering=0)
        self.lock = threading.Lock()
        self.n = 0
        self.waiting = {}
        self.on_event = on_event
        self.sessions = {}       # targetId -> standing session
        self.active = None       # targetId of the tab on screen
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        buf = b""
        while True:
            try:
                chunk = self.r.read(1 << 16)
            except OSError:
                chunk = b""
            if not chunk:
                break
            buf += chunk
            while b"\0" in buf:
                raw, buf = buf.split(b"\0", 1)
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                if "id" in msg:
                    slot = self.waiting.get(msg["id"])
                    if slot:
                        slot["reply"] = msg
                        slot["event"].set()
                else:
                    if msg.get("method") == "Target.detachedFromTarget":
                        gone = msg.get("params", {}).get("sessionId")
                        for tid, sid in list(self.sessions.items()):
                            if sid == gone:
                                self.sessions.pop(tid, None)
                    try:
                        self.on_event(msg)
                    except Exception as e:
                        log("event handler:", e)
        for slot in list(self.waiting.values()):
            slot["event"].set()

    def call(self, method, params=None, session=None, timeout=15):
        with self.lock:
            self.n += 1
            mid = self.n
            slot = {"event": threading.Event(), "reply": None}
            self.waiting[mid] = slot
            msg = {"id": mid, "method": method, "params": params or {}}
            if session:
                msg["sessionId"] = session
            self.w.write(json.dumps(msg).encode() + b"\0")
        slot["event"].wait(timeout)
        self.waiting.pop(mid, None)
        reply = slot["reply"]
        if reply is None:
            raise RuntimeError(f"{method}: no reply")
        if "error" in reply:
            raise RuntimeError(f"{method}: {reply['error'].get('message')}")
        return reply.get("result", {})

    def pages(self):
        return [t for t in self.call("Target.getTargets")["targetInfos"] if t.get("type") == "page"]

    def session(self, tid):
        if tid in self.sessions:
            return self.sessions[tid]
        sid = self.call("Target.attachToTarget", {"targetId": tid, "flatten": True})["sessionId"]
        self.call("Runtime.enable", session=sid)                                # needed for binding events
        self.call("Runtime.addBinding", {"name": "__bcsCorner"}, session=sid)   # page -> us (hot corner)
        self.sessions[tid] = sid
        return sid

    def on_tab(self, tid, method, params=None, timeout=15):
        """Run one command against a tab (re-attaching once if its session went away)."""
        for attempt in (1, 2):
            try:
                return self.call(method, params, session=self.session(tid), timeout=timeout)
            except RuntimeError as e:
                if attempt == 2 or "session" not in str(e).lower() and "target" not in str(e).lower():
                    raise
                self.sessions.pop(tid, None)

    def on_page(self, method, params=None, timeout=15):
        """Run one command against the tab on screen."""
        if not self.active:
            pages = self.pages()
            if not pages:
                raise RuntimeError("no page open")
            self.active = pages[0]["targetId"]
        return self.on_tab(self.active, method, params, timeout)

    def evaluate(self, expr, timeout=15, tid=None):
        params = {"expression": expr, "returnByValue": True}
        r = self.on_tab(tid, "Runtime.evaluate", params, timeout) if tid else self.on_page("Runtime.evaluate", params, timeout)
        if "exceptionDetails" in r:
            raise RuntimeError(r["exceptionDetails"].get("exception", {}).get("description") or r["exceptionDetails"].get("text"))
        return r.get("result", {}).get("value")


class Fleet:
    """Signed UDP messages so a hot corner on one display reaches all of them.

    The linked displays also keep a shared wall clock: every few seconds each one pings the
    others, works out how far each clock is from its own (half the round trip), and takes the
    median of all of them, itself included, as the wall's time. Every display lands on the same
    time even when one clock is off, without depending on internet time servers."""

    def __init__(self, on_message):
        self.on_message = on_message
        self.seen = []
        self.acks = {}           # message id -> addresses that confirmed it
        self.samples = {}        # host -> [(round trip, offset, when), ...]
        self.offset = 0.0        # add to time.time() to get wall time
        self.lock = threading.Lock()
        self.names = {}
        self.reported = None
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.sock.bind(("0.0.0.0", FLEET_PORT))
            threading.Thread(target=self._listen, daemon=True).start()
        except OSError as e:
            log(f"fleet: cannot listen on UDP {FLEET_PORT}:", e)

    @staticmethod
    def key():
        k = read(KEY_FILE)
        return k.encode() if len(k) >= 32 else None

    def _listen(self):
        while True:
            try:
                data, addr = self.sock.recvfrom(4096)
                key = self.key()
                if not key:
                    continue
                body, _, sig = data.rpartition(b"|")
                if not hmac.compare_digest(hmac.new(key, body, hashlib.sha256).hexdigest().encode(), sig):
                    continue
                msg = json.loads(body)
                t2 = time.time()
                if msg.get("cmd") == "tping":
                    if msg.get("node") != NODE:                  # answer straight back with our time
                        self._sign_send(dict(cmd="tpong", t0=msg.get("t0"), t1=time.time(), to=msg.get("node"), node=NODE,
                                             id=secrets.token_hex(8), ts=time.time(), **{"from": HOSTNAME}), [addr])
                    continue
                if msg.get("cmd") == "tpong":
                    if msg.get("to") == NODE and msg.get("node") != NODE and isinstance(msg.get("t0"), (int, float)):
                        rtt = t2 - msg["t0"]
                        if 0 <= rtt < 2:
                            with self.lock:
                                k = self.samples.setdefault(f"{addr[0]}:{addr[1]}", [])
                                self.names[f"{addr[0]}:{addr[1]}"] = msg.get("from", "?")
                                k.append((rtt, msg["t1"] - (msg["t0"] + t2) / 2, t2))
                                del k[:-8]
                    continue
                if msg.get("cmd") == "rack":                      # a display confirming a message we sent
                    if msg.get("ref") in self.acks:
                        self.acks[msg["ref"]].add((addr[0], addr[1]))
                    continue
                if msg.get("cmd") == "reboot" or msg.get("ack"):  # confirm every copy; act on the first (below)
                    if abs(time.time() - msg.get("ts", 0)) > 30 or msg.get("node") == NODE:
                        continue
                    self._sign_send(dict(cmd="rack", ref=msg.get("id"), ts=time.time(), id=secrets.token_hex(8),
                                         **{"from": HOSTNAME}), [addr], times=2)
                if msg.get("cmd") == "gcur":                      # gesture cursor, ~30/s: no duplicate tracking
                    if abs(time.time() - msg.get("ts", 0)) <= 120:
                        self.on_message(msg, addr[0])
                    continue
                if abs(time.time() - msg.get("ts", 0)) > 120 or msg.get("id") in self.seen:
                    continue
                self.seen = (self.seen + [msg["id"]])[-200:]   # our own sends are already in here
                self.on_message(msg, addr[0])
            except Exception as e:
                log("fleet: bad message:", e)

    def _sign_send(self, msg, addrs, times=1):
        key = self.key()
        if not key:
            return 0
        body = json.dumps(msg, separators=(",", ":")).encode()
        packet = body + b"|" + hmac.new(key, body, hashlib.sha256).hexdigest().encode()
        sent = 0
        for a in addrs:
            try:
                for _ in range(times):
                    self.sock.sendto(packet, a)
                sent += 1
            except OSError:
                pass
        return sent

    def peers(self):
        out = []
        for p in read(PEERS_FILE).splitlines():
            p = p.strip()
            if p and not p.startswith("#"):
                host, _, port = p.partition(":")
                out.append((host, int(port or FLEET_PORT)))
        return out

    def ping(self):
        """Ask every linked display for its time, then update the wall clock from the answers so far."""
        sent = self._sign_send(dict(cmd="tping", t0=time.time(), node=NODE, ts=time.time(), id=secrets.token_hex(8), **{"from": HOSTNAME}),
                               self.peers())
        now = time.time()
        with self.lock:
            live = {a: v for a, v in self.samples.items() if v and now - v[-1][2] < 90}
            offs = [min(v[-3:], key=lambda x: x[0])[1] for v in live.values()]   # recent only: follows a clock that gets stepped
            who = sorted(self.names.get(a, a) for a in live)
        vals = sorted(offs + [0.0])
        m = len(vals) // 2
        self.offset = vals[m] if len(vals) % 2 else (vals[m - 1] + vals[m]) / 2
        state = (tuple(who), round(self.offset, 1))
        if state != self.reported:                       # log changes, for 'journalctl --user -u bcs-kiosk'
            self.reported = state
            log(f"wall clock: {len(who)} display(s) answering ({', '.join(who) or 'none'}; pinged {sent}); "
                f"this clock is {abs(self.offset):.2f} s {'behind' if self.offset > 0 else 'ahead of'} the wall")
        try:
            with open(CLOCK_FILE, "w") as f:
                f.write(f"{self.offset:+.3f} {len(offs)} {int(now)} {','.join(who)}\n")
        except OSError:
            pass
        return self.offset

    def send_fast(self, **fields):
        """One copy to every linked display, no duplicate tracking (for the gesture cursor)."""
        return self._sign_send(dict(fields, ts=time.time(), id=secrets.token_hex(4), **{"from": HOSTNAME}), self.peers())

    def wall_time(self):
        return time.time() + self.offset

    def send_confirmed(self, wait=4.0, **fields):
        """Send to every other linked display, repeating until each one confirms (or `wait` runs out).
        -> (confirmed, expected)"""
        if not self.key() or not self.peers():
            return 0, 0
        mine = {"127.0.0.1"}
        try:
            mine.update(subprocess.run(["hostname", "-I"], capture_output=True, text=True, timeout=3).stdout.split())
        except Exception:
            pass
        targets = []
        for host, port in self.peers():
            try:
                ip = socket.gethostbyname(host)
            except OSError:
                log(f"fleet: can't find the address of {host}")
                continue
            if not ((ip in mine or ip.startswith("127.")) and port == FLEET_PORT):   # (not ourselves)
                targets.append((ip, port))
        msg = dict(fields, ts=time.time(), id=secrets.token_hex(8), node=NODE, **{"from": HOSTNAME})
        self.seen = (self.seen + [msg["id"]])[-200:]
        self.acks[msg["id"]] = got = set()
        end = time.time() + wait
        while time.time() < end:
            pending = [a for a in targets if a not in got]
            if not pending:
                break
            self._sign_send(msg, pending)
            time.sleep(0.25)
        self.acks.pop(msg["id"], None)
        return len(set(targets) & got), len(set(targets))

    def send(self, **fields):
        key = self.key()
        peers = [p.strip() for p in read(PEERS_FILE).splitlines() if p.strip() and not p.startswith("#")]
        if not key or not peers:
            return 0
        msg = dict(fields, ts=time.time(), id=secrets.token_hex(8), **{"from": HOSTNAME})
        self.seen = (self.seen + [msg["id"]])[-200:]
        body = json.dumps(msg, separators=(",", ":")).encode()
        packet = body + b"|" + hmac.new(key, body, hashlib.sha256).hexdigest().encode()
        sent = 0
        for p in peers:
            host, _, port = p.partition(":")
            try:
                for _ in range(2):   # UDP: send twice, receivers ignore the duplicate
                    self.sock.sendto(packet, (host, int(port or FLEET_PORT)))
                sent += 1
            except OSError:
                pass
        return sent


def main():
    urls = dashboard_urls()
    url = urls[0] if urls else ""
    if not url:
        log(f"no dashboard URL in {URL_FILE}")
        sys.exit(1)
    if not os.environ.get("BCS_KIOSK_REEXEC"):
        try:
            subprocess.run(["nm-online", "-q", "-t", "60"], timeout=70)
        except Exception:
            pass

    # Chrome runs either the dashboards or, while the blanket is up, only the blanket.
    # Switching between the two restarts Chrome (see the main loop).
    blanket_mode = blanket_wanted()
    blank_url = ("file://" + BLANKET_PAGE) if os.path.exists(BLANKET_PAGE) else "about:blank"

    def wanted_urls():
        return [blank_url] if blanket_mode else (dashboard_urls() or [url])

    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not env.get("WAYLAND_DISPLAY") and os.path.exists(os.path.join(env["XDG_RUNTIME_DIR"], "wayland-0")):
        env["WAYLAND_DISPLAY"] = "wayland-0"
    env.setdefault("DISPLAY", ":0")
    prepare_profile()

    to_chrome_r, to_chrome_w = os.pipe()
    from_chrome_r, from_chrome_w = os.pipe()

    def child_fds():
        a, b = os.dup(to_chrome_r), os.dup(from_chrome_w)
        os.dup2(a, 3)   # Chrome reads commands on fd 3
        os.dup2(b, 4)   # and writes replies on fd 4

    args = ["google-chrome", "--kiosk", "--no-first-run", "--noerrdialogs", "--disable-infobars",
            "--disable-session-crashed-bubble", "--disable-features=Translate",
            "--password-store=basic", "--check-for-update-interval=31536000",
            "--disable-background-timer-throttling", "--disable-renderer-backgrounding",   # rotation: tabs off screen stay live
            f"--user-data-dir={PROFILE}", "--remote-debugging-pipe"]
    args += os.environ.get("BCS_KIOSK_EXTRA_FLAGS", "").split()
    args.append(wanted_urls()[0])
    chrome = subprocess.Popen(args, env=env, preexec_fn=child_fds, pass_fds=(3, 4))
    os.close(to_chrome_r)
    os.close(from_chrome_w)

    pending = set()
    wake = threading.Event()

    def poke(what):
        pending.add(what)
        wake.set()

    def on_devtools_event(msg):
        if msg.get("method") == "Runtime.bindingCalled" and msg["params"].get("name") == "__bcsCorner":
            poke("corner")

    def on_fleet(msg, ip):
        if msg.get("cmd") == "gcur":                            # the camera display's cursor is on our screen
            if int(msg.get("d", 0)) == wall_position()[0]:
                gest["remote_t"] = time.time() if msg.get("on") else 0
                show_gesture({k: msg.get(k) for k in ("on", "x", "y", "hold", "pinch", "zf", "zid", "draw", "pen", "help", "spot")}, remote=True)
            return
        if msg.get("cmd") == "room":                            # the camera display: is anybody in the room?
            room["empty"], room["t"] = bool(msg.get("empty")), time.time()
            poke("room")
            return
        if msg.get("cmd") == "gspot":                           # spotlight: every display dims (the cursor's has the hole)
            gest["xspot"] = (bool(msg.get("on")), time.time())
            if not (gest.get("remote_t") and time.time() - gest["remote_t"] < 1.5):
                show_gesture({"on": False, "x": 0.5, "y": 0.5, "spot": bool(msg.get("on"))}, remote=True)
            return
        if msg.get("cmd") == "gthrow":                          # throw the dashboard on this display to another one
            if int(msg.get("d", 0)) == wall_position()[0]:
                gest["throw_to"] = int(msg.get("to", 0))
                poke("g:throw")
            return
        if msg.get("cmd") == "guest":                           # a dashboard thrown over from another display
            if int(msg.get("d", 0)) == wall_position()[0]:
                gest["guest_req"] = msg
                poke("g:guest")
            return
        if msg.get("cmd") == "ghold":                           # the reboot countdown, shown on every display
            gest["xhold"] = (msg.get("hold"), time.time())
            if not (gest.get("remote_t") and time.time() - gest["remote_t"] < 1.5):
                show_gesture({"on": False, "x": 0.5, "y": 0.5, "hold": msg.get("hold")}, remote=True)
            return
        if msg.get("cmd") == "reboot":                          # the camera display's two-fist gesture: reboot
            log(f"rebooting: asked by {msg.get('from')} ({ip}) - {msg.get('why', '')}")
            poke("g:rebootnow")
            return
        if msg.get("cmd") == "gact":                            # an action for the display under the cursor (0 = all)
            if int(msg.get("d", -1)) in (0, wall_position()[0]):
                log(f"gesture from {msg.get('from')}: {msg.get('act')}")
                poke("g:" + str(msg.get("act")))
            return
        if msg.get("cmd") == "blanket":
            set_blanket_flag(bool(msg.get("on")), msg.get("theme"))
            log(f"blanket {'on' if msg.get('on') else 'off'} (hot corner on {msg.get('from')} {ip})")
            poke("settings")

    dt = DevTools(from_chrome_r, to_chrome_w, on_devtools_event)
    fleet = Fleet(on_fleet)
    fleet.ping()
    log("blanket only (dashboards closed)" if blanket_mode else f"dashboard: {url}")
    if os.path.exists("/etc/bcs-noc-airplay"):
        subprocess.run(["systemctl", "--user", "start", "bcs-wallplayer.service"], capture_output=True, timeout=15)

    # ---- camera gestures (bcs-gesture sends its state here; nothing arrives if it isn't running)
    room = {"seen": time.time(), "empty": False, "t": 0, "cam_t": 0, "sent": 0, "sent_empty": None,
            "now_empty": False, "dim": None, "tick": 0}
    tvs = {"applied": None, "busy": False, "why": "", "tick": 0, "sched_text": None, "sched": [], "failed": 0}
    try:                                                        # what we last told the TV (survives our own restarts)
        if time.time() - os.path.getmtime(TV_STATUS) < 3600:
            tvs["applied"] = {"on": True, "off": False}.get(read(TV_STATUS).split("\t")[0])
    except OSError:
        pass
    gest = {"on": False, "ev": 0, "boot": None, "wh": None, "xy": None, "pushed": 0, "sig": None,
            "msg": 0, "toast": None, "pv": 0}
    gjs = {"mtime": None, "src": ""}

    def gesture_js():
        try:
            m = os.path.getmtime(GESTURE_JS)
        except OSError:
            return ""
        if m != gjs["mtime"]:
            gjs.update(mtime=m, src=read(GESTURE_JS))
        return gjs["src"]

    def to_agent(m, tid=None):
        """Hand the gesture state to the page's agent (installing it first if the page doesn't have it)."""
        tid = tid or dt.active
        if not tid or tid not in dt.sessions:
            return None
        payload = json.dumps(m, separators=(",", ":"))
        r = dt.evaluate(f"typeof __bcsGesture=='function'?__bcsGesture({payload}):'missing'", timeout=2, tid=tid)
        if r == "missing":
            src = gesture_js()
            if not src:
                return None
            r = dt.evaluate(f"{src}\n;__bcsGesture({payload})", timeout=3, tid=tid)
        return r

    def gesture_toast(text):
        gest["toast"] = text

    def on_gesture(m):
        """State from this display's camera (bcs-gesture). The cursor spans the whole wall: the part of it
        on our screen is shown here, the rest goes to the display it's on."""
        now = time.time()
        if m.get("boot") != gest["boot"] or now - gest["msg"] > 10:
            # first word from bcs-gesture (it, or we, just started): its recent events are old news,
            # e.g. the blanket gesture that made us restart Chrome must not toggle it straight back
            gest["boot"] = m.get("boot")
            gest["ev"] = max([e[0] for e in m.get("ev", [])] + [0])
        gest["msg"] = now
        if m.get("cam"):
            room["cam_t"] = now                                 # this display has the camera: it decides if the room is empty
            if m.get("room"):
                room["seen"] = max(room["seen"], float(m["room"]))
            if m.get("on") or m.get("hands"):
                room["seen"] = now
        me, n = wall_position()[0], int(m.get("n") or 1)
        linked = n > 1 and fleet.key() and fleet.peers()
        cx = float(m.get("x", 0.5))
        d = min(n, max(1, int(cx) + 1)) if linked else me              # display the cursor is on
        lx = cx - (d - 1) if linked else min(0.9999, max(0.0, cx - (me - 1)))
        engaged = bool(m.get("on"))
        hold = m.get("hold")
        local_hold = hold if hold and (hold.get("k") in ("wake", "blanket", "reboot", "rebootwait") or d == me) else None
        # the reboot ring / countdown goes on every display, wherever the cursor is
        everywhere = hold if hold and hold.get("k") in ("reboot", "rebootwait") else None
        if linked and (everywhere or gest.get("ghold")):
            for _ in range(1 if everywhere else 2):
                fleet.send_fast(cmd="ghold", hold=everywhere)
            gest["ghold"] = bool(everywhere)
        for eid, name in m.get("ev", []):
            if eid > gest["ev"]:
                gest["ev"] = eid
                if name in ("next", "prev", "pause", "click", "draw_on") and d != me:
                    fleet.send(cmd="gact", act=name, d=d)               # the display the cursor is on
                    log(f"gesture: {name} (display {d})")
                elif name == "draw_off":                                # clear the drawing everywhere
                    poke("g:inkclear")
                    if linked:
                        fleet.send(cmd="gact", act="inkclear", d=0)
                elif name in ("click", "draw_on"):
                    poke("g:" + name)
                elif name == "interlude":
                    poke("g:interlude")
                    if linked:
                        fleet.send(cmd="gact", act="interlude", d=0)
                elif name in ("next", "prev", "pause", "blanket"):
                    poke("g:" + name)
                elif name.startswith("throw:"):                # throw:S:T - send display S's dashboard to display T
                    try:
                        src, dst = (int(v) for v in name.split(":")[1:3])
                    except ValueError:
                        continue
                    if not linked:
                        gesture_toast("This display isn't linked to the others ('noc link')")
                    elif src == me:
                        gest["throw_to"] = dst
                        poke("g:throw")
                    else:
                        fleet.send(cmd="gthrow", d=src, to=dst)
                        log(f"gesture: throw display {src} to display {dst}")
                elif name == "throw_none":
                    gesture_toast("No display that way")
                elif name in ("spot_on", "spot_off"):
                    gesture_toast("Spotlight on (thumbs up again to turn it off)" if name == "spot_on" else "Spotlight off")
                elif name == "reboot_arm":
                    log("gesture: two fists - every display reboots in 5 s unless someone shows an open hand")
                elif name == "reboot_cancel":
                    poke("g:rebootcancel")
                    if linked:
                        fleet.send(cmd="gact", act="rebootcancel", d=0)
                elif name == "reboot":
                    poke("g:rebootall")
        # the cursor on another display: send it there; tell the one it left
        if linked:
            target = d if engaged and d != me else 0
            if gest.get("remote_d") and gest["remote_d"] != target:
                for _ in range(2):
                    fleet.send_fast(cmd="gcur", d=gest["remote_d"], on=False, x=0.5, y=0.5)
            gest["remote_d"] = target
            if target:
                fleet.send_fast(cmd="gcur", d=d, on=True, x=round(lx, 4), y=m.get("y"), pinch=m.get("pinch"),
                                zf=m.get("zf"), zid=m.get("zid"), draw=m.get("draw"), pen=m.get("pen"),
                                help=m.get("help"), spot=m.get("spot"),
                                hold=hold if hold and hold.get("k") in ("pause", "interlude", "draw", "drawoff") else None)
        # the spotlight dims every display: tell the others (a few times a second while it's on)
        spot = bool(m.get("spot")) and engaged
        if linked and (spot or gest.get("spot_b")) and (spot != gest.get("spot_b") or now - gest.get("spot_t", 0) > 0.3):
            for _ in range(1 if spot else 3):
                fleet.send_fast(cmd="gspot", on=spot)
            gest["spot_b"], gest["spot_t"] = spot, now
        if not engaged and not local_hold and gest.get("remote_t") and now - gest["remote_t"] < 1.5:
            return                                              # another display's camera has the cursor here: don't hide it
        out = {"on": engaged and d == me, "x": lx if d == me else 0.5, "y": m.get("y"), "hold": local_hold,
               "pinch": bool(m.get("pinch")) and d == me, "zf": m.get("zf"), "zid": m.get("zid"), "cam": m.get("cam"),
               "draw": bool(m.get("draw")), "pen": bool(m.get("pen")) and d == me,
               "help": bool(m.get("help")) and d == me, "spot": spot}
        if m.get("pv"):
            out["pv"] = m["pv"]
            gest["pv"] = now
        elif gest["pv"] and now - gest["pv"] > 2:
            out["pv"] = None
            gest["pv"] = 0
        show_gesture(out)

    def zoom_target(x, y):
        """Is the thing under the cursor something that zooms itself (a map, a zoomable chart)?
        Known map / chart libraries by their class names, or anything with its own wheel handler."""
        sid = dt.sessions.get(dt.active)
        if not sid:
            return "page"
        try:
            r = dt.evaluate(f"""(function(){{var e=document.elementFromPoint({x},{y});
                for(var n=e,i=0;n&&i<14;n=n.parentElement,i++){{if(n.matches&&n.matches({json.dumps(ZOOMABLE)}))return 'map';}}
                return e&&e.tagName!=='IFRAME'?'?':'page';}})()""", timeout=2)
            if r != "?":
                return "wheel" if r == "map" else "page"
            # unknown: does the element (or one of its parents, below <body>) handle the wheel itself?
            obj = dt.call("Runtime.evaluate", {"expression": f"document.elementFromPoint({x},{y})", "objectGroup": "bcs-zoom"},
                          session=sid, timeout=2)["result"].get("objectId")
            for _ in range(12):
                if not obj:
                    break
                # a scroll box or a whole-page wrapper uses the wheel to scroll, not zoom: magnify instead
                big = dt.call("Runtime.callFunctionOn", {"objectId": obj, "returnByValue": True, "functionDeclaration":
                              "function(){var r=this.getBoundingClientRect(),s=getComputedStyle(this);"
                              "return (r.width>=innerWidth*0.9&&r.height>=innerHeight*0.9)||"
                              "(/(auto|scroll)/.test(s.overflowY)&&this.scrollHeight>this.clientHeight+4)}"},
                              session=sid, timeout=2)["result"].get("value")
                if big:
                    return "page"
                ls = dt.call("DOMDebugger.getEventListeners", {"objectId": obj}, session=sid, timeout=2).get("listeners", [])
                if any(l.get("type") in ("wheel", "mousewheel", "DOMMouseScroll") for l in ls):
                    return "wheel"
                nxt = dt.call("Runtime.callFunctionOn", {"objectId": obj, "objectGroup": "bcs-zoom",
                              "functionDeclaration": "function(){var p=this.parentElement;return p&&p!==document.body&&p!==document.documentElement?p:null}"},
                              session=sid, timeout=2)["result"]
                obj = nxt.get("objectId")
            return "page"
        except Exception as e:
            log("zoom target:", e)
            return "page"
        finally:
            try:
                dt.call("Runtime.releaseObjectGroup", {"objectGroup": "bcs-zoom"}, session=sid, timeout=2)
            except Exception:
                pass

    def wheel_zoom(out):
        """Pinch-zoom over a map: turn the pinch into mouse-wheel notches at the cursor, so the map zooms."""
        if blanket_mode or not out.get("on") or not out.get("pinch") or not gest.get("wh") or not gest.get("xy"):
            return
        if out.get("zid") != gest.get("wz_id"):                 # a new pinch: what's under the cursor?
            gest["wz_id"], gest["wz_level"] = out.get("zid"), 0.0
            gest["wz_mode"] = zoom_target(*gest["xy"])
            if gest["wz_mode"] == "wheel":
                log("pinch over a map/zoomable chart: zooming it")
        if gest.get("wz_mode") != "wheel":
            return
        out["wheel"] = True                                     # tell the page not to magnify itself
        level = math.log2(max(0.05, float(out.get("zf") or 1)))
        steps = int((level - gest["wz_level"]) / WHEEL_STEP)
        now = time.time()
        if steps and now - gest.get("wz_at", 0) >= WHEEL_GAP:   # one notch at a time; the rest follow
            up = steps > 0
            gest["wz_level"] += WHEEL_STEP if up else -WHEEL_STEP
            gest["wz_at"] = now
            x, y = gest["xy"]                                    # hand up = zoom in = wheel turned away from you
            dt.call("Input.dispatchMouseEvent", {"type": "mouseWheel", "x": x, "y": y, "deltaX": 0,
                     "deltaY": -WHEEL_PX if up else WHEEL_PX}, session=dt.sessions[dt.active], timeout=2)

    def show_gesture(out, remote=False):
        """Draw the gesture state on our screen and move Chrome's mouse to the cursor (hover)."""
        now = time.time()
        try:
            wheel_zoom(out)
        except Exception as e:
            log("map zoom:", e)
        was = gest["on"]
        gest["on"] = bool(out.get("on")) and not blanket_mode
        if not out.get("hold") and gest.get("xhold") and gest["xhold"][0] and now - gest["xhold"][1] < 0.7:
            out["hold"] = gest["xhold"][0]                      # the reboot countdown from the camera display
        if out.get("spot") is None and gest.get("xspot") and now - gest["xspot"][1] < 1.2:
            out["spot"] = gest["xspot"][0]                      # the spotlight is on somewhere on the wall
        if blanket_mode:
            out.update(on=False, pinch=False, spot=False, help=False)
            if out.get("hold") and out["hold"].get("k") not in ("blanket", "reboot", "rebootwait"):
                out["hold"] = None
        if remote:
            out["cam"] = True
        if gest["toast"]:
            out["toast"], gest["toast"] = gest["toast"], None
            if len(out["toast"]) > 40:
                out["toast_ms"] = 6000                          # longer messages stay up long enough to read
        # the page only hears about changes (and a heartbeat for the camera dot)
        sig = json.dumps({k: v for k, v in out.items() if k != "pv"}, sort_keys=True)
        if sig == gest["sig"] and "pv" not in out and now - gest["pushed"] < 1.0:
            return
        gest["sig"], gest["pushed"] = sig, now
        wh = to_agent(out)
        if isinstance(wh, list) and len(wh) == 2:
            gest["wh"] = wh
        if not blanket_mode and gest["wh"] and dt.active in dt.sessions:
            W, H = gest["wh"]
            if gest["on"]:
                x, y = round(out["x"] * (W - 1)), round(out["y"] * (H - 1))
                if x < 40 and y > H - 40:                       # keep clear of the hot corner
                    x = 40
                if (x, y) != gest["xy"]:
                    gest["xy"] = (x, y)
                    dt.call("Input.dispatchMouseEvent", {"type": "mouseMoved", "x": x, "y": y}, session=dt.sessions[dt.active], timeout=2)
            elif was and gest["xy"]:
                gest["xy"] = None                               # let go: move the mouse off the page so tooltips close
                dt.call("Input.dispatchMouseEvent", {"type": "mouseMoved", "x": W - 1, "y": 0}, session=dt.sessions[dt.active], timeout=2)

    def gesture_listener():
        sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        try:
            sock.bind(("127.0.0.1", GESTURE_PORT))
        except OSError as e:
            log(f"gestures: cannot listen on 127.0.0.1:{GESTURE_PORT}:", e)
            return
        while True:
            try:
                data, _ = sock.recvfrom(65536)
                on_gesture(json.loads(data))
            except Exception as e:
                if time.time() - gest.get("errlog", 0) > 30:           # e.g. while Chrome restarts; don't flood the log
                    gest["errlog"] = time.time()
                    log("gestures:", e)
                time.sleep(0.2)

    threading.Thread(target=gesture_listener, daemon=True).start()

    signal.signal(signal.SIGUSR1, lambda *_: poke("play"))
    signal.signal(signal.SIGUSR2, lambda *_: poke("reload"))
    signal.signal(signal.SIGHUP, lambda *_: poke("settings"))
    signal.signal(signal.SIGTERM, lambda *_: (chrome.terminate(), sys.exit(0)))

    js_cache = {"mtime": None, "src": ""}
    js_shown = {"mtime": None}

    def overlay_js():
        try:
            m = os.path.getmtime(JS_FILE)
        except OSError:
            return ""
        if m != js_cache["mtime"]:
            js_cache.update(mtime=m, src=read(JS_FILE))
        return js_cache["src"]

    def play(secs):
        js = overlay_js()
        if not js:
            log(f"interlude script missing ({JS_FILE})")
            return
        try:
            log("interlude:", dt.evaluate(f"window.__BCS_MODE='interlude';window.__BCS_INTERLUDE_SECONDS={secs};\n{js}"))
        except Exception as e:
            log("interlude failed:", e)

    tabs = []          # [{"url": ..., "tid": ...}], one per dashboard, in order
    rot = {"offset": 0}

    def reconcile():
        """One tab per URL in the file, in order; extra tabs closed."""
        want = wanted_urls()
        pages = dt.pages()
        live = {p["targetId"] for p in pages}
        tabs[:] = [t for t in tabs if t["tid"] in live]
        if not tabs:
            # adopt the tab Chrome opened with (the one on the first dashboard URL), close any strays
            if not pages:
                return
            first = next((p for p in pages if p.get("url", "").startswith(want[0].rstrip("/"))), pages[0])["targetId"]
            dt.call("Target.activateTarget", {"targetId": first})
            tabs.append({"url": want[0], "tid": first})
            dt.active = first
            for p in pages:
                if p["targetId"] != first:
                    log("closing stray tab:", p.get("url", "?")[:80])
                    try:
                        dt.call("Target.closeTarget", {"targetId": p["targetId"]})
                    except Exception:
                        pass
        # reuse tabs already showing a wanted URL (no reload), re-point leftovers, open the rest
        pool, new = list(tabs), [None] * len(want)
        for i, u in enumerate(want):
            for t in pool:
                if t["url"] == u:
                    new[i] = t; pool.remove(t); break
        for i, u in enumerate(want):
            if new[i] is None:
                if pool:
                    t = pool.pop(0)
                    dt.on_tab(t["tid"], "Page.navigate", {"url": u})
                    t["url"] = u
                else:
                    t = {"url": u, "tid": dt.call("Target.createTarget", {"url": u, "background": True})["targetId"]}
                new[i] = t
                log("dashboard", i + 1, u)
        extra = pool
        tabs[:] = new
        if dt.active not in [t["tid"] for t in tabs] and dt.active != guest["tid"]:
            dt.call("Target.activateTarget", {"targetId": tabs[0]["tid"]})
            dt.active = tabs[0]["tid"]
        for t in extra:
            try:
                dt.call("Target.closeTarget", {"targetId": t["tid"]})
            except Exception:
                pass
            dt.sessions.pop(t["tid"], None)

    guest = {"tid": None, "until": 0, "url": None}

    def open_guest(req):
        """A dashboard thrown over from another display: show it here for a while (on a tab of its own)."""
        url = str(req.get("url") or "")
        if not url.startswith(("http://", "https://", "file://")):
            return
        live = {p["targetId"] for p in dt.pages()}
        if guest["tid"] in live:
            dt.on_tab(guest["tid"], "Page.navigate", {"url": url})
        else:
            guest["tid"] = dt.call("Target.createTarget", {"url": url, "background": True})["targetId"]
        guest.update(url=url, until=time.time() + GUEST_MINUTES * 60)
        time.sleep(0.4)
        show_tid(guest["tid"], f"guest dashboard from display {req.get('src')}: {url}")
        title = str(req.get("title") or "").strip()
        try:
            to_agent({"arrive": int(req.get("dir") or 1), "toast_ms": 6000,
                      "toast": f"From display {req.get('src')}" + (f": {title[:48]}" if title else "") +
                               " - flick an open hand to go back"})
        except Exception:
            pass

    def end_guest(why):
        tid = guest["tid"]
        guest.update(tid=None, url=None, until=0)
        if not tid:
            return
        if tabs:
            show_tid(tabs[wanted_tab()]["tid"], f"back to this display's dashboards ({why})")
        try:
            dt.call("Target.closeTarget", {"targetId": tid})
        except Exception:
            pass
        dt.sessions.pop(tid, None)

    def show(i):
        show_tid(tabs[i]["tid"], f"showing dashboard {i + 1} of {len(tabs)}: {tabs[i]['url']}")

    def show_tid(nxt, what):
        """Switch the screen to a tab: fade the old one to dark, cut, fade the new one in."""
        cur = dt.active
        if nxt == cur:
            return
        try:
            to_agent({"reset": True}, tid=cur)                  # leave the old dashboard un-zoomed
        except Exception:
            pass
        try:
            dt.evaluate(FADE_JS + "__bcsFade('out')", timeout=5, tid=cur)
            time.sleep(0.65)
        except Exception:
            pass
        try:
            dt.evaluate(FADE_JS + "__bcsFade('cover')", timeout=5, tid=nxt)
        except Exception:
            pass
        dt.call("Target.activateTarget", {"targetId": nxt})
        dt.active = nxt
        try:
            dt.evaluate(FADE_JS + "__bcsFade('in')", timeout=5, tid=nxt)
            dt.evaluate(FADE_JS + "__bcsFade('clear')", timeout=5, tid=cur)
        except Exception:
            pass
        log(what)

    def cur_tab():
        return next((i for i, t in enumerate(tabs) if t["tid"] == dt.active), 0)

    def wanted_tab():
        if len(tabs) < 2:
            return 0
        if rot.get("paused") is not None and time.time() - rot.get("paused_t", 0) > 1800:
            rot["paused"] = None                                # a forgotten pause ends after 30 minutes
            log("rotation resumed (pause timed out)")
        if rot.get("paused") is not None:
            return rot["paused"]
        if gest["on"]:
            return cur_tab()                                    # don't switch under someone using the cursor
        mins = rotate_minutes()
        # on clock boundaries, so it's predictable and survives restarts
        slot = int(fleet.wall_time() // (mins * 60)) if mins > 0 else 0
        return (slot + rot["offset"]) % len(tabs)

    blanket_shown = False
    theme_shown = None

    def sync_page():
        """Keep the corner agent installed and the blanket in the state we want (survives reloads)."""
        nonlocal blanket_shown, theme_shown
        want = blanket_wanted()
        theme = blanket_theme() if want else None
        if theme == "auto":
            theme = season_theme()                      # (switches over by itself when the season changes)
        # the wall position is pushed every sync, so a new 'noc wall' order applies within seconds
        up = dt.evaluate(CORNER_AGENT + f"\nwindow.__BCS_WALL={json.dumps(wall_position())};"
                         f"window.__BCS_NOW_OFFSET={holiday_offset() + fleet.offset};\n!!window.__bcsBlanket", timeout=5)
        overlay_js()                                   # refresh the cached script if it was updated
        if want and up and (theme != theme_shown or js_cache["mtime"] != js_shown["mtime"]):
            # theme changed, or an update brought new animation code: fade the old one out;
            # the next sync brings the new one in, so every display runs the same code
            if js_cache["mtime"] != js_shown["mtime"]:
                log("blanket: new animation installed, reloading it")
            js_shown["mtime"] = js_cache["mtime"]
            dt.evaluate("window.__bcsBlanketStop && window.__bcsBlanketStop()", timeout=5)
            theme_shown = None
        elif want and not up:
            js = overlay_js()
            if js:
                js_shown["mtime"] = js_cache["mtime"]
                dt.evaluate(f"window.__BCS_MODE='blanket';window.__BCS_THEME={json.dumps(theme)};"
                            f"window.__BCS_WALL={json.dumps(wall_position())};window.__BCS_NOW_OFFSET={holiday_offset() + fleet.offset};\n{js}")
                theme_shown = theme
        elif not want and up:
            dt.evaluate("window.__bcsBlanketStop && window.__bcsBlanketStop()", timeout=5)
        if want != blanket_shown:
            log("blanket", f"on ({theme})" if want else "off")
            blanket_shown = want

    def room_tick(now):
        """Room-aware dimming: is the room empty, and what this display does about it."""
        rs = room_settings()
        linked = bool(fleet.key() and fleet.peers())
        if not rs["on"]:
            empty = False
        elif now - room["cam_t"] < 30:                          # we have the camera
            empty = now - room["seen"] > rs["after"] * 60
            if linked and (empty != room["sent_empty"] or now - room["sent"] > 20):
                fleet.send(cmd="room", empty=empty)
                room["sent"], room["sent_empty"] = now, empty
        else:                                                   # another display's camera tells us (silence: not empty)
            empty = room["empty"] and now - room["t"] < 120
        known = rs["on"] and (now - room["cam_t"] < 30 or now - room["t"] < 120)
        if empty != room["now_empty"] or known != room.get("known"):
            if empty != room["now_empty"]:
                log("room: " + (f"empty (nobody seen for {rs['after']:g} min)" if empty else "someone's here"))
            room["now_empty"], room["known"] = empty, known
            tvs["tick"] = 0                                     # (the TV may need to follow)
        dim = bool(rs["on"] and rs["action"] == "dim" and empty and tvs["applied"] is not False)
        if dim != room["dim"] or (rs["on"] and now - room["tick"] > 2):
            room["tick"] = now
            try:
                to_agent({"dim": 1 if dim else 0, "only": True})
                room["dim"] = dim
            except Exception:
                pass
        try:
            with open(ROOM_STATUS, "w") as f:
                f.write(("off" if not rs["on"] else ("empty" if empty else "occupied")) +
                        (f" {int(now - room['seen'])}" if now - room["cam_t"] < 30 else " -") + "\n")
        except OSError:
            pass

    def tv_tick(now):
        """Switch the TV by the schedule, 'kiosk tv on|off' and the room. Leaves it alone if none are set up."""
        mod = tv_module()
        if not mod:
            return
        st = mod.settings()
        if st.get("schedule", "") != tvs["sched_text"]:
            tvs["sched_text"] = st.get("schedule", "")
            try:
                tvs["sched"] = mod.parse_schedule(tvs["sched_text"])
            except ValueError as e:
                log("tv schedule:", e)
                tvs["sched"] = []
        rs, ov = room_settings(), tv_override()
        if not (tvs["sched"] or ov or (rs["on"] and rs["action"] == "tvoff")):
            tvs["applied"] = None                               # not managed: never touch the TV
            want, why = None, "not managed (no schedule)"
        elif ov:
            want, why = ov[0], "switched by hand" + (f" until {mod.describe_time(ov[1])}" if ov[1] else "")
        elif not mod.scheduled_on(tvs["sched"], now):
            occupied = rs["on"] and not room["now_empty"] and (now - room["cam_t"] < 30 or now - room["t"] < 120)
            want, why = (True, "outside the schedule, but someone's in the room") if occupied else (False, "outside the schedule")
        elif rs["on"] and rs["action"] == "tvoff" and room["now_empty"]:
            want, why = False, "the room is empty"
        else:
            want, why = True, "on the schedule" if tvs["sched"] else "on"
        if want is not None and want != tvs["applied"] and not tvs["busy"] and now - tvs["failed"] > 300:
            tvs["busy"] = True

            def apply(want=want, why=why):
                try:
                    m = mod.pick()
                    rc, out = m.set(want)
                    log(f"TV {'on' if want else 'off'} ({why}; {m.name})" + ("" if rc == 0 else f" - failed: {out.strip()[:160]}"))
                    if rc == 0:
                        tvs["applied"] = want
                    else:
                        tvs["failed"] = time.time()
                except Exception as e:
                    log("TV:", e)
                    tvs["failed"] = time.time()
                finally:
                    tvs["busy"] = False
            threading.Thread(target=apply, daemon=True).start()
        tvs["why"] = why
        try:
            nxt = mod.next_change(tvs["sched"], now)[0] if tvs["sched"] and not ov else None
            with open(TV_STATUS, "w") as f:
                f.write(f"{'-' if want is None else 'on' if want else 'off'}\t{why}" +
                        (f"\tnext switch {mod.describe_time(nxt)}" if nxt else "") + "\n")
        except OSError:
            pass

    started = time.time()
    last_slot = last_mins = None
    last_sync = last_ping = 0
    while chrome.poll() is None:
        wake.wait(1)
        wake.clear()
        try:
            if "corner" in pending:
                pending.discard("corner")
                on = not blanket_wanted()
                set_blanket_flag(on)
                n = fleet.send(cmd="blanket", on=on, theme=blanket_theme())
                log(f"hot corner: blanket {'on' if on else 'off'}" + (f", sent to {n} linked display(s)" if n else ""))
                pending.add("settings")
            if blanket_wanted() != blanket_mode:
                log("blanket " + ("on: restarting Chrome with only the blanket" if not blanket_mode else "off: restarting Chrome with the dashboards"))
                chrome.terminate()
                try:
                    chrome.wait(15)
                except subprocess.TimeoutExpired:
                    chrome.kill()
                os.execve(sys.executable, [sys.executable] + sys.argv, dict(os.environ, BCS_KIOSK_REEXEC="1"))
            if "settings" in pending or not tabs:
                pending.discard("settings")
                tvs["tick"] = 0                                 # a 'kiosk tv' / 'kiosk room' change applies now
                reconcile()
                if os.path.exists(NEXT_FLAG):
                    os.remove(NEXT_FLAG)
                    rot["offset"] += 1
                last_sync = 0
            # a dashboard thrown over from another display: it stays a while, then this display's own come back
            if guest["tid"]:
                if guest["tid"] not in {p["targetId"] for p in dt.pages()}:          # closed under us: back to our own
                    if dt.active == guest["tid"] and tabs:
                        dt.active = tabs[wanted_tab()]["tid"]
                        dt.call("Target.activateTarget", {"targetId": dt.active})
                    guest.update(tid=None, url=None, until=0)
                elif gest["on"]:
                    guest["until"] = max(guest["until"], time.time() + 60)   # not while someone is using it
                elif time.time() > guest["until"]:
                    end_guest("time's up")
            # rotation (paused while the blanket or an interlude is up)
            elif len(tabs) > 1 and not blanket_mode and not airplay_live():   # hold still under an AirPlay picture
                i = wanted_tab()
                if tabs[i]["tid"] != dt.active and not dt.evaluate("!!window.__bcsInterlude", timeout=5):
                    show(i)
                    last_sync = 0
            for g in [p for p in list(pending) if p.startswith("g:")]:
                pending.discard(g)
                act = g[2:]
                log("gesture:", act)
                if act == "blanket":
                    pending.add("corner")                       # same as the hot corner: toggles every linked display
                    wake.set()
                elif act == "throw":
                    dst = gest.pop("throw_to", 0)
                    me = wall_position()[0]
                    if blanket_mode or not dst or dst == me:
                        continue
                    try:
                        url = dt.evaluate("location.href", timeout=3)
                        title = dt.evaluate("document.title", timeout=3) or ""
                    except Exception as e:
                        log("throw: can't read this dashboard:", e)
                        continue
                    way = 1 if dst > me else -1
                    try:
                        to_agent({"throw": way, "toast": f"Sent to display {dst}", "toast_ms": 2500})
                    except Exception:
                        pass
                    got, want = fleet.send_confirmed(wait=2.0, cmd="guest", d=dst, url=url, title=title[:120], src=me, dir=way, ack=True)
                    log(f"throw: {url} to display {dst}" + ("" if got else " - no answer"))
                    if not got:
                        gesture_toast(f"Display {dst} didn't answer")
                elif act == "guest":
                    req = gest.pop("guest_req", None)
                    if req and not blanket_mode:
                        try:
                            open_guest(req)
                        except Exception as e:
                            log("guest dashboard:", e)
                elif act == "rebootcancel":
                    try:
                        to_agent({"toast": "Reboot cancelled", "toast_ms": 3000})
                    except Exception:
                        pass
                elif act in ("rebootall", "rebootnow"):
                    try:
                        to_agent({"toast": "Rebooting all displays" if act == "rebootall" else "Rebooting", "toast_ms": 20000})
                    except Exception:
                        pass
                    if act == "rebootall":
                        # tell every other display first and wait until each confirms, then this one goes
                        got, want = fleet.send_confirmed(wait=4.0, cmd="reboot", why="two-fist gesture")
                        log(f"reboot all: {got} of {want} other display(s) confirmed" +
                            ("" if got == want else " - the rest may be off or unreachable"))
                    kiosk_cmd = shutil.which("kiosk") or "/usr/local/bin/kiosk"
                    r = subprocess.run([kiosk_cmd, "reboot", "1"], capture_output=True, text=True, timeout=20)
                    log("reboot:", (r.stdout + r.stderr).strip() or f"exit {r.returncode}")
                elif act == "interlude":
                    if not blanket_mode:
                        pending.add("play")
                elif act == "inkclear":
                    try:
                        to_agent({"ink": "clear"})
                    except Exception:
                        pass
                elif act == "draw_on":
                    gesture_toast("Drawing: point to draw, open hand to lift the pen, hold a fist to clear")
                elif act == "click":
                    # click where the gesture cursor is (Chrome's mouse is already there for hover)
                    if not blanket_mode and gest.get("xy") and dt.active in dt.sessions:
                        x, y = gest["xy"]
                        sid = dt.sessions[dt.active]
                        for typ in ("mousePressed", "mouseReleased"):
                            dt.call("Input.dispatchMouseEvent", {"type": typ, "x": x, "y": y, "button": "left", "clickCount": 1},
                                    session=sid, timeout=3)
                        try:
                            to_agent({"ripple": True})
                        except Exception:
                            pass
                elif blanket_mode:
                    pass
                elif act in ("next", "prev", "pause") and guest["tid"]:
                    if act == "pause":                          # keep the thrown-in dashboard here a while longer
                        guest["until"] = time.time() + 30 * 60
                        gesture_toast("Keeping it here for 30 minutes")
                    else:
                        end_guest("flicked away")
                        gesture_toast("Back to this display's dashboards")
                elif act in ("next", "prev"):
                    if len(tabs) < 2:
                        gesture_toast("Only one dashboard on this display")
                    else:
                        i = (cur_tab() + (1 if act == "next" else -1)) % len(tabs)
                        if rot.get("paused") is not None:
                            rot["paused"] = i
                        elif rotate_minutes() > 0:
                            rot["offset"] += (1 if act == "next" else -1)
                        else:
                            rot["offset"] = (rot["offset"] + (1 if act == "next" else -1)) % len(tabs)
                        try:
                            to_agent({"reset": True})
                        except Exception:
                            pass
                        show(i)
                        gesture_toast(f"Dashboard {i + 1} of {len(tabs)}")
                elif act == "pause":
                    if rot.get("paused") is None:
                        rot["paused"], rot["paused_t"] = cur_tab(), time.time()
                        gesture_toast("Rotation paused" if len(tabs) > 1 else "Nothing to rotate on this display")
                    else:
                        # carry on from this dashboard, on the normal schedule
                        mins = rotate_minutes()
                        slot = int(fleet.wall_time() // (mins * 60)) if mins > 0 else 0
                        rot["offset"] = (rot["paused"] - slot) % max(1, len(tabs))
                        rot["paused"] = None
                        gesture_toast("Rotation resumed")
            if "reload" in pending:
                pending.discard("reload")
                dt.on_page("Page.reload", {"ignoreCache": True})
                log("reloaded")
            # an AirPlay picture is up: get Chrome out of its way (GNOME may open the player's window
            # behind the fullscreen dashboard), and bring the dashboard back when it ends
            live = airplay_live()
            if live != gest.get("ap_live", False):
                gest["ap_live"] = live
                try:
                    wid = dt.call("Browser.getWindowForTarget", {"targetId": dt.active})["windowId"]
                    if live:                                    # Chrome won't minimize straight from fullscreen
                        dt.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "normal"}})
                        dt.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "minimized"}})
                        log("AirPlay picture showing: dashboard minimized")
                    else:
                        dt.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "normal"}})
                        dt.call("Browser.setWindowBounds", {"windowId": wid, "bounds": {"windowState": "fullscreen"}})
                        log("AirPlay picture gone: dashboard back")
                except Exception as e:
                    log("AirPlay: couldn't move the dashboard window:", e)
            # a new device is pairing with the AirPlay wall: show the code on this (the middle) screen
            try:
                pm = os.path.getmtime(AIRPLAY_PIN)
                if pm != gest.get("pin_seen") and time.time() - pm < 5:
                    gest["pin_seen"] = pm
                    pin = read(AIRPLAY_PIN)
                    if pin.isdigit():
                        to_agent({"toast": f"AirPlay code: {pin}", "toast_ms": 45000})
            except OSError:
                pass
            if gest.get("remote_t") and time.time() - gest["remote_t"] > 1.5:
                gest["remote_t"] = 0                            # the camera display went quiet: drop its cursor
                show_gesture({"on": False, "x": 0.5, "y": 0.5}, remote=True)
            if gest.get("xspot") and gest["xspot"][0] and time.time() - gest["xspot"][1] > 1.5:
                gest["xspot"] = None                            # no word about the spotlight: lift it
                show_gesture({"on": False, "x": 0.5, "y": 0.5, "spot": False}, remote=True)
            if "room" in pending or time.time() - room.get("last", 0) >= 5:
                pending.discard("room")
                room["last"] = time.time()
                room_tick(time.time())
            if time.time() - tvs.get("last", 0) >= 15 or not tvs["tick"]:
                tvs["last"] = tvs["tick"] = time.time()
                tv_tick(time.time())
            if time.time() - last_sync >= 2:
                last_sync = time.time()
                if time.time() - last_ping >= (10 if time.time() - started > 30 else 2):
                    last_ping = time.time()
                    fleet.ping()
                # anything that opened its own tab (a pop-up, a link) gets closed; the dashboard stays on screen
                ours = {t["tid"] for t in tabs} | ({guest["tid"]} if guest["tid"] else set())   # (a thrown-in dashboard isn't a stray)
                strays = [p for p in dt.pages() if p["targetId"] not in ours] if ours else []   # never before we've adopted a tab
                for p in strays:
                    log("closing stray tab:", p.get("url", "?")[:80])
                    try:
                        dt.call("Target.closeTarget", {"targetId": p["targetId"]})
                    except Exception:
                        pass
                if strays and dt.active:
                    dt.call("Target.activateTarget", {"targetId": dt.active})
                sync_page()
        except Exception as e:
            log("page:", e)

        mins, secs = interlude_setting()
        if "play" in pending:
            pending.discard("play")
            if not blanket_mode:
                play(secs)
            continue
        # scheduled: on clock boundaries (e.g. :00 and :30) so every display plays together;
        # skipped while the blanket is up
        if mins > 0 and time.time() - started > 90:
            slot = int(fleet.wall_time() // (mins * 60))
            if last_slot is None or mins != last_mins:
                last_slot, last_mins = slot, mins     # new schedule: wait for the next boundary
            elif slot != last_slot:
                last_slot = slot
                if not blanket_mode and not airplay_live():
                    play(secs)
    sys.exit(chrome.returncode or 0)


if __name__ == "__main__":
    main()
