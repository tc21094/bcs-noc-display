#!/usr/bin/env python3
"""
BCS NOC kiosk launcher (run by the bcs-kiosk user service).

Runs Chrome fullscreen on the dashboard and keeps a private DevTools pipe to it,
which lets it:
  - play the BCS NOC interlude over the dashboard on a schedule (burn-in protection)
  - show the "BCS Technology Department" blanket until it's turned off. While the blanket
    is up, Chrome runs with nothing but the blanket (the dashboards are closed), so the
    animation never competes with a heavy dashboard for memory or CPU
  - notice the mouse in the bottom-left corner (hot corner: toggles the blanket)
  - reload the page or switch URLs without restarting Chrome
  - rotate through several dashboards on a timer, with a fade between them

Signals (sent by the 'kiosk' command):
  SIGUSR1  play the interlude now
  SIGUSR2  reload the page
  SIGHUP   re-read settings (URL, blanket, fleet link)

Files:
  /etc/bcs-noc-dashboard-url        dashboard URL(s), one per line; several = a rotation
  /etc/bcs-noc-rotate               minutes per dashboard when rotating (0 = off)
  /etc/bcs-noc-interlude            minutes between interludes (0 = off), optional seconds: "30 12"
  ~/.config/bcs-noc/blanket         present while the blanket is on (survives reboots); holds its theme
  ~/.config/bcs-noc/blanket-theme   theme the hot corner / 'blanket on' uses: standard or holiday
  ~/.config/bcs-noc/wall            this display's place on the wall, "POSITION COUNT GAP%" (holiday scene)
  ~/.config/bcs-noc/fleet.key       shared secret for the hot corner to reach other displays
  ~/.config/bcs-noc/peers           the other displays (one host[:port] per line)
  ~/.config/bcs-noc/next            one-shot request to show the next dashboard
  ~/.config/bcs-noc/holiday-offset  seconds added to the holiday scene's clock ('noc blanket show')
If Chrome exits, this exits too and systemd starts it again.
"""
import hashlib, hmac, json, os, secrets, shutil, signal, socket, subprocess, sys, threading, time

URL_FILE = "/etc/bcs-noc-dashboard-url"
INTERLUDE_FILE = "/etc/bcs-noc-interlude"
ROTATE_FILE = "/etc/bcs-noc-rotate"
JS_FILE = "/usr/local/share/bcs-noc/interlude.js"
HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config", "bcs-noc")
BLANKET_FLAG = os.path.join(CONF, "blanket")
KEY_FILE = os.path.join(CONF, "fleet.key")
PEERS_FILE = os.path.join(CONF, "peers")
NEXT_FLAG = os.path.join(CONF, "next")
THEME_FILE = os.path.join(CONF, "blanket-theme")
WALL_FILE = os.path.join(CONF, "wall")
THEMES = ("standard", "holiday")
OFFSET_FILE = os.path.join(CONF, "holiday-offset")
CLOCK_FILE = os.path.join(CONF, "wallclock")          # this display's clock vs. the wall's (written for 'kiosk clock')
BLANKET_PAGE = "/usr/local/share/bcs-noc/blanket.html"
PROFILE = os.path.join(HOME, ".config", "bcs-kiosk", "chrome")
OLD_PROFILE = os.path.join(HOME, ".config", "google-chrome")
FLEET_PORT = int(os.environ.get("BCS_FLEET_PORT", "47474"))
HOSTNAME = os.environ.get("BCS_HOSTNAME") or socket.gethostname().split(".")[0]

# installed into every page: reports the mouse reaching the bottom-left corner
CORNER_AGENT = r"""
(function () {
  if (window.__bcsCornerAgent) return;
  window.__bcsCornerAgent = true;
  var inside = false, last = 0;
  window.addEventListener("mousemove", function (e) {
    var c = e.clientX <= 4 && e.clientY >= window.innerHeight - 5;
    if (c && !inside) {
      var now = Date.now();
      if (now - last > 1500 && typeof window.__bcsCorner === "function") { last = now; window.__bcsCorner("bottom-left"); }
    }
    inside = c;
  }, true);
})();
"""


def log(*a):
    print("kiosk:", *a, file=sys.stderr, flush=True)


def read(path, default=""):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def interlude_setting():
    """-> (minutes, seconds); minutes 0 = off"""
    parts = read(INTERLUDE_FILE, "30").split()
    try:
        mins = max(0, int(float(parts[0]))) if parts else 30
    except ValueError:
        mins = 30
    try:
        secs = min(60, max(6, int(float(parts[1])))) if len(parts) > 1 else 12
    except ValueError:
        secs = 12
    return mins, secs


def dashboard_urls():
    return [u.strip() for u in read(URL_FILE).splitlines() if u.strip() and not u.strip().startswith("#")]


def rotate_minutes():
    try:
        return max(0.0, float(read(ROTATE_FILE, "0").split()[0]))
    except (ValueError, IndexError):
        return 0.0


# dip-to-dark between dashboards: 'out' on the old tab, 'cover' + 'in' on the new one
FADE_JS = r"""
(function () {
  if (!window.__bcsFade) window.__bcsFade = function (m) {
    var h = window.__bcsFadeEl;
    function gone() { try { if (h.hidePopover) h.hidePopover(); } catch (e) {} h.remove(); if (window.__bcsFadeEl === h) window.__bcsFadeEl = null; }
    if (m === "clear") { if (h) gone(); return "clear"; }
    if (m === "in") {
      if (!h) return "none";
      requestAnimationFrame(function () { requestAnimationFrame(function () {
        h.style.setProperty("transition", "opacity .6s ease", "important");
        h.style.setProperty("opacity", "0", "important");
        setTimeout(gone, 800);
      }); });
      return "in";
    }
    if (!h) {
      h = document.createElement("div");
      [["position","fixed"],["inset","0"],["width","100vw"],["height","100vh"],["margin","0"],["padding","0"],["border","0"],
       ["max-width","none"],["max-height","none"],["background","rgb(2,6,16)"],["z-index","2147483646"],
       ["pointer-events","none"],["display","block"],["opacity","0"]].forEach(function (p) { h.style.setProperty(p[0], p[1], "important"); });
      try { h.popover = "manual"; } catch (e) {}
      document.documentElement.appendChild(h);
      try { if (h.showPopover) h.showPopover(); } catch (e) {}
      window.__bcsFadeEl = h;
    }
    if (m === "cover") { h.style.setProperty("transition", "none", "important"); h.style.setProperty("opacity", "1", "important"); return "cover"; }
    h.getBoundingClientRect();
    h.style.setProperty("transition", "opacity .6s ease", "important");
    h.style.setProperty("opacity", "1", "important");
    return "out";
  };
})();
"""


def blanket_wanted():
    return os.path.exists(BLANKET_FLAG)


def default_theme():
    t = read(THEME_FILE, "standard")
    return t if t in THEMES else "standard"


def blanket_theme():
    t = read(BLANKET_FLAG)
    return t if t in THEMES else default_theme()


def wall_position():
    """-> [position, count, gap %]; gap = space between screens as a percent of a screen width"""
    parts = read(WALL_FILE, "1 1").split()
    try:
        pos, count = int(parts[0]), int(parts[1])
        gap = float(parts[2]) if len(parts) > 2 else 8.0
        return [pos, count, gap] if 1 <= pos <= count else [1, 1, gap]
    except (ValueError, IndexError):
        return [1, 1, 8.0]


def holiday_offset():
    try:
        return float(read(OFFSET_FILE, "0").split()[0])
    except (ValueError, IndexError):
        return 0.0


def set_blanket_flag(on, theme=None):
    os.makedirs(CONF, exist_ok=True)
    if on:
        with open(BLANKET_FLAG, "w") as fh:
            fh.write((theme if theme in THEMES else default_theme()) + "\n")
    else:
        try:
            os.remove(BLANKET_FLAG)
        except FileNotFoundError:
            pass


def prepare_profile():
    # Chrome only allows a DevTools connection on a non-default profile folder.
    # The first time, copy the old profile so dashboard logins carry over.
    if not os.path.isdir(PROFILE):
        os.makedirs(os.path.dirname(PROFILE), exist_ok=True)
        if os.path.isdir(OLD_PROFILE):
            tmp = PROFILE + ".copying"
            shutil.rmtree(tmp, ignore_errors=True)
            try:
                shutil.copytree(OLD_PROFILE, tmp, symlinks=True,
                                ignore=shutil.ignore_patterns("Singleton*", "Cache", "Code Cache", "GPUCache",
                                                              "ShaderCache", "GrShaderCache", "GraphiteDawnCache"))
                os.rename(tmp, PROFILE)
                log("copied the existing Chrome profile (dashboard logins kept)")
            except Exception as e:
                log("could not copy the old Chrome profile:", e)
                shutil.rmtree(tmp, ignore_errors=True)
    # never restore the last session: the launcher opens exactly the dashboards it wants.
    # (Chrome otherwise reopens the previous tabs on every start, one more hidden copy each time.)
    shutil.rmtree(os.path.join(PROFILE, "Default", "Sessions"), ignore_errors=True)
    # no "Restore pages?" bar after a power cut or a stop
    pref = os.path.join(PROFILE, "Default", "Preferences")
    try:
        with open(pref) as fh:
            s = fh.read()
        s2 = s.replace('"exit_type":"Crashed"', '"exit_type":"Normal"').replace('"exited_cleanly":false', '"exited_cleanly":true')
        if s2 != s:
            with open(pref, "w") as fh:
                fh.write(s2)
    except OSError:
        pass


class DevTools:
    """Minimal Chrome DevTools Protocol client over --remote-debugging-pipe (JSON messages, NUL separated)."""

    def __init__(self, rfd, wfd, on_event):
        self.r = os.fdopen(rfd, "rb", buffering=0)
        self.w = os.fdopen(wfd, "wb", buffering=0)
        self.lock = threading.Lock()
        self.n = 0
        self.waiting = {}
        self.on_event = on_event
        self.sessions = {}       # targetId -> standing session
        self.active = None       # targetId of the tab on screen
        threading.Thread(target=self._reader, daemon=True).start()

    def _reader(self):
        buf = b""
        while True:
            try:
                chunk = self.r.read(1 << 16)
            except OSError:
                chunk = b""
            if not chunk:
                break
            buf += chunk
            while b"\0" in buf:
                raw, buf = buf.split(b"\0", 1)
                try:
                    msg = json.loads(raw)
                except ValueError:
                    continue
                if "id" in msg:
                    slot = self.waiting.get(msg["id"])
                    if slot:
                        slot["reply"] = msg
                        slot["event"].set()
                else:
                    if msg.get("method") == "Target.detachedFromTarget":
                        gone = msg.get("params", {}).get("sessionId")
                        for tid, sid in list(self.sessions.items()):
                            if sid == gone:
                                self.sessions.pop(tid, None)
                    try:
                        self.on_event(msg)
                    except Exception as e:
                        log("event handler:", e)
        for slot in list(self.waiting.values()):
            slot["event"].set()

    def call(self, method, params=None, session=None, timeout=15):
        with self.lock:
            self.n += 1
            mid = self.n
            slot = {"event": threading.Event(), "reply": None}
            self.waiting[mid] = slot
            msg = {"id": mid, "method": method, "params": params or {}}
            if session:
                msg["sessionId"] = session
            self.w.write(json.dumps(msg).encode() + b"\0")
        slot["event"].wait(timeout)
        self.waiting.pop(mid, None)
        reply = slot["reply"]
        if reply is None:
            raise RuntimeError(f"{method}: no reply")
        if "error" in reply:
            raise RuntimeError(f"{method}: {reply['error'].get('message')}")
        return reply.get("result", {})

    def pages(self):
        return [t for t in self.call("Target.getTargets")["targetInfos"] if t.get("type") == "page"]

    def session(self, tid):
        if tid in self.sessions:
            return self.sessions[tid]
        sid = self.call("Target.attachToTarget", {"targetId": tid, "flatten": True})["sessionId"]
        self.call("Runtime.enable", session=sid)                                # needed for binding events
        self.call("Runtime.addBinding", {"name": "__bcsCorner"}, session=sid)   # page -> us (hot corner)
        self.sessions[tid] = sid
        return sid

    def on_tab(self, tid, method, params=None, timeout=15):
        """Run one command against a tab (re-attaching once if its session went away)."""
        for attempt in (1, 2):
            try:
                return self.call(method, params, session=self.session(tid), timeout=timeout)
            except RuntimeError as e:
                if attempt == 2 or "session" not in str(e).lower() and "target" not in str(e).lower():
                    raise
                self.sessions.pop(tid, None)

    def on_page(self, method, params=None, timeout=15):
        """Run one command against the tab on screen."""
        if not self.active:
            pages = self.pages()
            if not pages:
                raise RuntimeError("no page open")
            self.active = pages[0]["targetId"]
        return self.on_tab(self.active, method, params, timeout)

    def evaluate(self, expr, timeout=15, tid=None):
        params = {"expression": expr, "returnByValue": True}
        r = self.on_tab(tid, "Runtime.evaluate", params, timeout) if tid else self.on_page("Runtime.evaluate", params, timeout)
        if "exceptionDetails" in r:
            raise RuntimeError(r["exceptionDetails"].get("exception", {}).get("description") or r["exceptionDetails"].get("text"))
        return r.get("result", {}).get("value")


class Fleet:
    """Signed UDP messages so a hot corner on one display reaches all of them.

    The linked displays also keep a shared wall clock: every few seconds each one pings the
    others, works out how far each clock is from its own (half the round trip), and takes the
    median of all of them, itself included, as the wall's time. Every display lands on the same
    time even when one clock is off, without depending on internet time servers."""

    def __init__(self, on_message):
        self.on_message = on_message
        self.seen = []
        self.samples = {}        # host -> [(round trip, offset, when), ...]
        self.offset = 0.0        # add to time.time() to get wall time
        self.lock = threading.Lock()
        self.sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        self.sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
        try:
            self.sock.bind(("0.0.0.0", FLEET_PORT))
            threading.Thread(target=self._listen, daemon=True).start()
        except OSError as e:
            log(f"fleet: cannot listen on UDP {FLEET_PORT}:", e)

    @staticmethod
    def key():
        k = read(KEY_FILE)
        return k.encode() if len(k) >= 32 else None

    def _listen(self):
        while True:
            try:
                data, addr = self.sock.recvfrom(4096)
                key = self.key()
                if not key:
                    continue
                body, _, sig = data.rpartition(b"|")
                if not hmac.compare_digest(hmac.new(key, body, hashlib.sha256).hexdigest().encode(), sig):
                    continue
                msg = json.loads(body)
                t2 = time.time()
                if msg.get("cmd") == "tping" and msg.get("from") != HOSTNAME:     # answer straight back, our time
                    self._sign_send(dict(cmd="tpong", t0=msg.get("t0"), t1=time.time(), to=msg.get("from"),
                                         id=secrets.token_hex(8), ts=time.time(), **{"from": HOSTNAME}), [addr])
                    continue
                if msg.get("cmd") == "tpong":
                    if msg.get("to") == HOSTNAME and isinstance(msg.get("t0"), (int, float)):
                        rtt = t2 - msg["t0"]
                        if 0 <= rtt < 2:
                            with self.lock:
                                k = self.samples.setdefault(msg.get("from", "?"), [])
                                k.append((rtt, msg["t1"] - (msg["t0"] + t2) / 2, t2))
                                del k[:-8]
                    continue
                if abs(time.time() - msg.get("ts", 0)) > 120 or msg.get("id") in self.seen:
                    continue
                self.seen = (self.seen + [msg["id"]])[-200:]   # our own sends are already in here
                self.on_message(msg, addr[0])
            except Exception as e:
                log("fleet: bad message:", e)

    def _sign_send(self, msg, addrs, times=1):
        key = self.key()
        if not key:
            return 0
        body = json.dumps(msg, separators=(",", ":")).encode()
        packet = body + b"|" + hmac.new(key, body, hashlib.sha256).hexdigest().encode()
        sent = 0
        for a in addrs:
            try:
                for _ in range(times):
                    self.sock.sendto(packet, a)
                sent += 1
            except OSError:
                pass
        return sent

    def peers(self):
        out = []
        for p in read(PEERS_FILE).splitlines():
            p = p.strip()
            if p and not p.startswith("#"):
                host, _, port = p.partition(":")
                out.append((host, int(port or FLEET_PORT)))
        return out

    def ping(self):
        """Ask every linked display for its time, then update the wall clock from the answers so far."""
        self._sign_send(dict(cmd="tping", t0=time.time(), ts=time.time(), id=secrets.token_hex(8), **{"from": HOSTNAME}),
                        self.peers())
        now = time.time()
        with self.lock:
            offs = [min(v, key=lambda x: x[0])[1] for v in self.samples.values() if v and now - v[-1][2] < 90]
        vals = sorted(offs + [0.0])
        m = len(vals) // 2
        self.offset = vals[m] if len(vals) % 2 else (vals[m - 1] + vals[m]) / 2
        try:
            with open(CLOCK_FILE, "w") as f:
                f.write(f"{self.offset:+.3f} {len(offs)} {int(now)}\n")
        except OSError:
            pass
        return self.offset

    def wall_time(self):
        return time.time() + self.offset

    def send(self, **fields):
        key = self.key()
        peers = [p.strip() for p in read(PEERS_FILE).splitlines() if p.strip() and not p.startswith("#")]
        if not key or not peers:
            return 0
        msg = dict(fields, ts=time.time(), id=secrets.token_hex(8), **{"from": HOSTNAME})
        self.seen = (self.seen + [msg["id"]])[-200:]
        body = json.dumps(msg, separators=(",", ":")).encode()
        packet = body + b"|" + hmac.new(key, body, hashlib.sha256).hexdigest().encode()
        sent = 0
        for p in peers:
            host, _, port = p.partition(":")
            try:
                for _ in range(2):   # UDP: send twice, receivers ignore the duplicate
                    self.sock.sendto(packet, (host, int(port or FLEET_PORT)))
                sent += 1
            except OSError:
                pass
        return sent


def main():
    urls = dashboard_urls()
    url = urls[0] if urls else ""
    if not url:
        log(f"no dashboard URL in {URL_FILE}")
        sys.exit(1)
    if not os.environ.get("BCS_KIOSK_REEXEC"):
        try:
            subprocess.run(["nm-online", "-q", "-t", "60"], timeout=70)
        except Exception:
            pass

    # Chrome runs either the dashboards or, while the blanket is up, only the blanket.
    # Switching between the two restarts Chrome (see the main loop).
    blanket_mode = blanket_wanted()
    blank_url = ("file://" + BLANKET_PAGE) if os.path.exists(BLANKET_PAGE) else "about:blank"

    def wanted_urls():
        return [blank_url] if blanket_mode else (dashboard_urls() or [url])

    env = os.environ.copy()
    env.setdefault("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}")
    if not env.get("WAYLAND_DISPLAY") and os.path.exists(os.path.join(env["XDG_RUNTIME_DIR"], "wayland-0")):
        env["WAYLAND_DISPLAY"] = "wayland-0"
    env.setdefault("DISPLAY", ":0")
    prepare_profile()

    to_chrome_r, to_chrome_w = os.pipe()
    from_chrome_r, from_chrome_w = os.pipe()

    def child_fds():
        a, b = os.dup(to_chrome_r), os.dup(from_chrome_w)
        os.dup2(a, 3)   # Chrome reads commands on fd 3
        os.dup2(b, 4)   # and writes replies on fd 4

    args = ["google-chrome", "--kiosk", "--no-first-run", "--noerrdialogs", "--disable-infobars",
            "--disable-session-crashed-bubble", "--disable-features=Translate",
            "--password-store=basic", "--check-for-update-interval=31536000",
            "--disable-background-timer-throttling", "--disable-renderer-backgrounding",   # rotation: tabs off screen stay live
            f"--user-data-dir={PROFILE}", "--remote-debugging-pipe"]
    args += os.environ.get("BCS_KIOSK_EXTRA_FLAGS", "").split()
    args.append(wanted_urls()[0])
    chrome = subprocess.Popen(args, env=env, preexec_fn=child_fds, pass_fds=(3, 4))
    os.close(to_chrome_r)
    os.close(from_chrome_w)

    pending = set()
    wake = threading.Event()

    def poke(what):
        pending.add(what)
        wake.set()

    def on_devtools_event(msg):
        if msg.get("method") == "Runtime.bindingCalled" and msg["params"].get("name") == "__bcsCorner":
            poke("corner")

    def on_fleet(msg, ip):
        if msg.get("cmd") == "blanket":
            set_blanket_flag(bool(msg.get("on")), msg.get("theme"))
            log(f"blanket {'on' if msg.get('on') else 'off'} (hot corner on {msg.get('from')} {ip})")
            poke("settings")

    dt = DevTools(from_chrome_r, to_chrome_w, on_devtools_event)
    fleet = Fleet(on_fleet)
    fleet.ping()
    log("blanket only (dashboards closed)" if blanket_mode else f"dashboard: {url}")

    signal.signal(signal.SIGUSR1, lambda *_: poke("play"))
    signal.signal(signal.SIGUSR2, lambda *_: poke("reload"))
    signal.signal(signal.SIGHUP, lambda *_: poke("settings"))
    signal.signal(signal.SIGTERM, lambda *_: (chrome.terminate(), sys.exit(0)))

    js_cache = {"mtime": None, "src": ""}
    js_shown = {"mtime": None}

    def overlay_js():
        try:
            m = os.path.getmtime(JS_FILE)
        except OSError:
            return ""
        if m != js_cache["mtime"]:
            js_cache.update(mtime=m, src=read(JS_FILE))
        return js_cache["src"]

    def play(secs):
        js = overlay_js()
        if not js:
            log(f"interlude script missing ({JS_FILE})")
            return
        try:
            log("interlude:", dt.evaluate(f"window.__BCS_MODE='interlude';window.__BCS_INTERLUDE_SECONDS={secs};\n{js}"))
        except Exception as e:
            log("interlude failed:", e)

    tabs = []          # [{"url": ..., "tid": ...}], one per dashboard, in order
    rot = {"offset": 0}

    def reconcile():
        """One tab per URL in the file, in order; extra tabs closed."""
        want = wanted_urls()
        pages = dt.pages()
        live = {p["targetId"] for p in pages}
        tabs[:] = [t for t in tabs if t["tid"] in live]
        if not tabs:
            # adopt the tab Chrome opened with (the one on the first dashboard URL), close any strays
            if not pages:
                return
            first = next((p for p in pages if p.get("url", "").startswith(want[0].rstrip("/"))), pages[0])["targetId"]
            dt.call("Target.activateTarget", {"targetId": first})
            tabs.append({"url": want[0], "tid": first})
            dt.active = first
            for p in pages:
                if p["targetId"] != first:
                    log("closing stray tab:", p.get("url", "?")[:80])
                    try:
                        dt.call("Target.closeTarget", {"targetId": p["targetId"]})
                    except Exception:
                        pass
        # reuse tabs already showing a wanted URL (no reload), re-point leftovers, open the rest
        pool, new = list(tabs), [None] * len(want)
        for i, u in enumerate(want):
            for t in pool:
                if t["url"] == u:
                    new[i] = t; pool.remove(t); break
        for i, u in enumerate(want):
            if new[i] is None:
                if pool:
                    t = pool.pop(0)
                    dt.on_tab(t["tid"], "Page.navigate", {"url": u})
                    t["url"] = u
                else:
                    t = {"url": u, "tid": dt.call("Target.createTarget", {"url": u, "background": True})["targetId"]}
                new[i] = t
                log("dashboard", i + 1, u)
        extra = pool
        tabs[:] = new
        if dt.active not in [t["tid"] for t in tabs]:
            dt.call("Target.activateTarget", {"targetId": tabs[0]["tid"]})
            dt.active = tabs[0]["tid"]
        for t in extra:
            try:
                dt.call("Target.closeTarget", {"targetId": t["tid"]})
            except Exception:
                pass
            dt.sessions.pop(t["tid"], None)

    def show(i):
        """Switch the screen to tab i: fade the old one to dark, cut, fade the new one in."""
        cur, nxt = dt.active, tabs[i]["tid"]
        if nxt == cur:
            return
        try:
            dt.evaluate(FADE_JS + "__bcsFade('out')", timeout=5, tid=cur)
            time.sleep(0.65)
        except Exception:
            pass
        try:
            dt.evaluate(FADE_JS + "__bcsFade('cover')", timeout=5, tid=nxt)
        except Exception:
            pass
        dt.call("Target.activateTarget", {"targetId": nxt})
        dt.active = nxt
        try:
            dt.evaluate(FADE_JS + "__bcsFade('in')", timeout=5, tid=nxt)
            dt.evaluate(FADE_JS + "__bcsFade('clear')", timeout=5, tid=cur)
        except Exception:
            pass
        log(f"showing dashboard {i + 1} of {len(tabs)}:", tabs[i]["url"])

    def wanted_tab():
        if len(tabs) < 2:
            return 0
        mins = rotate_minutes()
        # on clock boundaries, so it's predictable and survives restarts
        slot = int(fleet.wall_time() // (mins * 60)) if mins > 0 else 0
        return (slot + rot["offset"]) % len(tabs)

    blanket_shown = False
    theme_shown = None

    def sync_page():
        """Keep the corner agent installed and the blanket in the state we want (survives reloads)."""
        nonlocal blanket_shown, theme_shown
        want = blanket_wanted()
        theme = blanket_theme() if want else None
        # the wall position is pushed every sync, so a new 'noc wall' order applies within seconds
        up = dt.evaluate(CORNER_AGENT + f"\nwindow.__BCS_WALL={json.dumps(wall_position())};"
                         f"window.__BCS_NOW_OFFSET={holiday_offset() + fleet.offset};\n!!window.__bcsBlanket", timeout=5)
        overlay_js()                                   # refresh the cached script if it was updated
        if want and up and (theme != theme_shown or js_cache["mtime"] != js_shown["mtime"]):
            # theme changed, or an update brought new animation code: fade the old one out;
            # the next sync brings the new one in, so every display runs the same code
            if js_cache["mtime"] != js_shown["mtime"]:
                log("blanket: new animation installed, reloading it")
            js_shown["mtime"] = js_cache["mtime"]
            dt.evaluate("window.__bcsBlanketStop && window.__bcsBlanketStop()", timeout=5)
            theme_shown = None
        elif want and not up:
            js = overlay_js()
            if js:
                js_shown["mtime"] = js_cache["mtime"]
                dt.evaluate(f"window.__BCS_MODE='blanket';window.__BCS_THEME={json.dumps(theme)};"
                            f"window.__BCS_WALL={json.dumps(wall_position())};window.__BCS_NOW_OFFSET={holiday_offset() + fleet.offset};\n{js}")
                theme_shown = theme
        elif not want and up:
            dt.evaluate("window.__bcsBlanketStop && window.__bcsBlanketStop()", timeout=5)
        if want != blanket_shown:
            log("blanket", f"on ({theme})" if want else "off")
            blanket_shown = want

    started = time.time()
    last_slot = last_mins = None
    last_sync = last_ping = 0
    while chrome.poll() is None:
        wake.wait(1)
        wake.clear()
        try:
            if "corner" in pending:
                pending.discard("corner")
                on = not blanket_wanted()
                set_blanket_flag(on)
                n = fleet.send(cmd="blanket", on=on, theme=blanket_theme())
                log(f"hot corner: blanket {'on' if on else 'off'}" + (f", sent to {n} linked display(s)" if n else ""))
                pending.add("settings")
            if blanket_wanted() != blanket_mode:
                log("blanket " + ("on: restarting Chrome with only the blanket" if not blanket_mode else "off: restarting Chrome with the dashboards"))
                chrome.terminate()
                try:
                    chrome.wait(15)
                except subprocess.TimeoutExpired:
                    chrome.kill()
                os.execve(sys.executable, [sys.executable] + sys.argv, dict(os.environ, BCS_KIOSK_REEXEC="1"))
            if "settings" in pending or not tabs:
                pending.discard("settings")
                reconcile()
                if os.path.exists(NEXT_FLAG):
                    os.remove(NEXT_FLAG)
                    rot["offset"] += 1
                last_sync = 0
            # rotation (paused while the blanket or an interlude is up)
            if len(tabs) > 1 and not blanket_mode:
                i = wanted_tab()
                if tabs[i]["tid"] != dt.active and not dt.evaluate("!!window.__bcsInterlude", timeout=5):
                    show(i)
                    last_sync = 0
            if "reload" in pending:
                pending.discard("reload")
                dt.on_page("Page.reload", {"ignoreCache": True})
                log("reloaded")
            if time.time() - last_sync >= 2:
                last_sync = time.time()
                if time.time() - last_ping >= (10 if time.time() - started > 30 else 2):
                    last_ping = time.time()
                    fleet.ping()
                # anything that opened its own tab (a pop-up, a link) gets closed; the dashboard stays on screen
                ours = {t["tid"] for t in tabs}
                strays = [p for p in dt.pages() if p["targetId"] not in ours] if ours else []   # never before we've adopted a tab
                for p in strays:
                    log("closing stray tab:", p.get("url", "?")[:80])
                    try:
                        dt.call("Target.closeTarget", {"targetId": p["targetId"]})
                    except Exception:
                        pass
                if strays and dt.active:
                    dt.call("Target.activateTarget", {"targetId": dt.active})
                sync_page()
        except Exception as e:
            log("page:", e)

        mins, secs = interlude_setting()
        if "play" in pending:
            pending.discard("play")
            if not blanket_mode:
                play(secs)
            continue
        # scheduled: on clock boundaries (e.g. :00 and :30) so every display plays together;
        # skipped while the blanket is up
        if mins > 0 and time.time() - started > 90:
            slot = int(fleet.wall_time() // (mins * 60))
            if last_slot is None or mins != last_mins:
                last_slot, last_mins = slot, mins     # new schedule: wait for the next boundary
            elif slot != last_slot:
                last_slot = slot
                if not blanket_mode:
                    play(secs)
    sys.exit(chrome.returncode or 0)


if __name__ == "__main__":
    main()
