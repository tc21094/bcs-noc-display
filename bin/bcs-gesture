#!/opt/bcs-noc/gesture/bin/python3
"""bcs-gesture - camera gesture control for a BCS NOC display.

Watches the camera on this display, finds hands (MediaPipe hand landmarks, on this machine only;
no frame is ever stored or sent anywhere), and turns deliberate gestures into kiosk actions. It
sends its state ~30 times a second to kiosk-launch on 127.0.0.1, which draws the cursor and
feedback and acts on the dashboards.

Built for a busy room: nothing happens until someone *wakes* it by holding an open palm up,
facing the camera, still, for a second, close enough to the camera. Hands that pass by, hang at
someone's side, are far away or are moving never wake it.

  wake            open palm, fingers up, held still ~1 s       -> cursor appears where you are
  move cursor     move that hand (cursor follows the palm)     -> hover over things on the dashboard
  click           quick pinch and let go (a tap)               -> click what the cursor is on
  zoom            pinch (thumb + index), move up / down        -> zoom in / out at the cursor
  draw            point one finger and hold it still ~1.5 s    -> drawing on: point to draw, open your
                  hand to lift the pen, hold a fist to clear the drawing and stop
  next / prev     quick swipe left / right with an open hand   -> next / previous dashboard
  pause rotation  fist, held ~1.2 s                            -> stop / restart dashboard rotation
  interlude       "V" (index + middle), held ~1.2 s            -> play the BCS NOC interlude
  blanket         BOTH open palms up, held ~1.5 s (any time)   -> blanket on / off, all displays
  done            drop your hand: the cursor goes away after a few seconds

  bcs-gesture                      run (normally from the bcs-gesture user service)
  bcs-gesture --replay FILE.jsonl  feed recorded / synthetic hand landmarks instead of the camera
  bcs-gesture --image FILE         run the hand model on one picture and print what it sees
"""
import argparse, base64, json, math, os, socket, sys, time
from collections import deque

HOME = os.path.expanduser("~")
CONF = os.path.join(HOME, ".config", "bcs-noc")
SETTINGS = os.path.join(CONF, "gestures")              # KEY=VALUE lines (camera, range ...), optional
PREVIEW_FLAG = os.path.join(CONF, "gesture-preview")   # present (and fresh) = send a small preview picture
MODEL = os.environ.get("BCS_GESTURE_MODEL", "/opt/bcs-noc/gesture/hand_landmarker.task")
# Google's trained gesture classifier (hand tracking + Open_Palm / Closed_Fist / Victory ...). Used instead of
# the plain hand tracker when present; its verdict is combined with our own finger measurements.
GESTURE_MODEL = os.environ.get("BCS_GESTURE_CLASSIFIER", "/opt/bcs-noc/gesture/gesture_recognizer.task")
RECORD_FLAG = os.path.join(HOME, ".config", "bcs-noc", "gesture-record")   # 'kiosk gestures record': save hand landmarks
PORT = int(os.environ.get("BCS_GESTURE_PORT", "47481"))
BOOT = base64.b32encode(os.urandom(5)).decode()              # tells kiosk-launch when this program restarted

# a hand is "close enough" when its palm (wrist to middle knuckle) is at least this fraction of the
# frame height: ~0.045 is about 2.5-3 m with a typical 1080p webcam. 'range' in the settings file
# (metres) overrides it.
DEFAULTS = {"camera": "/dev/video0", "width": "1280", "height": "720", "range": "2.8", "fov": "43", "facing": "no"}


def log(*a):
    print("bcs-gesture:", *a, file=sys.stderr, flush=True)


def settings():
    s = dict(DEFAULTS)
    try:
        for line in open(SETTINGS):
            k, _, v = line.strip().partition("=")
            if k and v and not k.startswith("#"):
                s[k.strip()] = v.strip()
    except OSError:
        pass
    return s


def wall_info():
    """(this display's position, number of displays) from 'noc wall', so the cursor can cross the whole wall."""
    try:
        v = (os.environ.get("BCS_GESTURE_WALL") or open(os.path.join(CONF, "wall")).read()).split()
        pos, n = int(v[0]), int(v[1])
        return (pos, n) if 1 <= pos <= n else (1, 1)
    except (OSError, ValueError, IndexError):
        return (1, 1)


def min_palm(s):
    """Smallest palm (fraction of frame height) we act on, from the camera's vertical field of view and the range."""
    try:
        d, fov = float(s["range"]), float(s["fov"])
        return 0.095 / (2 * d * math.tan(math.radians(fov) / 2))
    except (ValueError, KeyError):
        return 0.045


# ------------------------------------------------------------------------------------------ hands
WRIST, THUMB_IP, THUMB_TIP = 0, 3, 4
FINGERS = {"index": (8, 6, 5), "middle": (12, 10, 9), "ring": (16, 14, 13), "pinky": (20, 18, 17)}


def dist(a, b):
    return math.hypot(a[0] - b[0], a[1] - b[1])


def bend(w, a, b, c):
    """Angle (degrees) between bone a->b and bone b->c in 3D: 0 = perfectly straight."""
    u = [w[b][i] - w[a][i] for i in range(3)]
    v = [w[c][i] - w[b][i] for i in range(3)]
    nu, nv = math.sqrt(sum(x * x for x in u)), math.sqrt(sum(x * x for x in v))
    if nu < 1e-9 or nv < 1e-9:
        return 0.0
    return math.degrees(math.acos(max(-1.0, min(1.0, sum(x * y for x, y in zip(u, v)) / (nu * nv)))))


CANNED = {"Open_Palm": "open", "Closed_Fist": "fist", "Victory": "victory", "Pointing_Up": "point"}


class Hand:
    """One detected hand. Points are in frame-height units (x scaled by the aspect ratio), mirrored like a mirror.
    world: the same 21 points in metres, 3D (from the tracker), which tells a straight finger from a bent one
    even when it points toward the camera. canned: (name, score) from Google's gesture classifier, if running."""

    def __init__(self, pts, handed="Right", score=1.0, world=None, canned=None):
        self.p = pts
        self.handed = handed
        self.score = score
        self.world = world
        self.canned = canned
        self.speed = 99.0          # filled in by the engine
        self.checks = []
        p = pts
        self.palm = max(1e-6, dist(p[0], p[9]))
        self.center = ((p[0][0] + p[5][0] + p[9][0] + p[17][0]) / 4, (p[0][1] + p[5][1] + p[9][1] + p[17][1]) / 4)
        self.ext = {}
        for name, (tip, pip, mcp) in FINGERS.items():
            if world:
                # straight finger: the knuckle, middle and end joints together bend less than ~65 degrees
                self.ext[name] = bend(world, mcp, pip, pip + 1) + bend(world, pip, pip + 1, tip) < 65 and \
                    bend(world, 0, mcp, pip) < 70
            else:
                self.ext[name] = dist(p[tip], p[0]) > dist(p[pip], p[0]) * 1.12 and dist(p[tip], p[mcp]) > 0.55 * self.palm
        self.thumb_out = dist(p[4], p[17]) > dist(p[3], p[17]) * 1.03 and dist(p[4], p[5]) > 0.42 * self.palm
        self.pinch = dist(p[4], p[8]) / self.palm
        # a real pinch has the index reaching out to the thumb; in a fist both are curled in by the palm
        self.reach = dist(p[8], p[0]) > 1.0 * self.palm and dist(p[4], p[0]) > 0.9 * self.palm
        v = (p[9][0] - p[0][0], p[9][1] - p[0][1])
        self.tilt = math.degrees(math.atan2(v[0], -v[1]))          # 0 = fingers straight up
        self.upright = abs(self.tilt) < 50
        a = (p[5][0] - p[0][0], p[5][1] - p[0][1]); b = (p[17][0] - p[0][0], p[17][1] - p[0][1])
        cross = a[0] * b[1] - a[1] * b[0]
        self.facing = cross > 0 if handed == "Right" else cross < 0     # palm toward the camera
        n = sum(self.ext.values())
        self.own = None                                       # what our own measurements alone say
        if self.pinch < 0.33 and self.reach:
            self.pose = "pinch"
        elif n == 4:
            self.pose = "open"
        elif n == 0:
            self.pose = "thumb" if self.thumb_out and dist(p[4], p[0]) > 1.2 * self.palm else "fist"
        elif self.ext["index"] and self.ext["middle"] and not self.ext["ring"] and not self.ext["pinky"]:
            self.pose = "victory"
        elif self.ext["index"] and n == 1:
            self.pose = "point"
        elif n == 3 and self.ext["index"] and self.ext["middle"]:
            self.pose = "open"                                # one finger (ring / pinky) read as bent: still an open hand
        else:
            self.pose = "other"
        self.own = self.pose
        # the trained classifier wins when it's confident (except for pinch, which it doesn't know)
        if canned and self.pose != "pinch" and canned[1] >= 0.6 and canned[0] in CANNED:
            self.pose = CANNED[canned[0]]


class OneEuro:
    """Low-latency smoothing: steady when the hand is still, responsive when it moves."""

    def __init__(self, mincutoff=1.2, beta=0.04, dcutoff=1.0):
        self.mc, self.beta, self.dc = mincutoff, beta, dcutoff
        self.x = self.dx = self.t = None

    @staticmethod
    def _a(cutoff, dt):
        r = 2 * math.pi * cutoff * dt
        return r / (r + 1)

    def __call__(self, x, t):
        if self.t is None or t <= self.t:
            self.x, self.dx, self.t = x, 0.0, t
            return x
        dt = t - self.t
        self.t = t
        dx = (x - self.x) / dt
        self.dx += self._a(self.dc, dt) * (dx - self.dx)
        cut = self.mc + self.beta * abs(self.dx)
        self.x += self._a(cut, dt) * (x - self.x)
        return self.x

    def reset(self):
        self.x = self.dx = self.t = None


# ------------------------------------------------------------------------------------------ engine
WAKE_HOLD, BLANKET_HOLD, POSE_HOLD = 1.0, 1.5, 1.2
DRAW_HOLD = 1.5           # a pointing finger held still this long turns drawing on
DRAW_STILL = 0.35         # ...really still (palm lengths / s): slowly pointing at something doesn't count
TAP_MAX = 0.45            # a pinch let go within this long (without zooming) is a click
LOST_AFTER = 3.0          # s without the controlling hand -> back to sleep
SPAN_X, SPAN_Y = 5.0, 3.2  # palm lengths of slow hand travel across one screen's width / height
ACCEL_FROM, ACCEL, ACCEL_MAX = 1.5, 0.6, 4.0   # faster than 1.5 palm lengths/s the cursor speeds up (up to 4x): crosses screens
STILL = 1.2               # palm lengths per second (over ~0.3 s): slower than this counts as holding still
GRACE = 0.3               # a hold survives a dropped / wobbly frame this long


class Engine:
    def __init__(self, min_palm=0.045, need_facing=False, wall=(1, 1)):
        self.min_palm = min_palm
        self.wall = wall                    # (this display's position, displays on the wall): the cursor spans them all
        self.need_facing = need_facing      # also require the palm (not the back of the hand) toward the camera
        self.tracks = []                    # [{"x", "y", "palm", "hist": deque[(t, x, y)]}] one per hand in view
        self.hold_seen = {}
        self.engaged = False
        self.ctrl = None                    # (x, y, palm) of the controlling hand last seen
        self.ctrl_seen = 0
        self.anchor = None                  # hand position that maps to the cursor's current place
        self.s0 = 1
        self.cx, self.cy = 0.5, 0.5
        self.fx, self.fy = OneEuro(), OneEuro()
        self.hist = deque()                 # (t, x, y) of the controlling hand, ~0.5 s
        self.cur_hist = deque()             # (t, cx, cy)
        self.poses = deque(maxlen=5)
        self.hold = {}                      # kind -> start time
        self.cool = 0                       # no new actions before this time
        self.freeze = 0                     # cursor held in place until this time (after a swipe)
        self.pinching = False
        self.pinch_y0 = 0
        self.pinch_t0 = 0
        self.drawing = False                # drawing mode: pointing = pen down
        self.pen = False
        self.zf = 1.0
        self.zid = 0
        self.events = deque()               # (id, name, time)
        self.evn = 0
        self.speeds = {}                    # rough per-hand speed tracking for the "still" checks
        self.prev = []                      # [(t, x, y, palm)] from the last frame
        self.last_t = 0

    # -- helpers
    def _emit(self, name, t):
        self.evn += 1
        self.events.append((self.evn, name, t))
        log("gesture:", name)

    def _speeds(self, hands, t):
        """Speed of each hand in palm lengths per second, measured over the last ~0.3 s so the
        tracker's frame-to-frame jitter (large for a small, far-away hand) doesn't count as movement."""
        out, tracks, free = [], [], list(self.tracks)
        for h in hands:
            best = None
            for tr in free:
                d = math.hypot(h.center[0] - tr["x"], h.center[1] - tr["y"])
                if d < 2.0 * h.palm and (best is None or d < best[0]):
                    best = (d, tr)
            if best:
                tr = best[1]
                free.remove(tr)
            else:
                tr = {"hist": deque()}
            tr.update(x=h.center[0], y=h.center[1], palm=h.palm)
            tr["hist"].append((t, h.center[0], h.center[1]))
            po = tr.setdefault("poses", deque())
            po.append((t, h.pose))
            while po and t - po[0][0] > 0.4:
                po.popleft()
            h.open_frac = sum(1 for _, q in po if q == "open") / len(po)
            while len(tr["hist"]) > 2 and t - tr["hist"][1][0] >= 0.3:
                tr["hist"].popleft()
            t0, x0, y0 = tr["hist"][0]
            sp = math.hypot(h.center[0] - x0, h.center[1] - y0) / h.palm / (t - t0) if t - t0 >= 0.12 else 99.0
            h.speed = sp
            out.append(sp)
            tracks.append(tr)
        self.tracks = tracks
        self.prev = [(t, h.center[0], h.center[1], h.palm) for h in hands]
        self.last_t = t
        return out

    def checks(self, h, speed):
        """The wake conditions for one hand, in the order the preview shows them."""
        # "open" if it read as open in most of the last ~0.4 s: one odd frame doesn't break the hold
        c = [("open", getattr(h, "open_frac", 1.0 if h.pose == "open" else 0.0) >= 0.6 and h.pose != "fist"),
             ("upright", h.upright), ("near", h.palm >= self.min_palm), ("still", speed < STILL)]
        if self.need_facing:
            c.append(("palm", h.facing))
        return c

    def _calling(self, h, speed):
        """An open hand, fingers up, close enough and held still."""
        h.checks = self.checks(h, speed)
        return all(ok for _, ok in h.checks)

    def _holding(self, kind, on, t, need):
        if not on:
            if kind in self.hold and t - self.hold_seen.get(kind, 0) > GRACE:
                self.hold.pop(kind, None)
            if kind in self.hold:                                # wobble: keep the ring, don't finish on it
                return min(0.99, (t - self.hold[kind]) / need)
            return 0.0
        self.hold_seen[kind] = t
        start = self.hold.setdefault(kind, t)
        return min(1.0, (t - start) / need)

    def _move(self, x, y, t):
        """Move the cursor by how far the (smoothed) hand moved, faster for quick moves (like a mouse):
        slow and steady for pointing at things, a quick sweep to cross to another screen."""
        fx, fy = self.fx(x, t), self.fy(y, t)
        if self.anchor is None or t <= self.anchor[2]:
            self.anchor = (fx, fy, t)
            return
        dx, dy = (fx - self.anchor[0]) / self.s0, (fy - self.anchor[1]) / self.s0
        v = math.hypot(dx, dy) / (t - self.anchor[2])
        g = 1.0 if self.drawing else min(ACCEL_MAX, 1 + ACCEL * max(0.0, v - ACCEL_FROM))
        self.cx = max(0.0, min(self.wall[1] - 1e-4, self.cx + dx / SPAN_X * g))
        self.cy = max(0.0, min(1.0, self.cy + dy / SPAN_Y * g))
        self.anchor = (fx, fy, t)

    def _reanchor(self, x, y):
        """Hand movement until now doesn't count (after a pinch or a swipe): carry on from here."""
        self.anchor = None
        self.fx.reset(); self.fy.reset()

    def _sleep(self):
        self.engaged = False
        self.ctrl = None
        self.pinching = False
        self.pen = False                    # (drawing mode stays on: wake up again and carry on drawing)
        self.hold.clear()
        self.hist.clear()
        self.cur_hist.clear()
        self.fx.reset(); self.fy.reset()

    # -- one frame
    def update(self, hands, t):
        hands = [h for h in hands if h.score >= 0.5]
        speeds = self._speeds(hands, t)
        hold_out = None

        # BLANKET: both palms up together, any time (works while the blanket is up, too)
        calling = [h for h, s in zip(hands, speeds) if self._calling(h, s)]
        two = len(calling) >= 2 and abs(calling[0].palm - calling[1].palm) < 0.5 * max(calling[0].palm, calling[1].palm) \
            and abs(calling[0].center[0] - calling[1].center[0]) > 1.5 * calling[0].palm
        p = self._holding("blanket", two and t >= self.cool, t, BLANKET_HOLD)
        if p > 0:
            hold_out = {"k": "blanket", "p": round(p, 3)}
            self.hold.pop("wake", None)
            if p >= 1:
                self._emit("blanket", t)
                self.hold.pop("blanket", None)
                self.cool = t + 3.0
                self._sleep()

        if not self.engaged:
            # WAKE: one calling hand held ~1 s
            one = calling[0] if len(calling) == 1 else None
            p = self._holding("wake", one is not None and not two and t >= self.cool, t, WAKE_HOLD)
            if p > 0:
                hold_out = hold_out or {"k": "wake", "p": round(p, 3)}
            if one is not None and p >= 1:
                self.engaged = True
                self.hold.clear()
                self.ctrl = (one.center[0], one.center[1], one.palm)
                self.ctrl_seen = t
                self.s0 = one.palm
                self.cx, self.cy = self.wall[0] - 0.5, 0.5          # middle of the screen the camera is on
                self._reanchor(*one.center)
                self.cool = t + 0.6
                self._emit("wake", t)
        else:
            # follow the controlling hand: the one nearest where it was, about the same size
            h = None
            if self.ctrl:
                cands = [(math.hypot(x.center[0] - self.ctrl[0], x.center[1] - self.ctrl[1]), x) for x in hands
                         if 0.6 * self.ctrl[2] < x.palm < 1.6 * self.ctrl[2]]
                cands = [c for c in cands if c[0] < max(4 * self.ctrl[2], 0.25)]
                if cands:
                    h = min(cands, key=lambda c: c[0])[1]
            if h is None:
                if t - self.ctrl_seen > LOST_AFTER:
                    self._emit("sleep", t)
                    self._sleep()
            else:
                self.ctrl = (h.center[0], h.center[1], h.palm)
                self.ctrl_seen = t
                self.s0 = 0.85 * self.s0 + 0.15 * h.palm        # follows someone stepping closer / back
                self.poses.append(h.pose)
                pose = max(set(self.poses), key=list(self.poses).count)
                x, y = h.center
                self.hist.append((t, x, y))
                while self.hist and t - self.hist[0][0] > 0.5:
                    self.hist.popleft()

                # ZOOM: pinch, then up / down. CLICK: a quick pinch and let go, without zooming
                if not self.pinching and h.pinch < 0.30 and h.reach and not self.drawing:
                    self.pinching = True
                    self.pinch_y0 = y
                    self.pinch_t0 = t
                    self.zid += 1
                    self.zf = 1.0
                elif self.pinching and (h.pinch > 0.48 or not h.reach):
                    self.pinching = False
                    self._reanchor(x, y)
                    if 0.06 <= t - self.pinch_t0 <= TAP_MAX and abs(self.zf - 1) < 0.15 and t >= self.cool:
                        self._emit("click", t)
                        self.cool = t + 0.4
                        self.zf = 1.0
                if self.pinching:
                    self.zf = 2 ** ((self.pinch_y0 - y) / (1.4 * self.s0))
                    self.zf = max(0.2, min(5.0, self.zf))
                else:
                    # SWIPE: a quick sideways flick of the open hand
                    swiped = False
                    if pose == "open" and t >= self.cool and len(self.hist) > 3 and not self.drawing:
                        t0, x0, y0 = next(((a, b, c) for (a, b, c) in self.hist if t - a <= 0.35), self.hist[0])
                        dx, dy = x - x0, y - y0
                        recent = [s for s in self.hist if t - s[0] <= 0.12]
                        vx = (recent[-1][1] - recent[0][1]) / max(1e-3, recent[-1][0] - recent[0][0]) if len(recent) > 1 else 0
                        if abs(dx) > 1.8 * self.s0 and abs(dx) > 2.2 * abs(dy) and abs(vx) > 4.0 * self.s0:
                            self._emit("next" if dx < 0 else "prev", t)
                            swiped = True
                            self.cool = t + 1.0
                            self.freeze = t + 0.8
                            # put the cursor back where it was before the flick
                            back = next((c for c in self.cur_hist if t - c[0] <= 0.45), None)
                            if back:
                                self.cx, self.cy = back[1], back[2]
                            self.hist.clear()
                    if t < self.freeze:
                        self._reanchor(x, y)                    # cursor stays put through the flick
                    elif not swiped:
                        self._move(x, y, t)
                    self.cur_hist.append((t, self.cx, self.cy))
                    while self.cur_hist and t - self.cur_hist[0][0] > 0.6:
                        self.cur_hist.popleft()

                    # DRAWING: pen down while pointing
                    self.pen = self.drawing and pose == "point"

                    # HOLDS: point still = draw; fist = pause rotation (in drawing mode: clear and stop); V = interlude
                    if not self.drawing:
                        p = self._holding("draw", pose == "point" and h.speed < DRAW_STILL and t >= self.cool, t, DRAW_HOLD)
                        if p > 0 and not hold_out:
                            hold_out = {"k": "draw", "p": round(p, 3)}
                        if p >= 1:
                            self.drawing = True
                            self.hold.pop("draw", None)
                            self._emit("draw_on", t)
                            self.cool = t + 0.5
                    holds = (("drawoff", "fist", "draw_off"),) if self.drawing else \
                        (("pause", "fist", "pause"), ("interlude", "victory", "interlude"))
                    for kind, want, ev in holds:
                        p = self._holding(kind, pose == want and t >= self.cool, t, POSE_HOLD)
                        if p > 0 and not hold_out:
                            hold_out = {"k": kind, "p": round(p, 3)}
                        if p >= 1:
                            self._emit(ev, t)
                            self.hold.pop(kind, None)
                            self.cool = t + 1.0
                            if ev == "draw_off":
                                self.drawing = self.pen = False

        while self.events and t - self.events[0][2] > 1.0:
            self.events.popleft()
        return {
            "on": self.engaged,
            "x": round(self.cx, 4), "y": round(self.cy, 4), "n": self.wall[1], "home": self.wall[0],
            "pinch": self.pinching, "zf": round(self.zf, 3), "zid": self.zid,
            "draw": self.drawing, "pen": self.pen and self.engaged,
            "hold": hold_out,
            "ev": [[i, n] for (i, n, _) in self.events],
            "hands": len(hands),
        }


# ------------------------------------------------------------------------------------------ sources
def hands_from_result(res, aspect):
    out = []
    worlds = getattr(res, "hand_world_landmarks", None) or [None] * len(res.hand_landmarks)
    gests = getattr(res, "gestures", None) or [None] * len(res.hand_landmarks)
    for lms, hd, wl, g in zip(res.hand_landmarks, res.handedness, worlds, gests):
        pts = [(l.x * aspect, l.y) for l in lms]
        world = [(l.x, l.y, l.z) for l in wl] if wl else None
        canned = (g[0].category_name, g[0].score) if g else None
        out.append(Hand(pts, hd[0].category_name, hd[0].score, world, canned))
    return out


def make_landmarker(video=True):
    """-> (mediapipe, detect(image, ms) -> result, description). The trained gesture classifier when its
    model is installed, else the plain hand tracker."""
    import mediapipe as mp
    from mediapipe.tasks.python import vision, BaseOptions
    mode = vision.RunningMode.VIDEO if video else vision.RunningMode.IMAGE
    conf = dict(num_hands=2, running_mode=mode, min_hand_detection_confidence=0.55,
                min_hand_presence_confidence=0.55, min_tracking_confidence=0.5)
    if os.path.exists(GESTURE_MODEL):
        try:
            r = vision.GestureRecognizer.create_from_options(
                vision.GestureRecognizerOptions(base_options=BaseOptions(model_asset_path=GESTURE_MODEL), **conf))
            return mp, (r.recognize_for_video if video else (lambda img, ms=0: r.recognize(img))), "trained gesture classifier"
        except Exception as e:
            log("gesture classifier failed to load, using the hand tracker:", e)
    lm = vision.HandLandmarker.create_from_options(
        vision.HandLandmarkerOptions(base_options=BaseOptions(model_asset_path=MODEL), **conf))
    return mp, (lm.detect_for_video if video else (lambda img, ms=0: lm.detect(img))), "hand tracker"


def preview_jpeg(frame, hands, state, cv2):
    """A small picture for the on-screen preview: the camera, the hands, and what it thinks."""
    img = cv2.resize(frame, (480, 270), interpolation=cv2.INTER_AREA)
    sx, sy = 270, 270
    for h in hands:
        col = (80, 220, 120) if h.palm >= state.get("_min", 0) else (90, 90, 230)
        for a, b in ((0, 1), (1, 2), (2, 3), (3, 4), (0, 5), (5, 6), (6, 7), (7, 8), (5, 9), (9, 10), (10, 11), (11, 12),
                     (9, 13), (13, 14), (14, 15), (15, 16), (13, 17), (0, 17), (17, 18), (18, 19), (19, 20)):
            pa, pb = h.p[a], h.p[b]
            cv2.line(img, (int(pa[0] * sx), int(pa[1] * sy)), (int(pb[0] * sx), int(pb[1] * sy)), col, 2)
        # under each hand: the wake checks, green = OK, red = what's stopping it
        x0, y0 = int(h.center[0] * sx) - 50, min(262, int(h.center[1] * sy) + 34)
        x0 = max(2, min(x0, 480 - 190))
        cv2.rectangle(img, (x0 - 3, y0 - 41), (x0 + 188, y0 + 5), (15, 15, 15), -1)          # dark backing so it reads
        label = h.pose + (f"   (trained: {h.canned[0].replace('_', ' ').lower()} {h.canned[1]:.0%})" if h.canned and h.canned[0] != "None" else "")
        cv2.putText(img, label, (x0, y0 - 28), cv2.FONT_HERSHEY_SIMPLEX, 0.4, (255, 255, 255), 1)
        fx = x0                                                         # fingers it sees straight: green
        for nm in ("index", "middle", "ring", "pinky"):
            cv2.putText(img, nm[0].upper(), (fx, y0 - 13), cv2.FONT_HERSHEY_SIMPLEX, 0.42, (80, 220, 120) if h.ext[nm] else (70, 70, 240), 1)
            fx += 14
        cv2.putText(img, "fingers straight", (fx + 4, y0 - 13), cv2.FONT_HERSHEY_SIMPLEX, 0.35, (170, 170, 170), 1)
        for name, ok in h.checks:
            cv2.putText(img, name, (x0, y0), cv2.FONT_HERSHEY_SIMPLEX, 0.38, (80, 220, 120) if ok else (70, 70, 240), 1)
            x0 += int(cv2.getTextSize(name, cv2.FONT_HERSHEY_SIMPLEX, 0.38, 1)[0][0]) + 6
    hd = state.get("hold")
    label = "ON - move your hand" if state["on"] else (f"waking {int(hd['p'] * 100)}%" if hd and hd["k"] == "wake" else
                                                       "asleep - hold an open hand up, still")
    cv2.rectangle(img, (0, 0), (480, 24), (20, 20, 20), -1)
    cv2.putText(img, label, (8, 17), cv2.FONT_HERSHEY_SIMPLEX, 0.5, (255, 255, 255), 1)
    for q in (75, 55, 35):                                              # must fit in one UDP message
        ok, buf = cv2.imencode(".jpg", img, [cv2.IMWRITE_JPEG_QUALITY, q])
        if ok and len(buf) < 44000:
            return base64.b64encode(buf.tobytes()).decode()
    return None


STATUS = os.path.join(CONF, "gesture-status")


def write_status(text):
    try:
        with open(STATUS, "w") as f:
            f.write(text + "\n")
    except OSError:
        pass


def preview_wanted():
    try:
        return time.time() - os.path.getmtime(PREVIEW_FLAG) < 600     # 'kiosk gestures preview' refreshes it; 10 min max
    except OSError:
        return False


class Camera:
    """Reads the camera on its own thread and keeps only the newest frame, so the picture never
    queues up behind the hand tracker (no lag), and the camera always runs at its full rate."""

    def __init__(self, cv2, dev, width, height):
        import threading
        self.cv2, self.dev = cv2, dev
        self.frame, self.n, self.fps, self.desc = None, 0, 0.0, ""
        self.ok = False
        self.new = threading.Event()
        live = dev.isdigit() or dev.startswith("/dev/")
        cap = cv2.VideoCapture(int(dev) if dev.isdigit() else dev, cv2.CAP_V4L2 if live else cv2.CAP_ANY)   # a file works too (testing)
        if live:
            # compressed (MJPG) frames: a webcam only reaches full frame rate at HD over USB this way
            cap.set(cv2.CAP_PROP_FOURCC, cv2.VideoWriter_fourcc(*"MJPG"))
            cap.set(cv2.CAP_PROP_FRAME_WIDTH, width)
            cap.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
            cap.set(cv2.CAP_PROP_FPS, 30)
            cap.set(cv2.CAP_PROP_BUFFERSIZE, 1)
        self.cap = cap
        if not cap.isOpened():
            return
        if live and dev.startswith("/dev/"):
            # many webcams halve their frame rate in dim light to expose longer (blurry, laggy hands);
            # keep the full rate and let them raise gain instead
            import subprocess
            for ctl in ("exposure_dynamic_framerate=0", "exposure_auto_priority=0"):
                subprocess.run(["v4l2-ctl", "-d", dev, "-c", ctl], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        fcc = int(cap.get(cv2.CAP_PROP_FOURCC))
        fcc = "".join(chr((fcc >> 8 * i) & 0xFF) for i in range(4)).strip("\0 ") or "?"
        self.desc = f"{fcc} {int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))}x{int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))}"
        if live and fcc != "MJPG":
            log(f"camera gave {fcc} instead of MJPG: the frame rate may be low at this size (try 'kiosk gestures size 640x480')")
        self.ok = True
        self.live = live
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        t, n = time.time(), 0
        while True:
            ok, f = self.cap.read()
            if not ok:
                self.ok = False
                self.new.set()
                return
            self.frame = f
            self.n += 1
            n += 1
            self.new.set()
            if time.time() - t >= 2:
                self.fps, t, n = n / (time.time() - t), time.time(), 0
            if not self.live:
                time.sleep(1 / 30)                                      # a test video plays at real time

    def latest(self, timeout=2):
        self.new.wait(timeout)
        self.new.clear()
        return self.frame if self.ok else None

    def close(self):
        try:
            self.cap.release()
        except Exception:
            pass


class Recorder:
    """'kiosk gestures record N': save N seconds of hand landmarks (points only, never pictures) to a
    file in the home folder, for tuning the recognition to a real room."""

    def __init__(self):
        self.f, self.until, self.path = None, 0, None

    def add(self, t, hands, state):
        if self.f is None:
            try:
                secs = float(open(RECORD_FLAG).read().strip() or 20)
                os.remove(RECORD_FLAG)
            except (OSError, ValueError):
                return
            self.path = os.path.join(HOME, time.strftime("bcs-gesture-record-%Y%m%d-%H%M%S.jsonl"))
            self.f, self.until = open(self.path, "w"), t + min(120, secs)
            log("recording hand landmarks to", self.path)
        self.f.write(json.dumps({"t": round(t, 3), "on": state["on"], "hands": [
            {"pts": [[round(a, 4), round(b, 4)] for a, b in h.p], "handed": h.handed, "score": round(h.score, 3),
             "world": [[round(c, 4) for c in w] for w in h.world] if h.world else None,
             "canned": list(h.canned) if h.canned else None, "pose": h.pose, "own": h.own,
             "checks": h.checks} for h in hands]}) + "\n")
        if t >= self.until:
            self.f.close()
            self.f = None
            log("recording saved:", self.path)

    def note(self):
        if self.f is not None:
            return f"; RECORDING to {self.path}"
        return f"; last recording: {self.path}" if self.path else ""


def run_camera(sock):
    if not os.path.exists(MODEL):
        log("hand model missing:", MODEL, "- re-run the installer with --gestures")
        write_status(f"HAND MODEL MISSING ({MODEL}): re-run the installer with --gestures")
        time.sleep(60)
        sys.exit(1)
    import cv2
    s = settings()
    engine = Engine(min_palm(s), s.get("facing") == "yes", wall_info())
    mp, detect, how = make_landmarker(True)
    rec = Recorder()
    cam, t_open, last_prev, fps_t, fps_n, fps, last_n, last_proc = None, 0, 0, time.time(), 0, 0, -1, 0
    t0 = time.monotonic()
    had_camera = False      # a display with no camera at all stays silent (another display's camera may be driving it)
    log(f"{how}, camera {s['camera']}, acting on hands within ~{s['range']} m, wall {engine.wall}")
    while True:
        if cam is None or not cam.ok:
            if cam is not None:
                log("camera stopped; reopening")
                cam.close()
                cam = None
            if time.time() - t_open < 5:
                time.sleep(0.5)
                if had_camera:                                  # it was working and went away: say so on screen
                    send(sock, {"cam": False})
                continue
            t_open = time.time()
            cam = Camera(cv2, s["camera"], int(s["width"]), int(s["height"]))
            if not cam.ok:
                log("camera not available:", s["camera"])
                write_status(f"NO CAMERA at {s['camera']} (plug one in, or 'kiosk gestures camera /dev/videoN')")
                cam = None
                continue
            log("camera open:", s["camera"], cam.desc)
            had_camera = True
        frame = cam.latest()
        if frame is None or cam.n == last_n:
            continue
        last_n = cam.n
        # asleep with nobody in view: ~12 tracking passes a second is plenty (saves CPU); otherwise as fast as it goes
        now = time.time()
        if not engine.engaged and not engine.prev and now - last_proc < 1 / 12 and not preview_wanted():
            continue
        last_proc = now
        frame = cv2.flip(frame, 1)                                      # mirror: your right is the screen's right
        h_, w_ = frame.shape[:2]
        small = cv2.resize(frame, (640, int(640 * h_ / w_)), interpolation=cv2.INTER_AREA)
        img = mp.Image(image_format=mp.ImageFormat.SRGB, data=cv2.cvtColor(small, cv2.COLOR_BGR2RGB))
        res = detect(img, int((time.monotonic() - t0) * 1000))
        hands = hands_from_result(res, w_ / h_)
        now = time.time()
        state = engine.update(hands, now)
        rec.add(now, hands, state)
        fps_n += 1
        if now - fps_t >= 5:
            fps, fps_n, fps_t = fps_n / (now - fps_t), 0, now
            engine.wall = wall_info()
            why = ""
            if hands and not engine.engaged:
                miss = [n for n, ok in hands[0].checks if not ok]
                why = f" (hand in view is not: {', '.join(miss)})" if miss else ""
            write_status(f"camera {cam.fps:.0f} frames/s ({cam.desc}), tracking {fps:.0f}/s ({how}), {len(hands)} hand(s) in view, "
                         f"{'in use' if engine.engaged else 'waiting for a raised open hand' + why}" + rec.note())
        state.update(cam=True, fps=round(fps, 1))
        if preview_wanted() and now - last_prev > 0.08:              # ~12 pictures a second
            last_prev = now
            state["_min"] = engine.min_palm
            state["pv"] = preview_jpeg(small, hands, state, cv2)
            state.pop("_min", None)
        send(sock, state)


def run_replay(sock, path, loop=False):
    """Frames from a .jsonl file: {"t": seconds, "hands": [{"pts": [[x, y], ... 21], "handed": "Right"}]}"""
    frames = [json.loads(l) for l in open(path) if l.strip()]
    engine = Engine(float(os.environ.get("BCS_GESTURE_MIN_PALM", "0.045")), wall=wall_info())
    while True:
        start = time.time()
        for f in frames:
            time.sleep(max(0, start + f["t"] - time.time()))
            hands = [Hand([tuple(p) for p in h["pts"]], h.get("handed", "Right"), h.get("score", 1.0),
                          [tuple(w) for w in h["world"]] if h.get("world") else None,
                          tuple(h["canned"]) if h.get("canned") else None) for h in f["hands"]]
            st = engine.update(hands, time.time())
            st.update(cam=True, fps=30)
            send(sock, st)
        if not loop:
            break


def send(sock, state):
    state["boot"] = BOOT
    try:
        sock.sendto(json.dumps(state, separators=(",", ":")).encode(), ("127.0.0.1", PORT))
    except OSError:
        pass


def main():
    ap = argparse.ArgumentParser(description="BCS NOC camera gestures")
    ap.add_argument("--replay")
    ap.add_argument("--loop", action="store_true")
    ap.add_argument("--image")
    a = ap.parse_args()
    if a.image:
        import cv2
        mp, detect, how = make_landmarker(False)
        print("using the", how)
        frame = cv2.flip(cv2.imread(a.image), 1)                        # mirrored, as the camera feed is
        img = mp.Image(image_format=mp.ImageFormat.SRGB, data=cv2.cvtColor(frame, cv2.COLOR_BGR2RGB))
        hands = hands_from_result(detect(img), frame.shape[1] / frame.shape[0])
        if not hands:
            print("no hands found")
        for h in hands:
            print(f"{h.handed} hand: {h.pose} (ours: {h.own}, trained: {h.canned}), palm {h.palm:.3f} of frame height, upright {h.upright} ({h.tilt:.0f} deg), "
                  f"facing camera {h.facing}, fingers {[k for k, v in h.ext.items() if v]}, thumb out {h.thumb_out}, pinch {h.pinch:.2f}")
        return
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    if a.replay:
        run_replay(sock, a.replay, a.loop)
    else:
        run_camera(sock)


if __name__ == "__main__":
    main()
