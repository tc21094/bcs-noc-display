#!/usr/bin/env bash
# noc - control all BCS NOC displays at once over SSH
#
# Setup (once, on your Mac/Linux machine):
#   noc add noc-1 tc@10.0.0.21        register each display (user = its auto-login user)
#   noc keys                          set up password-free SSH to every display
#
# Everyday use   (TARGET = all | a name | a number from 'noc list' | comma list like 1,3)
#   noc                               status of every display
#   noc stop [TARGET]                 close dashboards, back to the desktop
#   noc start [TARGET]                bring dashboards back
#   noc reload [TARGET]               reload the dashboard pages
#   noc restart [TARGET]              restart Chrome on displays
#   noc interlude [TARGET]            play the BCS NOC interlude now (all together by default)
#   noc interlude TARGET every N      play it every N minutes (0 = off)
#   noc blanket [TARGET] on|off       "BCS Technology Department" over the dashboards until off
#   noc blanket                       show blanket state ('noc blanket toggle' flips all to match)
#   noc link                          let a hot corner on any display toggle the blanket on all
#   noc url [TARGET [URL...]]         show URLs, or set a display's dashboard (several = a rotation)
#   noc rotate [TARGET] every N       rotate each display's dashboards every N minutes (0 = off)
#   noc next [TARGET]                 show the next dashboard now
#   noc disable|enable [TARGET]       keep dashboards off across reboots / undo
#   noc reboot|shutdown [TARGET]      reboot or power off (asks first)
#   noc run TARGET 'command'          run any shell command on displays
#   noc ssh TARGET                    open a shell on one display
#   noc update [TARGET]               re-run the installer from GitHub (asks for sudo password)
#   noc list | add | remove NAME      manage the display list
#
# Displays are listed in ~/.config/noc/hosts  (override with NOC_HOSTS=/path)

NOC_INSTALL_URL="https://raw.githubusercontent.com/tc21094/bcs-noc-display/main/install.sh"
HOSTS_FILE="${NOC_HOSTS:-$HOME/.config/noc/hosts}"
SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=6 -o ServerAliveInterval=5 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=accept-new -o LogLevel=ERROR)

if [ -t 1 ]; then B=$'\e[1m'; G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; D=$'\e[2m'; Z=$'\e[0m'; else B=; G=; R=; Y=; D=; Z=; fi
die() { echo "${R}noc:${Z} $*" >&2; exit 1; }

# ---------------------------------------------------------------- display list
NAMES=(); ADDRS=()
load_hosts() {
  NAMES=(); ADDRS=()
  [ -f "$HOSTS_FILE" ] || return 0
  local name addr rest
  while read -r name addr rest; do
    case "$name" in ''|'#'*) continue ;; esac
    NAMES+=("$name"); ADDRS+=("$addr")
  done <"$HOSTS_FILE"
}

need_hosts() {
  load_hosts
  [ ${#NAMES[@]} -gt 0 ] || die "no displays registered yet. Add one:  noc add noc-1 user@ip-address"
}

# resolve TARGET -> indices in SEL[]
SEL=()
select_targets() {
  local spec="${1:-all}" part i found
  SEL=()
  if [ "$spec" = all ]; then
    for i in "${!NAMES[@]}"; do SEL+=("$i"); done
    return
  fi
  local IFS=,
  for part in $spec; do
    found=
    if [[ "$part" =~ ^[0-9]+$ ]] && [ "$part" -ge 1 ] && [ "$part" -le ${#NAMES[@]} ]; then
      SEL+=($((part - 1))); found=1
    else
      for i in "${!NAMES[@]}"; do
        if [ "${NAMES[$i]}" = "$part" ]; then SEL+=("$i"); found=1; fi
      done
    fi
    [ -n "$found" ] || die "no display named '$part' (see: noc list)"
  done
}

is_target() {  # does $1 look like a target rather than another argument?
  [ "$1" = all ] && return 0
  local p IFS=,
  for p in $1; do
    [[ "$p" =~ ^[0-9]+$ ]] && continue
    local i ok=
    for i in "${!NAMES[@]}"; do [ "${NAMES[$i]}" = "$p" ] && ok=1; done
    [ -n "$ok" ] || return 1
  done
  return 0
}

# ---------------------------------------------------------------- fan-out
# run a remote command on every selected display in parallel, print results in order
fanout() {
  local remote="$1" tmp i rc fail=0
  tmp=$(mktemp -d "${TMPDIR:-/tmp}/noc.XXXXXX")
  for i in "${SEL[@]}"; do
    ( ssh "${SSH_OPTS[@]}" "${ADDRS[$i]}" "$remote" >"$tmp/$i.out" 2>&1; echo $? >"$tmp/$i.rc" ) &
  done
  wait
  for i in "${SEL[@]}"; do
    rc=$(cat "$tmp/$i.rc" 2>/dev/null || echo 255)
    if [ "$rc" = 0 ]; then mark="${G}●${Z}"; else mark="${R}●${Z}"; fail=1; fi
    if [ "$rc" = 255 ] && ! grep -q . "$tmp/$i.out"; then echo "unreachable" >"$tmp/$i.out"; fi
    sed "1s/^/$(printf '%s %s%-10s%s ' "$mark" "$B" "${NAMES[$i]}" "$Z")/; 2,\$s/^/             /" "$tmp/$i.out"
    [ -s "$tmp/$i.out" ] || printf '%s %s%-10s%s ok\n' "$mark" "$B" "${NAMES[$i]}" "$Z"
  done
  rm -rf "$tmp"
  return $fail
}

confirm() {
  local names="" i
  for i in "${SEL[@]}"; do names="$names ${NAMES[$i]}"; done
  [ -n "${NOC_YES:-}" ] && return 0
  printf '%s%s on:%s%s  Continue? [y/N] ' "$Y" "$1" "$names" "$Z"
  read -r ans </dev/tty
  case "$ans" in y|Y|yes) return 0 ;; *) echo "Cancelled."; exit 1 ;; esac
}

# ---------------------------------------------------------------- commands
cmd="${1:-status}"; [ $# -gt 0 ] && shift

case "$cmd" in
  -h|--help|help)
    sed -n '2,31p' "$0" | sed 's/^# \{0,1\}//' ;;

  list|ls)
    load_hosts
    [ ${#NAMES[@]} -gt 0 ] || { echo "No displays yet. Add one:  noc add noc-1 user@ip-address"; exit 0; }
    for i in "${!NAMES[@]}"; do printf '%2d  %s%-10s%s %s\n' $((i + 1)) "$B" "${NAMES[$i]}" "$Z" "${ADDRS[$i]}"; done
    echo "${D}($HOSTS_FILE)${Z}" ;;

  add)
    [ $# -eq 2 ] || die "usage: noc add NAME user@host"
    [[ "$2" == *@* ]] || die "give the login too, e.g.  noc add $1 tc@$2"
    load_hosts
    for n in "${NAMES[@]}"; do [ "$n" = "$1" ] && die "'$1' already exists (noc remove $1 first)"; done
    mkdir -p "$(dirname "$HOSTS_FILE")"
    [ -f "$HOSTS_FILE" ] || printf '# name   login@address\n' >"$HOSTS_FILE"
    printf '%-8s %s\n' "$1" "$2" >>"$HOSTS_FILE"
    echo "Added $1 ($2). Next: noc keys $1" ;;

  remove|rm)
    [ $# -eq 1 ] || die "usage: noc remove NAME"
    need_hosts; select_targets "$1"
    awk -v n="$1" '$1 != n' "$HOSTS_FILE" >"$HOSTS_FILE.tmp" && mv "$HOSTS_FILE.tmp" "$HOSTS_FILE"
    echo "Removed $1" ;;

  keys)
    need_hosts; select_targets "${1:-all}"
    KEY="$HOME/.ssh/id_ed25519"
    if [ ! -f "$KEY" ]; then
      echo "Creating SSH key $KEY"
      mkdir -p "$HOME/.ssh" && ssh-keygen -q -t ed25519 -N "" -f "$KEY" || die "ssh-keygen failed"
    fi
    for i in "${SEL[@]}"; do
      echo "${B}${NAMES[$i]}${Z} (${ADDRS[$i]}) - enter its password once:"
      ssh-copy-id -i "$KEY.pub" -o StrictHostKeyChecking=accept-new "${ADDRS[$i]}" >/dev/null 2>&1 \
        && echo "  ${G}✓${Z} key installed" || echo "  ${R}✗${Z} failed (is it on the network with SSH running?)"
    done ;;

  status|st)
    need_hosts; select_targets "${1:-all}"
    fanout "kiosk status" ;;

  start|stop|restart|reload|enable|disable)
    need_hosts; select_targets "${1:-all}"
    fanout "kiosk $cmd" ;;

  interlude)
    need_hosts
    if [ $# -gt 0 ] && is_target "$1"; then select_targets "$1"; shift; else select_targets all; fi
    case "${1:-now}" in
      now)   fanout "kiosk interlude now" ;;
      off)   fanout "kiosk interlude every 0" ;;
      every) [[ "${2:-}" =~ ^[0-9]+$ ]] || die "usage: noc interlude [TARGET] every MINUTES"
             fanout "kiosk interlude every $2" ;;
      *)     die "usage: noc interlude [TARGET] [now | every MINUTES | off]" ;;
    esac ;;

  blanket)
    need_hosts
    if [ $# -gt 0 ] && is_target "$1"; then select_targets "$1"; shift; else select_targets all; fi
    act="${1:-status}"
    if [ "$act" = toggle ]; then
      cur=$(ssh "${SSH_OPTS[@]}" "${ADDRS[${SEL[0]}]}" "kiosk blanket status" 2>/dev/null)
      [ "$cur" = on ] && act=off || act=on
    fi
    case "$act" in
      on|off) fanout "kiosk blanket $act" ;;
      status) fanout "kiosk blanket status" ;;
      *)      die "usage: noc blanket [TARGET] [on | off | toggle]" ;;
    esac ;;

  link)
    need_hosts; select_targets all
    if [ "${1:-}" = off ]; then fanout "kiosk link off"; exit; fi
    KEY=$(od -An -tx1 -N32 /dev/urandom | tr -d ' \n')
    PEERS=""
    for i in "${SEL[@]}"; do PEERS="$PEERS ${ADDRS[$i]#*@}"; done
    echo "Linking ${#SEL[@]} displays so a hot corner on any of them toggles the blanket on all."
    fanout "kiosk link $KEY$PEERS" ;;

  reboot|shutdown)
    need_hosts; select_targets "${1:-all}"
    confirm "$cmd"
    fanout "kiosk $cmd" ;;

  url)
    need_hosts
    if [ $# -eq 0 ]; then select_targets all; fanout "kiosk url"; exit; fi
    is_target "$1" || die "usage: noc url TARGET URL   (e.g. noc url 2 https://grafana/d/abc)"
    select_targets "$1"
    if [ $# -eq 1 ]; then fanout "kiosk url"; exit; fi
    shift
    QU=""
    for u in "$@"; do
      [[ "$u" =~ ^https?:// ]] || die "URL must start with http:// or https://  ($u)"
      QU="$QU $(printf '%q' "$u")"
    done
    [ ${#SEL[@]} -gt 1 ] && confirm "Set every one to:$QU"
    fanout "kiosk url$QU" ;;

  rotate)
    need_hosts
    if [ $# -gt 0 ] && is_target "$1"; then select_targets "$1"; shift; else select_targets all; fi
    case "${1:-}" in
      every) [[ "${2:-}" =~ ^[0-9]+([.][0-9]+)?$ ]] || die "usage: noc rotate [TARGET] every MINUTES"
             fanout "kiosk rotate every $2" ;;
      off)   fanout "kiosk rotate off" ;;
      "")    fanout "kiosk rotate" ;;
      *)     die "usage: noc rotate [TARGET] [every MINUTES | off]" ;;
    esac ;;

  next)
    need_hosts; select_targets "${1:-all}"
    fanout "kiosk next" ;;

  run)
    need_hosts
    [ $# -ge 2 ] || die "usage: noc run TARGET 'command'"
    select_targets "$1"; shift
    fanout "$*" ;;

  ssh)
    need_hosts
    [ $# -ge 1 ] || die "usage: noc ssh TARGET"
    select_targets "$1"
    [ ${#SEL[@]} -eq 1 ] || die "pick one display for ssh"
    exec ssh -o StrictHostKeyChecking=accept-new "${ADDRS[${SEL[0]}]}" ;;

  update)
    need_hosts; select_targets "${1:-all}"
    for i in "${SEL[@]}"; do
      echo; echo "${B}== ${NAMES[$i]}${Z}  (sudo password for ${ADDRS[$i]%%@*} if asked)"
      ssh -t -o StrictHostKeyChecking=accept-new "${ADDRS[$i]}" \
        "curl -fsSL $NOC_INSTALL_URL | sudo bash -s --"   # keeps each display's dashboards and settings
    done
    echo; echo "Reboot to finish:  noc reboot ${1:-all}" ;;

  *)
    # allow 'noc 2' / 'noc noc-1' as shorthand for status
    load_hosts
    if [ ${#NAMES[@]} -gt 0 ] && is_target "$cmd"; then select_targets "$cmd"; fanout "kiosk status"; exit; fi
    die "unknown command '$cmd' (try: noc help)" ;;
esac
