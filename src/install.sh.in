#!/usr/bin/env bash
# =============================================================================
#  BCS NOC  -  Mac mini display provisioning for Ubuntu 26.04
#
#  One command, run on the mini (wired Ethernet plugged in):
#
#    curl -fsSL https://raw.githubusercontent.com/tc21094/bcs-noc-display/main/install.sh | sudo bash -s -- --url "https://your-dashboard"
#
#  What it does
#    1. Installs the Broadcom Wi-Fi driver (if a Broadcom card is present)
#    2. Installs the animated BCS NOC boot splash and 4K desktop wallpaper
#    3. With --url: sets the mini up as a fullscreen dashboard kiosk that the
#       'noc' command can control remotely (kiosk stop/start/url/reboot ...)
#
#  Options
#    --url URL       Dashboard to show fullscreen (enables kiosk setup). Repeat it
#                    for several dashboards to rotate through. Leave it out on a
#                    re-run to keep the display's current dashboards.
#    --rotate MIN    Rotate through the dashboards every MIN minutes (0 = off)
#    --name NAME     Set this display's hostname, e.g. noc-1
#    --interlude MIN Play the BCS NOC interlude over the dashboard every MIN
#                    minutes, on the clock (default 30; 0 = off)
#    --user NAME     Account that auto-logs in (default: the user who ran sudo)
#    --no-wifi       Skip the Broadcom driver step
#    --no-splash     Skip the boot splash / wallpaper step
#    --reboot        Reboot automatically when finished
#    --airplay       AirPlay: the whole wall as one AirPlay display (run on every
#                    display; then 'noc airplay on'). Kept on re-runs.
#    --gestures      Camera gesture control (USB webcam on this display): hand
#                    tracking, cursor, zoom, swipe between dashboards. Kept on
#                    re-runs once installed.
#
#  Safe to re-run (e.g. to change the dashboard URL).
# =============================================================================

BCS_NOC_VERSION="@@VERSION@@"

main() {
set -uo pipefail
export DEBIAN_FRONTEND=noninteractive

URL=""
ROTATE=""
NEW_NAME=""
INTERLUDE=""
KIOSK_USER="${SUDO_USER:-}"
DO_WIFI=1
DO_SPLASH=1
DO_REBOOT=0
DO_GESTURES=0
DO_AIRPLAY=0
THEME=bcs-noc
THEME_DIR=/usr/share/plymouth/themes/$THEME

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url)       URL="${URL:+$URL$'\n'}${2:-}"; shift 2 ;;
    --rotate)    ROTATE="${2:-}"; shift 2 ;;
    --user)      KIOSK_USER="${2:-}"; shift 2 ;;
    --name)      NEW_NAME="${2:-}"; shift 2 ;;
    --interlude) INTERLUDE="${2:-}"; shift 2 ;;
    --no-wifi)   DO_WIFI=0; shift ;;
    --no-splash) DO_SPLASH=0; shift ;;
    --reboot)    DO_REBOOT=1; shift ;;
    --gestures)  DO_GESTURES=1; shift ;;
    --airplay)   DO_AIRPLAY=1; shift ;;
    -h|--help)   sed -n '2,34p' "$0" 2>/dev/null || echo "See header of install.sh"; return 0 ;;
    *) echo "Unknown option: $1"; return 1 ;;
  esac
done

C_B=$'\e[1;34m'; C_G=$'\e[1;32m'; C_Y=$'\e[1;33m'; C_R=$'\e[1;31m'; C_0=$'\e[0m'
step() { echo; echo "${C_B}==>${C_0} $*"; }
ok()   { echo "    ${C_G}✓${C_0} $*"; }
warn() { echo "    ${C_Y}!${C_0} $*"; WARNINGS+=("$*"); }
die()  { echo "${C_R}ERROR:${C_0} $*"; exit 1; }
WARNINGS=()
# set a GNOME setting for a user: straight into their running desktop if logged in, else into their profile
user_gset() {
  local u="$1"; shift
  local bus; bus="/run/user/$(id -u "$u")/bus"
  if [[ -S "$bus" ]]; then
    runuser -u "$u" -- env DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" gsettings set "$@" </dev/null >/dev/null 2>&1
  else
    runuser -u "$u" -- dbus-run-session -- gsettings set "$@" </dev/null >/dev/null 2>&1
  fi
}
APT() { apt-get -y -q -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold "$@" </dev/null; }

[[ $EUID -eq 0 ]] || die "Run with sudo:  curl -fsSL <url> | sudo bash -s -- [options]"
. /etc/os-release 2>/dev/null
[[ "${ID:-}" == "ubuntu" ]] || die "This installer is for Ubuntu."
[[ "${VERSION_ID:-}" == "26.04" ]] || warn "Built for Ubuntu 26.04; this is ${PRETTY_NAME:-unknown}. Continuing."
# re-run without --url on a display that's already set up: keep its dashboards
if [[ -z "$URL" && -s /etc/bcs-noc-dashboard-url ]]; then
  URL=$(grep -v '^[[:space:]]*$' /etc/bcs-noc-dashboard-url)
  [[ -z "$KIOSK_USER" || "$KIOSK_USER" == root ]] && KIOSK_USER=$(cat /etc/bcs-noc-kiosk-user 2>/dev/null)
fi
if [[ -n "$URL" ]]; then
  [[ -n "$KIOSK_USER" && "$KIOSK_USER" != "root" ]] || die "Kiosk mode needs a normal user. Run with sudo from that user, or pass --user NAME."
  id "$KIOSK_USER" >/dev/null 2>&1 || die "User '$KIOSK_USER' does not exist."
  while IFS= read -r u; do
    [[ "$u" =~ ^https?:// ]] || die "--url must start with http:// or https://  ($u)"
  done <<<"$URL"
fi
if [[ -n "$INTERLUDE" && ! "$INTERLUDE" =~ ^[0-9]+$ ]]; then die "--interlude takes a number of minutes (0 = off)"; fi
if [[ -n "$ROTATE" && ! "$ROTATE" =~ ^[0-9]+([.][0-9]+)?$ ]]; then die "--rotate takes a number of minutes (0 = off)"; fi
NURL=$(grep -c . <<<"$URL"); FIRST_URL=$(head -n1 <<<"$URL")
URL_DESC="$FIRST_URL"; [[ $NURL -gt 1 ]] && URL_DESC="$FIRST_URL (+$((NURL - 1)) more)"
if [[ -n "$NEW_NAME" ]]; then
  [[ "$NEW_NAME" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]{0,62}$ ]] || die "--name may only use letters, numbers and dashes"
fi

echo "${C_B}BCS NOC display setup${C_0} $BCS_NOC_VERSION  (wifi=$DO_WIFI splash=$DO_SPLASH kiosk=$([[ -n $URL ]] && echo "$URL_DESC" || echo off))"

WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
base64 -d >"$WORK/payload.tgz" <<'__BCS_PAYLOAD__'
@@PAYLOAD@@
__BCS_PAYLOAD__
tar -xzf "$WORK/payload.tgz" -C "$WORK" || die "Embedded payload is corrupt (was the download cut off?)"

step "Updating package lists"
APT update >/dev/null && ok "apt updated" || warn "apt update had errors (check network)"
APT install pciutils >/dev/null

# ----------------------------------------------------------------------------- Name + tools
if [[ -n "$NEW_NAME" ]]; then
  step "Hostname"
  OLD_NAME=$(hostname)
  if [[ "$OLD_NAME" != "$NEW_NAME" ]]; then
    hostnamectl set-hostname "$NEW_NAME" 2>/dev/null || echo "$NEW_NAME" >/etc/hostname
    if grep -q '^127\.0\.1\.1' /etc/hosts; then
      sed -i -E "s/^127\.0\.1\.1.*/127.0.1.1\t$NEW_NAME/" /etc/hosts
    else
      printf '127.0.1.1\t%s\n' "$NEW_NAME" >>/etc/hosts
    fi
  fi
  ok "Hostname is $NEW_NAME"
fi
install -m 755 "$WORK/bin/noc" /usr/local/bin/noc

# ----------------------------------------------------------------------------- Wi-Fi
if [[ $DO_WIFI -eq 1 ]]; then
  step "Broadcom Wi-Fi driver"
  if lspci -nn | grep -iE 'network|wireless' | grep -q '14e4:'; then
    ok "Found: $(lspci | grep -iE 'network controller' | grep -i broadcom | head -1 | cut -d: -f3- | xargs)"
    if lsmod | grep -q '^wl '; then
      ok "Driver already loaded"
    else
      rm -f /var/crash/broadcom-sta-dkms* 2>/dev/null
      if APT install "linux-headers-$(uname -r)" dkms broadcom-sta-dkms; then
        modprobe -r b43 bcma ssb brcmsmac 2>/dev/null
        if modprobe wl 2>/dev/null; then ok "Driver installed and loaded"
        else warn "Driver installed; it will load after reboot"; fi
      else
        warn "broadcom-sta-dkms failed to build. Build log:"
        tail -20 /var/lib/dkms/broadcom-sta/*/build/make.log 2>/dev/null | sed 's/^/      /'
      fi
    fi
  else
    ok "No Broadcom wireless card found, skipping"
  fi
fi

# ----------------------------------------------------------------------------- Splash
if [[ $DO_SPLASH -eq 1 ]]; then
  step "BCS NOC boot splash"
  APT install plymouth >/dev/null || warn "Could not install plymouth"

  rm -rf "$THEME_DIR"
  mkdir -p "$THEME_DIR"
  cp -r "$WORK/theme/." "$THEME_DIR/"
  chmod -R a+rX "$THEME_DIR"
  install -m 644 "$WORK/wallpaper.jpg" /usr/share/backgrounds/bcs-noc.jpg
  ok "Theme files installed ($(ls "$THEME_DIR" | wc -l) files)"

  update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
      "$THEME_DIR/$THEME.plymouth" 300 >/dev/null
  update-alternatives --set default.plymouth "$THEME_DIR/$THEME.plymouth" >/dev/null
  ok "Set as default boot theme"

  # make sure the kernel is told to show a splash
  if [[ -f /etc/default/grub ]] && ! grep -qE '^GRUB_CMDLINE_LINUX_DEFAULT=.*\bsplash\b' /etc/default/grub; then
    sed -i -E 's/^(GRUB_CMDLINE_LINUX_DEFAULT=")/\1quiet splash /' /etc/default/grub
    update-grub >/dev/null 2>&1 && ok "Added 'quiet splash' to the boot options" || warn "update-grub failed"
  fi

  echo "    rebuilding initramfs (takes a minute)..."
  if update-initramfs -u -k all >/dev/null 2>&1; then
    INITRD=/boot/initrd.img-$(uname -r)
    if command -v lsinitrd >/dev/null && lsinitrd "$INITRD" 2>/dev/null | grep -q "themes/$THEME/"; then
      ok "Splash is in the boot image"
    elif command -v lsinitramfs >/dev/null && lsinitramfs "$INITRD" 2>/dev/null | grep -q "themes/$THEME/"; then
      ok "Splash is in the boot image"
    else
      warn "Could not confirm the splash is in the boot image; check after reboot"
    fi
  else
    warn "initramfs rebuild failed; run 'sudo update-initramfs -u -k all' manually"
  fi

  # branded wallpaper + lock/login background (system default for every user)
  cat >/usr/share/glib-2.0/schemas/95-bcs-noc-branding.gschema.override <<'EOF'
[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/bcs-noc.jpg'
picture-uri-dark='file:///usr/share/backgrounds/bcs-noc.jpg'
picture-options='zoom'
primary-color='#070d1c'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/bcs-noc.jpg'
EOF
  glib-compile-schemas /usr/share/glib-2.0/schemas/
  WP_USER="${KIOSK_USER:-}"
  if [[ -n "$WP_USER" && "$WP_USER" != root ]] && id "$WP_USER" >/dev/null 2>&1; then
    user_gset "$WP_USER" org.gnome.desktop.background picture-uri 'file:///usr/share/backgrounds/bcs-noc.jpg'
    user_gset "$WP_USER" org.gnome.desktop.background picture-uri-dark 'file:///usr/share/backgrounds/bcs-noc.jpg'
    user_gset "$WP_USER" org.gnome.desktop.background picture-options 'zoom'
    user_gset "$WP_USER" org.gnome.desktop.screensaver picture-uri 'file:///usr/share/backgrounds/bcs-noc.jpg'
  fi
  ok "Wallpaper set"
fi

# ----------------------------------------------------------------------------- Kiosk
if [[ -n "$URL" ]]; then
  step "Dashboard kiosk for user '$KIOSK_USER'"
  KHOME=$(getent passwd "$KIOSK_USER" | cut -d: -f6)

  if ! command -v google-chrome >/dev/null 2>&1; then
    if wget -qO /tmp/chrome.deb https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb \
       && APT install /tmp/chrome.deb >/dev/null; then ok "Google Chrome installed"
    else warn "Google Chrome install failed"; fi
    rm -f /tmp/chrome.deb
  else
    ok "Google Chrome already installed"
  fi

  APT install openssh-server >/dev/null && ok "SSH server installed"

  GDM_CONF=/etc/gdm3/custom.conf
  if [[ -f $GDM_CONF ]]; then
    [[ -f "$GDM_CONF.bak" ]] || cp "$GDM_CONF" "$GDM_CONF.bak"
    sed -i -E '/^#?\s*AutomaticLogin(Enable)?\s*=/d' "$GDM_CONF"
    sed -i "/^\[daemon\]/a AutomaticLoginEnable = true\nAutomaticLogin = $KIOSK_USER" "$GDM_CONF"
    ok "Auto-login enabled"
  else
    warn "$GDM_CONF not found; enable automatic login in Settings > Users"
  fi

  # no blanking, no lock, no sleep, no banners - as system defaults and for this user
  cat >/usr/share/glib-2.0/schemas/96-bcs-noc-kiosk.gschema.override <<'EOF'
[org.gnome.desktop.session]
idle-delay=uint32 0

[org.gnome.desktop.screensaver]
lock-enabled=false
idle-activation-enabled=false

[org.gnome.desktop.lockdown]
disable-lock-screen=true

[org.gnome.settings-daemon.plugins.power]
sleep-inactive-ac-type='nothing'
idle-dim=false

[org.gnome.desktop.notifications]
show-banners=false
EOF
  glib-compile-schemas /usr/share/glib-2.0/schemas/
  user_gset "$KIOSK_USER" org.gnome.desktop.session idle-delay 0
  user_gset "$KIOSK_USER" org.gnome.desktop.screensaver lock-enabled false
  user_gset "$KIOSK_USER" org.gnome.desktop.screensaver idle-activation-enabled false
  user_gset "$KIOSK_USER" org.gnome.desktop.lockdown disable-lock-screen true
  user_gset "$KIOSK_USER" org.gnome.settings-daemon.plugins.power sleep-inactive-ac-type nothing
  user_gset "$KIOSK_USER" org.gnome.settings-daemon.plugins.power idle-dim false
  user_gset "$KIOSK_USER" org.gnome.desktop.notifications show-banners false
  ok "Screen blanking, lock and sleep disabled"

  # quiet the update / crash popups (security updates still install in the background)
  sed -i 's/^enabled=1/enabled=0/' /etc/default/apport 2>/dev/null
  systemctl disable --now apport.service >/dev/null 2>&1
  install -d -o "$KIOSK_USER" -g "$KIOSK_USER" "$KHOME/.config/autostart"
  if [[ -f /etc/xdg/autostart/update-notifier.desktop ]]; then
    { cat /etc/xdg/autostart/update-notifier.desktop; echo "Hidden=true"; } >"$KHOME/.config/autostart/update-notifier.desktop"
  fi
  ok "Update and crash popups silenced"

  # dashboard URL: owned by the kiosk user so 'kiosk url' / 'noc url' can change it without sudo
  printf '%s\n' "$URL" >/etc/bcs-noc-dashboard-url
  chown "$KIOSK_USER:" /etc/bcs-noc-dashboard-url
  chmod 644 /etc/bcs-noc-dashboard-url
  echo "$KIOSK_USER" >/etc/bcs-noc-kiosk-user
  # rotation interval: keep the current setting on re-runs unless --rotate is given
  if [[ -n "$ROTATE" ]]; then echo "$ROTATE" >/etc/bcs-noc-rotate
  elif [[ ! -f /etc/bcs-noc-rotate ]]; then echo 0 >/etc/bcs-noc-rotate; fi
  chown "$KIOSK_USER:" /etc/bcs-noc-rotate
  chmod 644 /etc/bcs-noc-rotate

  APT install python3 >/dev/null
  install -m 755 "$WORK/bin/kiosk-launch" /usr/local/bin/kiosk-launch
  install -m 755 "$WORK/bin/kiosk" /usr/local/bin/kiosk
  install -d /usr/local/share/bcs-noc
  install -m 644 "$WORK/share/interlude.js" /usr/local/share/bcs-noc/interlude.js
  install -m 644 "$WORK/share/blanket.html" /usr/local/share/bcs-noc/blanket.html
  install -m 644 "$WORK/share/gesture.js" /usr/local/share/bcs-noc/gesture.js
  install -m 755 "$WORK/bin/bcs-gesture" /usr/local/bin/bcs-gesture

  # AirPlay wall (--airplay, or kept on re-runs once installed): every display gets the player,
  # the receiver runs where 'kiosk airplay on' says
  [[ -f /etc/bcs-noc-airplay ]] && DO_AIRPLAY=1
  if [[ $DO_AIRPLAY -eq 1 ]]; then
    step "AirPlay wall"
    if APT install uxplay avahi-daemon avahi-utils bluez python3-dbus python3-psutil python3-gi gir1.2-gstreamer-1.0 gir1.2-gst-plugins-base-1.0 \
         gstreamer1.0-plugins-base gstreamer1.0-plugins-good gstreamer1.0-plugins-bad gstreamer1.0-plugins-ugly \
         gstreamer1.0-libav gstreamer1.0-vaapi >/dev/null 2>&1; then ok "UxPlay and video playback installed"
    else warn "Could not install UxPlay / GStreamer (apt install uxplay)"; fi
    install -m 755 "$WORK/bin/bcs-airplay" /usr/local/bin/bcs-airplay
    install -m 755 "$WORK/bin/bcs-wallplayer" /usr/local/bin/bcs-wallplayer
    # UxPlay's Bluetooth LE beacon (LGPL, see NOTICE): announces the wall to Apple devices in the room
    install -d /usr/local/lib/bcs-noc/uxplay-beacon
    install -m 644 "$WORK"/third_party/uxplay-beacon/* /usr/local/lib/bcs-noc/uxplay-beacon/
    command -v rfkill >/dev/null && rfkill unblock bluetooth 2>/dev/null
    if [[ -f /etc/bluetooth/main.conf ]] && ! grep -q '^AutoEnable=true' /etc/bluetooth/main.conf; then
      sed -i 's/^#\?AutoEnable=.*/AutoEnable=true/' /etc/bluetooth/main.conf
      grep -q '^AutoEnable=true' /etc/bluetooth/main.conf || printf '\n[Policy]\nAutoEnable=true\n' >>/etc/bluetooth/main.conf
    fi
    systemctl enable --now bluetooth >/dev/null 2>&1
    if bluetoothctl list 2>/dev/null | grep -q Controller; then ok "Bluetooth adapter found (the wall is also announced over Bluetooth)"
    else warn "No Bluetooth adapter found; the wall is announced on the network only (a USB Bluetooth 4.0+ dongle adds it)"; fi
    for u in airplay wallplayer; do
      desc=$([[ $u == airplay ]] && echo "BCS NOC AirPlay receiver (whole wall)" || echo "BCS NOC AirPlay wall player")
      printf '[Unit]\nDescription=%s\nAfter=graphical-session.target\nPartOf=graphical-session.target\n\n[Service]\nExecStart=/usr/local/bin/bcs-%s\nRestart=always\nRestartSec=5\n' \
        "$desc" "$u" >/etc/systemd/user/bcs-$u.service
    done
    systemctl enable --now avahi-daemon >/dev/null 2>&1
    if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
      ufw allow 5353/udp comment 'mDNS (AirPlay discovery)' >/dev/null
      ufw allow 7000,7001,7100/tcp comment 'AirPlay (UxPlay)' >/dev/null
      ufw allow 6000,6001,7011/udp comment 'AirPlay (UxPlay)' >/dev/null
      ufw allow 47600:47603/udp comment 'BCS NOC AirPlay wall' >/dev/null
      ok "Firewall: AirPlay ports allowed"
    fi
    echo installed >/etc/bcs-noc-airplay
    ok "AirPlay wall player ready (turn the receiver on with: noc airplay on)"
  fi

  # camera gestures (--gestures, or kept on re-runs once installed)
  [[ -f /etc/bcs-noc-gestures ]] && DO_GESTURES=1
  if [[ $DO_GESTURES -eq 1 ]]; then
    step "Camera gestures"
    GV=/opt/bcs-noc/gesture
    APT install python3-venv v4l-utils >/dev/null 2>&1 || warn "Could not install python3-venv"
    [[ -x $GV/bin/python3 ]] || python3 -m venv "$GV" >/dev/null 2>&1 || warn "Could not create $GV"
    if [[ -x $GV/bin/pip ]] && "$GV/bin/pip" install -q --disable-pip-version-check "mediapipe==1.2.2" >"$WORK/pip.log" 2>&1; then
      ok "Hand tracking (MediaPipe) installed"
    else
      warn "Could not install MediaPipe (see: $GV/bin/pip install mediapipe==1.2.2)"
    fi
    MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/latest/hand_landmarker.task
    if curl -fsSL --retry 3 -o "$WORK/hand.task" "$MODEL_URL" && [[ $(stat -c %s "$WORK/hand.task") -gt 1000000 ]]; then
      install -m 644 "$WORK/hand.task" "$GV/hand_landmarker.task"; ok "Hand model downloaded"
    elif [[ -s $GV/hand_landmarker.task ]]; then
      ok "Hand model already present"
    else
      warn "Could not download the hand model ($MODEL_URL)"
    fi
    # Google's trained gesture classifier (Open_Palm, Closed_Fist ...): recognises palms more reliably
    GR_URL=https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/latest/gesture_recognizer.task
    if curl -fsSL --retry 3 -o "$WORK/gr.task" "$GR_URL" 2>/dev/null && [[ $(stat -c %s "$WORK/gr.task") -gt 1000000 ]]; then
      install -m 644 "$WORK/gr.task" "$GV/gesture_recognizer.task"; ok "Gesture classifier downloaded"
    elif [[ -s $GV/gesture_recognizer.task ]]; then ok "Gesture classifier already present"
    else warn "Could not download the gesture classifier ($GR_URL); using the hand tracker alone"; fi
    usermod -aG video "$KIOSK_USER"                     # camera access (takes effect at next login)
    cat >/etc/systemd/user/bcs-gesture.service <<'EOF'
[Unit]
Description=BCS NOC camera gestures
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/bcs-gesture
Restart=always
RestartSec=5
Nice=5
CPUQuota=110%
EOF
    install -d -o "$KIOSK_USER" -g "$KIOSK_USER" "$KHOME/.config/bcs-noc"
    [[ -f /etc/bcs-noc-gestures ]] || touch "$KHOME/.config/bcs-noc/gestures-on"   # first install: turn it on
    chown "$KIOSK_USER:" "$KHOME/.config/bcs-noc/gestures-on" 2>/dev/null
    echo installed >/etc/bcs-noc-gestures
    if ls /dev/video* >/dev/null 2>&1; then ok "Camera found: $(ls /dev/video* | head -n1)"
    else warn "No camera found yet; plug in a USB webcam (gestures start once it's there)"; fi
    ok "Gestures on at next login (turn off: kiosk gestures off)"
  fi

  # BCS NOC interlude schedule: keep the current setting on re-runs unless --interlude is given
  if [[ -n "$INTERLUDE" ]]; then
    echo "$INTERLUDE 12" >/etc/bcs-noc-interlude
  elif [[ ! -f /etc/bcs-noc-interlude ]]; then
    echo "30 12" >/etc/bcs-noc-interlude
  fi
  chown "$KIOSK_USER:" /etc/bcs-noc-interlude
  chmod 644 /etc/bcs-noc-interlude
  # hot corner messages between displays (only matters if the firewall is turned on)
  if command -v ufw >/dev/null && ufw status 2>/dev/null | grep -q "Status: active"; then
    ufw allow 47474/udp comment 'BCS NOC hot corner' >/dev/null && ok "Firewall: allowed hot corner messages (UDP 47474)"
  fi
  IL=$(awk '{print $1}' /etc/bcs-noc-interlude)
  if [[ $IL == 0 ]]; then ok "Interlude off"; else ok "BCS NOC interlude every $IL minutes (on the clock)"; fi

  # Chrome runs as a systemd user service: restarted if it crashes, stopped cleanly by 'kiosk stop'
  mkdir -p /etc/systemd/user
  cat >/etc/systemd/user/bcs-kiosk.service <<'EOF'
[Unit]
Description=BCS NOC dashboard (fullscreen Chrome)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=/usr/local/bin/kiosk-launch
Restart=always
RestartSec=5
EOF
  cat >"$KHOME/.config/autostart/kiosk.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=BCS NOC Dashboard
Exec=/usr/local/bin/kiosk autostart
X-GNOME-Autostart-enabled=true
EOF
  chown -R "$KIOSK_USER:" "$KHOME/.config/autostart"

  # let the kiosk user reboot / power off without a password (for 'noc reboot')
  SC=$(command -v systemctl)
  printf '%s ALL=(root) NOPASSWD: %s reboot --ignore-inhibitors, %s poweroff --ignore-inhibitors\n' "$KIOSK_USER" "$SC" "$SC" >"$WORK/sudoers"
  if visudo -cf "$WORK/sudoers" >/dev/null 2>&1; then
    install -m 440 "$WORK/sudoers" /etc/sudoers.d/bcs-noc
  else
    warn "Could not add the reboot permission; 'noc reboot' will not work on this display"
  fi
  ok "Kiosk shows $URL_DESC at login (control it with: kiosk help)"
  if [[ $NURL -gt 1 ]]; then
    RM=$(cat /etc/bcs-noc-rotate)
    if [[ $RM =~ ^0*([.]0*)?$ ]]; then ok "Rotation off ('kiosk rotate every N' to turn it on; 'kiosk next' switches by hand)"
    else ok "Rotating $NURL dashboards every $RM minutes"; fi
  fi

  cat >/etc/systemd/system/macmini-autopower.service <<'EOF'
[Unit]
Description=Mac mini: power back on automatically after a power loss

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'lspci -n -s 00:1f.0 | grep -q " 8086:" && setpci -s 0:1f.0 0xa4.b=0 || true'

[Install]
WantedBy=multi-user.target
EOF
  systemctl daemon-reload >/dev/null 2>&1
  systemctl enable --now macmini-autopower.service >/dev/null 2>&1 && ok "Auto power-on after outage enabled"

  # GNOME holds a shutdown inhibitor while logged in, so reboots must ignore it
  echo "0 4 * * * root $(command -v systemctl) reboot --ignore-inhibitors" >/etc/cron.d/kiosk-reboot
  ok "Nightly reboot at 4:00 AM"
fi

# ----------------------------------------------------------------------------- done
echo "$BCS_NOC_VERSION" >/etc/bcs-noc-version
echo
if [[ -n "$URL" ]]; then
  IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<NF;i++) if($i=="src"){print $(i+1); exit}}')
  echo "Register this display with noc on your admin machine:"
  echo "    noc add ${NEW_NAME:-$(hostname -s)} $KIOSK_USER@${IP:-<this-ip>}"
  echo
fi
if [[ ${#WARNINGS[@]} -gt 0 ]]; then
  echo "${C_Y}Finished with ${#WARNINGS[@]} warning(s):${C_0}"
  for w in "${WARNINGS[@]}"; do echo "  - $w"; done
else
  echo "${C_G}All done.${C_0}"
fi
if [[ $DO_REBOOT -eq 1 ]]; then
  echo "Rebooting in 5 seconds..."; sleep 5; systemctl reboot --ignore-inhibitors
else
  echo "Reboot to see the new splash${URL:+ and start the kiosk}:  sudo systemctl reboot -i"
fi
}

# Everything lives in main() so bash reads the whole script before running it.
# That keeps 'curl ... | sudo bash' safe if a command reads from stdin.
main "$@"
