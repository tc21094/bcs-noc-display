      var n1 = i ? nrm(a, q) : nrm(q, r), n2 = i < p.length - 1 ? nrm(q, r) : n1;
      var nx = n1[0] + n2[0], ny = n1[1] + n2[1], l = Math.hypot(nx, ny) || 1;
      nx /= l; ny /= l;
      var ch = nx * n1[0] + ny * n1[1] || 1;
      out.push([q[0] + nx * o / ch, q[1] + ny * o / ch]);
    }
    return out;
  }
  function inPanel(x, y) { return x > panel.x0 && x < panel.x1 && y > panel.y0 - 30 && y < panel.y1 + 30; }
  function route(x, y, base, first) {
    var pts = [[x, y]], dir = base, step = Math.PI / 4, k = 0;
    x += Math.cos(dir) * first; y += Math.sin(dir) * first; pts.push([x, y]);
    while (k++ < 40) {
      var len = D * rnd(0.05, 0.15);
      dir = dir !== base ? base : [base - step, base, base + step][(Math.random() * 3) | 0];
      var nx = x + Math.cos(dir) * len, ny = y + Math.sin(dir) * len;
      if (inPanel(nx, ny)) { dir = base; nx = x + Math.cos(dir) * len; ny = y + Math.sin(dir) * len; }   // keep the lettering clear
      x = nx; y = ny; pts.push([x, y]);
      if (x < -MG - 30 || x > VW + MG + 30 || y < -MG - 30 || y > VH + MG + 30) break;
    }
    return pts;
  }
  function lane(pts) {
    pts = pts.slice().reverse();
    var L = [0];
    for (var i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    var ln = { p: pts, L: L, len: L[L.length - 1], pulses: [] };
    ln.g1 = ln.len - C.gapOut; ln.g0 = ln.len - C.gapIn;
    var n = 1 + (Math.random() < 0.35 ? 1 : 0);
    for (var j = 0; j < n; j++) ln.pulses.push({ s: -rnd(0, 1.3) * ln.g1, v: D * rnd(0.3, 0.65), ci: (Math.random() * 4) | 0 });
    return ln;
  }
  function at(ln, s) {
    var L = ln.L, p = ln.p;
    if (s <= 0) return p[0];
    if (s >= ln.len) return p[p.length - 1];
