      if (cp < pop) { HX = bp.X + off; lift = cp >= 156 && cp < 163.5 ? 80 * U * Math.sin(tgSeg(cp, 156, 163.5) * Math.PI) * (hI ? 0.8 : 1) : 0; if (lift > 2) pose = "lift"; }
      else if (cp < 197) { var rX = tgW(tgSt(w).house, w) + TG_HW * VW * (hI ? 0.62 : 0.12); HX = tgLerp(bp.X + off, rX, tgSeg(cp, pop, 197)); pose = "run"; }
      else if (cp < 212) { HX = tgW(tgSt(w).house, w) + TG_HW * VW * (hI ? 0.62 : 0.12); pose = "look"; fc = hI ? -1 : 1; }
      else { HX = tgW(tgSt(w).house, w) + TG_HW * VW * (hI ? 0.62 : 0.12) + tgSeg(cp, 212, 226) * 0.5 * VW; }
