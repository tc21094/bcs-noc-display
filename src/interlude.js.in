    if (cp < 300) return { X: tgLerp(start, trip, tgSeg(cp, 284, 300)), pose: "chase", face: 1 };
    if (cp < 300.6) { var u = tgSeg(cp, 300, 300.6); return { X: trip + 0.02 * VW * u, pose: "trip", face: 1, rot: 1.4 * u, y: -50 * U * Math.sin(u * Math.PI) }; }
    if (cp < 303.2) return { X: trip + 0.02 * VW + 0.015 * VW * tgSeg(cp, 300.6, 301.3), pose: "flat", face: 1, rot: 1.45 };
    if (cp < 306) return { X: trip + 0.035 * VW, pose: "dazed", face: 1 };
    if (cp < 328) return { X: tgLerp(trip + 0.035 * VW, P - 0.03 * VW, tgSeg(cp, 306, 328)), pose: "chase", face: 1 };
    if (cp < 336) return { X: P - 0.03 * VW, pose: "stand", face: Math.sin(cp * 2.2) > 0 ? 1 : -1, mark: "?" };
    if (cp < 339) return { X: P - 0.03 * VW, pose: cp >= 337.5 ? "box" : "stand", face: 1 };
