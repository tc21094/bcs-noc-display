  function tgUncle(cp, now, w) {
    var u = uncleAt(cp, w);
    if (!u) return;
    var o = tgUncleLook({ face: u.face, walk: u.walk, ph: now * 8 }), X = u.X, p = tgLastPass(cp, w), burst = null;
    if (!u.walk && p) {
      var age = cp - p.land, fly = cp >= p.t0 && cp < p.land;
      if (p.kind === "catch") {
        if (fly && p.land - cp < 0.8) { o.L = [-30, -110]; o.R = [-24, -116]; }
        else if (age >= 0 && age < 1.4) { o.L = [-10, -150]; o.R = [10, -152]; o.mouth = "o"; o.held = function () { tgFootball(0, -158, 0, 1); }; }
        else if (age >= 1.4 && age < 3.2) { o.lean = 0.2 * Math.sin(now * 12); o.L = [-28, -120 + 20 * Math.sin(now * 12)]; o.R = [28, -120 - 20 * Math.sin(now * 12)]; o.mouth = "smile"; }
      } else if (p.kind === "bonk") {
