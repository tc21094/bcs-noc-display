    var walking = cp < 12 || cp >= KID_OUT, hitT = cp >= FIGHT0 && cp < FIGHT1 + 5 ? hitAt(true, i, w, now) : -1;
    var throwing = cp >= FIGHT0 && cp < FIGHT1 && Math.floor((cp - FIGHT0) / THROW) % 2 === 0 && (Math.floor((cp - FIGHT0) / THROW) >> 1) % 2 === i && ((cp - FIGHT0) % THROW) < 0.35;
    c.save(); c.translate(x, gy); c.scale(U * 1.6, U * 1.6);
    if (hitT >= 0 && hitT < 1.2) c.rotate(-Math.min(1.4, hitT * 6));                     // knocked flat on his back
    var bob = walking ? Math.abs(Math.sin(now * 10)) * 3 : 0, face = cp >= KID_OUT ? -1 : 1;
    c.scale(face, 1);
    c.strokeStyle = "#2b3550"; c.lineWidth = 7; c.lineCap = "round";
    var st = walking ? Math.sin(now * 10) * 8 : 0;
    c.beginPath(); c.moveTo(-4, -24 - bob); c.lineTo(-5 + st, 0); c.moveTo(4, -24 - bob); c.lineTo(5 - st, 0); c.stroke();
    c.fillStyle = k.coat; rr(-12, -56 - bob, 24, 34, 9); c.fill();
    var arm = throwing ? -2.4 + ((cp - FIGHT0) % THROW) / 0.35 * 2.6 : walking ? Math.sin(now * 10) * 0.6 : 0.3;
    c.strokeStyle = k.coat; c.lineWidth = 7;
    c.beginPath(); c.moveTo(8, -48 - bob); c.lineTo(8 + Math.sin(arm) * 18, -48 - bob - Math.cos(arm) * 18); c.moveTo(-8, -48 - bob); c.lineTo(-14, -30 - bob); c.stroke();
    c.fillStyle = "#f1c9a5"; c.beginPath(); c.arc(0, -66 - bob, 10, 0, 6.283); c.fill();
    c.fillStyle = k.hat; c.beginPath(); c.arc(0, -68 - bob, 10.5, Math.PI, 0); c.fill(); c.beginPath(); c.arc(0, -80 - bob, 4, 0, 6.283); c.fill();
    c.fillStyle = "#1b1b1b"; c.beginPath(); c.arc(5, -66 - bob, 1.6, 0, 6.283); c.fill();
    c.restore();
  }
  function snowman(j, now, w) {
    if (w.pos !== w.n) return;
    var cp = now % PLOW_P;
    if (cp < BOOT) return;
    var X = snowmanX(j, w), xl = X - (w.n - 1) * VW * (1 + w.gp), sc = U * 1.6;
    // the plow: once the blade reaches him he gets shoved along in front of it, then buried in the pile
    var front = cp >= PLOW_AT ? (cp - PLOW_AT) * (VW / PLOW_T) - PLOW_LEN : -1e9, shoved = front - X;
    if (shoved > 0.3 * VW) return;
    var pushing = shoved > -10 * U;
    if (pushing) xl += shoved + 10 * U;
    var grow = cl((cp - BOOT) / 4), gy = VH - groundAt(X, now) + (pushing ? 30 * U * cl(shoved / (0.3 * VW)) : 0);
    var hitT = cp >= FIGHT0 && cp < FIGHT1 + 5 ? hitAt(false, j, w, now) : -1;
    c.save(); c.translate(xl, gy); c.scale(sc, sc * grow);
    if (pushing) c.rotate(-0.25 - 0.4 * cl(shoved / (0.3 * VW)));
    c.fillStyle = "#f7fbff"; c.strokeStyle = "rgba(150,175,205,.6)"; c.lineWidth = 2;
    c.beginPath(); c.arc(0, -26, 28, 0, 6.283); c.fill(); c.stroke();
    c.beginPath(); c.arc(0, -70, 21, 0, 6.283); c.fill(); c.stroke();
