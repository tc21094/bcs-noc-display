    else if (cp >= 20 && cp < 39) { tgCrow(perch[0], perch[1], 0, U * 1.2, cp > 30 && cp < 34 ? -1 : 1); if (cp >= 38.2) tgMark(perch[0] + 6 * U, perch[1] - 54 * U, "!"); }
    else if (cp >= 39 && cp < 43) { var v = tgSeg(cp, 39, 43); tgCrow(perch[0] + v * 0.4 * VW, perch[1] - v * VH * 0.5 - 20 * U * Math.sin(v * 9), Math.abs(Math.sin(now * 26)), U * 1.2, 1);
      for (var fe = 0; fe < 2; fe++) { c.fillStyle = "#16161c"; c.save(); c.translate(perch[0] + fe * 14 * U + Math.sin(now * 3 + fe) * 10 * U, perch[1] + v * 120 * U); c.rotate(now * 2 + fe); c.beginPath(); c.ellipse(0, 0, 8 * U, 2.5 * U, 0, 0, 6.283); c.fill(); c.restore(); } }
  }

  // ---- the parade balloon and its handlers
  function tgBalloonShape(x, y, sc, rot, eyesX) {
    c.save(); c.translate(x, y); c.rotate(rot); c.scale(sc * U, sc * U);
    var LOBE = ["#d62839", "#ef8a1f", "#f4c430", "#e06a2b", "#b5452c", "#f4c430", "#ef8a1f"];
    for (var i = 0; i < 7; i++) { var a = -Math.PI * 0.98 + i * (Math.PI * 0.78 / 6); c.fillStyle = LOBE[i];
      c.beginPath(); c.arc(-14 + Math.cos(a) * 74, -6 + Math.sin(a) * 74, 30, 0, 6.283); c.fill(); }
    var g = c.createRadialGradient(-20, -30, 10, 0, 0, 70); g.addColorStop(0, "#a8653a"); g.addColorStop(1, "#6e3a1e");
    c.fillStyle = g; c.beginPath(); c.arc(0, 0, 62, 0, 6.283); c.fill();
    c.strokeStyle = "rgba(255,255,255,.18)"; c.lineWidth = 3; for (var s = -1; s <= 1; s++) { c.beginPath(); c.ellipse(0, 0, 62 * (0.35 + 0.3 * Math.abs(s)), 62, 0, -1.3, 1.3); c.stroke(); }
    c.fillStyle = "#c9d3e0"; c.beginPath(); c.arc(50, -50, 26, 0, 6.283); c.fill();
    c.fillStyle = "#fff"; c.beginPath(); c.arc(50, -56, 10, 0, 6.283); c.arc(66, -54, 9, 0, 6.283); c.fill();
    c.fillStyle = "#111"; if (eyesX) { c.strokeStyle = "#111"; c.lineWidth = 3; [[50, -56], [66, -54]].forEach(function (e) { c.beginPath(); c.moveTo(e[0] - 5, e[1] - 5); c.lineTo(e[0] + 5, e[1] + 5); c.moveTo(e[0] + 5, e[1] - 5); c.lineTo(e[0] - 5, e[1] + 5); c.stroke(); }); }
    else { c.beginPath(); c.arc(53, -55, 4, 0, 6.283); c.arc(68, -53, 4, 0, 6.283); c.fill(); }
    c.fillStyle = "#e0952e"; c.beginPath(); c.moveTo(72, -44); c.lineTo(92, -38); c.lineTo(72, -32); c.closePath(); c.fill();
    c.fillStyle = "#d62839"; c.beginPath(); c.ellipse(70, -26, 6, 11, 0, 0, 6.283); c.fill();
    c.fillStyle = "#e08a2e"; c.fillRect(-18, 56, 8, 16); c.fillRect(10, 56, 8, 16);
    c.fillStyle = "rgba(255,255,255,.22)"; c.beginPath(); c.ellipse(-24, -30, 18, 10, -0.6, 0, 6.283); c.fill();
    c.restore();
  }
  function tgFlatBalloon(bx, pk, hw, wt) {     // deflated, draped over the ridge of the roof
    c.fillStyle = "#7a4424"; c.beginPath(); c.moveTo(bx - hw * 0.3, pk + (wt - pk) * 0.62);           // a limp skin over the ridge
    c.lineTo(bx - 6 * U, pk - 6 * U); c.quadraticCurveTo(bx, pk - 10 * U, bx + 6 * U, pk - 6 * U); c.lineTo(bx + hw * 0.32, pk + (wt - pk) * 0.66);
    c.quadraticCurveTo(bx + hw * 0.2, pk + (wt - pk) * 0.82, bx + hw * 0.1, pk + (wt - pk) * 0.5);
    c.quadraticCurveTo(bx - hw * 0.05, pk + (wt - pk) * 0.85, bx - hw * 0.16, pk + (wt - pk) * 0.6);
    c.quadraticCurveTo(bx - hw * 0.24, pk + (wt - pk) * 0.8, bx - hw * 0.3, pk + (wt - pk) * 0.62); c.fill();
    c.strokeStyle = "rgba(255,255,255,.2)"; c.lineWidth = 2 * U; c.beginPath(); c.moveTo(bx - hw * 0.22, pk + (wt - pk) * 0.5); c.lineTo(bx - 4 * U, pk); c.lineTo(bx + hw * 0.22, pk + (wt - pk) * 0.5); c.stroke();
    var LOBE = ["#d62839", "#ef8a1f", "#f4c430", "#e06a2b"];
    for (var i = 0; i < 4; i++) { c.fillStyle = LOBE[i]; c.beginPath(); c.ellipse(bx - hw * 0.25 + i * 14 * U, pk + (wt - pk) * (0.62 + i * 0.08), 13 * U, 26 * U, 0.5, 0, 6.283); c.fill(); }
    c.fillStyle = "#c9d3e0"; c.beginPath(); c.ellipse(bx + hw * 0.27, pk + (wt - pk) * 0.72, 22 * U, 12 * U, 0.6, 0, 6.283); c.fill();
    c.strokeStyle = "#111"; c.lineWidth = 2.5 * U; var ex = bx + hw * 0.27, ey = pk + (wt - pk) * 0.7;
    c.beginPath(); c.moveTo(ex - 4 * U, ey - 4 * U); c.lineTo(ex + 4 * U, ey + 4 * U); c.moveTo(ex + 4 * U, ey - 4 * U); c.lineTo(ex - 4 * U, ey + 4 * U); c.stroke();
  }
  function tgBalloonPos(cp, w) {
    var hd = tgHD(), X1 = tgChim(w), chimTop = VH - hd.hh - hd.rh * 0.75 - 40 * U, y0 = VH * 0.17;
    var X = tgLerp(-0.3 * VW, X1 - 30 * U, tgSeg(cp, BAL0, BAL_SNAG)), y = y0 + 9 * U * Math.sin(cp * 0.9);
    if (cp > BAL_SNAG - 9) y = tgLerp(y, chimTop - 60 * U, ease(tgSeg(cp, BAL_SNAG - 9, BAL_SNAG)));
    return { X: X, y: y };
  }
  function tgParade(cp, now, w) {
    if (cp < BAL0 || cp >= 226) return;
    var hd = tgHD(), pop = BAL_SNAG + 0.6, ropeY = null, bp = tgBalloonPos(Math.min(cp, pop), w);
    // the balloon
    if (cp < pop) {
      var x = tgL(bp.X, w);
      if (x > -300 * U && x < VW + 300 * U) {
        tgBalloonShape(x, bp.y, 1, 0.05 * Math.sin(cp * 0.7), false);
        ropeY = bp.y + 60 * U;
        if (cp >= BAL_SNAG) { c.strokeStyle = "#ffffff"; c.lineWidth = 4 * U; for (var r = 0; r < 8; r++) { var a = r / 8 * 6.283; c.beginPath(); c.moveTo(x + 40 * U + Math.cos(a) * 30 * U, bp.y + 50 * U + Math.sin(a) * 30 * U); c.lineTo(x + 40 * U + Math.cos(a) * 60 * U, bp.y + 50 * U + Math.sin(a) * 60 * U); c.stroke(); } }
      }
    } else if (cp < BAL_LAND) {                 // pffffft: zipping about, shrinking
      var e = (cp - pop) / (BAL_LAND - pop), hX = tgW(tgSt(w).house, w) + TG_HW * VW * 0.5, hY = VH - hd.hh - hd.rh;
      var X = tgLerp(bp.X, hX, e) + Math.sin(e * 15) * 0.45 * VW * (1 - e), y = tgLerp(bp.y, hY, e) - Math.abs(Math.sin(e * 9)) * VH * 0.35 * (1 - e);
      var xz = tgL(X, w);
      if (xz > -300 * U && xz < VW + 300 * U) {
        var sc = 1 - 0.55 * e;
        for (var p = 1; p < 6; p++) { c.fillStyle = "rgba(220,225,235," + (0.35 * (1 - p / 6)).toFixed(3) + ")"; c.beginPath(); c.arc(xz - Math.cos(e * 15) * p * 22 * U, y + p * 10 * U, (6 + p * 4) * U, 0, 6.283); c.fill(); }
        tgBalloonShape(xz, y, sc, e * 30, true);
      }
    }
    // the handlers: under it, lifted off their feet by a gust, then chasing it to the house and giving up
