    lx.drawImage(img.logo, 0, 0, lc.width, lc.height);
    lx.globalCompositeOperation = "source-atop";
    var f = cyc / 1.08, bw = lc.width * 0.35, x = -bw * 1.6 + (lc.width + bw * 3.2) * f;
    lx.setTransform(1, 0, -0.36, 1, 0, 0);                       // skewX(-20deg)
    var g = lx.createLinearGradient(x, 0, x + bw, 0);
    g.addColorStop(0, "rgba(255,255,255,0)"); g.addColorStop(0.5, "rgba(255,255,255,.6)"); g.addColorStop(1, "rgba(255,255,255,0)");
    lx.fillStyle = g; lx.fillRect(x, 0, bw, lc.height);
