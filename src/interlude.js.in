    var x = tgL(t.X, w), gy = tgGy(t.X, cp, w), hop = 0;
    if (cp >= BLOW_AT && cp < 424) { var px = tgGuyX(cp, w) + 60 * U + 50 * U, d = Math.abs(t.X - px); hop = Math.max(0, 1 - d / (90 * U)) * 70 * U; }
    if (t.pose === "sit") gy = VH - 34 * U;
