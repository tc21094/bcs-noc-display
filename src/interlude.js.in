        else if (age >= 0.3 && age < 2.4) { X = p.tx; o.rot = 1.5; o.face = 1; o.L = [-12, -150]; o.R = [12, -152]; burst = age - 0.3; }
        else if (age >= 2.4 && age < 4.6) { X = tgLerp(p.tx, u.X, tgSeg(age, 2.4, 4.6)); o.walk = true; o.face = -1; }
      } else if (p.kind === "gpa" && age >= 0 && age < 2.6) { o.L = [-12, -128]; o.R = [12, -128]; o.mouth = "o"; }
    }
    if (cp >= BOOM && cp < BOOM + 2.6) { o.L = [-28, -150]; o.R = [28, -150]; o.mouth = "o"; }
    if (!tgVis(X, w, 220 * U)) return;
