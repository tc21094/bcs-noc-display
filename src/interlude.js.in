    c.strokeStyle = "#e3c066"; c.lineWidth = 2.5;
    [[-58, -130, -70], [-58, -124, -70], [58, -130, 70], [58, -124, 70]].forEach(function (s) { c.beginPath(); c.moveTo(s[0], s[1]); c.lineTo(s[2], s[1] + 6 * Math.sin(now * 2 + s[1])); c.stroke(); });
    for (k = -16; k <= 16; k += 6) { c.beginPath(); c.moveTo(k, -76); c.lineTo(k + 2 * Math.sin(now * 2 + k), -60); c.stroke(); }
    c.save(); c.translate(0, -156); c.rotate(look * 0.22); c.translate(0, 156);
    c.fillStyle = "#d8b98a"; c.beginPath(); c.arc(0, -156, 18, 0, 6.283); c.fill();
    var lx = look * 9;
    if (Math.abs(look) > 0.5) { c.strokeStyle = "#5a3a22"; c.lineWidth = 2; c.beginPath(); c.moveTo(lx + 2, -168); c.lineTo(lx + 10, -171); c.stroke(); }
    c.fillStyle = "#1b1b1b"; c.beginPath(); c.arc(-6 + lx, -160, 2.8, 0, 6.283); c.arc(6 + lx, -160, 2.8, 0, 6.283); c.fill();
    c.strokeStyle = "#5a3a22"; c.lineWidth = 1.6; c.beginPath(); c.arc(lx, -152, 8, 0.3, 2.84); c.stroke();
    for (k = -6; k <= 6; k += 3) { c.beginPath(); c.moveTo(lx + k, -147 + Math.abs(k) * 0.5 - 2); c.lineTo(lx + k, -147 + Math.abs(k) * 0.5 + 2); c.stroke(); }
