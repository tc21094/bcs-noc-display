        tgLeafAt(px + lu * pw, VH - lh, (18 + 12 * hash(l * 7 + 3)) * U, l + (blowing ? now * 2 : 0) * hash(l), l % 4); }
      if (blowing) for (var f = 0; f < 6; f++) { var q = (now * 1.8 + f / 6) % 1;
        tgLeafAt(px + (0.2 + 0.7 * hash(f * 9 + 4)) * pw + q * 90 * U, VH - pileH * (0.7 + q * 0.9) + 120 * U * q * q, 20 * U, now * 6 + f, f % 4, 1 - q); }
    }
