  function snowLevel(X, now) { return cl((now - lastPass(X, now)) / ACC); }   // 0 just plowed .. 1 full
  function bank(xl, w) {                      // the tall bank the camper is buried in
    if (w.pos !== w.n) return 0;
    var a = VW * CAMP.x0 - CH * 0.45, z = VW * CAMP.x1 + CH * 0.55;
    if (xl < a || xl > z) return 0;
