    c.restore();
  }

  // ---- the fryer and Dad
  function tgFryer(cp, now, w, front) {
    var X = tgW(tgSt(w).fry, w);
    if (!tgVis(X, w, VW * 0.6)) return;
    var x = tgL(X, w), gy = VH - TG_HG * 0.8, potT = gy - 92 * U, lit = cp >= 63 && cp < 91;
    if (!front) {
      // propane tank, hose, burner stand, pot
      c.fillStyle = "#e9edf1"; rr(x + 38 * U, gy - 50 * U, 28 * U, 50 * U, 10 * U); c.fill();
      c.fillStyle = "#9aa2ad"; c.fillRect(x + 48 * U, gy - 58 * U, 8 * U, 9 * U);
      c.strokeStyle = "#1b1b1b"; c.lineWidth = 3 * U; c.beginPath(); c.moveTo(x + 52 * U, gy - 56 * U); c.quadraticCurveTo(x + 40 * U, gy - 10 * U, x + 14 * U, gy - 38 * U); c.stroke();
      c.strokeStyle = "#4a4f57"; c.lineWidth = 4 * U;
      c.beginPath(); c.moveTo(x - 28 * U, gy); c.lineTo(x - 20 * U, gy - 40 * U); c.moveTo(x + 28 * U, gy); c.lineTo(x + 20 * U, gy - 40 * U); c.moveTo(x - 24 * U, gy - 40 * U); c.lineTo(x + 24 * U, gy - 40 * U); c.stroke();
      if (lit) { c.globalCompositeOperation = "lighter"; for (var k = 0; k < 5; k++) { c.fillStyle = "rgba(90,160,255," + (0.5 + 0.4 * Math.sin(now * 20 + k)).toFixed(2) + ")";
        c.beginPath(); c.moveTo(x + (k - 2) * 8 * U - 4 * U, gy - 42 * U); c.lineTo(x + (k - 2) * 8 * U, gy - (50 + 4 * Math.sin(now * 25 + k)) * U); c.lineTo(x + (k - 2) * 8 * U + 4 * U, gy - 42 * U); c.fill(); }
        c.globalCompositeOperation = "source-over"; }
      var pg = c.createLinearGradient(x - 26 * U, 0, x + 26 * U, 0); pg.addColorStop(0, "#8d949e"); pg.addColorStop(0.4, "#e3e7ec"); pg.addColorStop(1, "#7d848e");
      c.fillStyle = pg; c.fillRect(x - 26 * U, potT, 52 * U, 50 * U);
      c.fillStyle = cp >= BOOM && cp < 92 ? "#2a2522" : "#c9ced6"; c.fillRect(x - 29 * U, potT - 4 * U, 58 * U, 6 * U);
      // the extinguisher waits next to it
      if (cp < 86 || cp >= 107) { c.fillStyle = "#c8323c"; rr(x - 0.13 * VW, gy - 34 * U, 13 * U, 34 * U, 4 * U); c.fill(); c.fillStyle = "#1b1b1b"; c.fillRect(x - 0.13 * VW + 2 * U, gy - 40 * U, 9 * U, 7 * U); }
      if (lit && cp < BOOM) tgSmoke(x, potT - 6 * U, now, 4, 0.7, 31);
      return;
    }
    // the hoisted turkey going in
    if (cp >= 68 && cp < BOOM + 0.15) {
      var ty = cp < 72 ? tgLerp(gy - 40 * U, potT - 70 * U, tgSeg(cp, 68, 70.5)) : tgLerp(potT - 70 * U, potT + 4 * U, ease(tgSeg(cp, 72, 75.8)));
      c.strokeStyle = "#8d949e"; c.lineWidth = 3 * U; c.beginPath(); c.moveTo(x - 0.05 * VW + 26 * U * TS, gy - 110 * U * TS); c.lineTo(x, ty - 34 * U); c.lineTo(x, ty - 14 * U); c.stroke();
      c.save(); c.beginPath(); c.rect(x - 60 * U, 0, 120 * U, cp >= 72 ? potT : VH); c.clip(); tgRoast(x, ty, 1.57, "frozen", now); c.restore();
      if (cp >= 74.5) for (var b = 0; b < 6; b++) { var bp = (now * 3 + b / 6) % 1; c.fillStyle = "rgba(255,230,160," + (0.8 * (1 - bp)).toFixed(2) + ")";
        c.beginPath(); c.arc(x + (hash(b * 7) - 0.5) * 50 * U, potT - bp * 26 * U, (2 + 2 * bp) * U, 0, 6.283); c.fill(); }
    }
    // FWOOSH
    var e = cp - BOOM;
    if (e >= 0 && e < 1.8) {
      if (e < 0.35) { c.fillStyle = "rgba(255,200,120," + (0.32 * (1 - e / 0.35)).toFixed(3) + ")"; c.fillRect(-MG, -MG, VW + 2 * MG, VH + 2 * MG); }
      var r = 40 * U + 250 * U * Math.sqrt(e / 1.8), cyb = potT - r * 0.75, a = 1 - cl((e - 1.1) / 0.7);
      c.save(); c.globalCompositeOperation = "lighter"; c.globalAlpha = a;
      var fg = c.createRadialGradient(x, cyb, r * 0.1, x, cyb, r);
      fg.addColorStop(0, "rgba(255,245,200,1)"); fg.addColorStop(0.35, "rgba(255,170,50,.95)"); fg.addColorStop(0.75, "rgba(230,70,20,.6)"); fg.addColorStop(1, "rgba(200,40,10,0)");
      c.fillStyle = fg; c.beginPath(); c.arc(x, cyb, r, 0, 6.283); c.fill();
      c.restore();
      for (var sk = 0; sk < 10; sk++) { var sa = -Math.PI * hash(sk * 5 + 1), sd = (60 + 380 * e) * U * (0.5 + hash(sk * 9 + 2)); c.drawImage(spA, x + Math.cos(sa) * sd - 7 * U, potT + Math.sin(sa) * sd + 140 * U * e * e - 7 * U, 14 * U, 14 * U); }
    }
    if (e >= 0.8 && e < 9) tgSmoke(x, potT - 60 * U, now, 7, 2.2, 55);
    // pot fire until the foam gets it
    if (cp >= BOOM + 1.2 && cp < 91.5) tgFlames(x, potT, 70 * U * (1 - tgSeg(cp, 89, 91.5)), now, 56 * U);
    // the foam on the pot
    if (cp >= 89 && cp < 215) {
      var fa = tgSeg(cp, 89, 91) * (1 - tgSeg(cp, 200, 215));
      c.fillStyle = "rgba(250,252,255," + (0.95 * fa).toFixed(3) + ")";
      for (var fb = 0; fb < 9; fb++) { c.beginPath(); c.arc(x + (fb - 4) * 8 * U, potT - 8 * U - (fb % 3) * 7 * U * fa, (9 + (fb % 2) * 4) * U * fa, 0, 6.283); c.fill(); }
      for (var dr = 0; dr < 3; dr++) { c.beginPath(); c.ellipse(x + (dr - 1) * 22 * U, potT + 12 * U + dr * 6 * U, 4 * U, 9 * U * fa, 0, 0, 6.283); c.fill(); }
    }
  }
  function dadAt(cp, w) {
    var door = tgDoor(w), Xf = tgW(tgSt(w).fry, w), xs = Xf - 0.05 * VW;
    if (cp < 60.2 || cp >= 106.6) return null;
    if (cp < 62.5) return { X: tgLerp(door, door - 0.03 * VW, tgSeg(cp, 60.2, 62.5)), pose: "carry", face: -1, walk: true };
    if (cp < 68) return { X: tgLerp(door - 0.03 * VW, xs, tgSeg(cp, 62.5, 68)), pose: "carry", face: -1, walk: true };
    if (cp < BOOM) return { X: xs, pose: "hoist", face: 1 };
    if (cp < BOOM + 1.2) { var u = tgSeg(cp, BOOM, BOOM + 1.2); return { X: tgLerp(xs, Xf - 0.115 * VW, ease(u)), pose: "flung", face: 1, rot: -1.45 * ease(u), soot: true, y: -60 * U * Math.sin(u * Math.PI) }; }
    if (cp < 82) return { X: Xf - 0.115 * VW, pose: "lying", face: 1, rot: -1.45, soot: true };
    if (cp < 86) return { X: Xf - 0.115 * VW, pose: "sit", face: 1, soot: true };
    if (cp < 88) return { X: Xf - 0.12 * VW, pose: "grab", face: -1, soot: true };
    if (cp < 92.5) return { X: Xf - 0.12 * VW, pose: "spray", face: 1, soot: true };
    if (cp < 100) return { X: Xf - 0.12 * VW, pose: "foam", face: 1, soot: true };
    return { X: tgLerp(Xf - 0.12 * VW, door, tgSeg(cp, 100, 106)), pose: "foam", face: 1, soot: true, walk: true };
  }
  function tgDad(cp, now, w) {
    var d = dadAt(cp, w);
    if (!d || !tgVis(d.X, w, 200 * U)) return;
    var x = tgL(d.X, w), gy = tgGy(d.X, cp, w) + (d.y || 0), o = tgDadLook({ face: d.face, walk: d.walk, ph: now * 8 }, d.soot);
    if (d.pose === "carry") { o.L = [24, -70]; o.R = [30, -64]; o.held = function () { tgAt(44, -70, function () { c.scale(1 / U, 1 / U); tgRoast(0, 0, 0, "frozen", now); }); }; }
    else if (d.pose === "hoist") { var lw = cp < 72 ? tgSeg(cp, 68, 70.5) : 1 - ease(tgSeg(cp, 72, 75.8)) * 0.6; o.L = [18, -88 - 30 * lw]; o.R = [26, -82 - 30 * lw]; o.lean = 0.1; }
    else if (d.pose === "flung" || d.pose === "lying") { o.rot = d.rot; o.L = [-30, -120]; o.R = [30, -124]; }
    else if (d.pose === "sit") { o.sit = true; o.L = [-14, -64]; o.R = [22, -60]; o.eyeCol = Math.sin(now * 3) > 0.92 ? "#3b322c" : "#ffffff"; }
    else if (d.pose === "grab") { o.L = [-30, -40]; o.R = [-20, -56]; }
    else if (d.pose === "spray" || d.pose === "foam") {
      o.L = [26, -72]; o.R = [34, -66];
      o.held = function () { c.fillStyle = "#c8323c"; rr(16, -84, 13, 34, 4); c.fill(); c.strokeStyle = "#1b1b1b"; c.lineWidth = 3; c.beginPath(); c.moveTo(24, -84); c.lineTo(40, -72); c.stroke(); };
    }
    c.save(); c.translate(x, gy); tgPerson(o, now); c.restore();
    if (d.soot) tgSmoke(x + 4 * U * d.face, gy - 128 * U * TS, now, 3, 0.5, 91);
    if (d.pose === "spray") {                   // the stream: at the pot, then whipping round onto himself
      var back = tgSeg(cp, 90.3, 91.2), nz = [x + 40 * U * TS * d.face, gy - 72 * U * TS], tgt = [tgLerp(tgL(tgW(tgSt(w).fry, w), w), x + 10 * U, back), tgLerp(VH - 100 * U, gy - 110 * U * TS, back)];
      c.strokeStyle = "rgba(250,252,255,.9)"; c.lineWidth = 10 * U; c.beginPath(); c.moveTo(nz[0], nz[1]);
      c.quadraticCurveTo((nz[0] + tgt[0]) / 2, Math.min(nz[1], tgt[1]) - 40 * U * (1 - back), tgt[0], tgt[1]); c.stroke();
      for (var p = 0; p < 6; p++) { var q = (now * 4 + p / 6) % 1; c.fillStyle = "rgba(255,255,255," + (1 - q).toFixed(2) + ")"; c.beginPath(); c.arc(tgt[0] + (hash(p * 3) - 0.5) * 50 * U * q, tgt[1] - 30 * U * q, 6 * U, 0, 6.283); c.fill(); }
    }
    if (d.pose === "foam" || (d.pose === "spray" && cp >= 91)) {   // covered in foam, goggles peeking out
      var fa = d.pose === "spray" ? tgSeg(cp, 91, 92.5) : 1;
      c.fillStyle = "rgba(250,252,255,.97)";
      for (var b = 0; b < 11; b++) { var by = gy - (12 + b * 12) * U * TS, bw = (34 - Math.abs(b - 5) * 2.5) * U * TS * fa;
        c.beginPath(); c.arc(x + Math.sin(b * 2.1) * 6 * U, by, bw * 0.75, 0, 6.283); c.fill(); }
      if (fa >= 1) { c.fillStyle = "rgba(170,220,255,.8)"; c.beginPath(); c.arc(x + 8 * U * TS * d.face, gy - 118 * U * TS, 8 * U * TS, 0, 6.283); c.fill();
        c.fillStyle = Math.sin(now * 2.6) > 0.9 ? "#ddd" : "#111"; c.beginPath(); c.arc(x + 9 * U * TS * d.face, gy - 118 * U * TS, 2.5 * U * TS, 0, 6.283); c.fill(); }
    }
  }
  function tgFlying(cp, now, w) {             // the flaming bird crossing the wall, then smoking where it fell
    var f = tgFlight(w), u = (cp - f.t0) / f.dur;
    if (u >= 0 && u <= 1) {
      var X = tgLerp(f.x0, f.x1, u), gy = VH - 100 * U, y = tgLerp(gy - 10 * U, VH - 30 * U, u) - 4 * f.peak * u * (1 - u), x = tgL(X, w);
      if (x > -200 * U && x < VW + 200 * U) {
        for (var k = 1; k < 8; k++) { var uu = u - k * 0.012; if (uu < 0) break;
          var Xk = tgLerp(f.x0, f.x1, uu), yk = tgLerp(gy - 10 * U, VH - 30 * U, uu) - 4 * f.peak * uu * (1 - uu);
          c.fillStyle = "rgba(120,120,130," + (0.3 * (1 - k / 8)).toFixed(3) + ")"; c.beginPath(); c.arc(tgL(Xk, w), yk, (10 + k * 4) * U, 0, 6.283); c.fill(); }
        tgFlames(x, y + 10 * U, 60 * U, now, 40 * U);
        tgRoast(x, y, -now * 9, "fire", now);
      }
    } else if (cp > f.land && cp < 222) {
      var lx = tgL(f.x1, w);
      if (lx > -100 * U && lx < VW + 100 * U) {
        var a = 1 - tgSeg(cp, 219, 222), gyl = tgGy(f.x1, cp, w) - 14 * U, bump = cp - f.land < 0.4 ? -30 * U * Math.sin((cp - f.land) / 0.4 * Math.PI) : 0;
        c.save(); c.globalAlpha = a; tgRoast(lx, gyl + bump, 0.15, "char", now); c.restore();
        tgSmoke(lx, gyl - 14 * U, now, 4, 0.8, 13);
        if (cp - f.land < 6) tgFlames(lx, gyl + 6 * U, 26 * U * (1 - (cp - f.land) / 6), now, 30 * U);
      }
    }
  }

  // ---- backyard football
  function tgPass(k, w) {
    var t0 = FB0 + k * FB_DT;
    if (k < 0 || t0 > FB1 || (t0 >= 68 && t0 <= 88)) return null;      // a break for the fryer act
    var st = tgSt(w), fx = tgW(st.qb, w) + 16 * U, ux = tgW(st.uncle, w), h = hash(k * 13 + 5);
    var kind = h < 0.38 ? "catch" : h < 0.6 ? "bonk" : h < 0.84 ? "dive" : "gpa";
    var tx = kind === "gpa" ? tgW(st.gpa, w) - 20 * U : kind === "dive" ? ux + 0.055 * VW : ux - 6 * U;
    var dist = Math.abs(tx - fx), dur = 1.3 + dist / (VW * 1.3);
    return { kind: kind, t0: t0, dur: dur, fx: fx, tx: tx, fy: 96 * U, ty: (kind === "catch" ? 118 : kind === "bonk" ? 140 : kind === "gpa" ? 66 : 10) * U,
             peak: Math.min(VH * 0.62, 90 * U + dist * 0.28), land: t0 + dur };
  }
  function tgLastPass(cp, w) {
    var kMax = Math.floor((cp - FB0) / FB_DT);
    for (var k = kMax; k >= kMax - 2; k--) { var p = tgPass(k, w); if (p && cp >= p.t0) return p; }
    return null;
  }
  function tgBall(cp, now, w) {
    var p = tgLastPass(cp, w);
    if (!p) return;
    var u = (cp - p.t0) / p.dur, gyF = tgGy(p.fx, cp, w) - p.fy, gyT = tgGy(p.tx, cp, w) - p.ty, X, Y, rot;
    if (u < 0) return;
    if (u <= 1) {
      X = tgLerp(p.fx, p.tx, u); Y = tgLerp(gyF, gyT, u) - 4 * p.peak * u * (1 - u);
      var vx = p.tx - p.fx, vy = (gyT - gyF) - 4 * p.peak * (1 - 2 * u);
      rot = Math.atan2(vy, vx);
      if (tgVis(X, w, 40 * U)) { c.save(); c.translate(tgL(X, w), Y); c.rotate(rot); c.scale(1, 0.75 + 0.25 * Math.sin(now * 30)); tgFootball(0, 0, 0); c.restore(); }
      return;
    }
    var age = cp - p.land;
    if (p.kind === "catch") {
      if (age > 1.4 && age < 2.4) { var b = age - 1.4; X = p.tx + 20 * U * b; Y = tgGy(X, cp, w) - 8 * U - 90 * U * Math.abs(Math.sin(b * 6)) * (1 - b); if (tgVis(X, w, 40 * U)) tgFootball(tgL(X, w), Y, b * 14); }
      return;
    }
    if (age > 3.2) return;
    var dir = p.kind === "bonk" ? -1 : 1, bu = Math.min(1, age / 1.2);
    X = p.tx + dir * 0.05 * VW * bu; Y = tgLerp(gyT, tgGy(X, cp, w) - 8 * U, bu) - 70 * U * Math.sin(bu * Math.PI) * (p.kind === "dive" ? 0.2 : 1);
    if (tgVis(X, w, 40 * U)) tgFootball(tgL(X, w), Y, bu * 9 * dir);
  }
  function qbAt(cp, w) {
    var X = tgW(tgSt(w).qb, w);
    if (cp < 6 || cp >= 158) return null;
    if (cp < 14) return { X: tgLerp(-0.06 * VW, X, tgSeg(cp, 6, 14)), walk: true, face: 1 };
    if (cp >= 150) return { X: tgLerp(X, -0.06 * VW, tgSeg(cp, 150, 158)), walk: true, face: -1 };
    return { X: X, face: 1 };
  }
  function tgQB(cp, now, w) {
    var q = qbAt(cp, w);
    if (!q || !tgVis(q.X, w, 100 * U)) return;
    var o = { sc: 0.72, sk: "#c98a5e", shirt: "#2f6fd1", pants: "#2b3550", face: q.face, walk: q.walk, ph: now * 10, shoe: "#e8e8e8",
      head: function (hx, hy) { c.fillStyle = "#e8862a"; c.beginPath(); c.arc(hx, hy - 2, 13.8, Math.PI, 0); c.fill(); c.beginPath(); c.arc(hx, hy - 17, 5, 0, 6.283); c.fill(); } };
    var k = Math.floor((cp - FB0 + 0.7) / FB_DT), p = tgPass(k, w), lp = tgLastPass(cp, w);
    if (p && cp >= p.t0 - 0.7 && cp < p.t0) { var wu = (cp - p.t0 + 0.7) / 0.7; o.R = [-18 - 6 * wu, -128 - 6 * wu]; o.held = function (A, B) { tgFootball(B[0], B[1], -0.6, 1); }; }
    else if (p && cp >= p.t0 && cp < p.t0 + 0.35) o.R = [34, -100];
    else if (lp && lp.kind === "catch" && cp - lp.land > 0 && cp - lp.land < 1.6) { o.L = [-20, -150]; o.R = [20, -152]; o.mouth = "o"; }
    else if (!q.walk && lp && cp - lp.t0 < FB_DT - 1) o.R = [24, -70];
    c.save(); c.translate(tgL(q.X, w), tgGy(q.X, cp, w)); tgPerson(o, now); c.restore();
  }
  function uncleAt(cp, w) {
    var door = tgDoor(w), ux = tgW(tgSt(w).uncle, w);
    if (cp < 8.6 || cp >= 158) return null;
    if (cp < 16) return { X: tgLerp(door, ux, tgSeg(cp, 8.6, 16)), walk: true, face: -1 };
    if (cp >= 150) return { X: tgLerp(ux, door, tgSeg(cp, 150, 157.8)), walk: true, face: 1 };
    return { X: ux, face: -1 };
