    }
    for (var i = H.smoke.length - 1; i >= 0; i--) {
      var s = H.smoke[i]; s.b += dt;
      if (s.b > 4) { H.smoke.splice(i, 1); continue; }
      s.y -= 18 * U * dt; s.x += (6 + 4 * Math.sin(s.b * 2)) * U * dt;
      c.fillStyle = "rgba(200,205,215," + (0.35 * (1 - s.b / 4)).toFixed(3) + ")";
