// BCS NOC interlude / blanket.
//   interlude: full-screen animation over the dashboard for a few seconds, then
//              faded away (burn-in protection)
//   blanket:   the same scene with "BCS / TECHNOLOGY DEPARTMENT", kept up until
//              window.__bcsBlanketStop() is called; drifts slowly so it can't burn in
// Style adapted from a colleague's maintenance-page animation: circuit lanes route
// in from the screen edges toward the logo, stop at a small break where data
// pulses spark, over a dot grid with a vignette. The BCS B sits in the centre.
// Injected by kiosk-launch through Chrome's DevTools pipe, so it works on any
// dashboard. It adds one temporary element to the page and loads nothing.
(function () {
  "use strict";
  var BLANKET = window.__BCS_MODE === "blanket";
  var FLAG = BLANKET ? "__bcsBlanket" : "__bcsInterlude";
  if (window[FLAG]) return "busy";
  window[FLAG] = true;

  var DUR = BLANKET ? Infinity : Math.max(6, Number(window.__BCS_INTERLUDE_SECONDS) || 12);
  var PNG = { logo: "@@LOGO@@", glow: "@@GLOW@@", text: BLANKET ? "@@TEXT2@@" : "@@TEXT@@" };
  var BL = "95,175,255";     // network blue (from the original)
  var AC = "232,44,68";      // accent: BCS red (the original used amber)

  var done = false, raf = 0, host = null;
  function cleanup() {
    if (done) return;
    done = true;
    if (raf) cancelAnimationFrame(raf);
    try { if (host && host.hidePopover) host.hidePopover(); } catch (e) {}
    try { if (host) host.remove(); } catch (e) {}
    window[FLAG] = false;
    if (BLANKET) window.__bcsBlanketStop = null;
  }
  if (!BLANKET) setTimeout(cleanup, (DUR + 8) * 1000);   // safety net if animation frames stop

  function blob(b64) {
    var bin = atob(b64), n = bin.length, u = new Uint8Array(n);
    for (var i = 0; i < n; i++) u[i] = bin.charCodeAt(i);
    return new Blob([u], { type: "image/png" });
  }
  function cl(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
  function ease(v) { v = cl(v); return v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2; }
  function rise(v) { v = cl(v); return 1 - Math.pow(1 - v, 4); }            // ~cubic-bezier(.16,1,.3,1)
  function rnd(a, b) { return a + Math.random() * (b - a); }

  // ---------------------------------------------------------------- overlay element
  host = document.createElement("div");
  var st = host.style;
  [["position", "fixed"], ["inset", "0"], ["width", "100vw"], ["height", "100vh"], ["max-width", "none"],
   ["max-height", "none"], ["margin", "0"], ["padding", "0"], ["border", "0"], ["background", "rgb(2,6,16)"],
   ["z-index", "2147483647"], ["pointer-events", BLANKET ? "auto" : "none"], ["overflow", "hidden"],
   ["display", "block"], ["opacity", "0"], ["transition", "opacity 0.7s ease"]].forEach(function (p) {
    st.setProperty(p[0], p[1], "important");
  });
  var root = host.attachShadow ? host.attachShadow({ mode: "closed" }) : host;
  var VW = window.innerWidth, VH = window.innerHeight, D = Math.min(VW, VH);
  var U = Math.max(1, D / 1080);             // line/sprite size unit: same look at 1080p and 4K
  var MG = BLANKET ? 24 : 0;                 // margin so the drifting scene never shows an edge
  var wrap = document.createElement("div");
  wrap.style.cssText = "position:absolute;left:" + -MG + "px;top:" + -MG + "px;width:" + (VW + 2 * MG) + "px;height:" + (VH + 2 * MG) + "px;will-change:transform";
  var bgc = document.createElement("canvas"), fxc = document.createElement("canvas");
  [bgc, fxc].forEach(function (cv) { cv.style.cssText = "position:absolute;left:0;top:0;width:100%;height:100%"; wrap.appendChild(cv); });
  root.appendChild(wrap);
  try { host.popover = "manual"; } catch (e) {}
  document.documentElement.appendChild(host);
  try { if (host.showPopover) host.showPopover(); } catch (e) {}   // top layer: above anything the page does

  // backing store: device pixels, capped to keep memory and GPU work modest
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  var K = Math.min(dpr, 2560 / (VW + 2 * MG), 1440 / (VH + 2 * MG));
  [bgc, fxc].forEach(function (cv) { cv.width = Math.round((VW + 2 * MG) * K); cv.height = Math.round((VH + 2 * MG) * K); });
  var b = bgc.getContext("2d"), c = fxc.getContext("2d");
  function toView(g) { g.setTransform(K, 0, 0, K, MG * K, MG * K); }   // draw in viewport CSS pixels

  // ---------------------------------------------------------------- layout (CSS px)
  var img = {};
  var LH = Math.round(Math.min(VH * 0.28, VW * 0.2 * 330 / 415));    // logo height
  var LW = Math.round(LH * 415 / 330), SC = LH / 330;                  // SC: artwork scale vs. the splash
  var cx = VW / 2, cy = Math.round(VH * 0.36);
  var C = { hw: LW / 2 + LH * 0.04, hh: LH / 2 + LH * 0.04, gapIn: LH * 0.16, gapOut: LH * 0.3 };
  var textTop = Math.round(cy + LH / 2 + VH * 0.055);
  var TW = (BLANKET ? 866 : 656) * SC, TH = (BLANKET ? 180 : 127) * SC;
  var barY = textTop + TH + VH * 0.03, barW = Math.min(VW * 0.6, 420 * SC * 1.6);
  var panel = { x0: cx - TW / 2 - 40, x1: cx + TW / 2 + 40, y0: textTop - 20, y1: barY + 30 };

  // ---------------------------------------------------------------- lanes (edge -> logo)
  function nrm(a, q) { var dx = q[0] - a[0], dy = q[1] - a[1], l = Math.hypot(dx, dy) || 1; return [-dy / l, dx / l]; }
  function offset(p, o) {
    var out = [];
    for (var i = 0; i < p.length; i++) {
      var a = p[Math.max(0, i - 1)], q = p[i], r = p[Math.min(p.length - 1, i + 1)];
      var n1 = i ? nrm(a, q) : nrm(q, r), n2 = i < p.length - 1 ? nrm(q, r) : n1;
      var nx = n1[0] + n2[0], ny = n1[1] + n2[1], l = Math.hypot(nx, ny) || 1;
      nx /= l; ny /= l;
      var ch = nx * n1[0] + ny * n1[1] || 1;
      out.push([q[0] + nx * o / ch, q[1] + ny * o / ch]);
    }
    return out;
  }
  function inPanel(x, y) { return x > panel.x0 && x < panel.x1 && y > panel.y0 - 30 && y < panel.y1 + 30; }
  function route(x, y, base, first) {
    var pts = [[x, y]], dir = base, step = Math.PI / 4, k = 0;
    x += Math.cos(dir) * first; y += Math.sin(dir) * first; pts.push([x, y]);
    while (k++ < 40) {
      var len = D * rnd(0.05, 0.15);
      dir = dir !== base ? base : [base - step, base, base + step][(Math.random() * 3) | 0];
      var nx = x + Math.cos(dir) * len, ny = y + Math.sin(dir) * len;
      if (inPanel(nx, ny)) { dir = base; nx = x + Math.cos(dir) * len; ny = y + Math.sin(dir) * len; }   // keep the lettering clear
      x = nx; y = ny; pts.push([x, y]);
      if (x < -MG - 30 || x > VW + MG + 30 || y < -MG - 30 || y > VH + MG + 30) break;
    }
    return pts;
  }
  function lane(pts) {
    pts = pts.slice().reverse();
    var L = [0];
    for (var i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    var ln = { p: pts, L: L, len: L[L.length - 1], pulses: [] };
    ln.g1 = ln.len - C.gapOut; ln.g0 = ln.len - C.gapIn;
    var n = 1 + (Math.random() < 0.35 ? 1 : 0);
    for (var j = 0; j < n; j++) ln.pulses.push({ s: -rnd(0, 1.3) * ln.g1, v: D * rnd(0.3, 0.65) });
    return ln;
  }
  function at(ln, s) {
    var L = ln.L, p = ln.p;
    if (s <= 0) return p[0];
    if (s >= ln.len) return p[p.length - 1];
    for (var i = 1; i < L.length; i++) if (L[i] >= s) {
      var f = (s - L[i - 1]) / (L[i] - L[i - 1]);
      return [p[i - 1][0] + (p[i][0] - p[i - 1][0]) * f, p[i - 1][1] + (p[i][1] - p[i - 1][1]) * f];
    }
    return p[p.length - 1];
  }
  function partial(ln, s0, s1) {
    if (s1 <= s0) return;
    var L = ln.L, p = ln.p, a = at(ln, s0);
    c.moveTo(a[0], a[1]);
    for (var i = 1; i < L.length; i++) {
      if (L[i] <= s0) continue;
      if (L[i] >= s1) { var q = at(ln, s1); c.lineTo(q[0], q[1]); return; }
      c.lineTo(p[i][0], p[i][1]);
    }
  }
  var lanes = [], pitch = LH * 0.15;
  [{ ang: -Math.PI / 2, n: 5, pin: function (k) { return [cx + k, cy - C.hh]; } },
   { ang: Math.PI, n: 4, pin: function (k) { return [cx - C.hw, cy + k]; } },
   { ang: 0, n: 4, pin: function (k) { return [cx + C.hw, cy + k]; } }].forEach(function (sd) {
    var p0 = sd.pin(0), centre = route(p0[0], p0[1], sd.ang, C.gapOut + D * rnd(0.02, 0.06));
    for (var k = 0; k < sd.n; k++) {
      var o = (k - (sd.n - 1) / 2) * pitch, sgn = (sd.ang === 0 || sd.ang === -Math.PI / 2) ? 1 : -1;
      var off = offset(centre, o * sgn), s0 = sd.pin(o);
      off[0] = [s0[0], s0[1]];
      lanes.push(lane(off));
    }
  });

  function sprite(col) {
    var s = document.createElement("canvas"), z = 64;
    s.width = s.height = z;
    var g = s.getContext("2d"), r = g.createRadialGradient(z / 2, z / 2, 0, z / 2, z / 2, z / 2);
    r.addColorStop(0, "rgba(255,255,255,1)"); r.addColorStop(0.18, "rgba(" + col + ",.9)");
    r.addColorStop(0.5, "rgba(" + col + ",.22)"); r.addColorStop(1, "rgba(" + col + ",0)");
    g.fillStyle = r; g.fillRect(0, 0, z, z);
    return s;
  }
  var spB = sprite(BL), spA = sprite(AC);

  // ---------------------------------------------------------------- static background
  (function () {
    b.setTransform(K, 0, 0, K, 0, 0);
    var W = VW + 2 * MG, H = VH + 2 * MG;
    var g = b.createRadialGradient(W / 2, MG + cy, 0, W / 2, MG + cy, Math.hypot(W, H) / 2);
    g.addColorStop(0, "rgb(14,14,24)"); g.addColorStop(1, "rgb(2,6,16)");
    b.fillStyle = g; b.fillRect(0, 0, W, H);
    var gs = Math.max(14, D * 0.032);
    b.fillStyle = "rgba(110,160,230,.10)";
    for (var y = gs / 2; y < H; y += gs) for (var x = gs / 2; x < W; x += gs) { b.beginPath(); b.arc(x, y, 0.9 * U, 0, 6.283); b.fill(); }
  })();
  function vignette() {   // drawn on the animated layer so lanes fade toward the edges
    c.save(); c.setTransform(K, 0, 0, K, 0, 0);
    var W = VW + 2 * MG, H = VH + 2 * MG;
    c.translate(W / 2, H / 2); c.scale(0.8 * W / 2, 0.75 * H / 2);
    var v = c.createRadialGradient(0, 0, 0, 0, 0, 1);
    v.addColorStop(0.45, "rgba(2,6,16,0)"); v.addColorStop(1, "rgba(2,6,16,.88)");
    c.fillStyle = v; c.fillRect(-3, -3, 6, 6);
    c.restore();
  }

  // ---------------------------------------------------------------- logo with shine sweep
  var lc = document.createElement("canvas"), lx = lc.getContext("2d");
  lc.width = Math.max(1, Math.round(LW * K)); lc.height = Math.max(1, Math.round(LH * K));
  function drawLogo(t, alpha) {
    if (!img.logo || alpha <= 0) return;
    var cyc = t >= 2.3 ? (t - 2.3) % 6 : -1, sweep = cyc >= 0 && cyc < 1.08;
    c.globalAlpha = alpha;
    if (!sweep) { c.drawImage(img.logo, cx - LW / 2, cy - LH / 2, LW, LH); c.globalAlpha = 1; return; }
    lx.setTransform(1, 0, 0, 1, 0, 0);
    lx.globalCompositeOperation = "source-over";
    lx.clearRect(0, 0, lc.width, lc.height);
    lx.drawImage(img.logo, 0, 0, lc.width, lc.height);
    lx.globalCompositeOperation = "source-atop";
    var f = cyc / 1.08, bw = lc.width * 0.35, x = -bw * 1.6 + (lc.width + bw * 3.2) * f;
    lx.setTransform(1, 0, -0.36, 1, 0, 0);                       // skewX(-20deg)
    var g = lx.createLinearGradient(x, 0, x + bw, 0);
    g.addColorStop(0, "rgba(255,255,255,0)"); g.addColorStop(0.5, "rgba(255,255,255,.6)"); g.addColorStop(1, "rgba(255,255,255,0)");
    lx.fillStyle = g; lx.fillRect(x, 0, bw, lc.height);
    c.drawImage(lc, cx - LW / 2, cy - LH / 2, LW, LH);
    c.globalAlpha = 1;
  }
  function flick(t) {   // the original's occasional flicker, every 7 s after the intro
    if (t < 3) return 1;
    var p = ((t - 3) % 7) / 7;
    return p < 0.86 ? 1 : p < 0.87 ? 0.55 : p < 0.88 ? 1 : p < 0.9 ? 0.4 : 1;
  }

  // ---------------------------------------------------------------- sparks
  var sparks = [];
  function spark(x, y, big) {
    var ps = [];
    for (var i = 0; i < (big ? 9 : 6); i++) { var a = rnd(0, 6.283), sp = D * rnd(0.04, 0.16); ps.push([Math.cos(a) * sp, Math.sin(a) * sp]); }
    sparks.push({ x: x, y: y, b: 0, ps: ps, big: big });
  }

  // ---------------------------------------------------------------- main loop
  var T0 = 0, last = 0, leaving = false, endAt = DUR, arrived = false;
  function leave() {
    if (leaving) return;
    leaving = true;
    endAt = (performance.now() - T0) / 1000 + 0.9;
    st.setProperty("transition", "opacity 0.9s ease", "important");
    st.setProperty("opacity", "0", "important");
  }
  if (BLANKET) window.__bcsBlanketStop = function () { if (!T0) cleanup(); else leave(); return "stopping"; };

  function frame(now) {
    if (done) return;
    if (BLANKET && now - last < 31) { raf = requestAnimationFrame(frame); return; }   // ~30 fps is plenty
    var t = (now - T0) / 1000, dt = Math.min(0.05, (now - last) / 1000), i, j, ln, p;
    last = now;
    if (t >= endAt) { cleanup(); return; }
    if (!BLANKET && t >= DUR - 0.9) leave();
    if (BLANKET) wrap.style.transform = "translate(" + (14 * Math.cos(t * 6.2832 / 300)).toFixed(2) + "px," + (9 * Math.sin(t * 6.2832 / 300)).toFixed(2) + "px)";

    c.setTransform(1, 0, 0, 1, 0, 0);
    c.clearRect(0, 0, fxc.width, fxc.height);
    toView(c);
    c.lineCap = "round"; c.lineJoin = "round";
    var rev = ease((t - 0.15) / 1.05);
    if (rev >= 1 && !arrived) { arrived = true; for (i = 0; i < lanes.length; i++) { p = at(lanes[i], lanes[i].g1); spark(p[0], p[1], true); } }

    // halo behind the logo
    var fk = flick(t);
    if (t > 1) {
      var hh = cl((t - 1) / 1) * (0.7 + 0.3 * Math.sin(t * 2.1)) * fk, hg = c.createRadialGradient(cx, cy, 0, cx, cy, LH * 1.5);
      hg.addColorStop(0, "rgba(" + AC + "," + (0.13 * hh).toFixed(3) + ")"); hg.addColorStop(0.5, "rgba(40,100,255," + (0.08 * hh).toFixed(3) + ")");
      hg.addColorStop(1, "rgba(40,100,255,0)");
      c.fillStyle = hg; c.fillRect(cx - LH * 1.5, cy - LH * 1.5, LH * 3, LH * 3);
    }

    // network (blue) up to the break; inner pins (accent) from the break to the logo
    var br = 0.85 + 0.15 * Math.sin(t * 1.3);
    for (i = 0; i < lanes.length; i++) {
      ln = lanes[i];
      c.strokeStyle = "rgba(" + BL + "," + (0.34 * br).toFixed(3) + ")"; c.lineWidth = 1.8 * U;   // a bit stronger than the original: TVs are viewed from across a room
      c.beginPath(); partial(ln, 0, Math.min(ln.g1, ln.len * rev)); c.stroke();
      if (rev >= 1) {
        var e1 = at(ln, ln.g1), e0 = at(ln, ln.g0);
        c.beginPath(); c.arc(e1[0], e1[1], 2.2 * U, 0, 6.283); c.stroke();
        var fl = t > 1.15 ? cl((t - 1.15) / 0.5) : 0;
        c.strokeStyle = "rgba(" + AC + "," + ((0.55 + 0.25 * Math.sin(t * 2.1 + i)) * fl * fk).toFixed(3) + ")"; c.lineWidth = 1.8 * U;
        c.beginPath(); partial(ln, ln.g0, ln.len); c.stroke();
        c.beginPath(); c.arc(e0[0], e0[1], 2.2 * U, 0, 6.283); c.stroke();
      }
    }

    c.globalCompositeOperation = "lighter";
    if (rev > 0 && rev < 1) {   // reveal heads racing in from the edges
      for (i = 0; i < lanes.length; i++) {
        ln = lanes[i]; var s = Math.min(ln.g1, ln.len * rev);
        c.strokeStyle = "rgba(" + BL + ",.55)"; c.lineWidth = 2 * U;
        c.beginPath(); partial(ln, Math.max(0, s - D * 0.12), s); c.stroke();
        p = at(ln, s); c.drawImage(spB, p[0] - 11 * U, p[1] - 11 * U, 22 * U, 22 * U);
      }
    }
    if (t > 1.4) {             // data pulses: in along the lanes, spark at the break
      for (i = 0; i < lanes.length; i++) {
        ln = lanes[i]; var tail = D * 0.09;
        for (j = 0; j < ln.pulses.length; j++) {
          var q = ln.pulses[j]; q.s += q.v * dt;
          if (q.s >= ln.g1) { p = at(ln, ln.g1); spark(p[0], p[1], false); q.s = -rnd(0.3, 1.5) * ln.g1; q.v = D * rnd(0.3, 0.65); continue; }
          if (q.s < 0) continue;
          for (var k = 0; k < 6; k++) {
            var s1 = q.s - tail * k / 6, s0 = q.s - tail * (k + 1) / 6;
            if (s1 <= 0) break;
            c.strokeStyle = "rgba(" + BL + "," + (0.7 * (1 - k / 6)).toFixed(3) + ")"; c.lineWidth = 2 * U;
            c.beginPath(); partial(ln, Math.max(0, s0), s1); c.stroke();
          }
          p = at(ln, q.s); c.drawImage(spB, p[0] - 9 * U, p[1] - 9 * U, 18 * U, 18 * U);
        }
      }
    }
    for (i = sparks.length - 1; i >= 0; i--) {
      var sk = sparks[i]; sk.b += dt;
      var life = sk.big ? 0.7 : 0.45, k3 = sk.b / life;
      if (k3 >= 1) { sparks.splice(i, 1); continue; }
      var z = (sk.big ? 34 : 22) * U * (1 - k3 * 0.5);
      c.globalAlpha = 1 - k3; c.drawImage(spA, sk.x - z / 2, sk.y - z / 2, z, z);
      for (j = 0; j < sk.ps.length; j++) {
        var px = sk.x + sk.ps[j][0] * sk.b, py = sk.y + sk.ps[j][1] * sk.b + D * 0.12 * sk.b * sk.b;
        c.drawImage(j % 3 ? spA : spB, px - 3 * U, py - 3 * U, 6 * U, 6 * U);
      }
      c.globalAlpha = 1;
    }
    c.globalCompositeOperation = "source-over";
    vignette();
    toView(c);

    // logo: glow, then the B with its shine sweep
    var la = ease((t - 0.9) / 0.9);
    if (img.glow && la > 0) {
      c.globalAlpha = la * (0.62 + 0.23 * Math.cos(t * 1.9)) * fk;
      var gp = 140 * SC;
      c.drawImage(img.glow, cx - LW / 2 - gp, cy - LH / 2 - gp, LW + 2 * gp, LH + 2 * gp);
      c.globalAlpha = 1;
    }
    drawLogo(t, la);

    // dark shade behind the lettering (keeps it readable over the lanes)
    var shy = textTop + (barY - textTop) / 2;
    c.save(); c.translate(cx, shy); c.scale(Math.min(VW * 0.9, TW * 1.25) / 2, VH * 0.13);
    var sh = c.createRadialGradient(0, 0, 0, 0, 0, 1);
    sh.addColorStop(0, "rgba(2,6,16,.85)"); sh.addColorStop(0.6, "rgba(2,6,16,.55)"); sh.addColorStop(1, "rgba(2,6,16,0)");
    c.fillStyle = sh; c.fillRect(-1, -1, 2, 2); c.restore();

    // lettering rises in, then the progress sweep
    var ta = rise((t - 2.45) / 1.0);
    if (img.text && ta > 0) { c.globalAlpha = ta; c.drawImage(img.text, cx - TW / 2, textTop + 14 * (1 - ta), TW, TH); }
    var ba = rise((t - 2.75) / 1.0);
    if (ba > 0) {
      var bx = cx - barW / 2, by = barY + 14 * (1 - ba);
      c.globalAlpha = ba;
      c.fillStyle = "rgba(120,170,240,.2)"; c.fillRect(bx, by, barW, 3 * U);
      if (t > 3) {
        var f = ((t - 3) % 2.2) / 2.2; f = f < 0.5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2;
        var sx = bx + (-0.4 + 1.4 * f) * barW, sw = barW * 0.4;
        c.save(); c.beginPath(); c.rect(bx, by, barW, 3 * U); c.clip();
        var sg = c.createLinearGradient(sx, 0, sx + sw, 0);
        sg.addColorStop(0, "rgba(" + AC + ",0)"); sg.addColorStop(0.5, "rgba(" + AC + ",1)"); sg.addColorStop(1, "rgba(" + AC + ",0)");
        c.fillStyle = sg; c.fillRect(sx, by, sw, 3 * U); c.restore();
      }
    }
    c.globalAlpha = 1;
    raf = requestAnimationFrame(frame);
  }

  function load(key) {
    return createImageBitmap(blob(PNG[key])).then(function (bm) { img[key] = bm; }, function () {});
  }
  Promise.all([load("logo"), load("glow"), load("text")]).then(function () {
    if (done) return;
    requestAnimationFrame(function (now) {
      T0 = last = now;
      st.setProperty("opacity", "1", "important");
      raf = requestAnimationFrame(frame);
    });
  });
  return "started";
})();
