    var hy = -104, hx = 0;
    if (hitT >= 0) { var u = hitT / 1.6; hx = -28 * Math.sin(Math.min(1, u * 2) * Math.PI / 2) * (u < 0.75 ? 1 : (1 - u) * 4); hy = -104 - 50 * Math.sin(Math.min(1, u * 1.6) * Math.PI) + (u > 0.5 && u < 0.75 ? 80 : 0); }
    c.beginPath(); c.arc(hx, hy, 15, 0, 6.283); c.fill(); c.stroke();
    var eye = cp < BOOT + 1.5 ? (Math.sin(now * 30) > 0 ? 1 : 0.2) : 1;                 // LED eyes flicker on as they boot
    c.globalCompositeOperation = "lighter"; c.globalAlpha = eye;
    c.drawImage(spB, hx - 4 - 9, hy - 4 - 9, 18, 18); c.drawImage(spB, hx + 6 - 9, hy - 4 - 9, 18, 18);
    c.globalAlpha = 1; c.globalCompositeOperation = "source-over";
    c.fillStyle = "#4fb6ff"; c.beginPath(); c.arc(hx - 4, hy - 4, 2.3, 0, 6.283); c.arc(hx + 6, hy - 4, 2.3, 0, 6.283); c.fill();
    c.fillStyle = "#f08c1a"; c.beginPath(); c.moveTo(hx - 2, hy + 1); c.lineTo(hx - 20, hy + 4); c.lineTo(hx - 2, hy + 5); c.closePath(); c.fill();   // carrot, facing the kids
    if (pushing) { c.fillStyle = "#1b1b1b"; c.beginPath(); c.arc(hx + 1, hy + 9, 3.2, 0, 6.283); c.fill(); }                                     // "oh no"
    c.fillStyle = "#c8323c"; c.fillRect(-17, -88, 34, 7); c.fillRect(6, -88, 7, 20);  // scarf
    c.fillStyle = "#1b1b1b"; [-56, -72, -86].forEach(function (by) { c.beginPath(); c.arc(-1, by + 20, 2.5, 0, 6.283); c.fill(); });
    var throwing = cp >= FIGHT0 && cp < FIGHT1 && Math.floor((cp - FIGHT0) / THROW) % 2 === 1 && (Math.floor((cp - FIGHT0) / THROW) >> 1) % 2 === j && ((cp - FIGHT0) % THROW) < 0.35;
    var arm = throwing ? 2.4 - ((cp - FIGHT0) % THROW) / 0.35 * 2.6 : 0.9;
    c.strokeStyle = "#5a3d22"; c.lineWidth = 3.5;
    c.beginPath(); c.moveTo(-18, -74); c.lineTo(-18 - Math.sin(arm) * 30, -74 - Math.cos(arm) * 30); c.moveTo(18, -74); c.lineTo(42, -86); c.stroke();
    c.restore();
  }
  function snowballs(now, w) {
    var cp = now % PLOW_P;
    if (cp < FIGHT0 || cp > FIGHT1 + 6) return;
    var base = (w.pos - 1) * VW * (1 + w.gp), kMax = Math.floor((cp - FIGHT0) / THROW);
    for (var k = Math.max(0, kMax - 4); k <= kMax; k++) {
      if (FIGHT0 + k * THROW > FIGHT1) break;
      var th = throwInfo(k, w, now), u = (cp - th.t0) / th.dur;
      if (u < 0) continue;
      var gyF = VH - groundAt(th.fx, now) - th.fy, gyT = VH - groundAt(th.tx, now) - th.ty;
      if (u <= 1) {
        var X = th.fx + (th.tx - th.fx) * u, Y = gyF + (gyT - gyF) * u - 4 * th.peak * u * (1 - u), xl = X - base;
        if (xl > -20 * U && xl < VW + 20 * U) {
          c.fillStyle = "rgba(0,0,0,.18)"; c.beginPath(); c.arc(xl + 2 * U, Y + 2 * U, 9 * U, 0, 6.283); c.fill();
          c.fillStyle = "#ffffff"; c.beginPath(); c.arc(xl, Y, 9 * U, 0, 6.283); c.fill();
        }
      } else if (u < 1 + 0.5 / th.dur) {                 // splat
        var sx = th.tx - base, sy = gyT, age = (u - 1) * th.dur;
        if (sx > -60 * U && sx < VW + 60 * U) for (var p = 0; p < 7; p++) {
