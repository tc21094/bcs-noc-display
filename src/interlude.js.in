    H.trail = [];
  })();

  function drawSnow(t, dt, near) {          // far flakes go behind the logo, near ones in front
    var wind = 18 * Math.sin(t * 0.07);
    for (var i = 0; i < H.snow.length; i++) {
      var f = H.snow[i];
      if ((f.r >= 2.1) !== near) continue;
      f.y += f.vy * U * dt; f.x += wind * U * dt;
      if (f.y > VH + MG + 10) { var nf = H.newFlake(false); nf.x = rnd(-MG, VW + MG); H.snow[i] = f = nf; }
      if (f.x > VW + MG + 20) f.x -= VW + 2 * MG + 40; else if (f.x < -MG - 20) f.x += VW + 2 * MG + 40;
      var x = f.x + Math.sin(t * f.sf + f.ph) * f.sw * U, d = f.r * U * 2.6;
