    c.strokeStyle = "#7d2f3a"; c.lineWidth = 30; c.beginPath(); c.moveTo(hip[0], hip[1]); c.lineTo(sh[0], sh[1]); c.stroke();
    c.fillStyle = "#7d2f3a"; c.beginPath(); c.ellipse(hip[0] + 6, hip[1] - 14 - br, 18, 14 + br, -a, 0, 6.283); c.fill();
    c.fillStyle = "#f0c8a0"; c.beginPath(); c.arc(hip[0] + 8, hip[1] - 20 - br, 5, 0, 6.283); c.arc(hip[0] + 14, hip[1] - 16 - br, 5, 0, 6.283); c.fill();
    c.fillStyle = "#f0c8a0"; c.beginPath(); c.arc(hd[0], hd[1], 13, 0, 6.283); c.fill();
