// BCS NOC interlude / blanket.
//   interlude: full-screen replay of the boot animation over the dashboard for a
//              few seconds, then faded away (burn-in protection)
//   blanket:   the same scene with "BCS / TECHNOLOGY DEPARTMENT", kept up until
//              window.__bcsBlanketStop() is called; drifts slowly so it can't burn in
// Injected by kiosk-launch through Chrome's DevTools pipe, so it works on any
// dashboard. It adds nothing to the page except one temporary element, and it
// loads nothing from the network.
(function () {
  "use strict";
  var BLANKET = window.__BCS_MODE === "blanket";
  var FLAG = BLANKET ? "__bcsBlanket" : "__bcsInterlude";
  if (window[FLAG]) return "busy";
  window[FLAG] = true;

  var DUR = BLANKET ? Infinity : Math.max(6, Number(window.__BCS_INTERLUDE_SECONDS) || 12);
  var D = @@DATA@@;
  var PNG = { logo: "@@LOGO@@", glow: "@@GLOW@@", text: BLANKET ? "@@TEXT2@@" : "@@TEXT@@" };
  var TEXT_BOX = BLANKET ? D.text2 : D.text;

  var done = false, raf = 0, host = null;
  function cleanup() {
    if (done) return;
    done = true;
    if (raf) cancelAnimationFrame(raf);
    try { if (host && host.hidePopover) host.hidePopover(); } catch (e) {}
    try { if (host) host.remove(); } catch (e) {}
    window[FLAG] = false;
    if (BLANKET) window.__bcsBlanketStop = null;
  }
  if (!BLANKET) setTimeout(cleanup, (DUR + 8) * 1000);   // safety net if animation frames stop

  function blob(b64) {
    var bin = atob(b64), n = bin.length, u = new Uint8Array(n);
    for (var i = 0; i < n; i++) u[i] = bin.charCodeAt(i);
    return new Blob([u], { type: "image/png" });
  }
  function ease(v) { v = v < 0 ? 0 : v > 1 ? 1 : v; return v * v * (3 - 2 * v); }

  // ---------------------------------------------------------------- overlay element
  host = document.createElement("div");
  var st = host.style;
  st.setProperty("position", "fixed", "important");
  st.setProperty("inset", "0", "important");
  st.setProperty("width", "100vw", "important");
  st.setProperty("height", "100vh", "important");
  st.setProperty("max-width", "none", "important");
  st.setProperty("max-height", "none", "important");
  st.setProperty("margin", "0", "important");
  st.setProperty("padding", "0", "important");
  st.setProperty("border", "0", "important");
  st.setProperty("background", "#050a17", "important");
  st.setProperty("z-index", "2147483647", "important");
  // the blanket catches the mouse so the hot corner works anywhere on it
  st.setProperty("pointer-events", BLANKET ? "auto" : "none", "important");
  st.setProperty("overflow", "hidden", "important");
  st.setProperty("display", "block", "important");
  st.setProperty("opacity", "0", "important");
  st.setProperty("transition", "opacity 0.7s ease", "important");
  var root = host.attachShadow ? host.attachShadow({ mode: "closed" }) : host;
  var cv = document.createElement("canvas");
  cv.style.cssText = "display:block;width:100%;height:100%";
  root.appendChild(cv);
  try { host.popover = "manual"; } catch (e) {}
  document.documentElement.appendChild(host);
  try { if (host.showPopover) host.showPopover(); } catch (e) {}   // top layer: above anything the page does

  // ---------------------------------------------------------------- canvas setup
  var dpr = Math.min(window.devicePixelRatio || 1, 2);
  var cw = Math.round(window.innerWidth * dpr), ch = Math.round(window.innerHeight * dpr);
  var cap = Math.min(1, 2560 / cw, 1440 / ch);              // keep memory and GPU work modest
  cw = Math.max(1, Math.round(cw * cap)); ch = Math.max(1, Math.round(ch * cap));
  cv.width = cw; cv.height = ch;
  var ctx = cv.getContext("2d");
  var S = Math.min(cw / 1920, ch / 1080), OX = (cw - 1920 * S) / 2, OY = (ch - 1080 * S) / 2;

  // static background (gradient + faint circuit maze), drawn once
  var bgc = document.createElement("canvas"), b;
  var gr = ctx.createLinearGradient(0, 0, 0, ch);
  gr.addColorStop(0, "#070d1c"); gr.addColorStop(1, "#02050c");
  var MP = Math.ceil(24 * S);   // margin so the drifting maze never shows an edge
  bgc.width = cw + 2 * MP; bgc.height = ch + 2 * MP;
  b = bgc.getContext("2d");
  b.setTransform(S, 0, 0, S, OX + MP, OY + MP);
  b.lineJoin = "round"; b.lineCap = "round";
  b.strokeStyle = "rgba(60,100,190,0.12)"; b.lineWidth = 2;
  D.maze.forEach(function (pts) {
    b.beginPath(); b.moveTo(pts[0][0], pts[0][1]);
    for (var i = 1; i < pts.length; i++) b.lineTo(pts[i][0], pts[i][1]);
    b.stroke();
  });
  b.strokeStyle = "rgba(70,115,210,0.18)";
  D.vias.forEach(function (p) { b.beginPath(); b.arc(p[0], p[1], 4, 0, 6.2832); b.stroke(); });
  b.fillStyle = "rgba(80,120,210,0.14)";
  D.dots.forEach(function (p) { b.fillRect(p[0] - 0.75, p[1] - 0.75, 1.5, 1.5); });

  // ---------------------------------------------------------------- drawing helpers
  var CORE = "rgba(52,112,235,0.92)";
  function pointAt(tr, s) {
    var p = tr.p, ps = tr.s, k = 0;
    while (k < p.length - 2 && s > ps[k + 1]) k++;
    var seg = ps[k + 1] - ps[k], f = seg > 0 ? (s - ps[k]) / seg : 0;
    f = f < 0 ? 0 : f > 1 ? 1 : f;
    return [p[k][0] + (p[k + 1][0] - p[k][0]) * f, p[k][1] + (p[k + 1][1] - p[k][1]) * f];
  }
  function tracePath(tr, s) {
    var p = tr.p, ps = tr.s;
    ctx.beginPath(); ctx.moveTo(p[0][0], p[0][1]);
    for (var i = 1; i < p.length; i++) {
      if (s >= ps[i]) { ctx.lineTo(p[i][0], p[i][1]); continue; }
      var q = pointAt(tr, s); ctx.lineTo(q[0], q[1]); break;
    }
  }
  function dot(x, y, r, c0, c1, c2) {
    var g = ctx.createRadialGradient(x, y, 0, x, y, r);
    g.addColorStop(0, c0); g.addColorStop(0.2, c0); g.addColorStop(0.42, c1); g.addColorStop(1, c2);
    ctx.fillStyle = g; ctx.fillRect(x - r, y - r, 2 * r, 2 * r);
  }
  var BLUE = ["rgba(240,248,255,1)", "rgba(120,175,255,0.6)", "rgba(30,85,230,0)"];
  var RED = ["rgba(255,225,228,1)", "rgba(235,45,70,0.65)", "rgba(235,45,70,0)"];
  function flash(x, y, age) {
    if (age < 0 || age > 0.5) return;
    var a = 1 - age / 0.5;
    ctx.strokeStyle = "rgba(120,175,255," + (0.9 * a).toFixed(3) + ")";
    ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(x, y, 10 + 14 * (age / 0.5), 0, 6.2832); ctx.stroke();
  }

  // ---------------------------------------------------------------- pulses
  var NP = 9, pulses = [];
  for (var k = 0; k < NP; k++) pulses.push({ on: false, wait: k * 0.18 + Math.random() * 0.4, fl: -1 });
  function stepPulse(p, dt, t) {
    if (!p.on) {
      p.wait -= dt;
      if (p.wait <= 0) {
        p.on = true; p.s = 0; p.v = 520 + Math.random() * 380;
        p.tr = D.traces[Math.floor(Math.random() * D.traces.length)];
        p.c = Math.random() < 0.25 ? RED : BLUE;
      }
    } else {
      p.s += p.v * dt;
      if (p.s >= p.tr.L) {
        p.on = false; p.wait = 0.2 + Math.random() * 1.4;
        p.fp = pointAt(p.tr, p.tr.L); p.fl = t;
      }
    }
    if (p.fp) flash(p.fp[0], p.fp[1], t - p.fl);
    if (!p.on) return;
    var fade = Math.min(1, p.s / 30);
    ctx.globalAlpha = fade * 0.4; var q = pointAt(p.tr, Math.max(0, p.s - 32)); dot(q[0], q[1], 11, p.c[0], p.c[1], p.c[2]);
    ctx.globalAlpha = fade * 0.7; q = pointAt(p.tr, Math.max(0, p.s - 16)); dot(q[0], q[1], 11, p.c[0], p.c[1], p.c[2]);
    ctx.globalAlpha = fade; q = pointAt(p.tr, p.s); dot(q[0], q[1], 20, p.c[0], p.c[1], p.c[2]);
    ctx.globalAlpha = 1;
  }

  // ---------------------------------------------------------------- main loop
  var img = {}, T0 = 0, last = 0, leaving = false, endAt = DUR;
  function leave() {
    if (leaving) return;
    leaving = true;
    endAt = (performance.now() - T0) / 1000 + 0.9;
    st.setProperty("transition", "opacity 0.9s ease", "important");
    st.setProperty("opacity", "0", "important");
  }
  if (BLANKET) window.__bcsBlanketStop = function () { if (!T0) cleanup(); else leave(); return "stopping"; };
  function frame(now) {
    if (done) return;
    if (BLANKET && now - last < 31) { raf = requestAnimationFrame(frame); return; }   // ~30 fps is plenty
    var t = (now - T0) / 1000, dt = Math.min(0.1, (now - last) / 1000);
    last = now;
    if (t >= endAt) { cleanup(); return; }
    if (!BLANKET && t >= DUR - 0.9) leave();

    // blanket: whole scene orbits slowly (a few pixels over minutes) so nothing sits still
    var dx = 0, dy = 0;
    if (BLANKET) { dx = 14 * Math.cos(t * 6.2832 / 300); dy = 9 * Math.sin(t * 6.2832 / 300); }
    ctx.setTransform(1, 0, 0, 1, 0, 0);
    ctx.fillStyle = gr; ctx.fillRect(0, 0, cw, ch);
    ctx.drawImage(bgc, Math.round(dx * S) - MP, Math.round(dy * S) - MP);
    ctx.setTransform(S, 0, 0, S, OX + dx * S, OY + dy * S);
    ctx.lineJoin = "round"; ctx.lineCap = "round";

    // traces draw outward from the logo
    for (var i = 0; i < D.traces.length; i++) {
      var tr = D.traces[i], start = 0.7 + tr.t0, s = (t - start) * tr.v;
      if (s <= 0) continue;
      if (s > tr.L) s = tr.L;
      tracePath(tr, s);
      ctx.strokeStyle = "rgba(30,85,230,0.16)"; ctx.lineWidth = 11; ctx.stroke();
      ctx.strokeStyle = "rgba(40,95,235,0.28)"; ctx.lineWidth = 6; ctx.stroke();
      ctx.strokeStyle = CORE; ctx.lineWidth = 2.6; ctx.stroke();
      var p0 = tr.p[0], hz = Math.abs(tr.p[1][1] - p0[1]) < 0.5;
      ctx.fillStyle = CORE;
      if (hz) ctx.fillRect(p0[0] - 5, p0[1] - 3.5, 10, 7); else ctx.fillRect(p0[0] - 3.5, p0[1] - 5, 7, 10);
      var e = pointAt(tr, s);
      if (s >= tr.L) {
        ctx.strokeStyle = "rgba(30,85,230,0.22)"; ctx.lineWidth = 9;
        ctx.beginPath(); ctx.arc(e[0], e[1], 5.25, 0, 6.2832); ctx.stroke();
        ctx.strokeStyle = CORE; ctx.lineWidth = 4.5; ctx.stroke();
        flash(e[0], e[1], t - (start + tr.L / tr.v));
      } else {
        dot(e[0], e[1], 20, BLUE[0], BLUE[1], BLUE[2]);
      }
    }

    // logo + glow
    var ga = t < 1.9 ? ease((t - 0.6) / 1.2) * 0.85 : 0.62 + 0.23 * Math.cos((t - 1.9) * 1.9);
    if (img.glow) { ctx.globalAlpha = ga; ctx.drawImage(img.glow, D.glow[0], D.glow[1], D.glow[2], D.glow[3]); }
    if (img.logo) { ctx.globalAlpha = ease((t - 0.5) / 0.7); ctx.drawImage(img.logo, D.logo[0], D.logo[1], D.logo[2], D.logo[3]); }
    // BCS NOC
    var ta = ease((t - 1.85) / 0.7);
    if (img.text && ta > 0) { ctx.globalAlpha = ta; ctx.drawImage(img.text, TEXT_BOX[0], TEXT_BOX[1] + 14 * (1 - ta), TEXT_BOX[2], TEXT_BOX[3]); }
    ctx.globalAlpha = 1;

    if (t > 2.9) for (var j = 0; j < NP; j++) stepPulse(pulses[j], dt, t);

    raf = requestAnimationFrame(frame);
  }

  function load(key) {
    return createImageBitmap(blob(PNG[key])).then(function (bm) { img[key] = bm; }, function () {});
  }
  Promise.all([load("logo"), load("glow"), load("text")]).then(function () {
    if (done) return;
    requestAnimationFrame(function (now) {
      T0 = last = now;
      st.setProperty("opacity", "1", "important");
      raf = requestAnimationFrame(frame);
    });
  });
  return "started";
})();
