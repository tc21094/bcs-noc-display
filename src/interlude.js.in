    s.width = s.height = z;
    var g = s.getContext("2d"), r = g.createRadialGradient(z / 2, z / 2, 0, z / 2, z / 2, z / 2);
    r.addColorStop(0, "rgba(255,255,255,1)"); r.addColorStop(0.18, "rgba(" + col + ",.9)");
    r.addColorStop(0.5, "rgba(" + col + ",.22)"); r.addColorStop(1, "rgba(" + col + ",0)");
    g.fillStyle = r; g.fillRect(0, 0, z, z);
    return s;
  }
  var GOLD = "255,200,90";
  var FEST = ["235,64,72", "70,205,120", GOLD, BL];         // holiday pulse colours
  var spB = sprite(BL), spA = sprite(HOLIDAY ? GOLD : FALL || THANKS ? "240,150,50" : AC), spF = HOLIDAY ? FEST.map(sprite) : null;
  // ---------------------------------------------------------------- fall theme (interlude only)
  // Automatic from the autumn equinox (Sept 22) through Thanksgiving (4th Thursday of November):
  // autumn-coloured data pulses, leaves tumbling down (a gust blows through halfway), a few
  // settling on the B and a drift of them collecting along the bottom.
  var LEAF = ["214,96,38", "190,52,38", "232,168,52", "150,92,48"];
  var spL = FALL || THANKS ? LEAF.map(sprite) : null, L = {};
  if (FALL || THANKS) (function () {
    L.img = LEAF.map(function (col, i) {
