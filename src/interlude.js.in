      if (f.x > VW + MG + 20) f.x -= VW + 2 * MG + 40; else if (f.x < -MG - 20) f.x += VW + 2 * MG + 40;
      var x = f.x + Math.sin(t * f.sf + f.ph) * f.sw * U, d = f.r * U * 2.6;
      c.globalAlpha = f.a; c.drawImage(H.flake, x - d / 2, f.y - d / 2, d, d);
    }
    c.globalAlpha = 1;
  }

  function snowCap(alpha) {                 // snow resting on the top edge of the B
    if (alpha <= 0) return;
    var x0 = cx - LW / 2 + LW * 0.012, x1 = cx - LW / 2 + LW * 0.845, y = cy - LH / 2 + LH * 0.014, h = LH * 0.05, n = 9, k, xx;
    c.save(); c.globalAlpha = alpha;
    c.beginPath(); c.moveTo(x0, y + h * 0.2);
    for (k = 1; k <= n; k++) {
      xx = x0 + (x1 - x0) * k / n;
      var bump = h * (0.55 + 0.45 * Math.sin(k * 2.3 + 1.1));
      c.quadraticCurveTo(xx - (x1 - x0) / n / 2, y - bump - h * 0.3, xx, y - bump * 0.45);
    }
    c.quadraticCurveTo(x1 + h * 0.5, y, x1, y + h * 0.35);
    for (k = n; k >= 0; k--) { xx = x0 + (x1 - x0) * k / n; c.lineTo(xx, y + (k % 3 === 1 ? h * 0.85 : h * 0.3)); }
    c.closePath();
