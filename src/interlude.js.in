  function cl(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }
  function ease(v) { v = cl(v); return v < 0.5 ? 4 * v * v * v : 1 - Math.pow(-2 * v + 2, 3) / 2; }
  function rise(v) { v = cl(v); return 1 - Math.pow(1 - v, 4); }            // ~cubic-bezier(.16,1,.3,1)
  function rnd(a, b) { return a + Math.random() * (b - a); }

  // ---------------------------------------------------------------- overlay element
  host = document.createElement("div");
  var st = host.style;
  [["position", "fixed"], ["inset", "0"], ["width", "100vw"], ["height", "100vh"], ["max-width", "none"],
   ["max-height", "none"], ["margin", "0"], ["padding", "0"], ["border", "0"], ["background", "rgb(2,6,16)"],
   ["z-index", "2147483647"], ["pointer-events", BLANKET ? "auto" : "none"], ["overflow", "hidden"],
   ["display", "block"], ["opacity", "0"], ["transition", "opacity 0.7s ease"]].forEach(function (p) {
    st.setProperty(p[0], p[1], "important");
  });
  var root = host.attachShadow ? host.attachShadow({ mode: "closed" }) : host;
  var VW = window.innerWidth, VH = window.innerHeight, D = Math.min(VW, VH);
  var U = Math.max(1, D / 1080);             // line/sprite size unit: same look at 1080p and 4K
  var MG = BLANKET ? 24 : 0;                 // margin so the drifting scene never shows an edge
  var wrap = document.createElement("div");
  wrap.style.cssText = "position:absolute;left:" + -MG + "px;top:" + -MG + "px;width:" + (VW + 2 * MG) + "px;height:" + (VH + 2 * MG) + "px;will-change:transform";
  var bgc = document.createElement("canvas"), fxc = document.createElement("canvas");
  [bgc, fxc].forEach(function (cv) { cv.style.cssText = "position:absolute;left:0;top:0;width:100%;height:100%"; wrap.appendChild(cv); });
  root.appendChild(wrap);
  try { host.popover = "manual"; } catch (e) {}
  document.documentElement.appendChild(host);
  try { if (host.showPopover) host.showPopover(); } catch (e) {}   // top layer: above anything the page does

  // backing store: device pixels, capped to keep memory and GPU work modest
