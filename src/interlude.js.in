    c.fillStyle = "#f2e8cf"; c.fill();
    c.save(); c.clip();
    c.fillStyle = "#2a9d8f"; c.fillRect(x0 - 5, oy + bh * 0.6, L + 10, bh * 0.5);
    c.fillStyle = "#d9dde2"; c.fillRect(x0 - 5, oy + bh * 0.58, L + 10, bh * 0.035);
    c.restore();
    c.strokeStyle = "rgba(40,50,60,.55)"; c.lineWidth = 2 * U; c.stroke();
    // windows (warm glow once it's dug out), door with a wreath
    var glowA = 0.25 + 0.75 * open;
    [[0.1, 0.33], [0.62, 0.86]].forEach(function (wn) {
      var a = P(wn[0], 0.2), z = P(wn[1], 0.46);
      c.fillStyle = "rgba(255,196,105," + glowA.toFixed(2) + ")"; rr(a[0], a[1], z[0] - a[0], z[1] - a[1], 8 * U); c.fill();
      c.strokeStyle = "#cfd5dc"; c.lineWidth = 3 * U; c.stroke();
    });
    var d0 = P(0.4, 0.24), d1 = P(0.54, 0.98);
    c.fillStyle = "#efe4c8"; rr(d0[0], d0[1], d1[0] - d0[0], d1[1] - d0[1], 6 * U); c.fill(); c.strokeStyle = "rgba(40,50,60,.5)"; c.stroke();
    var dw = P(0.47, 0.37); c.fillStyle = "rgba(255,196,105," + glowA.toFixed(2) + ")"; c.beginPath(); c.arc(dw[0], dw[1], 0.035 * L, 0, 6.283); c.fill();
    var wr = P(0.47, 0.64); c.strokeStyle = "#1f7a3a"; c.lineWidth = 6 * U; c.beginPath(); c.arc(wr[0], wr[1], 0.03 * L, 0, 6.283); c.stroke();
    c.fillStyle = "#d62839"; c.beginPath(); c.arc(wr[0], wr[1] + 0.03 * L, 4 * U, 0, 6.283); c.fill();
    // wheel and fender
    var wc = P(0.5, 1); c.fillStyle = "#1c1f24"; c.beginPath(); c.arc(wc[0], VH - CH * 0.11, CH * 0.11, 0, 6.283); c.fill();
    c.fillStyle = "#c9ced6"; c.beginPath(); c.arc(wc[0], VH - CH * 0.11, CH * 0.05, 0, 6.283); c.fill();
    // stovepipe, smoke and roof lights once it's dug out
    var sp = P(0.76, 0.03); c.fillStyle = "#4a4f57"; c.fillRect(sp[0] - 5 * U, sp[1] - 26 * U, 10 * U, 26 * U); c.fillRect(sp[0] - 9 * U, sp[1] - 30 * U, 18 * U, 6 * U);
    if (open > 0.6) {
      if (Math.random() < dt * 2.5) H.smoke.push({ x: sp[0], y: sp[1] - 32 * U, b: 0 });
      var ns = 9;
      for (var k = 1; k < ns; k++) {
        var lp = P(0.18 + 0.66 * k / ns, 0.015 + 0.02 * Math.sin(k * 0.4)), on = 0.5 + 0.5 * Math.sin(now * 3 + k * 1.3);
        c.fillStyle = "rgba(" + FEST[k % 4] + "," + (0.45 + 0.55 * on).toFixed(2) + ")"; c.beginPath(); c.arc(lp[0], lp[1], 4.5 * U, 0, 6.283); c.fill();
      }
    }
    for (var i = H.smoke.length - 1; i >= 0; i--) {
      var s = H.smoke[i]; s.b += dt;
      if (s.b > 4) { H.smoke.splice(i, 1); continue; }
      s.y -= 18 * U * dt; s.x += (6 + 4 * Math.sin(s.b * 2)) * U * dt;
      c.fillStyle = "rgba(200,205,215," + (0.35 * (1 - s.b / 4)).toFixed(3) + ")";
      c.beginPath(); c.arc(s.x, s.y, (6 + s.b * 7) * U, 0, 6.283); c.fill();
    }
    // a little snow left on the roof
    if (open > 0.3) { var r0 = P(0.27, 0.005), r1 = P(0.78, 0.04); c.fillStyle = "rgba(250,252,255,.95)"; rr(r0[0], r0[1] - 7 * U, r1[0] - r0[0], 10 * U, 5 * U); c.fill(); }
    c.restore();
  }

  // ---- the plow: a BCS truck pushing a growing pile of snow across the whole wall
  H.spray = [];
  function plow(now, w, dt) {
    var t0 = plowStart(now);
    if (now < t0) return;
    var v = VW / PLOW_T, front = (now - t0) * v - PLOW_LEN;              // blade, in wall coordinates
    var fl = front - (w.pos - 1) * VW * (1 + w.gp);                       // blade on this display
    var pile = HD * (0.8 + 1.7 * cl(front / (VW * 0.9)));
    if (w.pos === w.n) pile = Math.max(pile, CH * 1.05 * cl((fl - VW * CAMP.x0 + CH * 0.6) / CH));   // the camper's bank
    var pw = pile * 2.3;
    if (fl < -40 * U || fl - PLOW_LEN > VW + 40 * U) {
      if (fl > VW && fl < VW + pw + 40 * U) pileShape(fl, pile, pw, now);   // the pile leaves a moment after the truck
      return;
    }
    var gy = VH - 2 * U, sc = U, flash = 0.5 + 0.5 * Math.sin(now * 9);
    c.save(); c.translate(fl, gy); c.scale(sc, sc);
    // exhaust
    if (Math.random() < dt * 4) H.spray.push({ x: fl - 182 * U, y: gy - 152 * U, vx: -10 * U, vy: -30 * U, b: 0, smoke: true });
    c.fillStyle = "#3a3d42"; c.fillRect(-186, -150, 8, 60);
    // dump body with sander
    c.fillStyle = "#f08c1a"; rr(-312, -112, 140, 74, 6); c.fill();
    c.fillStyle = "rgba(0,0,0,.15)"; for (var r = 0; r < 4; r++) c.fillRect(-300 + r * 34, -108, 5, 66);
    c.fillStyle = "#2b2e33"; c.fillRect(-330, -70, 20, 30);
    // chassis
    c.fillStyle = "#2b2e33"; c.fillRect(-318, -40, 270, 14);
    // cab
    c.fillStyle = "#f6a21e"; c.beginPath(); c.moveTo(-172, -40); c.lineTo(-172, -128); c.quadraticCurveTo(-170, -138, -158, -138);
    c.lineTo(-112, -138); c.lineTo(-92, -98); c.lineTo(-92, -40); c.closePath(); c.fill();
    c.fillStyle = "rgba(150,200,240,.85)"; c.beginPath(); c.moveTo(-160, -128); c.lineTo(-118, -128); c.lineTo(-102, -100); c.lineTo(-160, -100); c.closePath(); c.fill();
    c.fillStyle = "#1d4fa0"; c.font = "bold 22px sans-serif"; c.fillText("BCS", -158, -66);
    // beacon on the roof
    c.fillStyle = "rgba(255,170,30," + (0.5 + 0.5 * flash).toFixed(2) + ")"; c.beginPath(); c.arc(-136, -144, 7, 0, 6.283); c.fill();
    c.globalCompositeOperation = "lighter"; c.globalAlpha = flash;
    c.drawImage(spA, -136 - 34, -144 - 34, 68, 68);
    c.globalAlpha = 1; c.globalCompositeOperation = "source-over";
    // hood, headlight and beam
    c.fillStyle = "#f6a21e"; rr(-96, -88, 44, 48, 6); c.fill();
    var beam = c.createLinearGradient(-50, 0, 120, 0); beam.addColorStop(0, "rgba(255,245,200,.35)"); beam.addColorStop(1, "rgba(255,245,200,0)");
    c.fillStyle = beam; c.beginPath(); c.moveTo(-52, -72); c.lineTo(140, -100); c.lineTo(140, -20); c.closePath(); c.fill();
    c.fillStyle = "#fff6d6"; c.beginPath(); c.arc(-54, -70, 6, 0, 6.283); c.fill();
    // wheels
    [-268, -112].forEach(function (wx) {
      c.fillStyle = "#16181b"; c.beginPath(); c.arc(wx, -26, 26, 0, 6.283); c.fill();
      c.save(); c.translate(wx, -26); c.rotate((now * v / (26 * U)) % 6.283);
      c.fillStyle = "#9aa1ab"; c.beginPath(); c.arc(0, 0, 10, 0, 6.283); c.fill();
      c.fillStyle = "#16181b"; c.fillRect(-2, -10, 4, 20); c.restore();
    });
    // blade with hazard stripes
    c.fillStyle = "#2b2e33"; c.fillRect(-56, -50, 26, 10);
    c.save(); c.beginPath(); c.moveTo(-34, -98); c.quadraticCurveTo(-6, -60, -4, -4); c.lineTo(-24, -4); c.quadraticCurveTo(-28, -60, -44, -96); c.closePath();
    c.fillStyle = "#ffd23f"; c.fill(); c.clip();
    c.fillStyle = "#1b1b1b"; for (var hz = -110; hz < 10; hz += 22) { c.beginPath(); c.moveTo(-50, hz); c.lineTo(0, hz + 30); c.lineTo(0, hz + 41); c.lineTo(-50, hz + 11); c.closePath(); c.fill(); }
    c.restore();
    c.restore();
    pileShape(fl, pile, pw, now);
    // snow flying off the top of the pile
    if (fl > -pw && fl < VW + pw) for (var e = 0; e < 3; e++)
      H.spray.push({ x: fl + rnd(0.2, 0.9) * pw, y: gy - pile * rnd(0.6, 1), vx: rnd(40, 140) * U, vy: rnd(-120, -40) * U, b: 0 });
    for (var i = H.spray.length - 1; i >= 0; i--) {
      var s = H.spray[i]; s.b += dt;
      if (s.b > (s.smoke ? 2.5 : 1.1)) { H.spray.splice(i, 1); continue; }
      s.x += s.vx * dt; s.y += s.vy * dt; if (!s.smoke) s.vy += 260 * U * dt;
      if (s.smoke) { c.fillStyle = "rgba(90,95,105," + (0.3 * (1 - s.b / 2.5)).toFixed(3) + ")"; c.beginPath(); c.arc(s.x, s.y, (5 + s.b * 9) * U, 0, 6.283); c.fill(); }
      else { c.globalAlpha = 1 - s.b / 1.1; c.drawImage(H.flake, s.x - 4 * U, s.y - 4 * U, 8 * U, 8 * U); c.globalAlpha = 1; }
    }
  }
  function pileShape(fl, pile, pw, now) {
    var gy = VH;
    c.beginPath(); c.moveTo(fl - 6 * U, gy);
    for (var k = 0; k <= 12; k++) {
      var u = k / 12, bump = 1 + 0.08 * Math.sin(u * 17 + now * 0.7);
      c.lineTo(fl - 6 * U + u * pw, gy - pile * Math.pow(Math.sin((0.08 + u * 0.92) * Math.PI * 0.62 + 0.3), 1.6) * bump);
    }
    c.lineTo(fl + pw, gy); c.closePath();
    var g = c.createLinearGradient(0, gy - pile, 0, gy);
    g.addColorStop(0, "#ffffff"); g.addColorStop(1, "#c6d6ea");
    c.fillStyle = g; c.fill();
  }

  // ---- ladder guy: three times per 8-minute cycle (and finished before the plow comes through),
  // at a random spot on one display, a gap in the lights goes dark; he props up a ladder, climbs,
  // fixes it (the bulbs come back on), and climbs down
  var LAD_P = 160, LAD_AT = 140, LAD_D = 40;
  function ladderEvent(now, w) {
    var slot = Math.floor(now / LAD_P), t = now - slot * LAD_P - LAD_AT;
    if (t < 0 || t > LAD_D) return null;
    if (1 + Math.floor(hash(slot * 3 + 1) * w.n) !== w.pos) return null;
    var r = hash(slot * 7 + 5), left = r < 0.5 || w.pos === w.n;           // the camper takes the right side of the last display
    return { t: t, x: VW * (left ? 0.07 + 0.25 * (r < 0.5 ? r * 2 : r * 2 - 1) : 0.68 + 0.25 * (r * 2 - 1)) };
  }
  function bulbLit(px, ev) {                  // the bulbs near him are out until he's fixed them
    if (!ev || Math.abs(px - ev.x) > VW * 0.13) return true;
    return ev.t >= 15 && (ev.t - 15) * VW * 0.13 / 5 >= Math.abs(px - ev.x);
  }
  function ladderGuy(ev, now) {
    if (!ev) return;
    var lt = ev.t, top = VH * 0.085;
    var up = lt < 2.5 ? rise(lt / 2.5) : lt > 34 ? 1 - rise((lt - 34) / 3) : 1;
    var ly = top + (1 - up) * (VH - top + 40 * U);                       // ladder slides up from below
    var x = ev.x, rw = 26 * U, gap = 34 * U;
    c.strokeStyle = "#b9c0c9"; c.lineWidth = 6 * U; c.lineCap = "round";
    c.beginPath(); c.moveTo(x - rw, VH + 10); c.lineTo(x - rw, ly); c.moveTo(x + rw, VH + 10); c.lineTo(x + rw, ly); c.stroke();
    c.lineWidth = 4 * U;
    for (var ry = VH - gap * 0.6; ry > ly + 6 * U; ry -= gap) { c.beginPath(); c.moveTo(x - rw, ry); c.lineTo(x + rw, ry); c.stroke(); }
    // him: in from below, up, at the top fixing the lights, back down
    var bottom = VH + 175 * U, high = top + 200 * U, fy;
    if (lt < 3 || lt > 33) return;
    if (lt < 14) fy = bottom + (high - bottom) * ease((lt - 3) / 11);
    else if (lt < 23) fy = high;
    else fy = high + (bottom - high) * ease((lt - 23) / 10);
    var climbing = (lt > 3 && lt < 14) || (lt > 23 && lt < 33), ph = fy / gap * Math.PI;
    var reach = lt >= 14 && lt < 23;
    c.save(); c.translate(x, fy); c.scale(U * 1.35, U * 1.35);
    var lf = climbing ? -16 * Math.max(0, Math.sin(ph)) : 0, rf = climbing ? -16 * Math.max(0, -Math.sin(ph)) : 0;
    c.strokeStyle = "#2f4a7a"; c.lineWidth = 11; c.lineCap = "round";                 // jeans
    c.beginPath(); c.moveTo(-8, -52); c.lineTo(-10, -26 + lf / 2); c.lineTo(-9, lf); c.stroke();
    c.beginPath(); c.moveTo(8, -52); c.lineTo(10, -26 + rf / 2); c.lineTo(9, rf); c.stroke();
    c.fillStyle = "#4a2f1d"; c.beginPath(); c.ellipse(-9, lf + 3, 8, 5, 0, 0, 6.283); c.fill(); c.beginPath(); c.ellipse(9, rf + 3, 8, 5, 0, 0, 6.283); c.fill();
    c.fillStyle = "#c8432f"; rr(-19, -100, 38, 54, 12); c.fill();                     // puffy coat, from behind
    c.strokeStyle = "rgba(0,0,0,.18)"; c.lineWidth = 2; c.beginPath(); c.moveTo(-17, -82); c.lineTo(17, -82); c.moveTo(-18, -64); c.lineTo(18, -64); c.stroke();
    c.strokeStyle = "rgba(255,255,255,.85)"; c.lineWidth = 2.5; c.beginPath(); c.ellipse(4, -74, 16, 22, -0.6, 0, 6.283); c.stroke();   // coil of lights over his shoulder
    for (var k = 0; k < 6; k++) { var a = k * 1.05; c.fillStyle = "rgb(" + FEST[k % 4] + ")"; c.beginPath(); c.arc(4 + Math.cos(a) * 16 * Math.cos(-0.6) - Math.sin(a) * 22 * Math.sin(-0.6), -74 + Math.cos(a) * 16 * Math.sin(-0.6) + Math.sin(a) * 22 * Math.cos(-0.6), 2.6, 0, 6.283); c.fill(); }
    var lh = climbing ? -128 + 10 * Math.sin(ph) : -128, rh = reach ? -160 + 6 * Math.sin(now * 6) : climbing ? -128 - 10 * Math.sin(ph) : -128;
    c.strokeStyle = "#c8432f"; c.lineWidth = 10;                                         // arms up to the rails / the lights
    c.beginPath(); c.moveTo(-15, -94); c.lineTo(-24, lh); c.moveTo(15, -94); c.lineTo(reach ? 18 : 24, rh); c.stroke();
    c.fillStyle = "#2e6b3f"; c.beginPath(); c.arc(-24, lh, 6, 0, 6.283); c.arc(reach ? 18 : 24, rh, 6, 0, 6.283); c.fill();  // gloves
    c.fillStyle = "#6b4a2e"; c.beginPath(); c.arc(0, -110, 12, 0, 6.283); c.fill();     // back of his head
    c.fillStyle = "#2e8b57"; c.beginPath(); c.arc(0, -113, 12.5, Math.PI, 0); c.fill(); c.fillRect(-12.5, -114, 25, 6);   // beanie
    c.fillStyle = "#ffffff"; c.beginPath(); c.arc(0, -127, 5, 0, 6.283); c.fill();
    c.restore();
  }

  function garland(t, ev) {                 // twinkling lights draped across the top
    var swags = 3, w = (VW + 2 * MG) / swags, top = VH * 0.012, sag = VH * 0.06;
    var glows = [];
    for (var sI = 0; sI < swags; sI++) {
      var x0 = -MG + sI * w, x1 = x0 + w, mx = (x0 + x1) / 2, my = top + 2 * sag;
      c.strokeStyle = "rgba(25,40,32,.95)"; c.lineWidth = 2 * U;
      c.beginPath(); c.moveTo(x0, top); c.quadraticCurveTo(mx, my, x1, top); c.stroke();
      var nb = Math.max(4, Math.round(w / (70 * U)));
      for (var b = 1; b < nb; b++) {
        var u = b / nb, px = (1 - u) * (1 - u) * x0 + 2 * u * (1 - u) * mx + u * u * x1, py = (1 - u) * (1 - u) * top + 2 * u * (1 - u) * my + u * u * top;
        var ci = (sI * nb + b) % 4, tw = 0.55 + 0.45 * Math.sin(t * (1.3 + (b % 3) * 0.45) + b * 1.7 + sI);
        var lit = bulbLit(px, ev);
        c.fillStyle = "rgba(25,40,32,1)"; c.fillRect(px - 2.5 * U, py, 5 * U, 4 * U);
        c.fillStyle = lit ? "rgba(" + FEST[ci] + "," + (0.55 + 0.45 * tw).toFixed(3) + ")" : "rgba(70,78,88,.9)";
        c.beginPath(); c.ellipse(px, py + 9 * U, 4.2 * U, 6.5 * U, 0, 0, 6.283); c.fill();
        if (lit) glows.push(px, py + 9 * U, ci, tw);
      }
    }
    c.globalCompositeOperation = "lighter";              // all the glows in one pass
    for (var gI = 0; gI < glows.length; gI += 4) {
      c.globalAlpha = glows[gI + 3];
      c.drawImage(spF[glows[gI + 2]], glows[gI] - 16 * U, glows[gI + 1] - 16 * U, 32 * U, 32 * U);
    }
    c.globalAlpha = 1; c.globalCompositeOperation = "source-over";
  }

  // ---- sleigh: crosses display 1, then 2, then 3 ... on the shared wall clock
  var SLEIGH_T = 7, TEAM_W = 420;           // seconds per display; team length (units)
  function wall() {                         // read live, so 'noc wall' applies without restarting the blanket
    var w = window.__BCS_WALL;
    return (w && w[0] >= 1 && w[0] <= w[1]) ? w : WALL;
  }
  var INK = "rgba(232,242,255,.96)";
  function leg(x, y, a1, a2) {
    var kx = x + Math.sin(a1) * 14, ky = y + Math.cos(a1) * 14;
    c.beginPath(); c.moveTo(x, y); c.lineTo(kx, ky); c.lineTo(kx + Math.sin(a2) * 13, ky + Math.cos(a2) * 13); c.stroke();
  }
  function deer(ox, ph) {
    var gl = Math.sin(ph);
    c.save(); c.translate(ox, 0);
    c.lineWidth = 4.2; c.strokeStyle = INK; c.fillStyle = INK;
    leg(18, 6, 1.0 + 0.45 * gl, -0.6 + 0.45 * gl); leg(10, 7, 0.7 - 0.45 * gl, -0.9 - 0.45 * gl);    // front legs, tucked
    leg(-22, 6, -1.0 + 0.35 * gl, -1.3 + 0.35 * gl); leg(-14, 7, -0.7 - 0.35 * gl, -1.0 - 0.35 * gl); // back legs, stretched
    c.beginPath(); c.ellipse(0, 0, 30, 12, 0, 0, 6.283); c.fill();
    c.beginPath(); c.moveTo(16, -8); c.lineTo(36, -30); c.lineTo(46, -26); c.lineTo(26, 3); c.closePath(); c.fill();
    c.beginPath(); c.ellipse(44, -26, 11, 7, -0.2, 0, 6.283); c.fill();
    c.beginPath(); c.ellipse(53, -23, 6, 4.5, 0, 0, 6.283); c.fill();
    c.beginPath(); c.moveTo(37, -31); c.lineTo(33, -39); c.lineTo(42, -33); c.closePath(); c.fill();
    c.beginPath(); c.ellipse(-31, -6, 6, 3, -0.4, 0, 6.283); c.fill();
    c.lineWidth = 2.6; c.lineCap = "round";
    [[0, 0], [6, 2]].forEach(function (o) {
      c.beginPath();
      c.moveTo(40 + o[0], -31 + o[1]); c.lineTo(33 + o[0], -46 + o[1]); c.lineTo(27 + o[0], -59 + o[1]);
      c.moveTo(33 + o[0], -46 + o[1]); c.lineTo(41 + o[0], -55 + o[1]);
      c.moveTo(29 + o[0], -53 + o[1]); c.lineTo(32 + o[0], -63 + o[1]);
      c.stroke();
    });
    c.restore();
  }
  function sleighBody(ox) {
    c.save(); c.translate(ox, 0);
    c.lineWidth = 3.5; c.strokeStyle = INK; c.fillStyle = INK; c.lineCap = "round";
    c.beginPath(); c.moveTo(-150, 30); c.lineTo(-12, 30); c.quadraticCurveTo(8, 30, 8, 18); c.quadraticCurveTo(8, 8, -2, 10); c.stroke();
    c.beginPath(); c.moveTo(-122, 30); c.lineTo(-122, 19); c.moveTo(-42, 30); c.lineTo(-42, 19); c.stroke();
    c.beginPath(); c.moveTo(-150, 20); c.lineTo(-22, 20); c.quadraticCurveTo(-2, 18, 4, 0); c.lineTo(-22, 2);
    c.quadraticCurveTo(-60, 4, -100, -2); c.quadraticCurveTo(-130, -6, -145, -24); c.quadraticCurveTo(-160, -30, -158, -14); c.closePath(); c.fill();
    c.beginPath(); c.ellipse(-118, -16, 18, 16, 0, 0, 6.283); c.fill();                 // sack
    c.beginPath(); c.ellipse(-72, -12, 15, 17, 0, 0, 6.283); c.fill();                  // Santa
    c.beginPath(); c.arc(-66, -36, 8.5, 0, 6.283); c.fill();
    c.fillStyle = "rgba(235,64,72,.98)";                                                // red hat
    c.beginPath(); c.moveTo(-75, -41); c.lineTo(-57, -41); c.lineTo(-49, -56); c.closePath(); c.fill();
    c.fillStyle = INK; c.beginPath(); c.arc(-49, -57, 3.5, 0, 6.283); c.fill();
    c.restore();
  }
  function sleigh(dt) {
    // the screens are gap% of a screen width apart (bezels + space between TVs): the sleigh
    // spends that long "between" screens, so it leaves one before it reaches the next
    var W = wall(), gp = Math.max(0, Number(W[2]) || 0) / 100;
    // fixed schedule on the wall clock: the sleigh enters display 1 at the top of every minute
    // (every 2 minutes for very long walls). Doesn't depend on any per-display setting, so a
    // display with the wrong settings can be early or late but never drifts off on its own cycle.
    var PERIOD = 60 * Math.max(1, Math.ceil((W[1] * SLEIGH_T * (1 + gp) + 6) / 60));
    var now = hnow(), cyc = now % PERIOD, sc = U * 1.1;
    var speed = VW / SLEIGH_T, tw = TEAM_W * sc;
    var lx = cyc * speed - tw - (W[0] - 1) * VW * (1 + gp);  // front of the team on this display
    var vis = lx > -20 * sc && lx - tw < VW + 20 * sc;
    var prog = cl((lx + tw) / (VW + tw * 2));
    var y = VH * 0.17 - Math.sin(prog * Math.PI) * VH * 0.035 + Math.sin(now * 2.4) * 5 * U;
    // sparkle trail from the back of the sleigh (outlives the sleigh)
    if (vis) for (var e = 0; e < 3; e++)
      H.trail.push({ x: lx - 405 * sc + rnd(-6, 6) * U, y: y + rnd(-14, 26) * sc, vx: rnd(-30, -6) * U, vy: rnd(-8, 18) * U, b: 0, gold: Math.random() < 0.6 });
    c.globalCompositeOperation = "lighter";
    for (var i = H.trail.length - 1; i >= 0; i--) {
      var p = H.trail[i]; p.b += dt;
      if (p.b > 1.6) { H.trail.splice(i, 1); continue; }
      p.x += p.vx * dt; p.y += p.vy * dt + 14 * U * dt * p.b;
      var zz = (10 - 5 * p.b) * U;
      c.globalAlpha = 1 - p.b / 1.6;
      c.drawImage(p.gold ? spA : spB, p.x - zz / 2, p.y - zz / 2, zz, zz);
    }
    c.globalAlpha = 1; c.globalCompositeOperation = "source-over";
    if (!vis) return;
    c.save(); c.translate(lx, y); c.scale(sc, sc);
    c.shadowColor = "rgba(120,180,255,.9)"; c.shadowBlur = 10 * U;
    c.strokeStyle = "rgba(255,210,120,.85)"; c.lineWidth = 1.5;                        // reins
    c.beginPath(); c.moveTo(-285, -14); c.quadraticCurveTo(-230, -2, -150, -18); c.lineTo(-40, -14); c.stroke();
    sleighBody(-255);
    deer(-175, now * 7 + 1.4);
    deer(-60, now * 7);
    c.restore();
  }

  // ---------------------------------------------------------------- main loop
  var T0 = 0, last = 0, leaving = false, endAt = DUR, arrived = false;
  function leave() {
    if (leaving) return;
    leaving = true;
    endAt = (performance.now() - T0) / 1000 + 0.9;
    st.setProperty("transition", "opacity 0.9s ease", "important");
    st.setProperty("opacity", "0", "important");
  }
  if (BLANKET) window.__bcsBlanketStop = function () { if (!T0) cleanup(); else leave(); return "stopping"; };

  function frame(now) {
    if (done) return;
    if (BLANKET && now - last < 31) { raf = requestAnimationFrame(frame); return; }   // ~30 fps is plenty
    var t = (now - T0) / 1000, dt = Math.min(0.05, (now - last) / 1000), i, j, ln, p;
    last = now;
    if (t >= endAt) { cleanup(); return; }
    if (!BLANKET && t >= DUR - 0.9) leave();
    if (BLANKET) wrap.style.transform = "translate(" + (14 * Math.cos(t * 6.2832 / 300)).toFixed(2) + "px," + (9 * Math.sin(t * 6.2832 / 300)).toFixed(2) + "px)";

    c.setTransform(1, 0, 0, 1, 0, 0);
    c.clearRect(0, 0, fxc.width, fxc.height);
    toView(c);
    c.lineCap = "round"; c.lineJoin = "round";
    var rev = ease((t - 0.15) / 1.05);
    if (rev >= 1 && !arrived) { arrived = true; for (i = 0; i < lanes.length; i++) { p = at(lanes[i], lanes[i].g1); spark(p[0], p[1], true); } }

    // halo behind the logo
    var fk = flick(t);
    if (t > 1) {
      var hh = cl((t - 1) / 1) * (0.7 + 0.3 * Math.sin(t * 2.1)) * fk, hg = c.createRadialGradient(cx, cy, 0, cx, cy, LH * 1.5);
      hg.addColorStop(0, "rgba(" + AC + "," + (0.13 * hh).toFixed(3) + ")"); hg.addColorStop(0.5, "rgba(40,100,255," + (0.08 * hh).toFixed(3) + ")");
      hg.addColorStop(1, "rgba(40,100,255,0)");
      c.fillStyle = hg; c.fillRect(cx - LH * 1.5, cy - LH * 1.5, LH * 3, LH * 3);
    }

    // network (blue) up to the break; inner pins (accent) from the break to the logo
    var br = 0.85 + 0.15 * Math.sin(t * 1.3);
    for (i = 0; i < lanes.length; i++) {
      ln = lanes[i];
      c.strokeStyle = "rgba(" + BL + "," + (0.34 * br).toFixed(3) + ")"; c.lineWidth = 1.8 * U;   // a bit stronger than the original: TVs are viewed from across a room
      c.beginPath(); partial(ln, 0, Math.min(ln.g1, ln.len * rev)); c.stroke();
      if (rev >= 1) {
        var e1 = at(ln, ln.g1), e0 = at(ln, ln.g0);
        c.beginPath(); c.arc(e1[0], e1[1], 2.2 * U, 0, 6.283); c.stroke();
        var fl = t > 1.15 ? cl((t - 1.15) / 0.5) : 0;
        c.strokeStyle = "rgba(" + AC + "," + ((0.55 + 0.25 * Math.sin(t * 2.1 + i)) * fl * fk).toFixed(3) + ")"; c.lineWidth = 1.8 * U;
        c.beginPath(); partial(ln, ln.g0, ln.len); c.stroke();
        c.beginPath(); c.arc(e0[0], e0[1], 2.2 * U, 0, 6.283); c.stroke();
      }
    }

    c.globalCompositeOperation = "lighter";
    if (rev > 0 && rev < 1) {   // reveal heads racing in from the edges
      for (i = 0; i < lanes.length; i++) {
        ln = lanes[i]; var s = Math.min(ln.g1, ln.len * rev);
        c.strokeStyle = "rgba(" + BL + ",.55)"; c.lineWidth = 2 * U;
        c.beginPath(); partial(ln, Math.max(0, s - D * 0.12), s); c.stroke();
        p = at(ln, s); c.drawImage(spB, p[0] - 11 * U, p[1] - 11 * U, 22 * U, 22 * U);
      }
    }
    if (t > 1.4) {             // data pulses: in along the lanes, spark at the break
      for (i = 0; i < lanes.length; i++) {
        ln = lanes[i]; var tail = D * 0.09;
        for (j = 0; j < ln.pulses.length; j++) {
          var q = ln.pulses[j]; q.s += q.v * dt;
          if (q.s >= ln.g1) { p = at(ln, ln.g1); spark(p[0], p[1], false); q.s = -rnd(0.3, 1.5) * ln.g1; q.v = D * rnd(0.3, 0.65); continue; }
          if (q.s < 0) continue;
          for (var k = 0; k < 6; k++) {
            var s1 = q.s - tail * k / 6, s0 = q.s - tail * (k + 1) / 6;
            if (s1 <= 0) break;
            c.strokeStyle = "rgba(" + (HOLIDAY ? FEST[q.ci] : BL) + "," + (0.7 * (1 - k / 6)).toFixed(3) + ")"; c.lineWidth = 2 * U;
            c.beginPath(); partial(ln, Math.max(0, s0), s1); c.stroke();
          }
          p = at(ln, q.s); c.drawImage(HOLIDAY ? spF[q.ci] : spB, p[0] - 9 * U, p[1] - 9 * U, 18 * U, 18 * U);
        }
      }
    }
    for (i = sparks.length - 1; i >= 0; i--) {
      var sk = sparks[i]; sk.b += dt;
      var life = sk.big ? 0.7 : 0.45, k3 = sk.b / life;
      if (k3 >= 1) { sparks.splice(i, 1); continue; }
      var z = (sk.big ? 34 : 22) * U * (1 - k3 * 0.5);
      c.globalAlpha = 1 - k3; c.drawImage(spA, sk.x - z / 2, sk.y - z / 2, z, z);
      for (j = 0; j < sk.ps.length; j++) {
        var px = sk.x + sk.ps[j][0] * sk.b, py = sk.y + sk.ps[j][1] * sk.b + D * 0.12 * sk.b * sk.b;
        c.drawImage(j % 3 ? spA : spB, px - 3 * U, py - 3 * U, 6 * U, 6 * U);
      }
      c.globalAlpha = 1;
    }
    c.globalCompositeOperation = "source-over";
    if (HOLIDAY) drawSnow(t, dt, false);
    vignette();
    toView(c);

    // logo: glow, then the B with its shine sweep
    var la = ease((t - 0.9) / 0.9);
    if (img.glow && la > 0) {
      c.globalAlpha = la * (0.62 + 0.23 * Math.cos(t * 1.9)) * fk;
      var gp = 140 * SC;
      c.drawImage(img.glow, cx - LW / 2 - gp, cy - LH / 2 - gp, LW + 2 * gp, LH + 2 * gp);
      c.globalAlpha = 1;
    }
    drawLogo(t, la);
    if (HOLIDAY) snowCap(ease((t - 3) / 3) * la);

    // dark shade behind the lettering (keeps it readable over the lanes)
    var shy = textTop + (barY - textTop) / 2;
    c.save(); c.translate(cx, shy); c.scale(Math.min(VW * 0.9, TW * 1.25) / 2, VH * 0.13);
    var sh = c.createRadialGradient(0, 0, 0, 0, 0, 1);
    sh.addColorStop(0, "rgba(2,6,16,.85)"); sh.addColorStop(0.6, "rgba(2,6,16,.55)"); sh.addColorStop(1, "rgba(2,6,16,0)");
    c.fillStyle = sh; c.fillRect(-1, -1, 2, 2); c.restore();

    // lettering rises in, then the progress sweep
    var ta = rise((t - 2.45) / 1.0);
    if (img.text && ta > 0) { c.globalAlpha = ta; c.drawImage(img.text, cx - TW / 2, textTop + 14 * (1 - ta), TW, TH); }
    var ba = rise((t - 2.75) / 1.0);
    if (ba > 0) {
      var bx = cx - barW / 2, by = barY + 14 * (1 - ba);
      c.globalAlpha = ba;
      c.fillStyle = "rgba(120,170,240,.2)"; c.fillRect(bx, by, barW, 3 * U);
      if (t > 3) {
        var f = ((t - 3) % 2.2) / 2.2; f = f < 0.5 ? 2 * f * f : 1 - Math.pow(-2 * f + 2, 2) / 2;
        var sx = bx + (-0.4 + 1.4 * f) * barW, sw = barW * 0.4;
        c.save(); c.beginPath(); c.rect(bx, by, barW, 3 * U); c.clip();
        var sg = c.createLinearGradient(sx, 0, sx + sw, 0);
        sg.addColorStop(0, "rgba(" + AC + ",0)"); sg.addColorStop(0.5, "rgba(" + AC + ",1)"); sg.addColorStop(1, "rgba(" + AC + ",0)");
        c.fillStyle = sg; c.fillRect(sx, by, sw, 3 * U); c.restore();
      }
    }
    c.globalAlpha = 1;
    if (HOLIDAY) {
      var ga2 = rise((t - 3.1) / 1.0);
      if (img.greet && ga2 > 0) {
        var gw = 565 * SC, gh = 85 * SC;
        c.globalAlpha = ga2 * (0.85 + 0.15 * Math.sin(t * 1.6));
        c.drawImage(img.greet, cx - gw / 2, barY + VH * 0.035 + 14 * (1 - ga2), gw, gh);
        c.globalAlpha = 1;
      }
      var hn = hnow(), wi = wallInfo(), ev = ladderEvent(hn, wi);
      sleigh(dt);
      camper(hn, wi, dt);
      ladderGuy(ev, hn);
      drawSnow(t, dt, true);
      drifts(hn, wi);
      plow(hn, wi, dt);
      garland(t, ev);
    }
    raf = requestAnimationFrame(frame);
  }

  function load(key) {
    return createImageBitmap(blob(PNG[key])).then(function (bm) { img[key] = bm; }, function () {});
  }
  Promise.all([load("logo"), load("glow"), load("text")].concat(HOLIDAY ? [load("greet")] : [])).then(function () {
    if (done) return;
    requestAnimationFrame(function (now) {
      T0 = last = now;
      st.setProperty("opacity", "1", "important");
      raf = requestAnimationFrame(frame);
    });
  });
  return "started";
})();
