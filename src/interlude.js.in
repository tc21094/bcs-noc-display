  var cx = VW / 2, cy = Math.round(VH * 0.36);
  var C = { hw: LW / 2 + LH * 0.04, hh: LH / 2 + LH * 0.04, gapIn: LH * 0.16, gapOut: LH * 0.3 };
  var textTop = Math.round(cy + LH / 2 + VH * 0.055);
  var TW = (BLANKET ? 866 : 656) * SC, TH = (BLANKET ? 180 : 127) * SC;
  var barY = textTop + TH + VH * 0.03, barW = Math.min(VW * 0.6, 420 * SC * 1.6);
  var panel = { x0: cx - TW / 2 - 40, x1: cx + TW / 2 + 40, y0: textTop - 20, y1: barY + 30 };

  // ---------------------------------------------------------------- lanes (edge -> logo)
  function nrm(a, q) { var dx = q[0] - a[0], dy = q[1] - a[1], l = Math.hypot(dx, dy) || 1; return [-dy / l, dx / l]; }
