    r.addColorStop(0, "rgba(255,255,255,1)"); r.addColorStop(0.35, "rgba(240,248,255,.85)"); r.addColorStop(1, "rgba(220,235,255,0)");
    g.fillStyle = r; g.fillRect(0, 0, z, z);
