      for (var z = 0; z < 3; z++) { var q = (now * 0.32 + z / 3) % 1; c.globalAlpha = Math.min(1, (1 - q) * 1.6); c.font = "bold " + Math.round((14 + 16 * q) * U) + "px sans-serif"; c.fillText("Z", hx + 18 * U + q * 46 * U, hy - 18 * U - q * 92 * U); }
