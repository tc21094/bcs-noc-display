        tgLeafAt(x + 30 * U + Math.cos(a) * sp * burst, gy - 10 * U + Math.sin(a) * sp * burst + 300 * U * burst * burst, 22 * U, b + burst * 8, b % 4, 1 - burst / 1.4); }
    }
  }

  // ---- Grandpa, out cold in his recliner in front of the game
  function tgGpa(cp, now, w) {
    var st = tgSt(w), X = tgW(st.gpa, w), x = tgL(X, w);
    if (x < -200 * U || x > VW + 200 * U) return;
    var gy = VH - 6 * U, p = tgLastPass(cp, w), bonk = p && p.kind === "gpa" && cp - p.land >= 0 && cp - p.land < 2.6;
    var startle = cp >= BOOM + 0.1 && cp < BOOM + 5.5, up = startle ? Math.min(1, (cp - BOOM) * 4) * (1 - tgSeg(cp, BOOM + 4.6, BOOM + 5.5)) : bonk ? 0.5 * Math.sin(Math.min(1, (cp - p.land) * 3) * Math.PI / 2) * (1 - tgSeg(cp - p.land, 2, 2.6)) : 0;
    c.save(); c.translate(x, gy); c.scale(U * 1.1 * TS, U * 1.1 * TS);
    c.fillStyle = "#3d2a1c"; c.fillRect(-42, -14, 92, 10); c.fillRect(-38, -6, 8, 6); c.fillRect(40, -6, 8, 6);
    c.fillStyle = "#7a4b2e"; rr(-42, -46, 74, 32, 9); c.fill();
    c.save(); c.translate(-34, -40); c.rotate(-0.62); c.fillStyle = "#6b4027"; rr(-14, -92, 28, 96, 11); c.fill(); c.restore();
    c.fillStyle = "#7a4b2e"; rr(30, -42, 42, 13, 6); c.fill(); c.fillStyle = "#3d2a1c"; c.fillRect(34, -30, 4, 18);
    // him: legs on the footrest, cardigan, hands on the belly
    var a = 0.62 - 0.5 * up, hip = [-18, -46], sh = [hip[0] - Math.sin(a) * 54, hip[1] - Math.cos(a) * 54], hd = [hip[0] - Math.sin(a) * 72, hip[1] - Math.cos(a) * 72];
