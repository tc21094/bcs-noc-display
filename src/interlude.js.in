          pre: function () { c.fillStyle = "#6e7781"; rr(-40, -104, 24, 50, 5); c.fill(); c.fillStyle = "#f08c1a"; rr(-40, -86, 24, 16, 3); c.fill();
            c.fillStyle = "#1b1b1b"; c.font = "bold 9px sans-serif"; c.textAlign = "center"; tgText("BCS", -28, -74); c.textAlign = "left"; },
