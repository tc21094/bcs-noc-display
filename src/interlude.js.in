    if (cp < 229) return { X: tgLerp(door, door - 0.035 * VW, tgSeg(cp, 225.4, 229)), pose: "walk", face: -1 };
    if (cp < 268) return { X: tgLerp(door - 0.035 * VW, hw + 0.09 * VW, tgSeg(cp, 229, 268)), pose: "walk", face: -1, mark: (cp % 9) < 1.2 ? "?" : null };
    if (cp < 275) return { X: hw + 0.09 * VW, pose: "inspect", face: -1 };
    if (cp < 280.5) return { X: tgLerp(hw + 0.09 * VW, start, tgSeg(cp, 275, 280.5)), pose: "walk", face: -1, slow: true };
    if (cp < 282) return { X: start, pose: "stand", face: -1 };
