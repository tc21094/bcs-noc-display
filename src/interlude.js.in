    c.lineTo(VW + MG, VH + MG); c.closePath();
    var g = c.createLinearGradient(0, VH - HD * 2, 0, VH);
    g.addColorStop(0, "rgb(250,252,255)"); g.addColorStop(1, "rgb(196,214,236)");
    c.fillStyle = g; c.fill();
  }

  // ---- vintage camper, buried on the last display until the plow comes through
  H.smoke = [];
  function rr(x, y, w_, h_, r) { c.beginPath(); c.moveTo(x + r, y); c.arcTo(x + w_, y, x + w_, y + h_, r); c.arcTo(x + w_, y + h_, x, y + h_, r);
    c.arcTo(x, y + h_, x, y, r); c.arcTo(x, y, x + w_, y, r); c.closePath(); }
  function camper(now, w, dt) {
    if (w.pos !== w.n) return;
    var x0 = VW * CAMP.x0, L = VW * (CAMP.x1 - CAMP.x0), bh = CH * 0.78, oy = VH - CH;
    var open = 1 - snowLevel(gX(x0 + L / 2, w), now);           // 1 = fully dug out
    function P(u, v) { return [x0 + u * L, oy + v * bh]; }
    c.save();
    // hitch, jack and propane tank
    c.strokeStyle = "#5b616b"; c.lineWidth = 5 * U;
    var h1 = P(1.0, 0.9), h2 = P(1.13, 0.97);
    c.beginPath(); c.moveTo(h1[0], h1[1]); c.lineTo(h2[0], h2[1]); c.lineTo(h2[0], VH); c.stroke();
    c.fillStyle = "#e8e8e8"; rr(h1[0] + 0.02 * L, h1[1] - 0.2 * bh, 0.05 * L, 0.2 * bh, 5 * U); c.fill();
    // body: rounded "canned ham" shape, cream over teal
    c.beginPath();
    var q = [[0.06, 1], [0.94, 1]];
    c.moveTo.apply(c, P(0.06, 1)); c.lineTo.apply(c, P(0.94, 1));
    c.quadraticCurveTo.apply(c, P(1, 1).concat(P(1, 0.82))); c.lineTo.apply(c, P(1, 0.45));
    c.quadraticCurveTo.apply(c, P(0.98, 0.1).concat(P(0.8, 0.04))); c.lineTo.apply(c, P(0.25, 0));
    c.quadraticCurveTo.apply(c, P(0.03, 0.02).concat(P(0, 0.35))); c.lineTo.apply(c, P(0, 0.82));
    c.quadraticCurveTo.apply(c, P(0, 1).concat(P(0.06, 1))); c.closePath();
    c.fillStyle = "#f2e8cf"; c.fill();
    c.save(); c.clip();
    c.fillStyle = "#2a9d8f"; c.fillRect(x0 - 5, oy + bh * 0.6, L + 10, bh * 0.5);
    c.fillStyle = "#d9dde2"; c.fillRect(x0 - 5, oy + bh * 0.58, L + 10, bh * 0.035);
    c.restore();
    c.strokeStyle = "rgba(40,50,60,.55)"; c.lineWidth = 2 * U; c.stroke();
    // windows (warm glow once it's dug out), door with a wreath
