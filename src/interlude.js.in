               vy: (14 + rr * 16) * rnd(0.8, 1.2), sw: rnd(6, 22), sf: rnd(0.3, 1.1), ph: rnd(0, 6.28), a: 0.45 + rr / 3.6 * 0.5 };
    }
    H.newFlake = flake;
