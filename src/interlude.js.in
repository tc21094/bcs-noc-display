          c.globalAlpha = 1 - age / 0.5; c.fillStyle = "#ffffff";
          c.beginPath(); c.arc(sx + Math.cos(a) * d, sy + Math.sin(a) * d + 80 * U * age * age, 3 * U, 0, 6.283); c.fill();
        }
        c.globalAlpha = 1;
      }
    }
  }

  // ---- the camper's owner (striped pajamas, nightcap, coffee mug). Once a cycle he strings far too
  // many lights on the camper and plugs them all into one power strip: it blows the breaker, the
  // lights brown out across the whole wall, and that's the dark gap the ladder guy comes to fix.
  // When the ladder guy gets zapped, the surge races along the lights to the camper's satellite dish,
  // which beams it into the snow - that's what boots up the snowmen - and he pops out to stare.
  // When the plow digs him out he waves his mug at it from the window, then steps outside just in
  // time for the snow on the roof to slide off onto him.
  var OVL = LAD_AT - 30, OWN_S = 0.9;          // overload act start within the cycle's first ladder slot; his scale
  function campP(u, v) { return [VW * CAMP.x0 + u * VW * (CAMP.x1 - CAMP.x0), VH - CH + v * CH * 0.78]; }
  function ladderSpot(slot, w) {
    var pos = 1 + Math.floor(hash(slot * 3 + 1) * w.n);
    // keep clear of the logo, the kids (left of display 1), the snowmen and the camper (last display)
    var bands = pos === w.n ? [[0.355, 0.375]] : [[pos === 1 ? 0.24 : 0.05, pos === 1 ? 0.34 : 0.32], [0.68, 0.93]];
    var b = bands[Math.floor(hash(slot * 7 + 5) * bands.length)], f = hash(slot * 7 + 9);
    return { pos: pos, x: VW * (b[0] + (b[1] - b[0]) * f) };
  }
  function wallXof(pos, xl, w) { return (pos - 1) * VW * (1 + w.gp) + xl; }
  function brownout(now) {                    // 1 = normal; flickers low for a few seconds after the overload
    var e = now % PLOW_P - OVL - 20.4;
    if (e < 0 || e > 2.8) return 1;
    return hash(Math.floor(now * 14)) < 0.35 ? 0.55 : 0.08;
  }
  function surgeRun(now, w) {                 // the first zap of each cycle: pulse along the lights to the dish
    var cp = now % PLOW_P, slot = Math.floor((now - cp) / LAD_P), sp = ladderSpot(slot, w);
    var xs = wallXof(sp.pos, sp.x, w), dsh = campP(0.62, 0), xd = wallXof(w.n, dsh[0], w);
    var v = Math.max(1.6 * VW, (xd - xs) / 2.2), t0 = LAD_AT + ZAP + 0.4;
    return { t0: t0, ta: t0 + Math.max(0, xd - xs) / v, xs: xs, xd: xd, v: v, cp: cp };
  }
  function pulseX(now, w) {                   // where the surge is on the wall right now (or null)
    var s = surgeRun(now, w);
    if (s.cp < s.t0 || s.cp > s.ta) return null;
    return s.xs + (s.cp - s.t0) * s.v;
  }
  function doorTimes(w) {                     // when the blade clears his window and his door
    var v = VW / PLOW_T, base = (w.n - 1) * VW * (1 + w.gp);
    return { win: PLOW_AT + (base + campP(0.215, 0)[0] + PLOW_LEN) / v, door: PLOW_AT + (base + campP(0.47, 0)[0] + PLOW_LEN) / v + 10 };
  }
  function roofSnow(now, w) {                 // the roof snow is gone from the moment it lands on him until it snows back
    var cp = now % PLOW_P, td = doorTimes(w).door;
    if (td + 20 >= PLOW_P) return 1;           // (a very long wall: no time for the gag this cycle)
    return cp >= td + 6 ? 0 : cl((cp - 50) / 40);
  }
  function owner(pose, now, look) {           // drawn with feet at (0,0); look -1 = facing left
    var s = U * OWN_S;
    c.save(); c.scale(s * (look || 1), s);
    var PJ = "#8fb3e0", PJ2 = "rgba(255,255,255,.55)";
    var L = [-20, -62], R = [20, -62], mug = R, mouth = 0;
    if (pose === "sip") R = [7, -102];
    else if (pose === "stretch") { L = [-24, -148]; R = [24, -150]; }
    else if (pose === "wave") R = [26 + 8 * Math.sin(now * 9), -140];
    else if (pose === "stare") { R = [14, -84]; mouth = 1; }
    else if (pose === "string") { L = [-30, -100]; R = [30, -96 + 4 * Math.sin(now * 5)]; }
    else if (pose === "shrug") { L = [-28, -80]; R = [28, -80]; }
    else if (pose === "buried") { R = [16, -150]; mouth = 1; }
    else if (pose === "shiver") { c.translate(Math.sin(now * 60) * 1.5, 0); R = [10, -80]; L = [-10, -80]; }
    mug = R;
