      if (i % 2 === 0) { g.beginPath(); g.moveTo(0, 2); g.lineTo(-13, -11); g.moveTo(0, 2); g.lineTo(13, -11); g.stroke(); }
      return s;
    });
    function leaf(anywhere) {
      var near = Math.random() < 0.35;
      return { x: rnd(-MG, VW + MG), y: anywhere ? rnd(-MG, VH) : -MG - rnd(20, 120), near: near,
               sz: (near ? rnd(36, 54) : rnd(18, 30)) * U, vy: (near ? rnd(55, 85) : rnd(30, 55)) * U,
               sw: rnd(20, 55) * U, sf: rnd(0.6, 1.4), ph: rnd(0, 6.3), rot: rnd(0, 6.3), spin: rnd(-1.6, 1.6),
               fl: rnd(1.5, 3.5), ci: Math.floor(rnd(0, 4)), a: near ? 1 : 0.55 };
