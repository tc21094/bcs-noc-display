    c.lineWidth = 4.2; c.strokeStyle = INK; c.fillStyle = INK;
    leg(18, 6, 1.0 + 0.45 * gl, -0.6 + 0.45 * gl); leg(10, 7, 0.7 - 0.45 * gl, -0.9 - 0.45 * gl);    // front legs, tucked
    leg(-22, 6, -1.0 + 0.35 * gl, -1.3 + 0.35 * gl); leg(-14, 7, -0.7 - 0.35 * gl, -1.0 - 0.35 * gl); // back legs, stretched
    c.beginPath(); c.ellipse(0, 0, 30, 12, 0, 0, 6.283); c.fill();
    c.beginPath(); c.moveTo(16, -8); c.lineTo(36, -30); c.lineTo(46, -26); c.lineTo(26, 3); c.closePath(); c.fill();
    c.beginPath(); c.ellipse(44, -26, 11, 7, -0.2, 0, 6.283); c.fill();
    c.beginPath(); c.ellipse(53, -23, 6, 4.5, 0, 0, 6.283); c.fill();
    c.beginPath(); c.moveTo(37, -31); c.lineTo(33, -39); c.lineTo(42, -33); c.closePath(); c.fill();
    c.beginPath(); c.ellipse(-31, -6, 6, 3, -0.4, 0, 6.283); c.fill();
    c.lineWidth = 2.6; c.lineCap = "round";
    [[0, 0], [6, 2]].forEach(function (o) {
