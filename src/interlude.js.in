    c.fillStyle = "#c9ced6"; c.beginPath(); c.arc(tx + 25 * U, gy - 78 * U, 3 * U, 0, 6.283); c.arc(tx + 25 * U, gy - 66 * U, 3 * U, 0, 6.283); c.fill();
  }

  // ---- the scarecrow, and a crow that picks the wrong perch
  function tgCrow(x, y, flap, scl, face) {
    c.save(); c.translate(x, y); c.scale(scl * (face || 1), scl);
    c.fillStyle = "#16161c"; c.beginPath(); c.ellipse(0, -10, 13, 8, -0.2, 0, 6.283); c.fill();
    c.beginPath(); c.moveTo(-10, -8); c.lineTo(-24, -4); c.lineTo(-11, -13); c.fill();
    c.beginPath(); c.arc(11, -18, 6.5, 0, 6.283); c.fill();
    c.fillStyle = "#8d949e"; c.beginPath(); c.moveTo(16, -19); c.lineTo(25, -16); c.lineTo(16, -15); c.fill();
    c.fillStyle = "#fff"; c.beginPath(); c.arc(13, -20, 1.8, 0, 6.283); c.fill();
    c.fillStyle = "#26262e"; c.beginPath(); c.moveTo(-6, -12); c.lineTo(6, -12); c.lineTo(-2, -12 - 18 * flap); c.closePath(); c.fill();
    c.strokeStyle = "#8d949e"; c.lineWidth = 1.5; c.beginPath(); c.moveTo(0, -3); c.lineTo(-1, 2); c.moveTo(4, -3); c.lineTo(4, 2); c.stroke();
    c.restore();
  }
  function tgScare(cp, now, w) {
    var st = tgSt(w), X = tgW(st.scare, w), x = tgL(X, w);
    if (x < -150 * U || x > VW + 150 * U) return;
    var gy = VH - 4 * U, look = 0;
