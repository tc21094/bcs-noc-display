    if (cp < 231) return { X: hw.X, pose: "alarm", face: 1, mark: "!" };
    if (cp < 284) return { X: hw.X, pose: "disguise", face: 1, o: { glasses: true, sign: true, fall: tgSeg(cp, 281.5, 282.6), whistle: tgIn(cp, 268, 281.5) } };
    if (cp < 318) return { X: tgLerp(hw.X, hid, tgSeg(cp, 284, 318)), pose: "run", face: 1, o: { glasses: true, fall: 1 } };
    if (cp < 336) return null;
    if (cp < 340) return { X: tgLerp(hid, P + 0.06 * VW, tgSeg(cp, 336, 340)), pose: "walk", face: -1, o: { phone: true } };
    if (cp < 342) return { X: P + 0.06 * VW, pose: "stand", face: -1, o: { phone: true } };
    if (cp < 382) return { X: P + 0.06 * VW, pose: "sit", face: -1, o: { slice: tgIn(cp, 344, 378) } };
    var hb = tgWander(424, w), X = tgLerp(P + 0.06 * VW, hb.X, tgSeg(cp, 382, 424));
    return { X: X, pose: "walk", face: -1, o: { slice: cp < 396 } };
  }

  // ---- the frozen turkey's flight from the fryer to Tom's feet
  function tgFlight(w) {
    var st = tgSt(w), x0 = tgW(st.fry, w), x1 = tgW(st.tom, w) + 0.075 * VW, dist = Math.abs(x0 - x1), dur = 2.2 + dist / (VW * 1.1);
    return { x0: x0, x1: x1, t0: BOOM + 0.15, dur: dur, land: BOOM + 0.15 + dur, peak: Math.min(VH * 0.78, 220 * U + dist * 0.16) };
  }
  function tgRoast(x, y, rot, state, now) {   // a store-bought turkey: frozen, on fire, or charred
    c.save(); c.translate(x, y); c.rotate(rot); c.scale(U, U);
    var body = state === "frozen" ? "#e6eef6" : state === "fire" ? "#5a3a26" : "#2a201a", leg = state === "frozen" ? "#d2dde8" : body;
    c.fillStyle = leg;
    c.save(); c.rotate(-0.5); c.beginPath(); c.ellipse(14, -16, 12, 7, 0, 0, 6.283); c.fill(); c.restore();
    c.save(); c.rotate(0.5); c.beginPath(); c.ellipse(14, 2, 12, 7, 0, 0, 6.283); c.fill(); c.restore();
    c.fillStyle = "#f4ead8"; c.beginPath(); c.arc(25, -27, 4, 0, 6.283); c.arc(23, 13, 4, 0, 6.283); c.fill();
    c.fillStyle = body; c.beginPath(); c.ellipse(-4, -6, 24, 17, 0, 0, 6.283); c.fill();
    if (state === "frozen") { c.fillStyle = "rgba(255,255,255,.8)"; for (var k = 0; k < 6; k++) { c.beginPath(); c.arc(-18 + k * 7, -14 + (k % 2) * 9, 1.6, 0, 6.283); c.fill(); }
      c.strokeStyle = "rgba(140,190,230,.7)"; c.lineWidth = 2; c.beginPath(); c.ellipse(-4, -6, 24, 17, 0, 0, 6.283); c.stroke(); }
    c.restore();
  }
  function tgFlames(x, y, h, now, w_) {       // a flickering fire: tongues of flame plus glow
    c.save(); c.globalCompositeOperation = "lighter";
    for (var k = 0; k < 6; k++) {
      var fx = x + (k - 2.5) * w_ / 6, fh = h * (0.55 + 0.45 * Math.abs(Math.sin(now * (7 + k) + k * 1.7)));
      var g = c.createLinearGradient(0, y, 0, y - fh); g.addColorStop(0, "rgba(255,190,60,.95)"); g.addColorStop(0.6, "rgba(255,110,30,.7)"); g.addColorStop(1, "rgba(255,60,20,0)");
      c.fillStyle = g; c.beginPath(); c.moveTo(fx - w_ / 7, y); c.quadraticCurveTo(fx - w_ / 10, y - fh * 0.6, fx + Math.sin(now * 9 + k) * w_ / 12, y - fh); c.quadraticCurveTo(fx + w_ / 10, y - fh * 0.6, fx + w_ / 7, y); c.closePath(); c.fill();
    }
