// BCS NOC interlude / blanket.
//   interlude: full-screen animation over the dashboard for a few seconds, then
//              faded away (burn-in protection)
//   blanket:   the same scene with "BCS / TECHNOLOGY DEPARTMENT", kept up until
//              window.__bcsBlanketStop() is called; drifts slowly so it can't burn in
//   holiday:   blanket theme (window.__BCS_THEME = "holiday"): snow, a snow cap on
//              the B, drifts, twinkling lights, festive pulses, and a sleigh that
//              crosses the whole wall of displays (window.__BCS_WALL = [position, count, gap %])
// Style adapted from a colleague's maintenance-page animation: circuit lanes route
// in from the screen edges toward the logo, stop at a small break where data
// pulses spark, over a dot grid with a vignette. The BCS B sits in the centre.
// Injected by kiosk-launch through Chrome's DevTools pipe, so it works on any
// dashboard. It adds one temporary element to the page and loads nothing.
(function () {
  "use strict";
  var BLANKET = window.__BCS_MODE === "blanket";
  var FLAG = BLANKET ? "__bcsBlanket" : "__bcsInterlude";
  if (window[FLAG]) return "busy";
  window[FLAG] = true;

  var DUR = BLANKET ? Infinity : Math.max(6, Number(window.__BCS_INTERLUDE_SECONDS) || 12);
  var PNG = { logo: "@@LOGO@@", glow: "@@GLOW@@", text: BLANKET ? "@@TEXT2@@" : "@@TEXT@@" };
  var HOLIDAY = BLANKET && window.__BCS_THEME === "holiday";
  var WALL = window.__BCS_WALL || [1, 1];   // [position from the left, number of displays]
  if (HOLIDAY) PNG.greet = "@@GREET@@";
  var BL = "95,175,255";     // network blue (from the original)
  var AC = "232,44,68";      // accent: BCS red (the original used amber)

  var done = false, raf = 0, host = null;
  function cleanup() {
    if (done) return;
    done = true;
    if (raf) cancelAnimationFrame(raf);
    try { if (host && host.hidePopover) host.hidePopover(); } catch (e) {}
    try { if (host) host.remove(); } catch (e) {}
    window[FLAG] = false;
    if (BLANKET) window.__bcsBlanketStop = null;
  }
  if (!BLANKET) setTimeout(cleanup, (DUR + 8) * 1000);   // safety net if animation frames stop

  function blob(b64) {
    var bin = atob(b64), n = bin.length, u = new Uint8Array(n);
    for (var i = 0; i < n; i++) u[i] = bin.charCodeAt(i);
    return new Blob([u], { type: "image/png" });
