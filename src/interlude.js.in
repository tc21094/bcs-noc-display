    c.fillStyle = "#3a3a40"; rr(tx - 32 * U, gy - 92 * U, 64 * U, 52 * U, 6 * U); c.fill();
    c.strokeStyle = "#8d949e"; c.lineWidth = 2 * U; c.beginPath(); c.moveTo(tx - 6 * U, gy - 92 * U); c.lineTo(tx - 22 * U, gy - 120 * U); c.moveTo(tx + 6 * U, gy - 92 * U); c.lineTo(tx + 20 * U, gy - 122 * U); c.stroke();
