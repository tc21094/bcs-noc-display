    c.fillStyle = g; c.shadowColor = "rgba(150,200,255,.6)"; c.shadowBlur = 8 * U; c.fill();
    c.restore();
  }

  // ---- the holiday scene runs on a shared wall clock, so every display agrees on it
  function hnow() { return Date.now() / 1000 + (Number(window.__BCS_NOW_OFFSET) || 0); }
  function wallInfo() { var w = wall(); return { pos: w[0], n: w[1], gp: Math.max(0, Number(w[2]) || 0) / 100 }; }
  function gX(xl, w) { return (w.pos - 1) * VW * (1 + w.gp) + xl; }      // local x -> position along the whole wall
  function hash(n) {                                                      // deterministic 0..1, same on every display
    n = n | 0; n = Math.imul(n ^ (n >>> 16), 0x45d9f3b); n = Math.imul(n ^ (n >>> 16), 0x45d9f3b); n ^= n >>> 16;
    return (n >>> 0) / 4294967296;
  }

  // ---- snow on the ground: builds up, a plow clears it (left to right across the wall) every 8 minutes
  var PLOW_P = 480, PLOW_AT = 370, PLOW_T = 16, ACC = 300;  // cycle, plow start in cycle, s per display, s to build up
  var PLOW_LEN = 330 * U, HD = VH * 0.045;                   // truck length (blade to tail), full drift height
  var CAMP = { x0: 0.67, x1: 0.9 }, CH = Math.min(VH * 0.15, 170 * U);   // camper on the last display
  function plowStart(now) { return now - (now % PLOW_P) + PLOW_AT; }
  function lastPass(X, now) {                 // when the blade last went past wall position X
    var tx = plowStart(now) + (X + PLOW_LEN) / (VW / PLOW_T);
