    c.fillStyle = "#6b4a2e"; c.fillRect(-4, -176, 8, 176); c.fillRect(-60, -132, 120, 7);
    c.fillStyle = "#b5452c"; rr(-22, -138, 44, 62, 6); c.fill(); c.fillRect(-58, -138, 40, 17); c.fillRect(18, -138, 40, 17);
    c.strokeStyle = "rgba(60,20,10,.35)"; c.lineWidth = 2;
