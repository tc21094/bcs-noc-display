    c.fillStyle = "#c8323c"; c.beginPath(); c.moveTo(-46, -26); c.lineTo(10, -26); c.lineTo(24, -60); c.lineTo(34, -60); c.lineTo(46, -24); c.lineTo(36, -16); c.lineTo(-40, -16); c.closePath(); c.fill();
    c.strokeStyle = "#3a3a40"; c.lineWidth = 4; c.beginPath(); c.moveTo(30, -60); c.lineTo(22, -92); c.lineTo(12, -92); c.stroke();
    c.fillStyle = "#f3efe6"; c.fillRect(-48, -66, 38, 32); c.fillStyle = "#c8323c"; c.font = "bold 10px sans-serif"; c.textAlign = "center"; tgText("PIZZA", -29, -46); c.textAlign = "left";
    c.restore();
