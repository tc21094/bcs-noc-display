    for (var q = 0; q < 6; q++) L.cap.push({ u: 0.12 + q * 0.15 + rnd(-0.04, 0.04), r: rnd(-0.6, 0.6), sz: rnd(30, 40) * U, ci: Math.floor(rnd(0, 4)), at: 3 + q * 0.9 });
  })();
