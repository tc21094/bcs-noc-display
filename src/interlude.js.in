    tgFarm(w);
    tgScare(cp, hn, w);
    tgGpa(cp, hn, w);
    tgLeaves(t, dt, true, tgWind(t, cp, w));
    tgGround(cp, w);
    tgPorchDeck(w);
    tgFryer(cp, hn, w, false);
    tgQB(cp, hn, w);
    tgUncle(cp, hn, w);
    tgDad(cp, hn, w);
    tgCook(cp, hn, w);
    tgTomDraw(cp, hn, w);
    tgScooter(cp, hn, w);
    tgFryer(cp, hn, w, true);
    tgFlying(cp, hn, w);
