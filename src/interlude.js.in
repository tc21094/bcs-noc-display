  var b = bgc.getContext("2d"), c = fxc.getContext("2d");
  function toView(g) { g.setTransform(K, 0, 0, K, MG * K, MG * K); }   // draw in viewport CSS pixels

  // ---------------------------------------------------------------- layout (CSS px)
  var img = {};
  var LH = Math.round(Math.min(VH * 0.28, VW * 0.2 * 330 / 415));    // logo height
  var LW = Math.round(LH * 415 / 330), SC = LH / 330;                  // SC: artwork scale vs. the splash
  var cx = VW / 2, cy = Math.round(VH * 0.36);
  var C = { hw: LW / 2 + LH * 0.04, hh: LH / 2 + LH * 0.04, gapIn: LH * 0.16, gapOut: LH * 0.3 };
  var textTop = Math.round(cy + LH / 2 + VH * 0.055);
  var TW = (BLANKET ? 866 : 656) * SC, TH = (BLANKET ? 180 : 127) * SC;
  var barY = textTop + TH + VH * 0.03, barW = Math.min(VW * 0.6, 420 * SC * 1.6);
  var panel = { x0: cx - TW / 2 - 40, x1: cx + TW / 2 + 40, y0: textTop - 20, y1: barY + 30 };

  // ---------------------------------------------------------------- lanes (edge -> logo)
  function nrm(a, q) { var dx = q[0] - a[0], dy = q[1] - a[1], l = Math.hypot(dx, dy) || 1; return [-dy / l, dx / l]; }
  function offset(p, o) {
    var out = [];
    for (var i = 0; i < p.length; i++) {
      var a = p[Math.max(0, i - 1)], q = p[i], r = p[Math.min(p.length - 1, i + 1)];
      var n1 = i ? nrm(a, q) : nrm(q, r), n2 = i < p.length - 1 ? nrm(q, r) : n1;
      var nx = n1[0] + n2[0], ny = n1[1] + n2[1], l = Math.hypot(nx, ny) || 1;
      nx /= l; ny /= l;
      var ch = nx * n1[0] + ny * n1[1] || 1;
      out.push([q[0] + nx * o / ch, q[1] + ny * o / ch]);
    }
    return out;
  }
  function inPanel(x, y) { return x > panel.x0 && x < panel.x1 && y > panel.y0 - 30 && y < panel.y1 + 30; }
  function route(x, y, base, first) {
    var pts = [[x, y]], dir = base, step = Math.PI / 4, k = 0;
    x += Math.cos(dir) * first; y += Math.sin(dir) * first; pts.push([x, y]);
    while (k++ < 40) {
      var len = D * rnd(0.05, 0.15);
      dir = dir !== base ? base : [base - step, base, base + step][(Math.random() * 3) | 0];
      var nx = x + Math.cos(dir) * len, ny = y + Math.sin(dir) * len;
      if (inPanel(nx, ny)) { dir = base; nx = x + Math.cos(dir) * len; ny = y + Math.sin(dir) * len; }   // keep the lettering clear
      x = nx; y = ny; pts.push([x, y]);
      if (x < -MG - 30 || x > VW + MG + 30 || y < -MG - 30 || y > VH + MG + 30) break;
    }
    return pts;
  }
  function lane(pts) {
    pts = pts.slice().reverse();
    var L = [0];
    for (var i = 1; i < pts.length; i++) L.push(L[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
    var ln = { p: pts, L: L, len: L[L.length - 1], pulses: [] };
    ln.g1 = ln.len - C.gapOut; ln.g0 = ln.len - C.gapIn;
    var n = 1 + (Math.random() < 0.35 ? 1 : 0);
    for (var j = 0; j < n; j++) ln.pulses.push({ s: -rnd(0, 1.3) * ln.g1, v: D * rnd(0.3, 0.65), ci: (Math.random() * 4) | 0 });
    return ln;
  }
  function at(ln, s) {
    var L = ln.L, p = ln.p;
    if (s <= 0) return p[0];
    if (s >= ln.len) return p[p.length - 1];
    for (var i = 1; i < L.length; i++) if (L[i] >= s) {
      var f = (s - L[i - 1]) / (L[i] - L[i - 1]);
      return [p[i - 1][0] + (p[i][0] - p[i - 1][0]) * f, p[i - 1][1] + (p[i][1] - p[i - 1][1]) * f];
    }
    return p[p.length - 1];
  }
  function partial(ln, s0, s1) {
    if (s1 <= s0) return;
    var L = ln.L, p = ln.p, a = at(ln, s0);
    c.moveTo(a[0], a[1]);
    for (var i = 1; i < L.length; i++) {
      if (L[i] <= s0) continue;
      if (L[i] >= s1) { var q = at(ln, s1); c.lineTo(q[0], q[1]); return; }
      c.lineTo(p[i][0], p[i][1]);
    }
  }
  var lanes = [], pitch = LH * 0.15;
  [{ ang: -Math.PI / 2, n: 5, pin: function (k) { return [cx + k, cy - C.hh]; } },
   { ang: Math.PI, n: 4, pin: function (k) { return [cx - C.hw, cy + k]; } },
   { ang: 0, n: 4, pin: function (k) { return [cx + C.hw, cy + k]; } }].forEach(function (sd) {
    var p0 = sd.pin(0), centre = route(p0[0], p0[1], sd.ang, C.gapOut + D * rnd(0.02, 0.06));
    for (var k = 0; k < sd.n; k++) {
      var o = (k - (sd.n - 1) / 2) * pitch, sgn = (sd.ang === 0 || sd.ang === -Math.PI / 2) ? 1 : -1;
      var off = offset(centre, o * sgn), s0 = sd.pin(o);
      off[0] = [s0[0], s0[1]];
      lanes.push(lane(off));
    }
  });

  function sprite(col) {
    var s = document.createElement("canvas"), z = 64;
    s.width = s.height = z;
    var g = s.getContext("2d"), r = g.createRadialGradient(z / 2, z / 2, 0, z / 2, z / 2, z / 2);
    r.addColorStop(0, "rgba(255,255,255,1)"); r.addColorStop(0.18, "rgba(" + col + ",.9)");
    r.addColorStop(0.5, "rgba(" + col + ",.22)"); r.addColorStop(1, "rgba(" + col + ",0)");
    g.fillStyle = r; g.fillRect(0, 0, z, z);
    return s;
  }
  var GOLD = "255,200,90";
  var FEST = ["235,64,72", "70,205,120", GOLD, BL];         // holiday pulse colours
  var spB = sprite(BL), spA = sprite(HOLIDAY ? GOLD : AC), spF = HOLIDAY ? FEST.map(sprite) : null;

  // ---------------------------------------------------------------- static background
  (function () {
    b.setTransform(K, 0, 0, K, 0, 0);
    var W = VW + 2 * MG, H = VH + 2 * MG;
    var g = b.createRadialGradient(W / 2, MG + cy, 0, W / 2, MG + cy, Math.hypot(W, H) / 2);
    g.addColorStop(0, "rgb(14,14,24)"); g.addColorStop(1, "rgb(2,6,16)");
    b.fillStyle = g; b.fillRect(0, 0, W, H);
    var gs = Math.max(14, D * 0.032);
    b.fillStyle = "rgba(110,160,230,.10)";
    for (var y = gs / 2; y < H; y += gs) for (var x = gs / 2; x < W; x += gs) { b.beginPath(); b.arc(x, y, 0.9 * U, 0, 6.283); b.fill(); }
  })();
  function vignette() {   // drawn on the animated layer so lanes fade toward the edges
