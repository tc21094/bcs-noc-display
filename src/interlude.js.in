      if (zt < 0.45) { c.fillStyle = "rgba(255,255,240," + (0.22 * (1 - zt / 0.45)).toFixed(3) + ")"; c.fillRect(-MG, -MG, VW + 2 * MG, VH + 2 * MG); }
      c.globalCompositeOperation = "lighter";
      c.strokeStyle = "rgba(255,250,190,.95)"; c.lineWidth = 3 * U;
      for (var b = 0; b < 3; b++) {
        var bx = x + (b - 1) * 34 * U, by = VH * 0.06; c.beginPath(); c.moveTo(bx, by);
        for (var s = 1; s <= 6; s++) c.lineTo(x + (b - 1) * 10 * U + rnd(-14, 14) * U, by + (high - 205 * U - by) * s / 6);
        c.stroke();
      }
      for (var sp = 0; sp < 10; sp++) { var a = rnd(0, 6.283), d = rnd(10, 60) * U; c.drawImage(spA, x + Math.cos(a) * d - 6 * U, high - 200 * U + Math.sin(a) * d - 6 * U, 12 * U, 12 * U); }
      c.globalCompositeOperation = "source-over";
    }
    if (lt >= ZAP + 1.5 && lt < ZAP + 6) {
      var st_ = (lt - ZAP - 1.5) / 4.5;
      for (var p = 0; p < 4; p++) { c.fillStyle = "rgba(120,125,135," + (0.4 * (1 - st_)).toFixed(3) + ")";
        c.beginPath(); c.arc(x + (p - 1.5) * 12 * U, high - 200 * U - st_ * 70 * U - p * 8 * U, (10 + st_ * 22) * U, 0, 6.283); c.fill(); }
    }
  }

  // ---- snowball fight. Two kids play on display 1. When the first ladder zap of each cycle surges
  // through the lights, two snowmen boot up (blue LED eyes) on the last display and start a snowball
  // fight with the kids - snowballs arc across every screen in between. The kids run home before the
  // plow comes; the snowmen don't, and get bulldozed.
  var KIDS = [{ dx: 0.07, coat: "#3f7fd6", hat: "#f2c230" }, { dx: 0.15, coat: "#9b4dca", hat: "#e5484d" }];
  var SNOWMEN = [{ dx: 0.13 }, { dx: 0.27 }];
  var BOOT = LAD_AT + ZAP + 4, FIGHT0 = BOOT + 10, FIGHT1 = 340, KID_OUT = 345, THROW = 1.6;
  function groundAt(X, now) { return HD * (1 + 0.35 * Math.sin(X / (190 * U) + 1) + 0.22 * Math.sin(X / (63 * U) + 2)) * snowLevel(X, now); }
  function kidX(i, cp) {                      // wall x; they walk in at the start of the cycle and run off before the plow
    var x = KIDS[i].dx * VW;
    if (cp < 12) x = -0.08 * VW + (x + 0.08 * VW) * ease(cp / 12);
    if (cp >= KID_OUT) x = x - (x + 0.12 * VW) * ease((cp - KID_OUT) / 8);
    return x;
  }
  function snowmanX(j, w) { return w.n === 1 ? (0.45 + 0.13 * j) * VW : (w.n - 1) * VW * (1 + w.gp) + SNOWMEN[j].dx * VW; }   // one display: they stand mid-screen
  function throwInfo(k, w, now) {             // throw k of the fight: who, at whom, where it lands, when
    var cp = now % PLOW_P, kidTeam = k % 2 === 0, who = (k >> 1) % 2, at = hash(k * 5 + 3) < 0.5 ? 0 : 1, hit = hash(k * 11 + 7) < 0.55;
    var t0 = FIGHT0 + k * THROW;
    var fx = kidTeam ? kidX(who, cp) : snowmanX(who, w), tx = kidTeam ? snowmanX(at, w) : kidX(at, cp);
    if (!hit) tx += (kidTeam ? -1 : 1) * VW * (0.03 + 0.05 * hash(k * 17 + 9));       // falls short
    var fy = kidTeam ? 70 * U : 135 * U, ty = hit ? (kidTeam ? 160 * U : 60 * U) : 0;
    var dist = Math.abs(tx - fx), dur = 1.1 + dist / (VW * 1.15);
    return { t0: t0, dur: dur, fx: fx, fy: fy, tx: tx, ty: ty, hit: hit, kidTeam: kidTeam, at: at, peak: Math.min(VH * 0.55, 60 * U + dist * 0.28) };
  }
  function hitAt(kidTarget, idx, w, now) {     // seconds since this one was last hit (or -1)
