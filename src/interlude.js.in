    c.strokeStyle = "#2b2b2b"; c.lineWidth = 1.6; var gl = up > 0.5 ? -5 : 0; c.beginPath(); c.arc(hd[0] + 5, hd[1] - 2 + gl, 4, 0, 6.283); c.stroke();
    if (up > 0.3) { c.fillStyle = "#1b1b1b"; c.beginPath(); c.arc(hd[0] + 5, hd[1] - 2, 1.8, 0, 6.283); c.fill(); }
    else { c.strokeStyle = "#1b1b1b"; c.beginPath(); c.moveTo(hd[0] + 2, hd[1] - 1); c.lineTo(hd[0] + 8, hd[1] - 1); c.stroke(); }
    c.fillStyle = "#5a2a1e"; c.beginPath(); c.ellipse(hd[0] + 7, hd[1] + 6, 2.5, up > 0.3 ? 4 : 2 + 1.5 * Math.abs(Math.sin(now * 1.3)), 0, 0, 6.283); c.fill();
