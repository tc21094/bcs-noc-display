      c.lineTo(p[i][0], p[i][1]);
    }
  }
  var lanes = [], pitch = LH * 0.15;
  [{ ang: -Math.PI / 2, n: 5, pin: function (k) { return [cx + k, cy - C.hh]; } },
   { ang: Math.PI, n: 4, pin: function (k) { return [cx - C.hw, cy + k]; } },
   { ang: 0, n: 4, pin: function (k) { return [cx + C.hw, cy + k]; } }].forEach(function (sd) {
    var p0 = sd.pin(0), centre = route(p0[0], p0[1], sd.ang, C.gapOut + D * rnd(0.02, 0.06));
    for (var k = 0; k < sd.n; k++) {
