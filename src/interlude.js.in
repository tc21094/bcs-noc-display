      c.strokeStyle = "rgba(25,40,32,.95)"; c.lineWidth = 2 * U;
      c.beginPath(); c.moveTo(x0, top); c.quadraticCurveTo(mx, my, x1, top); c.stroke();
      var nb = Math.max(4, Math.round(w / (70 * U)));
      for (var b = 1; b < nb; b++) {
        var u = b / nb, px = (1 - u) * (1 - u) * x0 + 2 * u * (1 - u) * mx + u * u * x1, py = (1 - u) * (1 - u) * top + 2 * u * (1 - u) * my + u * u * top;
        var ci = (sI * nb + b) % 4, tw = 0.55 + 0.45 * Math.sin(t * (1.3 + (b % 3) * 0.45) + b * 1.7 + sI);
        var lit = bulbLit(px, hn, wi), pb = pz !== null ? cl(1 - Math.abs(px - pz) / (VW * 0.12)) : 0;
        c.fillStyle = "rgba(25,40,32,1)"; c.fillRect(px - 2.5 * U, py, 5 * U, 4 * U);
        c.fillStyle = lit && bo > 0.1 ? "rgba(" + FEST[ci] + "," + ((0.55 + 0.45 * tw) * bo).toFixed(3) + ")" : "rgba(70,78,88,.9)";
        c.beginPath(); c.ellipse(px, py + 9 * U, 4.2 * U, 6.5 * U, 0, 0, 6.283); c.fill();
        if (lit) glows.push(px, py + 9 * U, ci, Math.min(1, (tw + sg) * bo + pb + ov), pb + ov * 0.6);
        if (popping && hash(sI * 97 + b * 13 + Math.floor(hn * 6)) < 0.08) c.drawImage(spA, px - 9 * U, py, 18 * U, 18 * U);
      }
    }
    c.globalCompositeOperation = "lighter";              // all the glows in one pass
    for (var gI = 0; gI < glows.length; gI += 5) {
      c.globalAlpha = glows[gI + 3];
      var gz = (32 + 40 * sg + 90 * glows[gI + 4]) * U;
      c.drawImage(spF[glows[gI + 2]], glows[gI] - gz / 2, glows[gI + 1] - gz / 2, gz, gz);
    }
    c.globalAlpha = 1; c.globalCompositeOperation = "source-over";
  }

  // ---------------------------------------------------------------- Thanksgiving (blanket theme)
  // A comedy that plays out across the whole wall on the shared clock, every 8 minutes. Tom the
  // turkey hangs out by the scarecrow and the pumpkins on the first display, under a harvest moon;
  // leaves fall and carpet the ground; a harvest garland hangs across the top; the B wears a
  // pilgrim hat. Grandpa sleeps in his recliner in front of the game on the middle display; the
  // house is on the last one.
  //  0:06  backyard football: a kid on the first display throws long bombs to an uncle on the last
  //        one, over everything in between. He catches some, takes some off the head, dives into
  //        the leaves for the rest, and now and then one lands on Grandpa.
  //  1:00  Dad deep-fries the (still frozen) turkey: fireball, Dad blown over and sooty, the flaming
  //        bird rockets across the wall and lands next to Tom, who faints. Dad puts the fire out
  //        with an extinguisher - and mostly foams himself.
  //  2:02  a giant turkey parade balloon drifts across with two handlers; a gust lifts them off their
  //        feet, it snags the chimney, pops, zips around and ends up draped over the roof.
  //  3:45  the Cook comes looking for Tom with a roasting pan. Tom's disguise - glasses, nose,
  //        mustache and a NOT A TURKEY sign - works until the mustache falls off. Chase across the
  //        wall; the Cook trips (pan on the head), Tom hides behind the house... and a scooter pulls
  //        up with a pizza. Tom ordered it. They share it on the porch steps.
  //  6:35  a BCS groundskeeper leaf-blows the whole wall clean into one huge pile at the far end,
  //        admires it, and a gust blows every leaf back across the wall, burying him.
  var TS = 1.25;                              // people's size
  var TG_P = 480, TG_HW = 0.265, TG_HG = VH * 0.028, BLOW_AT = 395, TG_GUST_D = 6.5;
  var FB0 = 22, FB1 = 146, FB_DT = 8, BOOM = 76, BAL0 = 122, BAL_SNAG = 190, BAL_LAND = 198;
  var TG_DOOR = [[8.5, 11], [60, 62.8], [104.3, 107], [155.5, 158.2], [225, 228.8], [383.6, 386.6]];
  var TG_LEAF = ["214,96,38", "190,52,38", "232,168,52", "150,92,48"];
  function tgSeg(cp, a, b) { return cl((cp - a) / (b - a)); }
  function tgLerp(a, b, u) { return a + (b - a) * u; }
  function tgIn(cp, a, b) { return cp >= a && cp < b; }
  function tgSt(w) {                          // where everyone lives: [display, fraction of its width]
    var n = w.n, M = n >= 3 ? Math.ceil(n / 2) : 1;
    if (n === 1) return { qb: [1, 0.045], tom: [1, 0.13], scare: [1, 0.215], uncle: [1, 0.3], gpa: [1, 0.41], tv: [1, 0.495], fry: [1, 0.6], house: [1, 0.72] };
    return { qb: [1, 0.07], tom: [1, 0.19], scare: [1, 0.3], uncle: [n, 0.28], gpa: [M, M === 1 ? 0.47 : 0.4],
             tv: [M, M === 1 ? 0.555 : 0.525], fry: [n, 0.6], house: [n, 0.72] };
  }
  function tgW(s, w) { return (s[0] - 1) * VW * (1 + w.gp) + s[1] * VW; }   // station -> wall x
  function tgL(X, w) { return X - (w.pos - 1) * VW * (1 + w.gp); }          // wall x -> this display
  function tgVis(X, w, m) { var x = tgL(X, w); return x > -m && x < VW + m; }
  function tgWide(w) { return w.n * VW + (w.n - 1) * VW * w.gp; }
  function tgDoor(w) { return tgW(tgSt(w).house, w) + TG_HW * VW * 0.3; }
  function tgPorch(w) { return tgDoor(w); }
  function tgChim(w) { return tgW(tgSt(w).house, w) + TG_HW * VW * 0.76; }
  function tgHD() { return { hh: Math.min(VH * 0.2, 220 * U), rh: Math.min(VH * 0.11, 120 * U) }; }
  function tgDoorOpen(cp) { for (var i = 0; i < TG_DOOR.length; i++) if (cp >= TG_DOOR[i][0] && cp < TG_DOOR[i][1]) return true; return false; }

  // ---- leaves on the ground: the groundskeeper blows them away, the gust brings them all back
  function tgBlow(w) { var v = Math.max(VW / 15, tgWide(w) / 48), x1 = tgWide(w) - 0.1 * VW; return { v: v, x1: x1, end: BLOW_AT + (x1 + 0.06 * VW) / v }; }
  function tgGuyX(cp, w) { var b = tgBlow(w); return -0.06 * VW + tgSeg(cp, BLOW_AT, b.end) * (b.x1 + 0.06 * VW); }
  function tgGust(w) { return tgBlow(w).end + 4; }
  function tgFront(cp, w) { return tgWide(w) + 0.1 * VW - (cp - tgGust(w)) / TG_GUST_D * (tgWide(w) + 0.3 * VW); }
  function tgCover(X, cp, w) {
    if (cp < BLOW_AT) return 1;
    if (cp >= tgGust(w) && X > tgFront(cp, w)) return 1;
    return X < tgGuyX(cp, w) + 40 * U ? 0.06 : 1;
  }
  function tgCoverH(X, cp, w) { return TG_HG * (1 + 0.4 * Math.sin(X / (170 * U) + 0.7) + 0.2 * Math.sin(X / (53 * U) + 2)) * tgCover(X, cp, w); }
  function tgGy(X, cp, w) { return VH - tgCoverH(X, cp, w) * 0.55; }
  function tgLeafAt(x, y, sz, rot, ci, a) {
    c.save(); c.translate(x, y); c.rotate(rot); if (a !== undefined) c.globalAlpha = a;
    c.drawImage(L.img[ci], -sz / 2, -sz / 2, sz, sz); c.restore();
  }
  function tgGround(cp, w) {
    var step = 14 * U, X0 = (w.pos - 1) * VW * (1 + w.gp), x;
    var g = c.createLinearGradient(0, VH - TG_HG * 2, 0, VH);
    g.addColorStop(0, "rgb(158,84,38)"); g.addColorStop(1, "rgb(84,46,24)");
    c.beginPath(); c.moveTo(-MG, VH + MG);
    for (x = -MG; x <= VW + MG + step; x += step) c.lineTo(x, VH - tgCoverH(X0 + x, cp, w));
    c.lineTo(VW + MG, VH + MG); c.closePath(); c.fillStyle = g; c.fill();
    var gs = 22 * U, k0 = Math.floor((X0 - MG) / gs), k1 = Math.ceil((X0 + VW + MG) / gs);
    for (var k = k0; k <= k1; k++) {
      var X = k * gs + hash(k * 3 + 1) * gs;
      if (tgCover(X, cp, w) < 0.5) continue;
      var h = tgCoverH(X, cp, w);
      tgLeafAt(X - X0, VH - h * (0.2 + 0.8 * hash(k * 5 + 2)), (20 + 14 * hash(k * 7 + 3)) * U, hash(k * 11 + 4) * 6.28, (hash(k * 13 + 5) * 4) | 0);
    }
  }
  function tgWind(t, cp, w) {                 // the breeze, and the big gust (blowing left)
    var wd = (16 * Math.sin(t * 0.21) + 10) * U, g0 = tgGust(w);
    if (cp >= g0 - 0.3 && cp < g0 + TG_GUST_D + 2.5 && tgL(tgFront(cp, w), w) < VW + 300 * U)
      wd -= 560 * U * cl((cp - g0 + 0.3) / 0.8) * (1 - cl((cp - g0 - TG_GUST_D) / 2.5));
    return wd;
  }
  function tgLeaves(t, dt, near, wd) {
    for (var i = 0; i < L.all.length; i++) {
      var f = L.all[i];
      if (f.near !== near) continue;
      f.y += f.vy * dt; f.x += (wd * (near ? 1 : 0.6) + Math.cos(t * f.sf + f.ph) * f.sw) * dt; f.rot += f.spin * dt * (1 + Math.abs(wd) / (120 * U));
      if (f.y > VH + 40 * U) { L.all[i] = L.new(false); continue; }
      if (f.x > VW + MG + 60 * U) f.x -= VW + 2 * MG + 120 * U; else if (f.x < -MG - 60 * U) f.x += VW + 2 * MG + 120 * U;
      var flip = Math.cos(t * f.fl + f.ph);
      c.save(); c.translate(f.x, f.y); c.rotate(f.rot + Math.sin(t * f.sf + f.ph) * 0.5); c.scale(0.25 + 0.75 * Math.abs(flip), 1);
      c.globalAlpha = f.a; c.drawImage(L.img[f.ci], -f.sz / 2, -f.sz / 2, f.sz, f.sz); c.restore();
    }
    c.globalAlpha = 1;
  }

  // ---- scenery: harvest moon, garland, the B's pilgrim hat, scarecrow, pumpkins, the house
  function tgMoon(w) {
    if (w.pos !== 1) return;
    var x = VW * 0.1, y = VH * 0.17, r = 54 * U;
    var g = c.createRadialGradient(x, y, r * 0.5, x, y, r * 3.4);
    g.addColorStop(0, "rgba(255,170,80,.22)"); g.addColorStop(1, "rgba(255,170,80,0)");
    c.fillStyle = g; c.fillRect(x - r * 3.4, y - r * 3.4, r * 6.8, r * 6.8);
    var mg = c.createRadialGradient(x - r * 0.3, y - r * 0.3, r * 0.1, x, y, r);
    mg.addColorStop(0, "#ffd08a"); mg.addColorStop(1, "#ee9a45");
    c.fillStyle = mg; c.beginPath(); c.arc(x, y, r, 0, 6.283); c.fill();
    c.fillStyle = "rgba(190,110,45,.35)";
    [[-0.32, -0.18, 0.17], [0.28, 0.18, 0.23], [0.05, -0.45, 0.1], [-0.15, 0.42, 0.12]].forEach(function (k) { c.beginPath(); c.arc(x + k[0] * r, y + k[1] * r, k[2] * r, 0, 6.283); c.fill(); });
  }
  function tgGarland(t, cp) {
    var swags = 3, sw = (VW + 2 * MG) / swags, top = VH * 0.012, sag = VH * 0.055, glows = [];
    var jump = cp >= BOOM && cp < BOOM + 1.8 ? (hash(Math.floor(t * 18)) < 0.5 ? 2.2 : 0.15) : 1;   // the fireball rattles them
    for (var s = 0; s < swags; s++) {
      var x0 = -MG + s * sw, x1 = x0 + sw, mx = (x0 + x1) / 2, my = top + 2 * sag;
      c.strokeStyle = "rgba(60,40,24,.95)"; c.lineWidth = 2 * U;
      c.beginPath(); c.moveTo(x0, top); c.quadraticCurveTo(mx, my, x1, top); c.stroke();
      var nb = Math.max(6, Math.round(sw / (46 * U)));
      for (var b = 1; b < nb; b++) {
        var u = b / nb, px = (1 - u) * (1 - u) * x0 + 2 * u * (1 - u) * mx + u * u * x1, py = (1 - u) * (1 - u) * top + 2 * u * (1 - u) * my + u * u * top;
        if (b % 2) {                                     // paper pennant, swaying
          c.save(); c.translate(px, py); c.rotate(Math.sin(t * 1.3 + b + s) * 0.12);
          c.fillStyle = "rgb(" + TG_LEAF[(b + s) % 4] + ")"; c.beginPath(); c.moveTo(-12 * U, 0); c.lineTo(12 * U, 0); c.lineTo(0, 27 * U); c.closePath(); c.fill();
          c.fillStyle = "rgba(255,255,255,.15)"; c.beginPath(); c.moveTo(-12 * U, 0); c.lineTo(0, 0); c.lineTo(0, 27 * U); c.closePath(); c.fill();
          c.restore();
        } else {                                         // warm bulb
          var tw = (0.6 + 0.4 * Math.sin(t * (1.1 + (b % 3) * 0.4) + b * 1.9 + s)) * jump;
          c.fillStyle = "rgba(60,40,24,1)"; c.fillRect(px - 2.5 * U, py, 5 * U, 4 * U);
          c.fillStyle = "rgba(255," + (170 + (b * 7) % 60) + ",80," + Math.min(1, 0.6 + 0.4 * tw).toFixed(3) + ")";
          c.beginPath(); c.ellipse(px, py + 9 * U, 4.2 * U, 6.5 * U, 0, 0, 6.283); c.fill();
          glows.push(px, py + 9 * U, Math.min(1.4, tw));
        }
      }
    }
    c.globalCompositeOperation = "lighter";
    for (var i = 0; i < glows.length; i += 3) { c.globalAlpha = Math.min(1, glows[i + 2]); var z = (34 + 30 * Math.max(0, glows[i + 2] - 1)) * U; c.drawImage(spA, glows[i] - z / 2, glows[i + 1] - z / 2, z, z); }
    c.globalAlpha = 1; c.globalCompositeOperation = "source-over";
  }
  function tgHat(t, la) {                     // a pilgrim hat on the B, and a few leaves settled on top
    if (la <= 0) return;
    var top = cy - LH / 2;
    for (var i = 0; i < L.cap.length; i++) {
      var k = L.cap[i], a = cl((t - k.at - 2) / 0.6) * la;
      if (a > 0 && k.u > 0.38) tgLeafAt(cx - LW / 2 + k.u * LW * 0.9, top + 4 * U - (1 - a) * 30 * U, k.sz, 1.57 + k.r, k.ci, a);
    }
    var d = 1 - ease((t - 2.6) / 1.3), s = LH / 300;
    if (d >= 1) return;
    c.save(); c.globalAlpha = la * (1 - d); c.translate(cx - LW / 2 + LW * 0.2, top + LH * 0.035 - d * 120 * U); c.rotate(-0.2 + d * 0.6); c.scale(s, s);
    c.fillStyle = "#1b1b20"; c.beginPath(); c.moveTo(-38, 0); c.lineTo(-30, -72); c.quadraticCurveTo(0, -80, 30, -72); c.lineTo(38, 0); c.closePath(); c.fill();
    c.beginPath(); c.ellipse(0, 0, 66, 11, 0, 0, 6.283); c.fill();
    c.fillStyle = "#3a3a42"; c.fillRect(-36, -22, 72, 15);
    c.strokeStyle = "#e2b84a"; c.lineWidth = 5; c.strokeRect(-11, -25, 22, 21);
    c.fillStyle = "rgba(255,255,255,.1)"; c.beginPath(); c.moveTo(-30, -72); c.quadraticCurveTo(-18, -76, -12, -74); c.lineTo(-18, 0); c.lineTo(-38, 0); c.closePath(); c.fill();
    c.restore();
  }
  function tgPumpkin(x, y, r, col) {
    c.fillStyle = col || "#e07a25";
    for (var k = -1; k <= 1; k++) { c.beginPath(); c.ellipse(x + k * r * 0.45, y - r * 0.8, r * 0.62, r * 0.8, 0, 0, 6.283); c.fill(); }
    c.strokeStyle = "rgba(120,50,10,.45)"; c.lineWidth = 1.5 * U;
    for (k = -1; k <= 1; k += 2) { c.beginPath(); c.ellipse(x + k * r * 0.22, y - r * 0.8, r * 0.3, r * 0.78, 0, 0, 6.283); c.stroke(); }
    c.strokeStyle = "#4e6b2a"; c.lineWidth = 4 * U; c.beginPath(); c.moveTo(x, y - r * 1.5); c.quadraticCurveTo(x + r * 0.1, y - r * 1.85, x + r * 0.32, y - r * 1.9); c.stroke();
  }
  function tgFarm(w) {                        // hay bales, pumpkins and corn stalks on the first display
    if (w.pos !== 1) return;
    var gy = VH - 4 * U, i;
    for (i = 0; i < 5; i++) {                  // corn stalks, far left
      var sx = (0.004 + i * 0.012) * VW, sh = (150 + 30 * hash(i * 9 + 1)) * U;
      c.strokeStyle = "#a88a48"; c.lineWidth = 4 * U; c.beginPath(); c.moveTo(sx, gy); c.quadraticCurveTo(sx + 8 * U, gy - sh * 0.6, sx + 3 * U, gy - sh); c.stroke();
      c.strokeStyle = "#c2a35a"; c.lineWidth = 3 * U;
      for (var l = 0; l < 4; l++) { var ly = gy - sh * (0.3 + l * 0.17), dir = l % 2 ? 1 : -1;
        c.beginPath(); c.moveTo(sx + 5 * U, ly); c.quadraticCurveTo(sx + dir * 26 * U, ly - 14 * U, sx + dir * 34 * U, ly + 8 * U); c.stroke(); }
    }
    var hb = [0.025 * VW + 20 * U, gy];                 // hay bale
    c.fillStyle = "#d8b45a"; rr(hb[0] - 50 * U, hb[1] - 52 * U, 100 * U, 52 * U, 8 * U); c.fill();
    c.strokeStyle = "rgba(140,100,30,.6)"; c.lineWidth = 2 * U;
    for (i = 0; i < 7; i++) { c.beginPath(); c.moveTo(hb[0] - 44 * U + i * 14 * U, hb[1] - 48 * U); c.lineTo(hb[0] - 40 * U + i * 14 * U, hb[1] - 4 * U); c.stroke(); }
    c.strokeStyle = "#8a5a2a"; c.lineWidth = 3 * U; c.beginPath(); c.moveTo(hb[0] - 50 * U, hb[1] - 36 * U); c.lineTo(hb[0] + 50 * U, hb[1] - 36 * U); c.moveTo(hb[0] - 50 * U, hb[1] - 16 * U); c.lineTo(hb[0] + 50 * U, hb[1] - 16 * U); c.stroke();
    tgPumpkin(hb[0] + 4 * U, hb[1] - 52 * U, 16 * U);
    tgPumpkin(0.105 * VW, gy, 22 * U); tgPumpkin(0.105 * VW + 34 * U, gy, 14 * U, "#ef9a3a"); tgPumpkin(0.105 * VW - 30 * U, gy, 11 * U, "#d9c27a");
  }
  function tgMark(x, y, ch, a) {              // "!" / "?" over someone's head
    c.save(); c.globalAlpha = a === undefined ? 1 : a; c.font = "bold " + Math.round(30 * U) + "px sans-serif"; c.textAlign = "center"; c.textBaseline = "middle";
    c.fillStyle = "rgba(255,255,255,.95)"; c.beginPath(); c.arc(x, y, 19 * U, 0, 6.283); c.fill();
    c.beginPath(); c.moveTo(x - 6 * U, y + 15 * U); c.lineTo(x - 12 * U, y + 28 * U); c.lineTo(x + 3 * U, y + 17 * U); c.fill();
    c.fillStyle = ch === "!" ? "#d62839" : "#1d4fa0"; c.fillText(ch, x, y + 1 * U); c.restore();
  }
  function tgStars(x, y, now, r) { for (var s = 0; s < 3; s++) { var a = now * 4 + s * 2.09; star(x + Math.cos(a) * r, y + Math.sin(a) * r * 0.3, 5 * U); } }
  function tgSmoke(x, y, now, n, sc, seed) {   // a little column of smoke (no state: same on every display)
    for (var k = 0; k < n; k++) {
      var ph = (now * 0.5 + k / n + hash(seed + k) * 0.3) % 1;
      c.fillStyle = "rgba(150,150,160," + (0.32 * (1 - ph)).toFixed(3) + ")";
      c.beginPath(); c.arc(x + Math.sin(now * 1.3 + k * 2) * 6 * U * sc + ph * 14 * U * sc, y - ph * 70 * U * sc, (5 + ph * 12) * U * sc, 0, 6.283); c.fill();
    }
  }

  // ---- the house (last display): door, window with a pie cooling, chimney, porch light
  function tgHouse(cp, now, w) {
    var st = tgSt(w), X0 = tgW(st.house, w);
    if (!tgVis(X0 + TG_HW * VW / 2, w, TG_HW * VW)) return;
    var x0 = tgL(X0, w), hw = TG_HW * VW, x1 = x0 + hw, hd = tgHD(), wt = VH - hd.hh, pk = wt - hd.rh;
    // chimney with smoke
    var chx = x0 + hw * 0.76;
    c.fillStyle = "#8b3a2a"; c.fillRect(chx - 15 * U, pk + hd.rh * 0.25 - 34 * U, 30 * U, hd.rh * 0.6 + 34 * U);
    c.fillStyle = "#6e2c20"; c.fillRect(chx - 19 * U, pk + hd.rh * 0.25 - 40 * U, 38 * U, 8 * U);
    tgSmoke(chx, pk + hd.rh * 0.25 - 44 * U, now, 5, 1.2, 77);
    // walls (siding) and roof
    c.fillStyle = "#c79a6b"; c.fillRect(x0, wt, hw, hd.hh + 2);
    c.strokeStyle = "rgba(90,60,30,.25)"; c.lineWidth = 1.5 * U;
    for (var sy = wt + 12 * U; sy < VH; sy += 13 * U) { c.beginPath(); c.moveTo(x0, sy); c.lineTo(x1, sy); c.stroke(); }
    c.fillStyle = "#5a3324"; c.beginPath(); c.moveTo(x0 - 22 * U, wt + 4 * U); c.lineTo(x0 + hw / 2, pk); c.lineTo(x1 + 22 * U, wt + 4 * U); c.closePath(); c.fill();
    c.strokeStyle = "rgba(0,0,0,.25)"; c.lineWidth = 2 * U;
    for (var r = 1; r < 5; r++) { var ry = pk + (wt - pk) * r / 5; c.beginPath(); c.moveTo(x0 + hw / 2 - (hw / 2 + 22 * U) * r / 5, ry); c.lineTo(x0 + hw / 2 + (hw / 2 + 22 * U) * r / 5, ry); c.stroke(); }
    // window: warm light, curtains, pie on the sill
    var wx0 = x0 + hw * 0.56, wx1 = x0 + hw * 0.9, wy0 = wt + hd.hh * 0.18, wy1 = wt + hd.hh * 0.58;
    c.fillStyle = "#ffc76a"; c.fillRect(wx0, wy0, wx1 - wx0, wy1 - wy0);
    c.fillStyle = "#b5452c"; c.beginPath(); c.moveTo(wx0, wy0); c.lineTo(wx0 + (wx1 - wx0) * 0.24, wy0); c.quadraticCurveTo(wx0 + (wx1 - wx0) * 0.08, (wy0 + wy1) / 2, wx0 + (wx1 - wx0) * 0.18, wy1); c.lineTo(wx0, wy1); c.fill();
