    var o = tgCookLook({ face: k.face, walk: k.pose === "walk" || k.pose === "chase", run: k.pose === "chase", ph: now * (k.pose === "chase" ? 13 : k.slow ? 5 : 8), rot: k.rot });
    var pan = true, panUp = false;
    if (k.pose === "inspect") { o.lean = 0.35; o.hy = 2; o.R = [22, -70]; o.L = [-6, -150 + 3 * Math.sin(now * 18)]; }
    else if (k.pose === "chase") { panUp = true; o.R = [18, -156]; }
