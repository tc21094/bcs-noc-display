    var W = VW + 2 * MG, H = VH + 2 * MG;
    c.translate(W / 2, H / 2); c.scale(0.8 * W / 2, 0.75 * H / 2);
    var v = c.createRadialGradient(0, 0, 0, 0, 0, 1);
    v.addColorStop(0.45, "rgba(2,6,16,0)"); v.addColorStop(1, "rgba(2,6,16,.88)");
    c.fillStyle = v; c.fillRect(-3, -3, 6, 6);
