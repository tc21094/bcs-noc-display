    c.fillStyle = g; c.fill();
  }

  // ---- ladder guy: three times per 8-minute cycle, at a random spot on one display, a gap in the
  // lights goes dark and he fixes it - badly. The ladder falls over before he can climb it, he nearly
  // comes off halfway up, the lights zap him when he plugs them in, and he climbs down seeing stars.
  var LAD_P = 160, LAD_AT = 100, LAD_D = 56, ZAP = 24;      // the whole act fits inside its 160 s slot
  function ladderEvent(now, w) {
    var slot = Math.floor(now / LAD_P), t = now - slot * LAD_P - LAD_AT;
    if (t < 0 || t > LAD_D) return null;
    var sp = ladderSpot(slot, w);
    return sp.pos === w.pos ? { t: t, x: sp.x } : null;
  }
  function bulbLit(px, now, w) {              // the bulbs where he'll work are out from the brownout until the zap
    var slot = Math.floor(now / LAD_P), t = now - slot * LAD_P, sp = ladderSpot(slot, w);
    if (sp.pos !== w.pos || Math.abs(px - sp.x) > VW * 0.13) return true;
    var from = slot % (PLOW_P / LAD_P) === 0 ? OVL + 23 : LAD_AT;
    return t < from || t >= LAD_AT + ZAP + 0.4;
  }
  function surge(ev) { return ev && ev.t >= ZAP && ev.t < ZAP + 2.5 ? 1 - (ev.t - ZAP) / 2.5 : 0; }
  function ladderAngle(lt) {                  // topples over, gets stood back up, wobbles halfway up
    if (lt >= 2 && lt < 3.4) { var u = (lt - 2) / 1.4; return -1.35 * u * u + (u > 0.85 ? 0.08 * Math.sin((u - 0.85) * 40) : 0); }
    if (lt >= 3.4 && lt < 5.5) return -1.35 * (1 - ease((lt - 3.4) / 2.1));
    if (lt >= 11 && lt < 14.5) return 0.13 * Math.sin((lt - 11) * 7.5) * Math.sin((lt - 11) / 3.5 * Math.PI);
    return 0;
  }
  function guy(fy, pose, now, lt) {           // pose: climb | stand | reach | zap | dazed | lift
    c.save(); c.translate(0, fy); c.scale(U * 1.35, U * 1.35);
    var climbing = pose === "climb", ph = fy / (34 * U) * Math.PI;
    if (pose === "zap") c.translate(Math.sin(now * 90) * 2.5, 0);                         // buzzing
    var lf = climbing ? -16 * Math.max(0, Math.sin(ph)) : 0, rf = climbing ? -16 * Math.max(0, -Math.sin(ph)) : 0;
    c.strokeStyle = "#2f4a7a"; c.lineWidth = 11; c.lineCap = "round";
    c.beginPath(); c.moveTo(-8, -52); c.lineTo(-10, -26 + lf / 2); c.lineTo(-9, lf); c.stroke();
    c.beginPath(); c.moveTo(8, -52); c.lineTo(10, -26 + rf / 2); c.lineTo(9, rf); c.stroke();
    c.fillStyle = "#4a2f1d"; c.beginPath(); c.ellipse(-9, lf + 3, 8, 5, 0, 0, 6.283); c.fill(); c.beginPath(); c.ellipse(9, rf + 3, 8, 5, 0, 0, 6.283); c.fill();
    c.fillStyle = "#c8432f"; rr(-19, -100, 38, 54, 12); c.fill();
    c.strokeStyle = "rgba(0,0,0,.18)"; c.lineWidth = 2; c.beginPath(); c.moveTo(-17, -82); c.lineTo(17, -82); c.moveTo(-18, -64); c.lineTo(18, -64); c.stroke();
    if (pose !== "dazed" && lt < ZAP) {                                                 // coil of lights (used up after the zap)
      c.strokeStyle = "rgba(255,255,255,.85)"; c.lineWidth = 2.5; c.beginPath(); c.ellipse(4, -74, 16, 22, -0.6, 0, 6.283); c.stroke();
      for (var k = 0; k < 6; k++) { var a = k * 1.05; c.fillStyle = "rgb(" + FEST[k % 4] + ")"; c.beginPath();
        c.arc(4 + Math.cos(a) * 16 * Math.cos(-0.6) - Math.sin(a) * 22 * Math.sin(-0.6), -74 + Math.cos(a) * 16 * Math.sin(-0.6) + Math.sin(a) * 22 * Math.cos(-0.6), 2.6, 0, 6.283); c.fill(); }
    }
    var L, R;                                  // hand positions
    if (climbing) { L = [-24, -128 + 10 * Math.sin(ph)]; R = [24, -128 - 10 * Math.sin(ph)]; }
    else if (pose === "reach") { L = [-24, -128]; R = [18, -160 + 6 * Math.sin(now * 6)]; }
    else if (pose === "zap") { L = [-30, -150]; R = [30, -152]; }
    else if (pose === "wobble") { var wa = now * 14; L = [-22 + Math.cos(wa) * 26, -112 + Math.sin(wa) * 26]; R = [22 + Math.cos(wa + 3) * 26, -112 + Math.sin(wa + 3) * 26]; }
    else if (pose === "lift") { L = [-30, -120]; R = [30, -120]; }
    else { L = [-24, -128]; R = [24, -128]; }
    c.strokeStyle = "#c8432f"; c.lineWidth = 10;
    c.beginPath(); c.moveTo(-15, -94); c.lineTo(L[0], L[1]); c.moveTo(15, -94); c.lineTo(R[0], R[1]); c.stroke();
    c.fillStyle = "#2e6b3f"; c.beginPath(); c.arc(L[0], L[1], 6, 0, 6.283); c.arc(R[0], R[1], 6, 0, 6.283); c.fill();
    var frizz = lt >= ZAP && lt < ZAP + 7;
    c.fillStyle = "#6b4a2e"; c.beginPath(); c.arc(0, -110, 12, 0, 6.283); c.fill();
    if (frizz) {                                                                        // hair standing straight up
      c.strokeStyle = "#6b4a2e"; c.lineWidth = 3;
      for (var hk = 0; hk < 9; hk++) { var ha = Math.PI + hk / 8 * Math.PI; c.beginPath(); c.moveTo(Math.cos(ha) * 11, -110 + Math.sin(ha) * 11);
        c.lineTo(Math.cos(ha) * 24 + Math.sin(now * 30 + hk) * 2, -110 + Math.sin(ha) * 24); c.stroke(); }
    }
    c.save(); if (frizz) { c.translate(4, -24 - 6 * Math.sin(Math.min(1, (lt - ZAP) * 3) * Math.PI / 2)); c.rotate(0.35); }
    c.fillStyle = "#2e8b57"; c.beginPath(); c.arc(0, -113, 12.5, Math.PI, 0); c.fill(); c.fillRect(-12.5, -114, 25, 6);
    c.fillStyle = "#ffffff"; c.beginPath(); c.arc(0, -127, 5, 0, 6.283); c.fill();
    c.restore();
    if (pose === "dazed" || (lt > ZAP + 2 && lt < ZAP + 9)) {                           // seeing stars
      for (var sI = 0; sI < 3; sI++) { var sa = now * 4 + sI * 2.09; star(Math.cos(sa) * 22, -138 + Math.sin(sa) * 6, 5); }
    }
    c.restore();
  }
  function star(x, y, r) {
    c.fillStyle = "#ffd84a"; c.beginPath();
    for (var k = 0; k < 10; k++) { var a = -Math.PI / 2 + k * Math.PI / 5, rr_ = k % 2 ? r * 0.45 : r; c.lineTo(x + Math.cos(a) * rr_, y + Math.sin(a) * rr_); }
    c.closePath(); c.fill();
  }
  function ladderGuy(ev, now, w) {
    if (!ev) return;
    var lt = ev.t, top = VH * 0.085, x = ev.x, rw = 26 * U, gap = 34 * U;
    var up = lt < 2 ? rise(lt / 2) : lt > 41 ? 1 - rise((lt - 41) / 3) : 1;
    var ly = top + (1 - up) * (VH - top + 40 * U), ang = ladderAngle(lt);
    var ground = VH - 4 * U, high = top + 200 * U;
    // where he is
    var fy, pose, onLadder = true;
    if (lt < 5.5) { fy = ground; pose = lt >= 3.4 ? "lift" : "stand"; onLadder = false; }
    else if (lt < 17) { fy = ground + (high - ground) * ease((lt - 5.5) / 11.5); pose = lt >= 11 && lt < 14.5 ? "wobble" : "climb"; }
    else if (lt < ZAP) { fy = high; pose = "reach"; }
    else if (lt < ZAP + 2) { fy = high; pose = "zap"; }
    else if (lt < ZAP + 5) { fy = high; pose = "dazed"; }
    else if (lt < 41) { fy = high + (ground - high) * ease((lt - ZAP - 5) / (41 - ZAP - 5)); pose = "climb"; }
    else { fy = ground; pose = "stand"; onLadder = false; }
    var gx = onLadder ? x : x + 48 * U;
    c.save(); c.translate(x, VH); c.rotate(ang); c.translate(-x, -VH);
    c.strokeStyle = "#b9c0c9"; c.lineWidth = 6 * U; c.lineCap = "round";
    c.beginPath(); c.moveTo(x - rw, VH + 10); c.lineTo(x - rw, ly); c.moveTo(x + rw, VH + 10); c.lineTo(x + rw, ly); c.stroke();
    c.lineWidth = 4 * U;
    for (var ry = VH - gap * 0.6; ry > ly + 6 * U; ry -= gap) { c.beginPath(); c.moveTo(x - rw, ry); c.lineTo(x + rw, ry); c.stroke(); }
    if (onLadder && lt < 44) { c.translate(gx, 0); if (pose === "wobble") c.rotate(ang * 1.6); guy(fy, pose, now, lt); }
    c.restore();
    if (!onLadder && lt < 46) { c.save(); c.translate(gx, 0); guy(fy, pose, now, lt); c.restore(); }
    // the zap: flash, lightning down to his hands, sparks, then a puff of smoke
