  var THEME = window.__BCS_THEME === "auto" ? seasonTheme(new Date()) : window.__BCS_THEME;
  var HOLIDAY = BLANKET && THEME === "holiday", THANKS = BLANKET && THEME === "thanksgiving";
  var IT = window.__BCS_INTERLUDE_THEME;       // "fall" / "standard" force it; anything else = by the calendar
  var FALL = !BLANKET && (IT === "fall" || (IT !== "standard" && fallSeason(new Date())));
  var WALL = window.__BCS_WALL || [1, 1];   // [position from the left, number of displays]
  var BL = "95,175,255";     // network blue (from the original)
  var AC = "232,44,68";      // accent: BCS red (the original used amber)

  var done = false, raf = 0, host = null;
