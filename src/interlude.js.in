    if (p && p.kind === "bonk" && cp - p.land >= 0 && cp - p.land < 2.4) tgStars(x, gy - 140 * U * TS, now, 22 * U);
    if (p && p.kind === "gpa" && cp - p.land >= 0 && cp - p.land < 2.6) tgMark(x, gy - 170 * U * TS, "!");
