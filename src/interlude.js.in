  }
  function drifts(now, w) {
    var step = 16 * U;
    c.beginPath(); c.moveTo(-MG, VH + MG);
    for (var x = -MG; x <= VW + MG + step; x += step) {
      var X = gX(x, w), base = HD * (1 + 0.35 * Math.sin(X / (190 * U) + 1) + 0.22 * Math.sin(X / (63 * U) + 2));
      c.lineTo(x, VH - Math.max(base, bank(x, w)) * snowLevel(X, now));
