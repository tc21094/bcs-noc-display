      var o = { sc: 0.92, sk: hI ? "#8d5a3b" : "#f0c8a0", shirt: "#3a6ea5", pants: "#2b3550", face: fc, walk: pose !== "look" && pose !== "lift", run: pose === "run", ph: now * (pose === "run" ? 14 : 8) + hI * 2,
        dress: function () { c.fillStyle = "#ff8a1f"; c.fillRect(-17, -98, 34, 46); c.fillStyle = "#e8f0f8"; c.fillRect(-17, -76, 34, 4); c.fillRect(-17, -64, 34, 4); },
        head: function (hx_, hy_) { c.fillStyle = "#ff8a1f"; c.beginPath(); c.arc(hx_, hy_ - 3, 13.6, Math.PI, 0); c.fill(); c.fillRect(hx_, hy_ - 6, 18, 4); } };
      if (pose === "walk" || pose === "lift") { o.L = [4, -150]; o.R = [10, -154]; if (pose === "lift") { o.walk = true; o.ph = now * 22 + hI; o.mouth = "o"; } }
      if (pose === "look") { o.L = [-26, -84]; o.R = [26, -84]; o.hy = -2; }
