      var pu = tgSeg(cp, 300, 301.5), headX = x + 112 * U * TS * k.face, px = tgLerp(x + 30 * U, headX, pu), py = tgLerp(gy - 150 * U * TS, gy - 30 * U * TS, pu) - 200 * U * Math.sin(pu * Math.PI);
      c.save(); c.translate(px, py); c.scale(U * TS, U * TS); tgPan(0, 0, pu * 12); c.restore();
      if (cp >= 301.5 && cp < 302) { c.fillStyle = "#ffffff"; c.font = "bold " + Math.round(22 * U) + "px sans-serif"; c.textAlign = "center"; c.fillText("BONG", headX, gy - 70 * U * TS); c.textAlign = "left"; }
      if (cp >= 301.5) tgStars(headX, gy - 48 * U * TS, now, 18 * U);
