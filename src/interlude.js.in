    c.strokeStyle = PJ; c.lineWidth = 12; c.lineCap = "round";
    c.beginPath(); c.moveTo(-8, -50); c.lineTo(-9, -4); c.moveTo(8, -50); c.lineTo(9, -4); c.stroke();
    c.fillStyle = "#8a5a3c"; c.beginPath(); c.ellipse(-11, -2, 11, 6, 0, 0, 6.283); c.ellipse(11, -2, 11, 6, 0, 0, 6.283); c.fill();
    // striped pajama top
    c.fillStyle = PJ; rr(-19, -100, 38, 56, 13); c.fill();
    c.strokeStyle = PJ2; c.lineWidth = 3;
    for (var sx = -12; sx <= 12; sx += 8) { c.beginPath(); c.moveTo(sx, -97); c.lineTo(sx, -47); c.stroke(); }
    c.fillStyle = "#ffffff"; [-88, -76, -64].forEach(function (by) { c.beginPath(); c.arc(0, by, 2, 0, 6.283); c.fill(); });
    // arms
    c.strokeStyle = PJ; c.lineWidth = 10;
    c.beginPath(); c.moveTo(-15, -94); c.lineTo(L[0], L[1]); c.moveTo(15, -94); c.lineTo(R[0], R[1]); c.stroke();
    c.fillStyle = "#f0c8a0"; c.beginPath(); c.arc(L[0], L[1], 5.5, 0, 6.283); c.arc(R[0], R[1], 5.5, 0, 6.283); c.fill();
    // mug, with steam
    if (pose !== "string") {
      c.fillStyle = "#c8323c"; c.fillRect(mug[0] - 6, mug[1] - 14, 13, 15);
      c.strokeStyle = "#c8323c"; c.lineWidth = 3; c.beginPath(); c.arc(mug[0] + 8, mug[1] - 7, 4.5, -1.4, 1.4); c.stroke();
      c.strokeStyle = "rgba(230,235,245,.5)"; c.lineWidth = 2;
      for (var st = 0; st < 2; st++) { var ph = now * 2 + st * 2; c.beginPath(); c.moveTo(mug[0] - 2 + st * 5, mug[1] - 16);
        c.quadraticCurveTo(mug[0] + 4 * Math.sin(ph) + st * 5, mug[1] - 24, mug[0] - 2 + st * 5, mug[1] - 32); c.stroke(); }
    }
    // head, glasses, nightcap
    c.fillStyle = "#f0c8a0"; c.beginPath(); c.arc(0, -112, 13, 0, 6.283); c.fill();
    c.strokeStyle = "#2b2b2b"; c.lineWidth = 1.6; c.beginPath(); c.arc(-5, -113, 4, 0, 6.283); c.moveTo(7, -113); c.arc(3 + 1, -113, 4, 0, 6.283); c.stroke();
    if (mouth) { c.fillStyle = "#5a2a1e"; c.beginPath(); c.ellipse(2, -103, 3, 4, 0, 0, 6.283); c.fill(); }
    c.fillStyle = "#3a8a5a"; c.beginPath(); c.moveTo(-13, -116); c.quadraticCurveTo(-4, -146, 22, -134); c.lineTo(13, -118); c.closePath(); c.fill();
    c.fillStyle = "#ffffff"; c.fillRect(-14, -121, 28, 6); c.beginPath(); c.arc(23, -134, 5, 0, 6.283); c.fill();
    c.restore();
  }
  // strung lights: a ridiculous number, in rows all over the camper
  var STRUNG = (function () {
